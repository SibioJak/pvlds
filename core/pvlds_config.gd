class_name PvldsConfig
extends RefCounted

## Plain, hand-editable JSON config: where VPX lives and where the tables
## live. Written by the first-run desk pass; safe to edit by hand after.
## Deliberately knows nothing about table .ini files - those are never
## read, written, moved, or regenerated by PVLDS.

const DEFAULT_EXE_NAME: String = "VPinball_GL64.exe"
## The default launch-args template. Plain -play: VPX has no
## exit-after-table flag (the "-exit" once shipped here came from
## frontend folklore; in vpinball's own parser "exit" is a no-op
## option "(ab)used by frontend, not handled by us" -
## src/core/AppCommands.cpp - and Chris's build read it as a table
## filename and errored). Table exits land in the VPX editor; the
## watchdog's session-close duty is what finishes the trip back.
const DEFAULT_LAUNCH_ARGS: String = "-play \"{table}\""
## The BAD default one fix round shipped. A saved template
## byte-identical to this was our dictation - auto-migration or the
## player's hand following our instructions - never a customization,
## so load_from_disk repairs it to DEFAULT_LAUNCH_ARGS. Anything
## else is the user's and is never rewritten.
const BAD_DEFAULT_LAUNCH_ARGS: String = "-play -exit \"{table}\""
const CONFIG_FILE_NAME: String = "pvlds_config.json"

var vpx_exe_path: String = ""
var launch_args_template: String = DEFAULT_LAUNCH_ARGS
var table_folders: Array[String] = []
var vpsdb_path: String = ""
var focus_herding: bool = true ## watchdog window duty kill-switch (design section 3 amendment)
## The player's World of Virtual Pinball API key (self-service
## in his WoVP profile; the Tournament Room's read side uses
## it). A secret: it lives ONLY in this local file, is loaded
## at boot, and is never printed or logged anywhere - the
## desk and the in-room SETUP panel mask it, and the harness
## greps every produced log for a sentinel key.
var wovp_api_key: String = ""
## Display dial (the GRAD FIX round's taste setting, ridden
## from the in-room SETUP panel): the starfield's layering.
## (The wing dial went with the wing in GRADFIX6 - the flip
## has no off state; a saved wing_enabled key in an old
## config file is simply no longer read.)
var starfield_mode: String = "layered" ## "layered" | "flat" | "off"
## NEXTROUND (item 4): the PINemHi personal-best read.
## pinemhi_folder: the PINemHi install folder PVLDS reads
## TOP10_Personal files from; "" = auto-detect the common
## locations (PinemhiScores.AUTO_DETECT_CANDIDATES).
## pinemhi_enabled: the toggle; off = the board line never
## appears (and the folder is never read).
var pinemhi_folder: String = ""
var pinemhi_enabled: bool = true
## PINEMHI2 (Part B): the watcher-management toggle.
## pinemhi_manage_watcher: when true, PVLDS runs the
## PINemHi watcher (pinemhi_rom_monitor.exe, in the folder
## above) strictly inside PVLDS's own open hours - the
## watchdog process starts it if it is not running, leaves
## a pre-running one adopted and untouched, and closes
## only a watcher PVLDS itself started, at true exit.
## Default OFF: PVLDS never touches the watcher process.
var pinemhi_manage_watcher: bool = false
## ROOMSUBMIT: the screenshots folder the in-room WoVP
## score submission reads score photos from - the folder
## his headset screenshots land in on this PC. "" = not
## set: the submit panel says so in words and sends
## nothing. Deliberately NO toggle (unlike PINemHi above):
## the folder's emptiness IS the off state - PINemHi's
## toggle exists because its auto-detect can find the
## wrong install, and a folder the player picks himself
## needs no second switch.
var screenshots_folder: String = ""
const STARFIELD_MODES: Array[String] = ["layered", "flat", "off"]
## Wall travel gait (was the GRADFIX10 item 3 display dial):
## the OPTIMIZE round closed the smooth-cruise saga by the
## player's ruling - STEPPED is the only gait now. The key
## stays in the file so configs written by ANY shipped build
## keep loading, but every stored value coerces to "stepped"
## on load (an old "smooth" included) and saves write
## "stepped". The SETUP panel's WALL MOTION button is gone.
var wall_motion_mode: String = "stepped" ## always "stepped" (OPTIMIZE)
const WALL_MOTION_MODES: Array[String] = ["stepped"]
## Deliberately absent: any close-duty or hold-to-exit setting.
## The exit model was simplified by the player's ruling
## (2026-10-22): the watchdog's session-close duty is
## unconditional and there is no hold gesture - D-pad right is a
## plain BACK button (in play: VPX's own Exit Game, then the
## watchdog closes the editor it lands in; in the room: quit to
## the desktop). Old configs carrying close_vpx_on_table_exit /
## hold_exit_enabled / hold_exit_button load fine - the keys are
## simply not read - and saves stop writing them.


static func beside_exe_path() -> String:
	return OS.get_executable_path().get_base_dir().path_join(CONFIG_FILE_NAME)


static func user_path() -> String:
	return "user://".path_join(CONFIG_FILE_NAME)


static func existing_path() -> String:
	# Prefer a config sitting next to the executable (a plain file the user
	# can see and edit); fall back to user:// (editor runs, first run).
	if not OS.has_feature("editor"):
		var beside: String = beside_exe_path()
		if FileAccess.file_exists(beside):
			return beside
	return user_path()


static func save_path() -> String:
	if OS.has_feature("editor"):
		return user_path()
	return beside_exe_path()


func load_from_disk() -> bool:
	var path: String = PvldsConfig.existing_path()
	if not FileAccess.file_exists(path):
		return false
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if not (parsed is Dictionary):
		return false
	var d: Dictionary = parsed
	vpx_exe_path = str(d.get("vpx_exe_path", ""))
	launch_args_template = str(d.get("launch_args_template", DEFAULT_LAUNCH_ARGS))
	if launch_args_template == BAD_DEFAULT_LAUNCH_ARGS:
		# Damage repair: the saved template IS the bad string we
		# shipped as a default (never a customization), so it resets
		# to the good default. The file on disk still holds the bad
		# text until the next save; the in-memory value is what
		# launches use and what the desk shows.
		launch_args_template = DEFAULT_LAUNCH_ARGS
	vpsdb_path = str(d.get("vpsdb_path", ""))
	focus_herding = bool(d.get("focus_herding", true))
	wovp_api_key = str(d.get("wovp_api_key", ""))
	starfield_mode = str(d.get("starfield_mode", "layered"))
	if not STARFIELD_MODES.has(starfield_mode):
		starfield_mode = "layered"
	pinemhi_folder = str(d.get("pinemhi_folder", ""))
	pinemhi_enabled = bool(d.get("pinemhi_enabled", true))
	pinemhi_manage_watcher = bool(d.get("pinemhi_manage_watcher", false))
	screenshots_folder = str(d.get("screenshots_folder", ""))
	# OPTIMIZE: any stored gait coerces to the one gait -
	# a config written by a shipped build may carry "smooth"
	# (the old default) and must load as "stepped", never error.
	wall_motion_mode = "stepped"
	table_folders.clear()
	var folders: Variant = d.get("table_folders", [])
	if folders is Array:
		var arr: Array = folders
		for item: Variant in arr:
			var f: String = str(item)
			if f != "":
				table_folders.append(f)
	return true


func save_to_disk() -> bool:
	var d: Dictionary = {}
	d["vpx_exe_path"] = vpx_exe_path
	d["launch_args_template"] = launch_args_template
	d["vpsdb_path"] = vpsdb_path
	d["focus_herding"] = focus_herding
	d["wovp_api_key"] = wovp_api_key
	d["starfield_mode"] = starfield_mode
	d["pinemhi_folder"] = pinemhi_folder
	d["pinemhi_enabled"] = pinemhi_enabled
	d["pinemhi_manage_watcher"] = pinemhi_manage_watcher
	d["screenshots_folder"] = screenshots_folder
	wall_motion_mode = "stepped" ## OPTIMIZE: saves write the one gait, whatever a caller left standing in the var
	d["wall_motion_mode"] = wall_motion_mode
	var folders: Array = []
	for f: String in table_folders:
		folders.append(f)
	d["table_folders"] = folders
	var file: FileAccess = FileAccess.open(PvldsConfig.save_path(), FileAccess.WRITE)
	if file == null:
		return false
	file.store_string(JSON.stringify(d, "\t"))
	file.close()
	return true


func is_configured() -> bool:
	return not table_folders.is_empty()
