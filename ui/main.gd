		var mdims: Array = [[512, 640], [400, 500], [300, 600]][mi2]
		(fl_solid.call(int(mdims[0]), int(mdims[1]), Color(0.2, 0.2, 0.2)) as Image).save_png(mp)
		med_paths.append(mp)
