func _grad_count(kind: String, example: String) -> void:
	_grad_viol[kind] = int(_grad_viol.get(kind, 0)) + 1
	if not _grad_viol_first.has(kind):
		_grad_viol_first[kind] = example


func _grad_expect(cond: bool, label: String) -> void:
	if cond:
		print("  ok - grad smoke: ", label)
	else:
		_grad_failures += 1
		printerr("  FAIL - grad smoke: ", label)


func _grad_fail(label: String) -> void:
	_grad_expect(false, label)


func _grad_game(game_id: String) -> GameEntry:
	if _room == null or _room._scanner == null:
		return null
	for g: GameEntry in _room._scanner.games:
		if g.game_id == game_id:
			return g
	return null


func _grad_panel_index(game_id: String) -> int:
	if _room == null:
		return -1
	for i: int in range(_room._panels.size()):
		if _room._panels[i] != null and _room._panels[i].payload == game_id:
			return i
	return -1


func _grad_manifest_games() -> Array:
	var out: Array = []
	var gs: Variant = _grad_manifest.get("games", [])
	if gs is Array:
		out = gs
	return out


## The fallback cast, visited one by one: a card's face is
## only real once the drum's window has filled it, so each
## special game is centred, its fill awaited, and its chain
## read there - the state a player actually meets.
func _grad_visit_games() -> Array:
	var out: Array = []
	for entry: Variant in _grad_manifest_games():
		if not (entry is Dictionary):
			continue
		var kind: String = str((entry as Dictionary).get("kind", ""))
		if kind == "b2s" or kind == "titlecard" or kind == "orphan" or kind == "missing":
			out.append(entry)
	return out


func _grad_visit_step() -> void:
	var visits: Array = _grad_visit_games()
	if _grad_visit_i < 0:
		_grad_visit_i = 0
		_grad_visit_settle = 0
		if visits.is_empty():
			_grad_phase = 2
			return
		_grad_focus_visit(visits[0])
		return
	if _grad_visit_i >= visits.size():
		_grad_phase = 2
		return
	var e: Dictionary = visits[_grad_visit_i]
	var g: GameEntry = _grad_visit_game(e)
	_grad_visit_settle += 1
	# Filled means the seated PANEL wears a real face: a
	# title-card game's face is a room-rendered texture,
	# never a file face_path() could name.
	var filled: bool = false
	if g != null:
		var pidx: int = _grad_panel_index(g.game_id)
		if pidx >= 0:
			var ptex: Texture2D = _room._panels[pidx].current_texture()
			filled = ptex != null and ptex != _room._placeholder_tex
	if _grad_visit_settle > 500:
		_grad_fail("fallback: %s's face never filled" % str(e.get("name", "?")))
		filled = true
	if filled and not _room.page_slide_active() and _grad_visit_settle > 10:
		_grad_leg_fallback_visit(e, g)
		_grad_visit_i += 1
		_grad_visit_settle = 0
		if _grad_visit_i < visits.size():
			_grad_focus_visit(visits[_grad_visit_i])
		else:
			_grad_phase = 2


func _grad_visit_game(e: Dictionary) -> GameEntry:
	var gid: String = str(e.get("id", ""))
	if gid != "":
		return _grad_game(gid)
	for cand: GameEntry in _room._scanner.games:
		if not cand.builds.is_empty() and str(cand.builds[0].file_name).begins_with(str(e.get("stem", ""))):
			return cand
	return null


func _grad_focus_visit(e: Dictionary) -> void:
	var g: GameEntry = _grad_visit_game(e)
	if g == null:
		return
	var idx: int = _grad_panel_index(g.game_id)
	if idx >= 0:
		_room._set_focused(_room._panels[idx])


## GRADFIX7 (item 1): a manifest game by kind + display name.
func _grad_gf7_find(kind: String, gname: String) -> GameEntry:
	for entry: Variant in _grad_manifest_games():
		if not (entry is Dictionary):
			continue
		var e: Dictionary = entry
		if str(e.get("kind", "")) == kind and str(e.get("name", "")) == gname:
			return _grad_visit_game(e)
	return null


## GRADFIX7 (item 1): the at-rest truth for one game, computed
## INDEPENDENTLY of the room (the census must not grade the
## room with the room's own probe): an author shot sitting in
## the shot cache, a side image on disk, or the extraction
## chain's cache - walked in source order, a stamped negative
## falling through, the first untried source answering "no
## art yet" (post-drain, untried means the warmer finished
## and still owes nothing it can pay).
func _grad_gf7_chain_says_art(g: GameEntry) -> bool:
	if g.shot_url != "" and ArtProvider.shot_is_cached(g.shot_url):
		return true
	if g.art_path != "":
		return true
	for src: String in g.art_sources():
		if ArtProvider.is_cache_current(src):
			return true
		if ArtProvider.is_negative_outcome(ArtProvider.outcome_for_source(src)):
			continue
		return false
	return false


func _grad_gf7_count(kind: String, example: String) -> void:
	_grad_gf7_viol[kind] = int(_grad_gf7_viol.get(kind, 0)) + 1
	if not _grad_gf7_viol_first.has(kind):
		_grad_gf7_viol_first[kind] = example


## GRADFIX7 (item 1) phase 8: the at-rest legs. Stage 0 waits
## for the warmer to idle and the shot fetcher to drain; stage
## 1 settles 2 s, judges the heal-honesty leg from the phase-1
## sample, then centres each chain-only fixture and reads its
## STANDING panel state (face_state) - no paying call is made
## for any of them in this phase; stage 2 is the at-rest
## census sweep over the whole library.
func _grad_gf7_step() -> void:
	match _grad_gf7_stage:
		0:
			var warm_idle: bool = _art_warmer == null or _art_warmer.is_idle()
			var shots_done: bool = _shot_fetcher == null or not _shot_fetcher.is_fetching()
			if warm_idle and shots_done:
				_grad_gf7_stage = 1
				_grad_gf7_since = Time.get_ticks_msec()
				_grad_gf7_ti = 0
				_grad_gf7_focused = false
				_grad_gf7_wait = 0
		1:
			if Time.get_ticks_msec() - _grad_gf7_since < 2000:
				return
			# (The heal-honesty leg lives in stage 3: Taxi
			# itself is already warm by any sample this boot
			# allows - the warmer and the room start on the
			# same scan landing and the warmer wins - so the
			# leg re-creates Taxi's cold condition with a
			# fresh-stamp clone of its own file, there.)
			var targets: Array = [
				["b2s", "Taxi", "chain upgrade: 'Taxi' wears its extracted backglass at rest"],
				["b2s", "The Goonies Never Say Die Pinball", "chain upgrade: 'Goonies' wears its extracted backglass at rest"],
				["vpxonly", "Zulu Vpx Chain", "chain upgrade: the vpx-only game wears its embedded art at rest"],
				["bigb2s", "Big Chain Glass", "chain upgrade: 'BigB2S' wears its extracted backglass at rest"],
			]
			if _grad_gf7_ti >= targets.size():
				_grad_gf7_stage = 2
				_grad_gf7_census_i = -1
				_grad_gf7_census_settle = 0
				return
			var t: Array = targets[_grad_gf7_ti]
			var g: GameEntry = _grad_gf7_find(str(t[0]), str(t[1]))
			if g == null:
				_grad_fail(str(t[2]) + " (fixture game not in the library)")
				_grad_gf7_ti += 1
				_grad_gf7_focused = false
				return
			var pidx: int = _grad_panel_index(g.game_id)
			if not _grad_gf7_focused:
				if pidx >= 0:
					_room._set_focused(_room._panels[pidx])
				_grad_gf7_focused = true
				_grad_gf7_wait = 0
				return
			_grad_gf7_wait += 1
			if _room.page_slide_active():
				_grad_gf7_wait = 0
				return
			var standing: Dictionary = {}
			for st: Variant in _room.face_state():
				if str((st as Dictionary).get("game_id", "")) == g.game_id:
					standing = st
					break
			if not standing.is_empty() and bool(standing.get("key_stamped", false)) \
					and not bool(standing.get("is_placeholder", true)) and _grad_gf7_wait > 5:
				_grad_expect(bool(standing.get("from_art", false)), str(t[2]))
				_grad_gf7_ti += 1
				_grad_gf7_focused = false
			elif _grad_gf7_wait > 1500:
				_grad_fail(str(t[2]) + " (its face never settled at rest)")
				_grad_gf7_ti += 1
				_grad_gf7_focused = false
		2:
			_grad_gf7_census_step()
		3:
			_grad_gf8_step()


## One census centre's assertions (GRADFIX7 item 1): every
## visible panel judged by game name against the independent
## truth table - expected-art stands as art with its plate and
## label up and a real texture; deliberate fallback stands
## styled and ONLY those games do; exactly one Launch visible
## per card; no flip standing; every pivot at 0; no back
## visible; and the Launch seat law - styled faces at
## PANEL_LAUNCH_Y, art faces at the bottom their standing
## plate's bottom earns (-0.47, or +0.44 when the grown plate
## reaches past -0.40).
func _grad_gf7_census_centre(c: int) -> void:
	var fs: Dictionary = _room.flip_state()
	if bool(fs.get("active", false)):
		_grad_gf7_count("flip", "centre %d: a flip stands (idx %s)" % [c, str(fs.get("idx", "?"))])
	var kind_by_title: Dictionary = {}
	for entry: Variant in _grad_manifest_games():
		if entry is Dictionary:
			kind_by_title[str((entry as Dictionary).get("name", ""))] = str((entry as Dictionary).get("kind", ""))
	for st: Variant in _room.face_state():
		var sd: Dictionary = st
		var idx: int = int(sd.get("idx", -1))
		if idx < 0 or idx >= _room._visible_games.size():
			continue
		_grad_gf7_seen[idx] = true
		var g: GameEntry = _room._visible_games[idx]
		var kind: String = str(kind_by_title.get(g.title, ""))
		var expected_art: bool = ["shot", "pair", "long", "b2s", "side", "vpxonly", "bigb2s"].has(kind) \
			or _grad_gf7_chain_says_art(g)
		var from_art: bool = bool(sd.get("from_art", false))
		if expected_art:
			if from_art:
				_grad_gf7_art_ok += 1
			else:
				_grad_gf7_count("art", "centre %d: '%s' (kind %s) should stand as art but wears its styled card" % [c, g.title, kind])
			var plate: MeshInstance3D = _room._panel_plates[idx] if idx < _room._panel_plates.size() else null
			var label: Label3D = _room._panel_labels[idx] if idx < _room._panel_labels.size() else null
			if from_art and (plate == null or not plate.visible or label == null or not label.visible):
				_grad_gf7_count("plate", "centre %d: '%s' stands as art without its plate+label up" % [c, g.title])
			if bool(sd.get("is_unreal", true)) or bool(sd.get("is_placeholder", true)):
				_grad_gf7_count("tex", "centre %d: '%s' wears an unreal or placeholder texture" % [c, g.title])
		else:
			if from_art:
				_grad_gf7_count("fallback", "centre %d: '%s' (kind %s) should stand styled but wears art" % [c, g.title, kind])
			else:
				_grad_gf7_fallback_ok += 1
		var front: ClickableQuad = _room._panel_launches[idx] if idx < _room._panel_launches.size() else null
		var back: ClickableQuad = _room._panel_back_launches[idx] if idx < _room._panel_back_launches.size() else null
		# GRADFIX13 (item 2): the census's Launch law is
		# inverted - the plinths are stripped, so a card
		# shows ZERO Launch quads: the front and back
		# entries are null (never minted), and any minted
		# quad standing visible or pickable at rest is a
		# violation counted under "launchcount". The back
		# HOLDER's visibility is judged the standing way
		# (a hidden holder's button is not visible however
		# its flag stands) - read off the panel pool's back
		# holder, since the button itself no longer exists
		# to parent-read. Under PVLDS_GF13_NC=plinth the
		# buttons are minted again and every centre counts
		# violations here; the verdict leg below is named
		# "no launch:" so the harness NC fails by name.
		var nodes7: Dictionary = _room._panel_pool.get(g.game_id, {}) as Dictionary
		var back_holder: Node3D = nodes7.get("back") as Node3D if not nodes7.is_empty() else null
		var vis_count: int = (1 if front != null and front.visible else 0) + (1 if back != null and back_holder != null and back_holder.visible else 0)
		if front != null or back != null or vis_count != 0:
			_grad_gf7_count("launchcount", "centre %d: '%s' carries a Launch plinth (front %s, back %s, visible %d)" % [
				c, g.title, str(front != null), str(back != null), vis_count])
		if back_holder != null and back_holder.visible:
			_grad_gf7_count("backvis", "centre %d: '%s' shows its back at rest" % [c, g.title])
		if idx < _room._panels.size() and absf(_room._panels[idx].flip_angle()) > 0.01:
			_grad_gf7_count("pivot", "centre %d: '%s' pivot stands at %.3f rad" % [c, g.title, _room._panels[idx].flip_angle()])


## The census sweep (GRADFIX7 item 1): every panel becomes
## the centre in turn; a centre is judged once the slide has
## rested and every visible face honestly stands (stamped,
## no placeholder). Desk-camera grabs at the first, middle
## and last centres are the eyeball record.
func _grad_gf7_census_step() -> void:
	var n: int = _room._panels.size()
	if _grad_gf7_census_i < 0:
		_grad_gf7_census_i = 0
		_room._set_focused(_room._panels[0])
		_grad_gf7_census_settle = 0
		_grad_gf7_census_wait = 0
		return
	_grad_gf7_census_wait += 1
	if _room.page_slide_active():
		_grad_gf7_census_settle = 0
		return
	var ready: bool = true
	for st: Variant in _room.face_state():
		if not bool((st as Dictionary).get("key_stamped", false)) or bool((st as Dictionary).get("is_placeholder", true)):
			ready = false
			break
	_grad_gf7_census_settle = _grad_gf7_census_settle + 1 if ready else 0
	if _grad_gf7_census_settle < 3:
		if _grad_gf7_census_wait > 1500:
			_grad_gf7_count("settle", "centre %d: a visible face never settled" % _grad_gf7_census_i)
			_grad_gf7_census_settle = 3 ## judge this centre as it stands and move on
		else:
			return
	if _room.centre_index() == _grad_gf7_census_i:
		_grad_gf7_census_centre(_grad_gf7_census_i)
		if _grad_gf7_census_i == 0:
			_grad_save_grab("gradfix7_census_start.png")
		elif _grad_gf7_census_i == n / 2:
			_grad_save_grab("gradfix7_census_mid.png")
		elif _grad_gf7_census_i == n - 1:
			_grad_save_grab("gradfix7_census_end.png")
	_grad_gf7_census_i += 1
	_grad_gf7_census_settle = 0
	_grad_gf7_census_wait = 0
	if _grad_gf7_census_i >= n:
		print("GRADFIX7 CENSUS (GRADFIX13 restatement): %d panels swept, %d art-standing observations, %d fallback-standing observations, %d Launch-plinth violations"
			% [_grad_gf7_seen.size(), _grad_gf7_art_ok, _grad_gf7_fallback_ok, _grad_gf7_seat_viol])
		_grad_expect(_grad_gf7_seen.size() == n,
			"at-rest census: every panel was swept (%d of %d)" % [_grad_gf7_seen.size(), n])
		var kinds: Array = [
			["art", "at-rest census: every expected-art panel stands as art"],
			["fallback", "at-rest census: styled faces stand only where fallback is deliberate"],
			["plate", "at-rest census: every art face stands with its plate+label up"],
			["tex", "at-rest census: every visible texture is real, none the placeholder"],
			["launchcount", "no launch: at-rest census: no card carries a Launch plinth, front or back (GRADFIX13 item 2 - the strip)"],
			["backvis", "at-rest census: no back visible at rest"],
			["pivot", "at-rest census: every pivot angle is 0 at rest"],
			["flip", "at-rest census: no flip stands at rest"],
			["settle", "at-rest census: every visible face settled at its centre"],
		]
		for pair: Variant in kinds:
			var kk: String = str((pair as Array)[0])
			var lt: String = str((pair as Array)[1])
			var cnt: int = int(_grad_gf7_viol.get(kk, 0))
			if cnt == 0:
				_grad_expect(true, lt)
			else:
				_grad_expect(false, "%s (%d violations; first: %s)" % [lt, cnt, str(_grad_gf7_viol_first.get(kk, ""))])
		_grad_gf7_stage = 3
		_grad_gf8_ti = 0
		_grad_gf8_focused = false
		_grad_gf8_wait = 0
	else:
		_room._set_focused(_room._panels[_grad_gf7_census_i])


## Mean luminance (0-255, Rec.709 weights, stride 2) of an
## image over a window - the face-luminance leg's measure,
## the same weights the harness census
## (check_face_luminance.gd) uses.
func _grad_mean_lum(img: Image, win: Rect2i) -> float:
	if img == null or img.is_empty():
		return -1.0
	var x0: int = maxi(0, win.position.x)
	var y0: int = maxi(0, win.position.y)
	var x1: int = mini(img.get_width(), win.position.x + win.size.x)
	var y1: int = mini(img.get_height(), win.position.y + win.size.y)
	if x1 <= x0 or y1 <= y0:
		return -1.0
	var sum: float = 0.0
	var n: int = 0
	var y: int = y0
	while y < y1:
		var x: int = x0
		while x < x1:
			var c: Color = img.get_pixel(x, y)
			sum += 0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b
			n += 1
			x += 2
		y += 2
	if n == 0:
		return -1.0
	return sum / float(n) * 255.0


## The centred window of a source image that the face's
## KEEP_ASPECT_COVERED draw shows on the card canvas - the
## source luminance the standing face must match.
func _grad_cover_win(img: Image) -> Rect2i:
	var iw: float = float(img.get_width())
	var ih: float = float(img.get_height())
	var scale: float = maxf(float(RoomView.CARD_FACE_PX.x) / iw, float(RoomView.CARD_FACE_PX.y) / ih)
	var ww: int = int(round(float(RoomView.CARD_FACE_PX.x) / scale))
	var wh: int = int(round(float(RoomView.CARD_FACE_PX.y) / scale))
	return Rect2i(int((iw - float(ww)) * 0.5), int((ih - float(wh)) * 0.5), ww, wh)


## GRADFIX8 (item 2, CRUSHED FACES) phase 8 stage 3: the
## face-luminance legs. The convicted fault: a pair
## backglass's standing face was its OFF half - the unlit
## glass - at ~0.44x the mean luminance of its own lit On
## half, while every other class stands in its lit picture
## and the render pipeline itself is 1:1 (the harness census,
## check_face_luminance.gd). Each target's STANDING panel
## texture is measured against its lit source (the pair's On
## half; a shot's cache; the chain's extraction), cover-window
## to whole-face, inside the adopted tolerance: rendered
## within max(10 grey levels, 15% of source). The seam
## PVLDS_GRADFIX8_NC=crush restores the Off-half serving, so
## the pair leg fails by name.
func _grad_gf8_step() -> void:
	var targets: Array = [
		["bigb2s", "Big Chain Glass", "on"],
		["shot", "Aaron Spelling", "shot"],
		["b2s", "Taxi", "chain"],
		["vpxonly", "Zulu Vpx Chain", "chain"],
	]
	if _grad_gf8_ti >= targets.size():
		_grad_phase = 7
		_grad_visit_i = -1
		return
	var t: Array = targets[_grad_gf8_ti]
	var g: GameEntry = _grad_gf7_find(str(t[0]), str(t[1]))
	if g == null:
		_grad_fail("face luminance: '%s' standing face matches its lit source (fixture game not in the library)" % str(t[1]))
		_grad_gf8_ti += 1
		_grad_gf8_focused = false
		return
	var pidx: int = _grad_panel_index(g.game_id)
	if not _grad_gf8_focused:
		if pidx >= 0:
			_room._set_focused(_room._panels[pidx])
		_grad_gf8_focused = true
		_grad_gf8_wait = 0
		return
	_grad_gf8_wait += 1
	if _room.page_slide_active():
		_grad_gf8_wait = 0
		return
	var standing: Dictionary = {}
	for st: Variant in _room.face_state():
		if str((st as Dictionary).get("game_id", "")) == g.game_id:
			standing = st
			break
	var settled: bool = not standing.is_empty() and bool(standing.get("key_stamped", false)) \
		and not bool(standing.get("is_placeholder", true)) and _grad_gf8_wait > 5
	if not settled and _grad_gf8_wait <= 1500:
		return
	if not settled:
		_grad_fail("face luminance: '%s' standing face matches its lit source (its face never settled at rest)" % str(t[1]))
		_grad_gf8_ti += 1
		_grad_gf8_focused = false
		return
	var src_path: String = ""
	match str(t[2]):
		"on":
			src_path = g.pair_on_art()
		"shot":
			src_path = ArtProvider.shot_cache_path_for(g.shot_url)
		_:
			src_path = g.face_path_ready()
	var src_img: Image = Image.new()
	var src_lum: float = -1.0
	if src_path != "" and src_img.load(src_path) == OK:
		src_lum = _grad_mean_lum(src_img, _grad_cover_win(src_img))
	var rendered_lum: float = -1.0
	if pidx >= 0:
		var ptex: Texture2D = _room._panels[pidx].current_texture()
		if ptex != null:
			var rimg: Image = ptex.get_image()
			if rimg != null:
				rendered_lum = _grad_mean_lum(rimg, Rect2i(0, 0, rimg.get_width(), rimg.get_height()))
	var tol: float = maxf(10.0, 0.15 * src_lum) if src_lum > 0.0 else -1.0
	_grad_expect(src_lum > 0.0 and rendered_lum >= 0.0 and absf(rendered_lum - src_lum) <= tol,
		"face luminance: '%s' standing face matches its lit source (rendered %.1f, source %.1f, tolerance %.1f)"
		% [str(t[1]), rendered_lum, src_lum, tol])
	_grad_gf8_ti += 1
	_grad_gf8_focused = false


## The heal-honesty leg (GRADFIX7 item 1), phase 14 - the
## grad run's last, so the clone it plants cannot shift the
## shelf indices the other phases judge. Taxi's
## stamped key must gain its art segment when the warmer
## lands, with no paying call. Taxi itself can never show
## the transition in this boot - the warmer and the room
## start on the same scan landing and the warmer extracts
## Taxi before its panel first fills (measured twice: the
## earliest sample already wore the art segment). So the leg
## re-creates the identical cold condition deterministically:
## a fresh-stamp clone of Taxi's own 31 MB .directb2s (plus
## its dummy .vpx) is planted in the library folder and the
## library rescans. The room is already built, so the clone's
## face stamps STYLED within a tick of adoption, seconds
## before its extraction can land; then the warmer drains
## and the leg judges the standing upgrade - the stamped
## key's art segment, the panel's from_art, and the
## no-paying-call witness (the clone's art_path still unset:
## nothing in this boot ever called face_path()/ensure_art()
## for it - the heal and the probe did all the work).
func _grad_gf7_heal_step() -> void:
	match _grad_gf7_heal_stage:
		0:
			var stem: String = ""
			for entry: Variant in _grad_manifest_games():
				if entry is Dictionary and str((entry as Dictionary).get("kind", "")) == "b2s" \
						and str((entry as Dictionary).get("name", "")) == "Taxi":
					stem = str((entry as Dictionary).get("stem", ""))
			var folder: String = str(_config.table_folders[0]) if _config != null and not _config.table_folders.is_empty() else ""
			_grad_expect(stem != "" and folder != "",
				"heal honesty: Taxi's fixture files are locatable for the clone")
			if stem == "" or folder == "":
				_grad_phase = 6
				return
			var new_stem: String = "Taxi Healcheck (Williams 1988)"
			var ok_copy: bool = true
			for ext: String in [".vpx", ".directb2s"]:
				var bytes: PackedByteArray = FileAccess.get_file_as_bytes(folder.path_join(stem + ext))
				var out: FileAccess = FileAccess.open(folder.path_join(new_stem + ext), FileAccess.WRITE)
				if bytes.is_empty() or out == null:
					ok_copy = false
					break
				out.store_buffer(bytes)
				out.close()
			_grad_expect(ok_copy, "heal honesty: the Taxi clone is planted")
			if not ok_copy or not start_scan():
				_grad_fail("heal honesty: the rescan never started")
				_grad_phase = 6
				return
			_grad_gf7_heal_stage = 1
			_grad_gf7_wait = 0
		1:
			_grad_gf7_wait += 1
			if _scan_active:
				return
			if _grad_gf7_heal_game == null:
				for g: GameEntry in _scanner.games:
					if g.title == "Taxi Healcheck":
						_grad_gf7_heal_game = g
						break
				if _grad_gf7_heal_game == null:
					if _grad_gf7_wait > 3600:
						_grad_fail("heal honesty: the clone never joined the library")
						_grad_phase = 6
					return
				var pidx: int = _grad_panel_index(_grad_gf7_heal_game.game_id)
				if pidx >= 0:
					_room._set_focused(_room._panels[pidx])
				return
			var k: String = str(_room._panel_face_key.get(_grad_gf7_heal_game.game_id, ""))
			if k != "":
				_grad_gf7_heal_before = k
				_grad_gf7_heal_stage = 2
				_grad_gf7_wait = 0
			elif _grad_gf7_wait > 3600:
				_grad_fail("heal honesty: the clone's face never stamped")
				_grad_phase = 6
		2:
			if _art_warmer != null and not _art_warmer.is_idle():
				return
			# The warmer has landed; the heal + refill take
			# their own frames (the heal's throttle, then the
			# worker's render). Poll for the upgrade itself -
			# the stamped key's art segment AND the standing
			# from_art - and judge only when it stands or the
			# wait runs out.
			var g: GameEntry = _grad_gf7_heal_game
			var after: String = str(_room._panel_face_key.get(g.game_id, ""))
			var aparts: PackedStringArray = after.split("|")
			var from_art: bool = false
			for st: Variant in _room.face_state():
				if str((st as Dictionary).get("game_id", "")) == g.game_id:
					from_art = bool((st as Dictionary).get("from_art", false))
					break
			var upgraded: bool = aparts.size() > 1 and aparts[1] != "" and from_art
			_grad_gf7_wait += 1
			if not upgraded and _grad_gf7_wait < 3600:
				return
			var bparts: PackedStringArray = _grad_gf7_heal_before.split("|")
			_grad_expect(bparts.size() > 1 and bparts[1] == "",
				"heal honesty: the Taxi clone's stamped key starts styled ('%s')" % _grad_gf7_heal_before)
			_grad_expect(aparts.size() > 1 and aparts[1] != "" and g.art_path == "",
				"heal honesty: Taxi's stamped key gains its art segment when the warmer lands, with no paying call")
			_grad_expect(from_art,
				"heal honesty: the Taxi clone stands wearing its extracted backglass after the heal")
			_grad_phase = 6


## GRADFIX8 (item 3) board-pairing legs, run once on the
## grad run's last phase: Chris's field case rebuilt from
## the real records - the VPS database's own Iron Maiden
## Legacy of the Beast record (game ZhNnPRvbTS, Stern 2018;
## its VPW build _UMEFSmYor at v1.0.12, authors ["VPW"],
## the vpuniverse slug "iron-maiden-legacy-of-the-beast-
## original-2022-vpw" - fields copied verbatim from the
## real vpsdb.json record) and his renamed file "Iron
## Maiden Legacy of the Beast (Original 2022) VPW
## 1.0.12.vpx". The board side is the fixture shape the
## TR1-era data carries (a monthly_contracts challenge
## naming the game and build by their VPS ids), with his
## real field row on it: #35, 135,990,580.
func _grad_gf8_pairing_legs() -> void:
	var root_user: String = "user://gradfix8_pairing"
	_wipe_tree(ProjectSettings.globalize_path(root_user))
	var user_dir: DirAccess = DirAccess.open("user://")
	if user_dir != null and not user_dir.dir_exists("gradfix8_pairing"):
		user_dir.make_dir("gradfix8_pairing")
	var root_dir: DirAccess = DirAccess.open(root_user)
	if root_dir != null and not root_dir.dir_exists("tables_exact"):
		root_dir.make_dir("tables_exact")
	if root_dir != null and not root_dir.dir_exists("tables_diff"):
		root_dir.make_dir("tables_diff")
	var exact_tables: String = root_user.path_join("tables_exact")
	var diff_tables: String = root_user.path_join("tables_diff")
	var db_data: Array = [
		{
			"id": "ZhNnPRvbTS", "name": "Iron Maiden Legacy of the Beast",
			"manufacturer": "Stern", "year": 2018, "designers": ["Keith Elwin"],
			"tableFiles": [
				{"id": "_UMEFSmYor", "version": "1.0.12", "tableFormat": "VPX", "authors": ["VPW"], "createdAt": 1678510800000, "features": ["VR", "Hybrid", "FastFlips", "SSF", "Music", "incl. PuP", "4k", "Scorbit", "no ROM", "nFozzy", "Fleep"], "imgUrl": "https://virtualpinballspreadsheet.github.io/vps-db/img/ZhNnPRvbTS_table_1672516219642.webp", "urls": [{"url": "https://vpuniverse.com/files/file/12603-iron-maiden-legacy-of-the-beast-original-2022-vpw/"}]},
				{"id": "N1Rm5GDsRK", "version": "1.1", "tableFormat": "VPX", "authors": ["Solters", "Oroborus"], "createdAt": 1659564000000, "features": ["MOD", "VR", "FlexDMD", "no ROM"], "imgUrl": "https://virtualpinballspreadsheet.github.io/vps-db/img/ZhNnPRvbTS_table_1660072135926.webp", "urls": [{"url": "https://vpuniverse.com/files/file/10946-vr-room-im-legacy-of-the-beast-pro-tribute/"}]},
				{"id": "xJ9vBfm2Ib", "version": "1.1", "tableFormat": "VPX", "authors": ["Oroborus", "JPSalas", "Enomao", "Arngrim"], "createdAt": 1658872800000, "features": ["Music", "no ROM", "Retheme"], "imgUrl": "https://virtualpinballspreadsheet.github.io/vps-db/img/undefined_table_1656291728556.webp", "urls": [{"url": "https://vpuniverse.com/files/file/10592-iron-maiden-legacy-of-the-beast-pro-tribute/"}, {"url": "https://www.vpforums.org/index.php?app=downloads&showfile=16735"}]},
			],
		},
	]
	_grad_expect(_write_text_file(root_user.path_join("vpsdb.json"), JSON.stringify(db_data)),
		"board pairing: the Iron Maiden fixture db is written")
	var pair_db: VpsDatabase = VpsDatabase.new()
	_grad_expect(pair_db.load_db(root_user.path_join("vpsdb.json")),
		"board pairing: the Iron Maiden fixture db loads")
	var exact_name: String = "Iron Maiden Legacy of the Beast (Original 2022) VPW 1.0.12.vpx"
	var diff_name: String = "Iron Maiden Legacy of the Beast (Stern 2018) v1.1.vpx"
	_grad_expect(_write_text_file(exact_tables.path_join(exact_name), "fixture"),
		"board pairing: his renamed file is planted")
	_grad_expect(_write_text_file(diff_tables.path_join(diff_name), "fixture"),
		"board pairing: the different-build file is planted")
	var ch: WovpChallenge = WovpChallenge.new()
	ch.challenge_id = "gradfix8-monthly-lotb"
	ch.name = "October"
	ch.type_code = WovpChallenge.TYPE_MONTHLY
	ch.table_external_id = "ZhNnPRvbTS"
	ch.table_name = "Iron Maiden Legacy of the Beast"
	ch.table_manufacturer = "Stern"
	ch.table_year = 2018
	ch.version_external_id = "_UMEFSmYor"
	ch.version_name = "VPW 1.0.12"
	ch.end_unix = 1999999999
	var his: WovpScoreRow = WovpScoreRow.new()
	his.position = 35
	his.participant_name = "S. Kubrick"
	his.score = 135990580.0
	his.user_id = "fixture-user-1"
	ch.rows.append(his)
	# The exact case: his renamed file, scanned fresh.
	var exact_folders: Array[String] = [exact_tables]
	var scan_exact: LibraryScanner = LibraryScanner.new()
	scan_exact.scan(exact_folders, pair_db)
	var g_exact: GameEntry = scan_exact.game_by_id("ZhNnPRvbTS")
	_grad_expect(g_exact != null,
		"board pairing: his renamed Iron Maiden file resolves to the VPS game ZhNnPRvbTS - the board's join key (the (Original 2022) paren states the build's kind and year, not Stern 2018's)")
	if g_exact != null:
		var b_exact: TableBuild = g_exact.build_by_path(exact_tables.path_join(exact_name))
		_grad_expect(b_exact != null and b_exact.matched_db and b_exact.table_file_id == "_UMEFSmYor",
			"board pairing: his renamed file resolves to the VPW build _UMEFSmYor itself, not just the game")
		_grad_expect(_room._challenge_build_owned(g_exact, ch),
			"board pairing: the challenge's build is his build")
		var spec_exact: Dictionary = RoomSpecs.tournament_board_spec(
			ch, true, "fixture-user-1", 1700000000, _room._challenge_build_owned(g_exact, ch))
		_grad_expect(not _nav_spec_has_chip(spec_exact, "NOT IN YOUR LIBRARY")
			and not _nav_spec_has_chip(spec_exact, "DIFFERENT BUILD IN YOUR LIBRARY"),
			"board pairing: the Iron Maiden board carries no library chip - the game and the build are both his")
		var his_row_stands: bool = false
		for rv: Variant in (spec_exact.get("rows", []) as Array):
			if rv is Dictionary and str((rv as Dictionary).get("text", "")).contains("#35") \
					and str((rv as Dictionary).get("text", "")).contains("135,990,580"):
				his_row_stands = true
		_grad_expect(his_row_stands,
			"board pairing: his #35 row (135,990,580) stands on the Iron Maiden board the chip used to contradict")
	# The honesty branch: the right game, a different build.
	var diff_folders: Array[String] = [diff_tables]
	var scan_diff: LibraryScanner = LibraryScanner.new()
	scan_diff.scan(diff_folders, pair_db)
	var g_diff: GameEntry = scan_diff.game_by_id("ZhNnPRvbTS")
	_grad_expect(g_diff != null,
		"board pairing: the different-build file still resolves to the game - the game is his")
	if g_diff != null:
		var b_diff: TableBuild = g_diff.build_by_path(diff_tables.path_join(diff_name))
		_grad_expect(b_diff != null and b_diff.matched_db and b_diff.table_file_id == "N1Rm5GDsRK",
			"board pairing: the different-build file resolves to build N1Rm5GDsRK - a real build of the game, and not the challenge's")
		_grad_expect(not _room._challenge_build_owned(g_diff, ch),
			"board pairing: the challenge's build is NOT among his builds of the game")
		var spec_diff: Dictionary = RoomSpecs.tournament_board_spec(
			ch, true, "fixture-user-1", 1700000000, _room._challenge_build_owned(g_diff, ch))
		_grad_expect(_nav_spec_has_chip(spec_diff, "DIFFERENT BUILD IN YOUR LIBRARY")
			and not _nav_spec_has_chip(spec_diff, "NOT IN YOUR LIBRARY"),
			"board pairing: the different-build board says DIFFERENT BUILD IN YOUR LIBRARY, never the blanket NOT IN YOUR LIBRARY")
	# The blanket chip's reserved case: a game he does not own.
	var ch_none: WovpChallenge = WovpChallenge.new()
	ch_none.challenge_id = "gradfix8-season-acdc"
	ch_none.name = "Main - Week 3"
	ch_none.type_code = WovpChallenge.TYPE_SEASON
	ch_none.table_external_id = "kGBkVb-v"
	ch_none.table_name = "AC/DC (LUCI Premium)"
	ch_none.version_external_id = "butCgIcLzI"
	ch_none.end_unix = 1999999999
	var spec_none: Dictionary = RoomSpecs.tournament_board_spec(
		ch_none, scan_exact.game_by_id("kGBkVb-v") != null, "fixture-user-1", 1700000000, false)
	_grad_expect(_nav_spec_has_chip(spec_none, "NOT IN YOUR LIBRARY")
		and not _nav_spec_has_chip(spec_none, "DIFFERENT BUILD IN YOUR LIBRARY"),
		"board pairing: a game he does not own at all keeps the blanket NOT IN YOUR LIBRARY chip, and only that case does")
	_wipe_tree(ProjectSettings.globalize_path(root_user))
## GRADFIX8 phase 9 (items 1/5/6, the room-furniture round):
## the centring probes render first (one unawaited pass over
## the room's factory, the layout probes' pattern), then the
## named legs judge: the standing board's content block and
## the library flip back's, centred on their canvases; the
## widened board carrying its longest deadline whole; the
## shelf-end fins gone. Under PVLDS_GRADFIX8_NC=offcentre
## CardFace restores the top-loaded composition and the two
## centring legs fail by name.
func _grad_gf9_step() -> void:
	match _grad_gf8_stage:
		0:
			if not _grad_gf8_probes_started:
				_grad_gf8_probes_started = true
				_grad_gf8_run_probes()
			_grad_gf8_wait += 1
			if _grad_gf8_probes_done:
				_grad_gf8_stage = 1
				_grad_gf8_wait = 0
			elif _grad_gf8_wait > 3600:
				_grad_fail("board centred: the GRADFIX8 probes never landed")
				_grad_gf8_stage = 1
				_grad_gf8_wait = 0
		1:
			_grad_gf8_legs()
			_grad_phase = 15
			_grad_gf8_stage = 0
			_grad_power_stage = 0
			_grad_wait = 0


## GRADFIX10 (item 1): a rendered board face's content-ink
## vertical centroid, in face pixels, judged against the
## face's own FRAME - the suites' legs read the one measure
## the factory's correction pass uses (TextureFactory.
## ink_centroid; the plinth, when a spec reserves one, is
## excluded as furniture, not content).
func _board_ink_centroid(tex: Texture2D, exclude_face_rect: Rect2) -> Vector2:
	if tex == null:
		return Vector2(-1.0, 0.0)
	return TextureFactory.ink_centroid(tex.get_image(), exclude_face_rect)


## GRADFIX13 (item 1): the extent ruler - the midpoint of a
## rendered face's first and last ink rows, judged against
## the face's own FRAME. GF10's legs judged the ink MASS
## (the centroid above) and passed a shipped board whose
## visible composition - band top to last-row bottom -
## rode 2.41% of frame height high, because the score
## rows' solid panels pool the mass below the extent's
## centre and the factory's correction chased the mass.
## The legs below read the extent now (the factory's
## correction pass uses the same measure); the centroid
## helper stays for the record prints.
func _board_ink_extent(tex: Texture2D, exclude_face_rect: Rect2) -> Vector2:
	if tex == null:
		return Vector2(-1.0, 0.0)
	return TextureFactory.ink_extent(tex.get_image(), exclude_face_rect)


func _grad_gf8_run_probes() -> void:
	var now_unix: int = int(Time.get_unix_time_from_system())
	# The board: the layout fixture's season challenge with
	# its deadline re-seated 3h14m out - the field shape
	# whose sub line ("Ends ... - 3h 14m left - CLOSES
	# SOON") ellipsized on the old 0.62 m board.
	var text: String = FileAccess.get_file_as_string("res://data/wovp/challenges_search_layout.json")
	var parsed: Dictionary = WovpClient.parse_challenges(text)
	var ch: WovpChallenge = null
	if bool(parsed.get("ok", false)):
		for cv: Variant in (parsed.get("challenges", []) as Array):
			var cand: WovpChallenge = cv as WovpChallenge
			if cand != null and cand.type_code == WovpChallenge.TYPE_SEASON:
				ch = cand
				break
	if ch != null:
		ch.end_unix = now_unix + 3 * 3600 + 14 * 60
		_grad_gf8_board_spec = RoomSpecs.tournament_board_spec(ch, true, "fixture-user-long", now_unix)
		_grad_gf10_board_tex = await _room._factory.render_texture(_grad_gf8_board_spec, RoomSpecs.board_face_px())
		_grad_gf8_board_m = _room._factory.face_board_metrics()
	# GRADFIX10 (item 1): the few-rows board - a fresh extra
	# board carrying only his own pending row (the smallest
	# composition the field shows), parsed from a one-row
	# answer in the layout fixture's own shape, its deadline
	# re-seated 30h out (the amber warmth band). The frame-
	# centring ink leg judges this texture beside the full
	# board's: a composition that only centres when full is
	# not centred.
	var few_text: String = "{\"items\": [{\"id\": \"fixture-ch-gf10-few\", \"challengeTypeCode\": \"extra\", \"name\": \"Extra - Week 3\", \"startDateUTC\": \"2026-10-19T19:00:00Z\", \"endDateUTC\": \"2026-11-01T19:00:00Z\", \"pinballTable\": {\"id\": \"pt-twilight-zone\", \"externalId\": \"gf10fewtable\", \"name\": \"Twilight Zone\", \"manufacturer\": \"Bally\", \"year\": 1993}, \"scoreBoard\": {\"items\": [{\"position\": 1, \"values\": {\"Position\": 1, \"ParticipantName\": \"S. Kubrick\", \"Score\": 5785360.0, \"UserId\": \"fixture-user-long\", \"IsPending\": true}}]}}]}"
	var few_parsed: Dictionary = WovpClient.parse_challenges(few_text)
	if bool(few_parsed.get("ok", false)):
		var few_arr: Array = few_parsed.get("challenges", []) as Array
		if not few_arr.is_empty():
			var few_ch: WovpChallenge = few_arr[0] as WovpChallenge
			if few_ch != null:
				few_ch.end_unix = now_unix + 30 * 3600
				_grad_gf10_few_spec = RoomSpecs.tournament_board_spec(few_ch, true, "fixture-user-long", now_unix)
				_grad_gf10_few_tex = await _room._factory.render_texture(_grad_gf10_few_spec, RoomSpecs.board_face_px())
				_grad_gf10_few_m = _room._factory.face_board_metrics()
	# The back: the fixture library's longest title, through
	# the library's own back spec at the back's own size.
	var g: GameEntry = _grad_game(str(_grad_manifest.get("long_id", "")))
	if g != null:
		var wspec: Dictionary = RoomSpecs.wing_spec(g, null, "", now_unix)
		_grad_gf15_back_tex = await _room._factory.render_texture(wspec, RoomSpecs.BACK_FACE_PX)
		_grad_gf8_back_m = _room._factory.face_board_metrics()
	_grad_gf8_probes_done = true


func _grad_gf8_legs() -> void:
	# Item 1a, restated by GRADFIX10 (item 1): GRADFIX8
	# judged the standing board's content BLOCK (its
	# bounding box) against the area above the footer plinth
	# and passed it (+4 px) while the field read the board
	# 66 px high over a dead dark plank. Two ruler faults:
	# the area was not the frame, and the box is not the
	# ink - the block's mass (solid panels below, sparse
	# text above) sits off its box centre by up to ~27 px.
	# GRADFIX10's legs therefore judge the rendered INK
	# against the FRAME (below); the box is printed here as
	# the record, not the verdict. The reservation itself is
	# gone (the spec carries footer_px 0; the tournament
	# layout legs convict a reserved band by name), and
	# under PVLDS_GRADFIX10_NC=deadplank it returns and the
	# ink legs fail by name.
	var bm: Dictionary = _grad_gf8_board_m
	var bface: Vector2 = bm.get("face_size", Vector2.ZERO)
	var bcr: Rect2 = bm.get("content_rect", Rect2())
	var bcen: Vector2 = bcr.get_center()
	print("GRADFIX10 BOARD: content box centroid (%.1f, %.1f), frame centre (%.1f, %.1f), box delta (%.1f, %.1f) px on a %s face (spec footer_px %d) - the box is the record; the ink legs below are the verdict"
		% [bcen.x, bcen.y, bface.x * 0.5, bface.y * 0.5, bcen.x - bface.x * 0.5, bcen.y - bface.y * 0.5, str(bface), int(_grad_gf8_board_spec.get("footer_px", 0))])
	# Item 1a, the width: the longest deadline form renders
	# WHOLE on the widened board - its measured need fits
	# its allotment at the rendered font.
	var bneed: float = float(bm.get("sub_need_px", 0.0))
	var ballot: float = float(bm.get("sub_allot_px", 0.0))
	_grad_expect(bneed > 0.0 and bneed <= ballot + 0.5,
		"board width: the widened board (%.2f m) carries the full deadline whole - '%s' needs %.0f px of its %.0f px (the 0.62 m board allotted 568 and the line ellipsized)"
			% [RoomSpecs.board_panel_size().x, str(bm.get("sub_text", "")), bneed, ballot])
	# GRADFIX10 (item 1): the ink ruler - the rendered faces'
	# content-ink centroid against the FRAME's centre (the
	# frame located from the face's own size, never from the
	# content's bounds), tolerance 2% of frame height, on a
	# many-rows board (the layout season board) and a
	# few-rows board (his pending row alone). The plinth, if
	# a spec reserves one, is excluded from the ink - under
	# PVLDS_GRADFIX10_NC=deadplank the reservation returns,
	# the content rides high again, and these legs fail by
	# name.
	# GRADFIX13 (item 1) restates the ruler: the field
	# convicted the MASS centroid - it passed the shipped
	# board at +0.44% while the composition's EXTENT rode
	# -2.41% high (the score panels pool the mass low, so
	# centring the mass parks the edges high). These legs
	# now judge the ink EXTENT (first-to-last ink row)
	# against the frame, same names, same 2% tolerance;
	# under PVLDS_GF13_NC=inkmass the factory's correction
	# chases the mass again and they fail by name. The
	# seated-grab legs (the tournament smoke's "seated
	# centre:") judge the same extent through the room.
	var bex: Rect2 = bm.get("footer", Rect2())
	var bink: Vector2 = _board_ink_extent(_grad_gf10_board_tex, bex)
	var bink_delta: float = bink.x - bface.y * 0.5
	print("GRADFIX13 BOARD EXTENT: centre %.1f, frame centre %.1f, delta %.1f px (%.2f%% of frame height), ink %d px (the GF10 mass centroid on this face is the record print in the factory's history: it passed at +0.44%% while the extent rode -2.41%%)"
		% [bink.x, bface.y * 0.5, bink_delta, 100.0 * bink_delta / maxf(1.0, bface.y), int(bink.y)])
	_grad_expect(bink.y > 0.0 and absf(bink_delta) <= bface.y * 0.02,
		"board centred: the many-rows board's content ink EXTENT centres on its FRAME (extent centre %.1f vs frame centre %.1f, delta %.1f px = %.2f%% of frame height, tolerance 2%%; GRADFIX10's ink-mass ruler passed this board while its composition rode 26 px high)"
			% [bink.x, bface.y * 0.5, bink_delta, 100.0 * bink_delta / maxf(1.0, bface.y)])
	var fface: Vector2 = _grad_gf10_few_m.get("face_size", Vector2.ZERO)
	var fex: Rect2 = _grad_gf10_few_m.get("footer", Rect2())
	var fink: Vector2 = _board_ink_extent(_grad_gf10_few_tex, fex)
	var fink_delta: float = fink.x - fface.y * 0.5
	print("GRADFIX13 FEW EXTENT: centre %.1f, frame centre %.1f, delta %.1f px (%.2f%% of frame height), ink %d px"
		% [fink.x, fface.y * 0.5, fink_delta, 100.0 * fink_delta / maxf(1.0, fface.y), int(fink.y)])
	_grad_expect(fink.y > 0.0 and absf(fink_delta) <= fface.y * 0.02,
		"board frame-centred: the few-rows board's content ink EXTENT centres on its FRAME (extent centre %.1f vs frame centre %.1f, delta %.1f px = %.2f%% of frame height, tolerance 2%%)"
			% [fink.x, fface.y * 0.5, fink_delta, 100.0 * fink_delta / maxf(1.0, fface.y)])
	# Item 1b: the library flip back's whole composition -
	# TABLE DATA band, title, data rows - centred on the
	# card canvas.
	var wm: Dictionary = _grad_gf8_back_m
	var wface: Vector2 = wm.get("face_size", Vector2.ZERO)
	var wcr: Rect2 = wm.get("content_rect", Rect2())
	var wcen: Vector2 = wcr.get_center()
	var wtgt: Vector2 = wface * 0.5
	print("GRADFIX8 BACK: content centroid (%.1f, %.1f), canvas centre (%.1f, %.1f), delta (%.1f, %.1f) px on a %s face"
		% [wcen.x, wcen.y, wtgt.x, wtgt.y, wcen.x - wtgt.x, wcen.y - wtgt.y, str(wface)])
	_grad_expect(not wm.is_empty() and wcr.size.y > 0.0 and absf(wcen.x - wtgt.x) <= 12.0 and absf(wcen.y - wtgt.y) <= 12.0,
		"back centred: the flip back's TABLE DATA composition centres on its canvas (centroid (%.0f, %.0f) vs centre (%.0f, %.0f), delta (%.0f, %.0f) px; the pre-fix block rode 431 px high)"
			% [wcen.x, wcen.y, wtgt.x, wtgt.y, wcen.x - wtgt.x, wcen.y - wtgt.y])
	# Item 5: the shelf-end bookend fins are GONE from the
	# room - no fin node stands in the library view (the
	# tournament smoke's walk asserts the same count in the
	# Tournament view, where GRADFIX3's removal is now
	# verified by census rather than assumed).
	_grad_expect(_room.bookend_fin_count() == 0,
		"fins: zero bookend fin nodes stand in the room (library view; got %d)" % _room.bookend_fin_count())
	# GRADFIX15 (items 1+2, the amputation): the board and
	# back faces are FRAMELESS - the text block stands on
	# transparency, no panel fill behind it, and the grey
	# spine line is deleted at its source. The census judges
	# every pixel of the three probe faces against the text
	# block's own part rects: visible alpha outside them is
	# stray and must be 0; the former spine-line columns must
	# carry no visible pixel outside the block. Under
	# PVLDS_GF15_NC=panelfill the panel fill returns and
	# these legs fail by name.
	_grad_gf15_census_leg("many-rows board", _grad_gf10_board_tex, bm)
	_grad_gf15_census_leg("few-rows board", _grad_gf10_few_tex, _grad_gf10_few_m)
	_grad_gf15_census_leg("flip back", _grad_gf15_back_tex, wm)


## GRADFIX15 (item 3): one face's frameless census verdict -
## the pixel counts print either way (the record), and the
## leg fails on any stray alpha, any missing transparency,
## or any visible pixel at the grey line's former address.
func _grad_gf15_census_leg(label: String, tex: Texture2D, metrics: Dictionary) -> void:
	if tex == null or metrics.is_empty():
		_grad_expect(false, "frameless census: the %s face rendered for its census (texture %s, metrics %s)"
			% [label, "present" if tex != null else "MISSING", "present" if not metrics.is_empty() else "MISSING"])
		return
	var c: Dictionary = TextureFactory.frameless_census(tex.get_image(), metrics.get("part_rects", []) as Array)
	print("GRADFIX15 CENSUS %s: total %d, visible ink/accent %d, transparent %d, stray %d (first %s), grey-line columns %d"
		% [label, int(c.get("total", 0)), int(c.get("visible", 0)), int(c.get("transparent", 0)),
			int(c.get("stray", 0)), str(c.get("stray_pos", Vector2i(-1, -1))), int(c.get("line_out", 0))])
	_grad_expect(int(c.get("total", 0)) > 0 and int(c.get("transparent", 0)) > 0 and int(c.get("stray", 0)) == 0,
		"frameless census: the %s's text block stands on transparency - %d visible ink/accent px, %d transparent px, %d stray-alpha px outside the text block (must be 0; PVLDS_GF15_NC=panelfill restores the panel fill and this leg fails by name)"
			% [label, int(c.get("visible", 0)), int(c.get("transparent", 0)), int(c.get("stray", 0))])
	_grad_expect(int(c.get("line_out", 0)) == 0,
		"grey line: no visible pixel stands in the former spine-line columns of the %s (%d found outside the text block - the hairline is deleted at its source, CardFace's spine furniture)"
			% [label, int(c.get("line_out", 0))])
	# Item 6: the pager stops are gone from the rail; the
	# page readout stays and still TRACKS the centred
	# column - move the centre a page over and the readout
	# must name the new page, then restore the boot centre.
	_grad_expect(not _room._rail_quads.has("page_prev") and not _room._rail_quads.has("page_next") and _room._rail_quads.has("page_label"),
		"pager stops: the rail carries no < > pager stops and keeps the page readout (quads: %s)" % str(_room._rail_quads.keys()))
	var la_before: Array = _room._rail_label_accent("page_label")
	var readout_before: String = str(la_before[0]) if not la_before.is_empty() else ""
	var target_idx: int = mini(RoomView.PAGE_SIZE, maxi(0, _room._visible_games.size() - 1))
	_room._set_centre(target_idx)
	var la_after: Array = _room._rail_label_accent("page_label")
	var readout_after: String = str(la_after[0]) if not la_after.is_empty() else ""
	var readout_want: String = "%d / %d" % [_room._page + 1, _room.page_count()]
	_grad_expect(readout_after == readout_want and readout_after != readout_before,
		"page readout: the readout still tracks the centred column (was '%s', centre moved to shelf %d, reads '%s', page state %s)"
			% [readout_before, target_idx, readout_after, readout_want])
	_room._set_centre(_grad_boot_centre)


func _grad_leg_fallback_visit(e: Dictionary, g: GameEntry) -> void:
	var kind: String = str(e.get("kind", ""))
	if g == null:
		_grad_fail("faces: fixture game '%s' is in the library" % str(e.get("name", "?")))
		return
	match kind:
		"b2s":
			_grad_expect(g.shot_url == "" and not g.has_shot_face(),
				"fallback: %s has no author shot" % g.title)
			_grad_expect(g.backglass_face_path() != "" and g.face_path() == g.backglass_face_path(),
				"fallback: %s's face is its backglass" % g.title)
		"titlecard", "orphan":
			_grad_expect(not g.has_shot_face() and g.backglass_face_path() == "",
				"fallback: %s has neither shot nor backglass" % g.title)
			var pidx2: int = _grad_panel_index(g.game_id)
			var ptex2: Texture2D = _room._panels[pidx2].current_texture() if pidx2 >= 0 else null
			_grad_expect(ptex2 != null and ptex2 != _room._placeholder_tex,
				"fallback: %s still wears a generated title card" % g.title)
		"missing":
			var url: String = str(e.get("shot_url", ""))
			_grad_expect(not g.has_shot_face(),
				"fallback: the 404 shot does not dress %s" % g.title)
			_grad_expect(ArtProvider.is_negative_outcome(ArtProvider.shot_outcome(url)),
				"fallback: the 404 shot is a recorded negative for %s" % g.title)
			_grad_expect(g.face_path() != ArtProvider.shot_cache_path_for(url),
				"fallback: %s falls through the chain for good" % g.title)


func _grad_save_grab(name: String) -> void:
	var dir: String = OS.get_environment("PVLDS_GRAB_DIR")
	if dir == "":
		return
	var img: Image = get_viewport().get_texture().get_image()
	var err: Error = img.save_png(dir.path_join(name))
	print("GRAD GRAB: ", name, " err=", err, " size=", img.get_size())


## A world AABB's screen rect through the desk camera.
func _grad_aabb_screen_rect(aabb: AABB, cam: Camera3D) -> Rect2:
	var c: Array[Vector3] = []
	for sx: float in [-1.0, 1.0]:
		for sy: float in [-1.0, 1.0]:
			for sz: float in [-1.0, 1.0]:
				c.append(aabb.position + Vector3(
					(aabb.size.x if sx > 0.0 else 0.0),
					(aabb.size.y if sy > 0.0 else 0.0),
					(aabb.size.z if sz > 0.0 else 0.0)))
	var rect: Rect2 = Rect2(cam.unproject_position(c[0]), Vector2.ZERO)
	for i: int in range(1, c.size()):
		rect = rect.expand(cam.unproject_position(c[i]))
	return rect


## A panel's label screen rect from its LOCAL aabb corners
## through its own transform - the tight projected quad.
## (The world AABB of a tilted label is fat in two axes;
## projecting that box again would measure the box, not
## the label - the first grad run's census convicted its
## own ruler that way.)
func _grad_label_screen_rect(i: int, cam: Camera3D) -> Rect2:
	var label: Label3D = _room._panel_labels[i] if i < _room._panel_labels.size() else null
	if label == null:
		return Rect2()
	var la: AABB = label.get_aabb()
	var gt: Transform3D = label.global_transform
	var corners: Array[Vector3] = [
		la.position, la.position + Vector3(la.size.x, 0.0, 0.0),
		la.position + Vector3(0.0, la.size.y, 0.0), la.position + la.size]
	var rect: Rect2 = Rect2(cam.unproject_position(gt * corners[0]), Vector2.ZERO)
	for ci: int in range(1, corners.size()):
		rect = rect.expand(cam.unproject_position(gt * corners[ci]))
	return rect


## A quad's four screen points, corners in order, from its
## transform and half-size.
func _grad_quad_screen_points(gt: Transform3D, half: Vector2, cam: Camera3D) -> Array[Vector2]:
	var pts: Array[Vector2] = []
	for c: Vector2 in [Vector2(-half.x, -half.y), Vector2(half.x, -half.y),
			Vector2(half.x, half.y), Vector2(-half.x, half.y)]:
		pts.append(cam.unproject_position(gt * Vector3(c.x, c.y, 0.0)))
	return pts


## Project a world point from an arbitrary eye position
## through the camera's own orientation and fov (the
## GRADFIX2 companion legs judge occlusion from a ring of
## eye offsets around the seated viewpoint - a player's
## head is never exactly on the drum's axis, and the
## field's eaten board edges lived in that difference).
## Scale-only: consistent across the polys it compares, in
## the same units _grad_quad_screen_points returns at the
## harness's 1280x720.
func _grad_project_from(cam: Camera3D, eye: Vector3, p: Vector3) -> Vector2:
	var rel: Vector3 = p - eye
	var b: Basis = cam.global_transform.basis
	var cx: float = rel.dot(b.x)
	var cy: float = rel.dot(b.y)
	var cz: float = rel.dot(-b.z)
	if cz < 0.05:
		cz = 0.05
	var t: float = tan(deg_to_rad(cam.fov) * 0.5)
	var aspect: float = 1280.0 / 720.0
	return Vector2(cx / (cz * t * aspect), cy / (cz * t)) * 360.0 + Vector2(640.0, 360.0)


func _grad_quad_screen_points_from(cam: Camera3D, eye: Vector3, gt: Transform3D, half: Vector2) -> Array[Vector2]:
	var pts: Array[Vector2] = []
	for c: Vector2 in [Vector2(-half.x, -half.y), Vector2(half.x, -half.y),
			Vector2(half.x, half.y), Vector2(-half.x, half.y)]:
		pts.append(_grad_project_from(cam, eye, gt * Vector3(c.x, c.y, 0.0)))
	return pts


## Convex-polygon overlap by the separating-axis test: the
## census's exact measure (projected AABBs of slanted quads
## intersect in their slack corners where the quads
## themselves never meet - the census convicted its ruler
## twice that way before this).
func _grad_polys_overlap(a: Array[Vector2], b: Array[Vector2]) -> bool:
	for poly: Array in [a, b]:
		for i: int in range(poly.size()):
			var p1: Vector2 = poly[i]
			var p2: Vector2 = poly[(i + 1) % poly.size()]
			var axis: Vector2 = Vector2(-(p2.y - p1.y), p2.x - p1.x).normalized()
			var amin: float = INF
			var amax: float = -INF
			var bmin: float = INF
			var bmax: float = -INF
			for p: Vector2 in a:
				var d: float = p.dot(axis)
				amin = minf(amin, d)
				amax = maxf(amax, d)
			for p: Vector2 in b:
				var d2: float = p.dot(axis)
				bmin = minf(bmin, d2)
				bmax = maxf(bmax, d2)
			if amax < bmin or bmax < amin:
				return false
	return true


## The intersection area of two convex screen polygons
## (Sutherland-Hodgman: clip a against b's edges).
## The closest approach of two screen polygons (px): the
## companion-wholeness legs' margin measure - a companion
## whose text merely GRAZES its card (a pixel or two of
## clearance at the harness's 1280x720) has no clearance
## at all at headset resolution with a moving head, which
## is how the GRAD FIX wing's text read as eaten in the
## field even where the card never quite covered it.
func _grad_poly_min_gap(a: Array[Vector2], b: Array[Vector2]) -> float:
	var best: float = 1.0e9
	for i: int in range(a.size()):
		var a1: Vector2 = a[i]
		var a2: Vector2 = a[(i + 1) % a.size()]
		for j: int in range(b.size()):
			best = minf(best, _grad_seg_seg_dist(a1, a2, b[j], b[(j + 1) % b.size()]))
	return best


func _grad_seg_seg_dist(p1: Vector2, p2: Vector2, p3: Vector2, p4: Vector2) -> float:
	var d1: float = _grad_point_seg_dist(p1, p3, p4)
	var d2: float = _grad_point_seg_dist(p2, p3, p4)
	var d3: float = _grad_point_seg_dist(p3, p1, p2)
	var d4: float = _grad_point_seg_dist(p4, p1, p2)
	return minf(minf(d1, d2), minf(d3, d4))


func _grad_point_seg_dist(p: Vector2, a: Vector2, b: Vector2) -> float:
	var ab: Vector2 = b - a
	var len2: float = ab.length_squared()
	if len2 < 0.000001:
		return p.distance_to(a)
	var t: float = clampf((p - a).dot(ab) / len2, 0.0, 1.0)
	return p.distance_to(a + ab * t)


func _grad_poly_intersect_area(a: Array[Vector2], b: Array[Vector2]) -> float:
	var poly: Array[Vector2] = a.duplicate()
	var bsign: float = 0.0
	for e: int in range(b.size()):
		var bp: Vector2 = b[e]
		var bq: Vector2 = b[(e + 1) % b.size()]
		bsign += bp.x * bq.y - bq.x * bp.y
	var sgn: float = 1.0 if bsign >= 0.0 else -1.0
	for e: int in range(b.size()):
		if poly.is_empty():
			return 0.0
		var p1: Vector2 = b[e]
		var p2: Vector2 = b[(e + 1) % b.size()]
		var edge: Vector2 = p2 - p1
		var out: Array[Vector2] = []
		for i: int in range(poly.size()):
			var cur: Vector2 = poly[i]
			var prev: Vector2 = poly[(i + poly.size() - 1) % poly.size()]
			var cur_in: bool = edge.cross(cur - p1) * sgn >= 0.0
			var prev_in: bool = edge.cross(prev - p1) * sgn >= 0.0
			if cur_in:
				if not prev_in:
					var d: Vector2 = cur - prev
					var denom: float = edge.cross(d)
					if absf(denom) > 0.00001:
						var t: float = edge.cross(p1 - prev) / denom
						out.append(prev + d * t)
				out.append(cur)
			elif prev_in:
				var d: Vector2 = cur - prev
				var denom: float = edge.cross(d)
				if absf(denom) > 0.00001:
					var t: float = edge.cross(p1 - prev) / denom
					out.append(prev + d * t)
		poly = out
	var area: float = 0.0
	for i: int in range(poly.size()):
		var p: Vector2 = poly[i]
		var q: Vector2 = poly[(i + 1) % poly.size()]
		area += p.x * q.y - q.x * p.y
	return absf(area) * 0.5


func _drive_grad_smoke() -> void:
	match _grad_phase:
		0:
			# GRADFIX7 (item 1): the filter press and the
			# manifest load happen on the FIRST tick the room
			# exists - not after the boot view's wall lands -
			# so every later phase (the at-rest legs included)
			# starts from the whole library.
			if not _grad_gf7_boot_pressed and _room != null and not _room._panels.is_empty():
				_grad_gf7_boot_pressed = true
				_room._handle_rail("filter:all")
				var mpath: String = OS.get_environment("PVLDS_GRAD_MANIFEST")
				var f: FileAccess = FileAccess.open(mpath, FileAccess.READ)
				if f != null:
					var parsed: Variant = JSON.parse_string(f.get_as_text())
					if parsed is Dictionary:
						_grad_manifest = parsed
				_grad_expect(not _grad_manifest.is_empty(),
					"fixtures: the graduation manifest loads")
			if _room != null and _room.visible and _room.wall_ready and _grad_gf7_boot_pressed:
				Input.warp_mouse(Vector2(512.0, 764.0)) ## parked: hover would drive the centre (see the nav driver)
				_grad_boot_centre = _room.centre_index() ## the centre the boot's own seating left
				_grad_phase = 1
				_grad_wait = 0
			else:
				_grad_wait += 1
				if _grad_wait > 3600:
					_grad_fail("the room never came up")
					_finish_grad_smoke()
		1:
			# Settled = the fetcher's own queue has walked:
			# it starts before the room adopts (Main's scan
			# landing order), so an idle fetcher after a
			# margin IS the drained state. (An earlier draft
			# polled for every manifest URL to resolve -
			# but a URL the matcher never assigned to a
			# library game is never queued, and the poll
			# outwaited the run: the faces legs below are
			# where unclaimed shots are named, per game.)
			_grad_wait += 1
			var drained: bool = _shot_fetcher != null and not _shot_fetcher.is_fetching()
			if _grad_wait > 3600 and not drained:
				_grad_fail("shots: the fetch queue never drained")
				_grad_leg_library()
				_grad_leg_faces()
				_grad_leg_nameplate_sample()
				_grad_leg_background_static()
				_grad_phase = 8
				_grad_gf7_stage = 0
				_grad_wait = 0
			elif drained and _grad_wait > 240:
				_grad_leg_library()
				_grad_leg_faces()
				_grad_leg_nameplate_sample()
				_grad_audit_labels("drained")
				_grad_leg_background_static()
				_grad_save_grab("grad_boot.png")
				_grad_phase = 8
				_grad_gf7_stage = 0
				_grad_wait = 0
		7:
			_grad_visit_step()
		8:
			_grad_gf7_step()
		14:
			_grad_gf7_heal_step()
		2:
			_grad_sweep_step()
		3:
			_grad_leg_background_lock()
			_grad_phase = 9
			_grad_wait = 0
		9:
			_grad_gf9_step()
		15:
			_grad_gf8_border_step()
		4:
			_grad_tournament_step()
		5:
			_grad_power_step()
		6:
			if not _grad_gf8_done:
				_grad_gf8_done = true
				_grad_gf8_pairing_legs()
			_finish_grad_smoke()
		10:
			_grad_ink_step()
		11:
			_grad_swing_step()
		12:
			_grad_named_step()
		13:
			_grad_sky_step()


func _grad_leg_library() -> void:
	var want: int = _grad_manifest_games().size()
	var games: Array = []
	if _room != null and _room._scanner != null:
		games = _room._scanner.games
	_grad_expect(games.size() == want,
		"library: the whole fixture library lands (%d of %d games)" % [games.size(), want])
	_grad_expect(_room._panels.size() == games.size(),
		"library: one drum panel per game (%d panels)" % _room._panels.size())
	var n: int = games.size()
	_grad_expect(_room.boot_visible_count > 0
		and absi(_room.boot_centre_index - (_room.boot_visible_count - 1) / 2) <= 1,
		"library: the drum boots mid-shelf (centre %d of its %d-game boot view)"
		% [_room.boot_centre_index, _room.boot_visible_count])
	# The shelf's fill order (GRADFIX3 item 5, the user's
	# design call): the shelf fills TOP TO BOTTOM in a
	# column, then steps right - so a title's column is
	# monotonic with its place in the (alphabetical)
	# standing order, and its seat is exactly (index / 3,
	# index % 3), derived here from the mapping's law, not
	# from the room's own function. Under
	# PVLDS_GRID_NC=rowmajor the shipped across-the-band
	# fill returns and this leg fails by name.
	var order_bad: String = ""
	var prev_col: int = -1
	for i: int in range(_room._panels.size()):
		var cc: Vector2i = _room._grid_coord(i)
		if cc.x < prev_col or cc != Vector2i(i / 3, i % 3):
			order_bad = "shelf %d stands at %s" % [i, str(cc)]
			break
		prev_col = cc.x
	_grad_expect(order_bad == "",
		"column order: the shelf fills top-to-bottom in a column, column position monotonic with alphabetical rank%s"
			% ("" if order_bad == "" else " (" + order_bad + ")"))
	# The long title's seat, re-derived under the new
	# mapping: it stood on the bottom band under row-major
	# (shelf 102, row 2); the column-major fill seats it at
	# (34, 0). Its floor clearance is judged by the sweep's
	# own legs at every centre it is visible from, as
	# before - the seat is geography, the clearance is law.
	var long_idx: int = _grad_panel_index(str(_grad_manifest.get("long_id", "")))
	if long_idx >= 0:
		var coord: Vector2i = _room._grid_coord(long_idx)
		_grad_expect(coord == Vector2i(long_idx / 3, long_idx % 3),
			"fixtures: the longest title stands at its column-major seat (shelf %d, column %d, band %d)" % [long_idx, coord.x, coord.y])
	else:
		_grad_fail("fixtures: the longest title is on the shelf")


func _grad_leg_faces() -> void:
	# Every shot game in the cast, not a sample: a fixture
	# file that claimed the wrong build (or none) is named
	# here, counted like the census.
	var shot_total: int = 0
	var shot_ok: int = 0
	var shot_bad: Array[String] = []
	for entry: Variant in _grad_manifest_games():
		if not (entry is Dictionary):
			continue
		var e: Dictionary = entry
		var kind: String = str(e.get("kind", ""))
		var gid: String = str(e.get("id", ""))
		var g: GameEntry = _grad_game(gid) if gid != "" else null
		if g == null and gid == "":
			# Id-less fixtures (the orphan and the GRADFIX7
			# chain cast) resolve by their file stem.
			g = _grad_visit_game(e)
		if g == null:
			_grad_fail("faces: fixture game '%s' is in the library" % str(e.get("name", "?")))
			continue
		match kind:
			"shot", "long":
				shot_total += 1
				if g.has_shot_face() and g.face_path() == ArtProvider.shot_cache_path_for(str(e.get("shot_url", ""))):
					shot_ok += 1
				elif shot_bad.size() < 5:
					shot_bad.append(g.title)
			"pair":
				_grad_expect(g.has_shot_face(),
					"shot ranking: the pair table wears its author shot")
				_grad_expect(g.backglass_face_path() != "",
					"power: the pair table's backglass stands under its shot")
				_grad_expect(g.pair_on_art() != "",
					"power: the pair table still owns its Off/On pair under the shot")
			_:
				pass ## the fallback cast is read on its visits (phase 7)
	if shot_bad.is_empty():
		_grad_expect(true, "shot ranking: every author shot is its game's face (%d games)" % shot_total)
	else:
		_grad_expect(false, "shot ranking: every author shot is its game's face (%d of %d; missing: %s)"
			% [shot_ok, shot_total, ", ".join(shot_bad)])


func _grad_leg_nameplate_sample() -> void:
	# Sampled seated panels: the plate stands under the
	# title and carries it whole (the NC hides the plates).
	var cam: Camera3D = _room._active_camera()
	var checked: int = 0
	for i: int in range(_room._panels.size()):
		if checked >= 8:
			break
		var panel: ClickableQuad = _room._panels[i]
		if panel == null or not panel.visible:
			continue
		var plate: MeshInstance3D = _room._panel_plates[i] if i < _room._panel_plates.size() else null
		var label: Label3D = _room._panel_labels[i] if i < _room._panel_labels.size() else null
		if plate == null or label == null or not label.visible:
			continue
		checked += 1
		_grad_expect(plate.visible,
			"nameplate: panel %d's plate stands under its title" % i)
		if plate.visible and plate.mesh is QuadMesh:
			var qm: QuadMesh = plate.mesh as QuadMesh
			var pr: Rect2 = Rect2(Vector2(plate.position.x, plate.position.y) - qm.size * 0.5, qm.size)
			var la: AABB = label.get_aabb()
			var lr: Rect2 = Rect2(Vector2(label.position.x, label.position.y) + Vector2(la.position.x, la.position.y),
				Vector2(la.size.x, la.size.y))
			_grad_expect(pr.encloses(lr) or pr.intersects(lr),
				"nameplate: panel %d's plate carries its title block" % i)
	_grad_expect(checked >= 4, "nameplate: a sample of plates was readable (%d)" % checked)


## Label-state audit (the GRAD FIX round's diagnostic, kept
## as a standing leg): every filled panel's nameplate state
## must agree with the face its own fill recorded - an art
## face (a non-empty art segment in the face key) stands its
## plate + label up; a generated title card (empty segment)
## keeps both down, because the card carries its own title.
## The graduation census measured only labels that were
## visible; a label wrongly hidden was invisible to it -
## this audit reads the state itself, at several points in
## the run, so a divergence is named with its game and key.
func _grad_audit_labels(tag: String) -> void:
	var checked: int = 0
	for i: int in range(_room._panels.size()):
		if i >= _room._visible_games.size():
			break
		var game: GameEntry = _room._visible_games[i]
		var fkey: String = str(_room._panel_face_key.get(game.game_id, ""))
		if fkey == "":
			continue
		var parts: PackedStringArray = fkey.split("|")
		var art_seg: String = parts[1] if parts.size() > 1 else ""
		var want: bool = art_seg != ""
		var label: Label3D = _room._panel_labels[i] if i < _room._panel_labels.size() else null
		var plate: MeshInstance3D = _room._panel_plates[i] if i < _room._panel_plates.size() else null
		if label == null or plate == null:
			continue
		checked += 1
		if label.visible != want or plate.visible != want:
			_grad_expect(false,
				"label state (%s): panel %d (%s) wears face key '%s' but label=%s plate=%s (want both %s)"
				% [tag, i, game.title, fkey, str(label.visible), str(plate.visible), str(want)])
		if want:
			if label.text != game.title:
				_grad_expect(false,
					"label state (%s): panel %d's label text '%s' != title '%s'"
					% [tag, i, label.text, game.title])
			var aabb: AABB = label.get_aabb()
			if aabb.size.y <= 0.0:
				_grad_expect(false,
					"label state (%s): panel %d's label has no height (%s)"
					% [tag, i, game.title])
	print("GRAD LABEL AUDIT (%s): %d panels checked" % [tag, checked])


func _grad_leg_background_static() -> void:
	var layers: Array = _room.background_layers()
	# Two layers since GRADFIX9 removed the wireframe shell
	# (Chris's order, 2026-10-31 - "drop the wireframe shell
	# entirely, like the ring and the fins"; GRADFIX4 had
	# already removed the orbit ring, item 5e): starfield
	# far, starfield near - nothing else stands.
	_grad_expect(layers.size() == 2,
		"background world-lock: the stack stands (starfield, starfield near - %d layers)" % layers.size())
	_grad_expect(_room.wireframe_shell_count() == 0,
		"wireframe shell: zero wireframe shell nodes stand in the room (library view; got %d - GRADFIX9: the shell is removed entirely, Chris's 2026-10-31 order)" % _room.wireframe_shell_count())
	var drum: Node3D = _room.drum_node()
	_grad_bg_before.clear()
	for layer: Variant in layers:
		var node: Node3D = layer as Node3D
		# Ancestry, not direct parentage (GRADFIX3 fix of a
		# vacuous leg): the layers hang on the stack's root,
		# so a direct-parent check read "not the drum's
		# child" true even under PVLDS_BG_NC=drum, which
		# parents the ROOT to the drum - the control could
		# never fail since graduation. The law is that no
		# layer rides anywhere in the drum's subtree.
		_grad_expect(node != null and drum != null and not drum.is_ancestor_of(node),
			"background world-lock: a layer is not the drum's child")
		if node != null:
			_grad_bg_before.append(node.global_transform)
	# The starfield dial: STARFIELD contract - flat stands
	# the far shell alone, off stands nothing, layered
	# stands the star VOLUME and its backdrop with both
	# shells down (the GRAD FIX round's "layered stands
	# both shells" is retired with the shells' layered
	# seat). The volume and the backdrop are world-locked
	# like every layer: never the drum's children.
	for band_v: Variant in _room.starfield_volume_bands():
		var band_n: Node3D = band_v as Node3D
		_grad_expect(band_n != null and drum != null and not drum.is_ancestor_of(band_n),
			"background world-lock: a volume band is not the drum's child")
	var backdrop_n: Node3D = _room.starfield_backdrop_node()
	_grad_expect(backdrop_n != null and drum != null and not drum.is_ancestor_of(backdrop_n),
		"background world-lock: the backdrop is not the drum's child")
	if layers.size() == 2:
		var far_shell: Node3D = layers[0] as Node3D
		var near_shell: Node3D = layers[1] as Node3D
		_room.set_starfield_mode("flat")
		_grad_expect(far_shell.visible and not near_shell.visible and not _room.starfield_volume_standing(),
			"starfield dial: flat stands the far shell alone")
		_room.set_starfield_mode("off")
		_grad_expect(not far_shell.visible and not near_shell.visible and not _room.starfield_volume_standing(),
			"starfield dial: off stands no stars")
		_room.set_starfield_mode("layered")
		_grad_expect(not far_shell.visible and not near_shell.visible and _room.starfield_volume_standing(),
			"starfield dial: layered stands the star volume, not the shells (STARFIELD)")
		_grad_expect(_room.starfield_mode() == "layered",
			"starfield dial: the room reports the standing mode")


func _grad_leg_background_lock() -> void:
	var layers: Array = _room.background_layers()
	var still: bool = layers.size() == _grad_bg_before.size()
	if still:
		for i: int in range(layers.size()):
			var node: Node3D = layers[i] as Node3D
			var before_t: Transform3D = _grad_bg_before[i]
			if node == null or not node.global_transform.origin.is_equal_approx(before_t.origin):
				still = false
	_grad_expect(still,
		"background world-lock: no layer moved while the drum swept the shelf")


## A sky grab's star blobs over its top band (the wall's
## band of frame, drum hidden): the image is max-pooled 3x3
## (a pinpoint star survives pooling; the pooled grid keeps
## the flood fill cheap), thresholded, and flood-filled
## into blobs - each {x, y (full-res px), size (full-res
## px^2)}. The parallax proofs match blobs between a pair
## of grabs and take the MEDIAN displacement: a sparse
## field's raw centroid is dominated by edge entries and
## exits, but the median matched star moves by the field's
## own translation.
func _grad_sky_blobs(img: Image, band_frac: float = 0.45) -> Array:
	var w: int = img.get_width()
	var h: int = int(float(img.get_height()) * band_frac)
	var pw: int = w / 3
	var ph: int = h / 3
	var grid: Array = []
	grid.resize(pw * ph)
	for py: int in range(ph):
		for px: int in range(pw):
			var best: float = 0.0
			for dy: int in range(3):
				for dx: int in range(3):
					var lum: float = img.get_pixel(px * 3 + dx, py * 3 + dy).get_luminance()
					if lum > best:
						best = lum
			grid[py * pw + px] = 1 if best > 0.30 else 0
	var blobs: Array = []
	var stack: Array[int] = []
	for start: int in range(pw * ph):
		if int(grid[start]) != 1:
			continue
		grid[start] = 2
		stack.clear()
		stack.append(start)
		var cnt: int = 0
		var sx: float = 0.0
		var sy: float = 0.0
		while not stack.is_empty():
			var cur: int = stack.pop_back()
			var cx: int = cur % pw
			var cy: int = cur / pw
			cnt += 1
			sx += float(cx)
			sy += float(cy)
			var nbs: Array[int] = []
			if cx > 0:
				nbs.append(cur - 1)
			if cx < pw - 1:
				nbs.append(cur + 1)
			if cy > 0:
				nbs.append(cur - pw)
			if cy < ph - 1:
				nbs.append(cur + pw)
			for nb: int in nbs:
				if int(grid[nb]) != 1:
					continue
				grid[nb] = 2
				stack.append(nb)
		blobs.append({
			"x": (sx / float(cnt)) * 3.0 + 1.0,
			"y": (sy / float(cnt)) * 3.0 + 1.0,
			"size": float(cnt) * 9.0,
		})
	return blobs


## Warp-match two grabs' blob fields under a KNOWN
## world-space Y-rotation of theta degrees: each blob of
## `a` is carried to where a rotation of the field by
## theta puts it on screen (the perspective warp - a
## Y-rotation's screen displacement grows toward the
## frame's edges, so no single translation can register
## the pair), then matched to the nearest blob of `b`
## within 40 px. Returns (median x-residual, match
## fraction, TIGHT fraction - matches whose residuals are
## under 6 px on BOTH axes; an x-only tight at this star
## density lets a wrong warp land ~28% by nearest-neighbour
## luck alone, while a 2D tight is the honest test of "the
## warp predicts where the star went"). A correct warp in
## the correct direction
## lands the whole constellation on itself (residual ~0,
## most blobs matched, most matches tight); the opposite
## direction - the control - still finds stray blobs
## within 40 px at this star density, but lands them
## scattered, never tight. This is the direction proof in
## its sharpest form: not "the field moved left", but
## "the field moved by exactly this rotation, this way".
func _grad_sky_warp_match(a: Array, b: Array, theta_deg: float, img_w: float, img_h: float, fov_deg: float) -> Vector3:
	var aspect: float = img_w / img_h
	var hfov: float = 2.0 * atan(tan(deg_to_rad(fov_deg * 0.5)) * aspect)
	var f: float = (img_w * 0.5) / tan(hfov * 0.5)
	var cx: float = img_w * 0.5
	var cy: float = img_h * 0.5
	var th: float = deg_to_rad(theta_deg)
	var residuals: Array[float] = []
	var matched: int = 0
	var tight: int = 0
	for av: Variant in a:
		var ad: Dictionary = av
		var ax: float = float(ad["x"])
		var ay: float = float(ad["y"])
		# The full direction warp: the blob's look direction,
		# rotated about the view's Y axis by +theta and
		# reprojected. (Under R_y(+theta) a direction's
		# screen azimuth falls by theta - the pattern sweeps
		# left - which is the motion both the shell drift
		# and a right head turn produce; the x-only form of
		# this warp already landed at 0.1 px residuals.)
		# A Y-rotation sags y toward the frame's corners as
		# well as sweeping x - an x-only warp mis-picks
		# neighbours there and spreads its own residuals.
		var d: Vector3 = Vector3((ax - cx) / f, (cy - ay) / f, -1.0).normalized()
		var cs: float = cos(th)
		var sn: float = sin(th)
		var rx: float = d.x * cs + d.z * sn
		var rz: float = -d.x * sn + d.z * cs
		var wx: float = cx + f * rx / (-rz)
		var wy: float = cy - f * d.y / (-rz)
		var best_d: float = 1600.0
		var best_dx: float = 0.0
		var best_dy: float = 0.0
		for bv: Variant in b:
			var bd: Dictionary = bv
			var dx: float = float(bd["x"]) - wx
			var dy: float = float(bd["y"]) - wy
			var d2: float = dx * dx + dy * dy
			if d2 < best_d:
				best_d = d2
				best_dx = dx
				best_dy = dy
		if best_d < 1600.0:
			matched += 1
			residuals.append(best_dx)
			if absf(best_dx) <= 6.0 and absf(best_dy) <= 6.0:
				tight += 1
	var frac: float = float(matched) / float(maxi(a.size(), 1))
	var tfrac: float = float(tight) / float(maxi(a.size(), 1))
	if a.is_empty() or matched < a.size() / 4:
		return Vector3(-9999.0, frac, tfrac)
	residuals.sort()
	return Vector3(residuals[residuals.size() / 2], frac, tfrac)


## One sky grab's density truth, in the zenith leg's own
## measures: [bright-coverage centre/ring ratio, star-count
## density centre/ring ratio], sampled on the zenith leg's
## rings (centre disc r < 0.25, ring 0.55 < r < 0.75 of the
## half-frame, ink = luminance > 0.30). The zenith leg
## (GRADFIX4) keeps its inline original; this twin serves
## the nadir legs (GRADFIX5) so both poles - and the
## Tournament Room's down view - answer the same questions
## with the same arithmetic.
func _grad_sky_density(img: Image) -> Vector2:
	var uw: int = img.get_width()
	var uh: int = img.get_height()
	var cx: float = float(uw) * 0.5
	var cy: float = float(uh) * 0.5
	var rmax: float = float(mini(uw, uh))
	var c_in: int = 0
	var c_tot: int = 0
	var r_in: int = 0
	var r_tot: int = 0
	for yy: int in range(0, uh, 3):
		for xx: int in range(0, uw, 3):
			var rr: float = Vector2(float(xx) - cx, float(yy) - cy).length() / rmax
			var ink: bool = img.get_pixel(xx, yy).get_luminance() > 0.30
			if rr < 0.25:
				c_tot += 1
				if ink:
					c_in += 1
			elif rr > 0.55 and rr < 0.75:
				r_tot += 1
				if ink:
					r_in += 1
	var cov: float = (float(c_in) / float(maxi(c_tot, 1))) / maxf(float(r_in) / float(maxi(r_tot, 1)), 0.0001)
	var blobs: Array = _grad_sky_blobs(img, 1.0)
	var zc: int = 0
	var zr: int = 0
	for zb: Variant in blobs:
		var zd: Dictionary = zb
		var zrr: float = Vector2(float(zd["x"]) - cx, float(zd["y"]) - cy).length() / rmax
		if zrr < 0.25:
			zc += 1
		elif zrr > 0.55 and zrr < 0.75:
			zr += 1
	var cnt: float = (float(zc) / 0.0625) / maxf(float(zr) / 0.26, 0.001)
	return Vector2(cov, cnt)


## One sky grab's DIM-LINE density truth (GRADFIX9): the
## wireframe shell's lines were faint - alpha 0.13 of a
## mid-blue, far under the bright-star threshold the
## density legs read - so its signature lives in the dim
## band (luminance 0.04..0.25, stars and sky glow excluded
## as far as the band allows). Where the shell stood, its
## meridians CONVERGED on the pole at the frame's centre:
## the centre disc's dim-line density stood well clear of
## the ring's. With the shell removed (Chris's order,
## 2026-10-31) the two densities sit even - stars only.
## Returns the centre/ring dim-line density ratio on the
## density legs' own rings.
func _grad_sky_line_ratio(img: Image) -> float:
	var uw: int = img.get_width()
	var uh: int = img.get_height()
	var cx: float = float(uw) * 0.5
	var cy: float = float(uh) * 0.5
	var rmax: float = float(mini(uw, uh))
	var c_in: int = 0
	var c_tot: int = 0
	var r_in: int = 0
	var r_tot: int = 0
	for yy: int in range(0, uh, 3):
		for xx: int in range(0, uw, 3):
			var rr: float = Vector2(float(xx) - cx, float(yy) - cy).length() / rmax
			var lum: float = img.get_pixel(xx, yy).get_luminance()
			var ink: bool = lum > 0.04 and lum < 0.25
			if rr < 0.25:
				c_tot += 1
				if ink:
					c_in += 1
			elif rr > 0.55 and rr < 0.75:
				r_tot += 1
				if ink:
					r_in += 1
	return (float(c_in) / float(maxi(c_tot, 1))) / maxf(float(r_in) / float(maxi(r_tot, 1)), 0.0001)


## The sky pass proofs (GRADFIX4 item 5, phase 13): the
## drift's world-space truth read off the room's own state,
## the parallax read off RENDERED pairs (each layer isolated,
## displaced opposite the motion, near more than far), the
## head-yaw direction proof (a static layer sweeps opposite
## a right turn by the turned amount), the zenith's even
## density (no pole pinch), and the pinpoint profile. Grabs:
## gradfix4_sky_up.png (straight up), gradfix4_sky_level.png
## and gradfix4_sky_below.png (the sky itself from level and
## from below - the item 5e ring judgement stood on these
## two grabs, and the ring was removed on their evidence).
## Under PVLDS_BG_NC=uv the pre-fix UV field stands
## and the zenith + pinpoint legs fail by name.
## STARFIELD: stand ONE sky node and hide every other sky
## surface (both shells, the backdrop, every volume band) -
## the sky pass's per-layer isolation, whichever sky stands.
func _grad_sky_isolate(only: Node3D) -> void:
	for layer_v: Variant in _room.background_layers():
		var layer_n: Node3D = layer_v as Node3D
		if layer_n != null:
			layer_n.visible = layer_n == only
	var backdrop_n: Node3D = _room.starfield_backdrop_node()
	if backdrop_n != null:
		backdrop_n.visible = backdrop_n == only
	for band_v: Variant in _room.starfield_volume_bands():
		var band_n: Node3D = band_v as Node3D
		if band_n != null:
			band_n.visible = band_n == only


func _grad_sky_step() -> void:
	# STARFIELD: the measurable pair is the room's standing
	# pair - the volume's outermost and innermost bands in
	# the shipped sky, the two shells under a legacy seam.
	var layers: Array = _room.starfield_sky_pair()
	if layers.size() != 2 or layers[0] == null or layers[1] == null:
		_grad_fail("sky: the background stack is missing")
		_grad_phase = 3
		_grad_wait = 0
		return
	var far_shell: Node3D = layers[0] as Node3D
	var near_shell: Node3D = layers[1] as Node3D
	var cam: Camera3D = _room._active_camera()
	_grad_wait += 1
	match _grad_sky_stage:
		0:
			_room.drum_node().visible = false
			_room.set_starfield_mode("layered")
			_grad_sky_isolate(near_shell)
			_grad_sky_stage = 1
			_grad_wait = 0
		1:
			if _grad_wait > 6:
				_grad_sky_img["near0"] = get_viewport().get_texture().get_image()
				_grad_sky_near_yaw0 = float(_room.starfield_drift_state().get("near_yaw_deg", 0.0))
				_grad_sky_isolate(far_shell)
				_grad_sky_stage = 2
				_grad_wait = 0
		2:
			if _grad_wait > 6:
				_grad_sky_img["far0"] = get_viewport().get_texture().get_image()
				_grad_sky_far_yaw0 = float(_room.starfield_drift_state().get("far_yaw_deg", 0.0))
				_grad_sky_since = Time.get_ticks_msec()
				_grad_sky_stage = 3
				_grad_wait = 0
		3:
			if Time.get_ticks_msec() - _grad_sky_since > 9000:
				_grad_sky_img["far1"] = get_viewport().get_texture().get_image()
				_grad_sky_img["far_yaw1"] = float(_room.starfield_drift_state().get("far_yaw_deg", 0.0))
				_grad_sky_isolate(near_shell)
				_grad_sky_stage = 4
				_grad_wait = 0
		4:
			if _grad_wait > 6:
				_grad_sky_img["near1"] = get_viewport().get_texture().get_image()
				var near_yaw1: float = float(_room.starfield_drift_state().get("near_yaw_deg", 0.0))
				var far_yaw1: float = float(_grad_sky_img.get("far_yaw1", 0.0))
				var far_adv: float = fposmod(far_yaw1 - _grad_sky_far_yaw0, 360.0)
				var near_adv: float = fposmod(near_yaw1 - _grad_sky_near_yaw0, 360.0)
				print("GRAD SKY: drift over the window - far advanced %.2f deg, near %.2f deg (speeds %.2f / %.2f deg/s)"
					% [far_adv, near_adv, RoomView.BG_DRIFT_FAR_DEG, RoomView.BG_DRIFT_NEAR_DEG])
				_grad_expect(far_adv > 0.5 and near_adv > far_adv * 1.5,
					"sky drift: both layers drift in world space, the near layer faster (far %.2f deg, near %.2f deg over the window)" % [far_adv, near_adv])
				var nblobs0: Array = _grad_sky_blobs(_grad_sky_img["near0"])
				var nblobs1: Array = _grad_sky_blobs(_grad_sky_img["near1"])
				var fblobs0: Array = _grad_sky_blobs(_grad_sky_img["far0"])
				var fblobs1: Array = _grad_sky_blobs(_grad_sky_img["far1"])
				var iw: float = float((_grad_sky_img["near0"] as Image).get_width())
				var ih: float = float((_grad_sky_img["near0"] as Image).get_height())
				var nwarp: Vector3 = _grad_sky_warp_match(nblobs0, nblobs1, near_adv, iw, ih, cam.fov)
				var fwarp: Vector3 = _grad_sky_warp_match(fblobs0, fblobs1, far_adv, iw, ih, cam.fov)
				var nctrl: Vector3 = _grad_sky_warp_match(nblobs0, nblobs1, -near_adv, iw, ih, cam.fov)
				print("GRAD SKY: rendered drift - near warp by +%.2f deg: %.0f%% matched (%.0f%% tight), residual %.1f px; far warp by +%.2f deg: %.0f%% (%.0f%% tight), %.1f px; near opposite-warp control: %.0f%% tight"
					% [near_adv, nwarp.y * 100.0, nwarp.z * 100.0, nwarp.x, far_adv, fwarp.y * 100.0, fwarp.z * 100.0, fwarp.x, nctrl.z * 100.0])
				_grad_expect(nblobs0.size() > 30 and fblobs0.size() > 30,
					"sky parallax: both layers carry measurable stars (near %d blobs, far %d blobs)" % [nblobs0.size(), fblobs0.size()])
				_grad_expect(nwarp.y > 0.5 and absf(nwarp.x) <= 5.0 and fwarp.y > 0.5 and absf(fwarp.x) <= 5.0,
					"sky parallax: each rendered layer moved by exactly its own world rotation, near faster than far (near +%.2f deg: %.0f%% matched, residual %.1f px; far +%.2f deg: %.0f%%, %.1f px)"
						% [near_adv, nwarp.y * 100.0, nwarp.x, far_adv, fwarp.y * 100.0, fwarp.x])
				_grad_expect(nctrl.z < nwarp.z * 0.5,
					"sky parallax: the opposite warp lands nowhere tight - the drift's direction is the world's, not the view's (control %.0f%% tight against %.0f%%)" % [nctrl.z * 100.0, nwarp.z * 100.0])
				_grad_sky_img["near_blobs"] = nblobs0
				_room.set_starfield_mode("flat")
				_grad_sky_stage = 5
				_grad_wait = 0
		5:
			if _grad_wait > 6:
				_grad_sky_img["yaw0"] = get_viewport().get_texture().get_image()
				_room._desk_rig.rotation.y = deg_to_rad(-14.0) ## the head turns RIGHT
				_grad_sky_stage = 6
				_grad_wait = 0
		6:
			if _grad_wait > 6:
				_grad_sky_img["yaw1"] = get_viewport().get_texture().get_image()
				var yblobs0: Array = _grad_sky_blobs(_grad_sky_img["yaw0"])
				var yblobs1: Array = _grad_sky_blobs(_grad_sky_img["yaw1"])
				var yw: float = float((_grad_sky_img["yaw0"] as Image).get_width())
				var yh: float = float((_grad_sky_img["yaw0"] as Image).get_height())
				var ywarp: Vector3 = _grad_sky_warp_match(yblobs0, yblobs1, 14.0, yw, yh, cam.fov)
				var yctrl: Vector3 = _grad_sky_warp_match(yblobs0, yblobs1, -14.0, yw, yh, cam.fov)
				print("GRAD SKY: yaw pair - warp by the turn (+14 deg): %.0f%% matched (%.0f%% tight), residual %.1f px; opposite warp: %.0f%% tight"
					% [ywarp.y * 100.0, ywarp.z * 100.0, ywarp.x, yctrl.z * 100.0])
				_grad_expect(ywarp.y > 0.5 and absf(ywarp.x) <= 5.0,
					"sky yaw: a right head turn sweeps the static field opposite the turn by exactly the turned amount (%.0f%% matched under the turn's own warp, residual %.1f px)" % [ywarp.y * 100.0, ywarp.x])
				_grad_expect(yctrl.z < ywarp.z * 0.5,
					"sky yaw: the opposite warp lands nowhere tight - the field is world-fixed, not view-fixed (control %.0f%% tight against %.0f%%)" % [yctrl.z * 100.0, ywarp.z * 100.0])
				_room._desk_rig.rotation.y = 0.0
				_room.set_starfield_mode("layered") ## the mode's own apply stands the full sky again
				_grad_sky_stage = 7
				_grad_wait = 0
		7:
			if _grad_wait > 6:
				cam.rotation_degrees = Vector3(90.0, 0.0, 0.0) ## straight up
				_grad_sky_stage = 8
				_grad_wait = 0
		8:
			if _grad_wait > 6:
				_grad_save_grab("gradfix4_sky_up.png")
				var up: Image = get_viewport().get_texture().get_image()
				var uw: int = up.get_width()
				var uh: int = up.get_height()
				var cx: float = float(uw) * 0.5
				var cy: float = float(uh) * 0.5
				var rmax: float = float(mini(uw, uh))
				var c_in: int = 0
				var c_tot: int = 0
				var r_in: int = 0
				var r_tot: int = 0
				for yy: int in range(0, uh, 3):
					for xx: int in range(0, uw, 3):
						var rr: float = Vector2(float(xx) - cx, float(yy) - cy).length() / rmax
						var ink: bool = up.get_pixel(xx, yy).get_luminance() > 0.30
						if rr < 0.25:
							c_tot += 1
							if ink:
								c_in += 1
						elif rr > 0.55 and rr < 0.75:
							r_tot += 1
							if ink:
								r_in += 1
				var cdens: float = float(c_in) / float(maxi(c_tot, 1))
				var rdens: float = float(r_in) / float(maxi(r_tot, 1))
				var ratio: float = cdens / maxf(rdens, 0.0001)
				print("GRAD SKY: zenith densities - centre %.4f, ring %.4f, ratio %.2f" % [cdens, rdens, ratio])
				_grad_expect(ratio > 0.45 and ratio < 2.2,
					"sky zenith: looking straight up, the star density stays even - no pole pinch (centre/ring %.2f)" % ratio)
				# The pinch's sharper signature is in the COUNT,
				# not the coverage: where a UV field's cells
				# converge on the pole, vastly more cells (hence
				# star discs) crowd into each unit of sky, so the
				# centre's countable blobs per unit area EXPLODE
				# (measured 7.71x under the UV NC) while the
				# bright-pixel coverage barely moves (0.90-1.09 -
				# the crowded discs are squashed as fast as they
				# multiply, so coverage alone cannot convict it).
				# The direction field itself reads ~2.1x on this
				# measure - an artefact of the measurement chain
				# (perspective plus the 3D lattice's slice
				# statistics at two off-axis regimes), NOT a
				# visible pinch: its zenith grab reads even to
				# the eye and its coverage ratio sits at 0.82-
				# 0.93. The bound is set from the measured gap:
				# ~2.1 real against 7.71 pinched, trip at 4.0.
				var zblobs: Array = _grad_sky_blobs(up, 1.0)
				var zc: int = 0
				var zr: int = 0
				for zb: Variant in zblobs:
					var zd: Dictionary = zb
					var zrr: float = Vector2(float(zd["x"]) - cx, float(zd["y"]) - cy).length() / rmax
					if zrr < 0.25:
						zc += 1
					elif zrr > 0.55 and zrr < 0.75:
						zr += 1
				var zratio: float = (float(zc) / 0.0625) / maxf(float(zr) / 0.26, 0.001)
				print("GRAD SKY: zenith star counts - centre %d blobs, ring %d blobs, count-density ratio %.2f" % [zc, zr, zratio])
				_grad_expect(zratio > 0.35 and zratio < 5.0,
					"sky zenith: the star count does not explode at the pole the way a converging UV grid's does (count-density centre/ring %.2f; the UV field reads 7.71; STARFIELD calibration: the direction-space shells read 2.24-2.52 on this measure, a true 3D-uniform geometric field reads higher by projection law alone - 3.45 here - so the bound sits at 5.0, clear of both honest fields and well under the pinch fault)" % zratio)
				# GRADFIX9: the wireframe shell is GONE - the
				# zenith grab must show stars only, no radial
				# line convergence at the pole (Chris's
				# 2026-10-31 order: drop the shell entirely).
				var zline: float = _grad_sky_line_ratio(up)
				print("GRAD SKY: zenith dim-line densities - centre/ring ratio %.2f" % zline)
				_grad_expect(zline > 0.40 and zline < 2.50,
					"sky zenith: no wireframe lines converge at the pole - stars only (dim-line centre/ring %.2f; GRADFIX9: shell removed, Chris's 2026-10-31 order)" % zline)
				# Pinpoint: the NEAR layer's median blob size.
				# A pinpoint star is a couple of pixels across
				# even pooled; the old UV field's soft discs
				# (radius 0.26 of a much larger cell) pool into
				# blobs several times that area.
				var nblobs: Array = _grad_sky_img.get("near_blobs", [])
				var sizes: Array[float] = []
				for nb: Variant in nblobs:
					sizes.append(float((nb as Dictionary).get("size", 0.0)))
				sizes.sort()
				var med_size: float = sizes[sizes.size() / 2] if not sizes.is_empty() else -1.0
				print("GRAD SKY: pinpoint median near-star blob %.1f px^2 over %d blobs" % [med_size, sizes.size()])
				_grad_expect(med_size > 0.0 and med_size < 27.0,
					"sky pinpoint: the stars are hard points, not soft blobs (median blob %.1f px^2)" % med_size)
				cam.rotation_degrees = Vector3(-90.0, 0.0, 0.0) ## straight down - the GRADFIX5 nadir leg
				_grad_sky_stage = 12
				_grad_wait = 0
		12:
			if _grad_wait > 6:
				# GRADFIX5 (item 2): the nadir - the field
				# fault's home ground. Pre-fix, the room's
				# opaque floor slab filled this frame entire
				# (coverage ~0); the retired slab stands
				# behind PVLDS_GRADFIX5_NC=floor so this leg
				# fails against it by name.
				_grad_save_grab("gradfix5_sky_nadir.png")
				var down: Image = get_viewport().get_texture().get_image()
				var dd: Vector2 = _grad_sky_density(down)
				print("GRAD SKY: nadir densities - coverage ratio %.2f, count-density ratio %.2f" % [dd.x, dd.y])
				_grad_expect(dd.x > 0.45 and dd.x < 2.2,
					"sky nadir: looking straight down, the stars are still there - density even, no bare lower half (coverage centre/ring %.2f)" % dd.x)
				_grad_expect(dd.y > 0.35 and dd.y < 5.0,
					"sky nadir: the star count stays even at the nadir (count-density centre/ring %.2f; STARFIELD calibration as at the zenith leg - shells 2.52, geometric volume 4.10, the UV pinch fault 7.71, bound 5.0)" % dd.y)
				# GRADFIX9: the nadir is where Chris SAW the
				# shell - "very feint lines that converge at a
				# central point... radiate outward and cover
				# the entire globe." The grab must now show
				# stars only: no dim-line convergence at the
				# centre (his 2026-10-31 order: drop the
				# wireframe shell entirely).
				var dline: float = _grad_sky_line_ratio(down)
				print("GRAD SKY: nadir dim-line densities - centre/ring ratio %.2f" % dline)
				_grad_expect(dline > 0.25 and dline < 2.50,
					"sky nadir: no wireframe lines converge at the centre point - stars only (dim-line centre/ring %.2f; GRADFIX9: shell removed, Chris's 2026-10-31 order; STARFIELD: the fault signature is centre-HIGH against the 2.50 top - the floor is a sanity bound only, re-based at 0.25 because the geometric field's dim band legitimately holds dim far stars and the backdrop's band glow, whose centre/ring split reads 0.32-1.41 across boots)" % dline)
				cam.rotation_degrees = Vector3(-35.0, 0.0, 0.0) ## down-forward: the desk view's sky
				_grad_sky_stage = 13
				_grad_wait = 0
		13:
			if _grad_wait > 6:
				_grad_save_grab("gradfix5_sky_down.png")
				cam.rotation_degrees = Vector3.ZERO
				_grad_sky_stage = 9
				_grad_wait = 0
		9:
			if _grad_wait > 4:
				_grad_sky_stage = 10
				_grad_wait = 0
		10:
			if _grad_wait > 6:
				_grad_save_grab("gradfix4_sky_level.png")
				cam.rotation_degrees = Vector3(24.0, 0.0, 0.0)
				_grad_sky_stage = 11
				_grad_wait = 0
		11:
			if _grad_wait > 6:
				_grad_save_grab("gradfix4_sky_below.png")
				cam.rotation_degrees = Vector3.ZERO
				_room.drum_node().visible = true
				_room.set_starfield_mode("layered")
				_grad_phase = 3
				_grad_wait = 0
				_grad_power_stage = 0


## The sweep: centre every shelf index in turn; at each
## settled centre, measure the visible labels.
func _grad_sweep_step() -> void:
	var n: int = _room._panels.size()
	if _grad_sweep_i < 0:
		_grad_sweep_i = 0
		_room._set_focused(_room._panels[0])
		_grad_sweep_settle = 0
		return
	if _room.page_slide_active():
		_grad_sweep_settle = 0
		# A mid-swing grab on a long early swing.
		if not _grad_swing_grabbed and _grad_sweep_i > 2 and absf(_room.page_slide_yaw_deg()) > 2.0:
			_grad_save_grab("grad_swing.png")
			_grad_swing_grabbed = true
		return
	_grad_sweep_settle += 1
	if _grad_sweep_settle < 3:
		return
	if _room.centre_index() == _grad_sweep_i:
		_grad_measure_centre(_grad_sweep_i)
	_grad_sweep_i += 1
	_grad_sweep_settle = 0
	if _grad_sweep_i >= n:
		print("GRAD CENSUS: %d centres, %d labels measured, long-title label bottom %.4f m, rail intrusion max %.1f px (%s), fringe rail intrusions beyond the browsing zone %d, pop fringe worst %.1f px, flipsweep added-coverage worst %.1f px over %d centres"
			% [n, _grad_labels_measured, _grad_long_min_bottom, _grad_rail_max_depth, _grad_rail_worst, _grad_fringe_rail, _grad_pop_worst, _grad_flipsweep_worst, _grad_flipsweep_samples])
		_grad_expect(_grad_labels_measured > n,
			"census: labels were measured across the sweep (%d)" % _grad_labels_measured)
		_grad_audit_labels("post-sweep")
		_grad_census_verdicts()
		_grad_phase = 10
		_grad_ink_stage = 0
		_grad_wait = 0
	else:
		_room._set_focused(_room._panels[_grad_sweep_i])


## The ink legs (the GRAD FIX round, kept standing): the
## graduation census measured label GEOMETRY, and the field
## fault - names that come and go - lived entirely in the
## ink: the card's own transparent face could sort after its
## nameplate plate and label in the transparent pass and
## paint over both, leaving state, alpha and geometry all
## correct and the name simply not drawn. For a spread of
## art-faced panels across the shelf: centre the panel, let
## the room go quiet, take the frame; hide the label, take
## it again (the label's ink is the diff); hide the plate
## too, take a third (the plate's presence is the mean
## darkening it lends the label's rect). Both must register,
## per panel, or the leg fails by name.
func _grad_ink_step() -> void:
	_grad_wait += 1
	match _grad_ink_stage:
		0:
			_grad_ink_targets.clear()
			var n: int = _room._panels.size()
			for k: int in range(8):
				var i: int = int(round(float(k) * float(maxi(n - 1, 0)) / 7.0))
				if i < _room._visible_games.size():
					var g: GameEntry = _room._visible_games[i]
					var fk: String = str(_room._panel_face_key.get(g.game_id, ""))
					if fk.split("|").size() > 1 and fk.split("|")[1] != "":
						_grad_ink_targets.append(i)
			_grad_expect(not _grad_ink_targets.is_empty(),
				"label ink: art-faced panels exist to probe")
			_grad_ink_stage = 1
			_grad_wait = 0
		1:
			if _grad_ink_targets.is_empty():
				_grad_expect(_grad_ink_plate_checked >= 5,
					"plate ink: at least five panels stood plate-checked (%d did)" % _grad_ink_plate_checked)
				_grad_phase = 11
				_grad_swing_stage = 0
				_grad_wait = 0
				return
			var i: int = int(_grad_ink_targets[0])
			_room._set_focused(_room._panels[i])
			_grad_ink_tries = 0
			_grad_ink_stage = 2
			_grad_wait = 0
		2:
			# Stability is judged directly, not by proxy: two
			# frames a few ticks apart must agree inside the
			# label's rect before any diff is trusted (a power
			# performance settling, a wing texture landing -
			# whatever moves, the rect says so).
			if not _room.page_slide_active() and _grad_wait > 10:
				var i: int = int(_grad_ink_targets[0])
				_grad_ink_label = _room._panel_labels[i]
				_grad_ink_plate = _room._panel_plates[i]
				_grad_ink_img_a = get_viewport().get_texture().get_image()
				_grad_ink_stage = 25
				_grad_wait = 0
			elif _grad_wait > 3600:
				_grad_fail("label ink: the room never went quiet")
				_grad_phase = 3
		25:
			if _grad_wait > 4:
				_grad_ink_tries += 1
				if _grad_ink_tries > 900:
					_grad_fail("label ink: the frame never settled")
					_grad_ink_label.visible = true
					_grad_ink_plate.visible = true
					_grad_phase = 3
					return
				var img_a2: Image = get_viewport().get_texture().get_image()
				var i: int = int(_grad_ink_targets[0])
				var cam: Camera3D = _room._active_camera()
				var rect: Rect2 = _grad_label_screen_rect(i, cam).intersection(
					Rect2(Vector2.ZERO, Vector2(img_a2.get_size())))
				var changed: int = 0
				for y: int in range(int(rect.position.y), int(rect.position.y + rect.size.y)):
					for x: int in range(int(rect.position.x), int(rect.position.x + rect.size.x)):
						var pa: Color = _grad_ink_img_a.get_pixel(x, y)
						var pb: Color = img_a2.get_pixel(x, y)
						if absf(pa.r - pb.r) + absf(pa.g - pb.g) + absf(pa.b - pb.b) > 0.24:
							changed += 1
				_grad_ink_img_a = img_a2
				if changed <= 5:
					_grad_ink_label.visible = false
					_grad_ink_stage = 3
				_grad_wait = 0
		3:
			if _grad_wait > 3:
				_grad_ink_img_b = get_viewport().get_texture().get_image()
				_grad_ink_plate.visible = false
				_grad_ink_stage = 4
				_grad_wait = 0
		4:
			if _grad_wait > 3:
				var img_c: Image = get_viewport().get_texture().get_image()
				var i: int = int(_grad_ink_targets[0])
				var cam: Camera3D = _room._active_camera()
				var rect: Rect2 = _grad_label_screen_rect(i, cam).intersection(
					Rect2(Vector2.ZERO, Vector2(img_c.get_size())))
				var label_px: int = 0
				var sum_b: float = 0.0
				var sum_c: float = 0.0
				var npix: int = 0
				var x0: int = int(rect.position.x)
				var y0: int = int(rect.position.y)
				var x1: int = int(rect.position.x + rect.size.x)
				var y1: int = int(rect.position.y + rect.size.y)
				for y: int in range(y0, y1):
					for x: int in range(x0, x1):
						var pa: Color = _grad_ink_img_a.get_pixel(x, y)
						var pb: Color = _grad_ink_img_b.get_pixel(x, y)
						var pc: Color = img_c.get_pixel(x, y)
						if absf(pa.r - pb.r) + absf(pa.g - pb.g) + absf(pa.b - pb.b) > 0.24:
							label_px += 1
						sum_b += (pb.r + pb.g + pb.b) / 3.0
						sum_c += (pc.r + pc.g + pc.b) / 3.0
						npix += 1
				var plate_lift: float = (sum_c - sum_b) / float(maxi(npix, 1))
				var g: GameEntry = _room._visible_games[i]
				printerr("GRAD INK: panel %d (%s) label px %d plate lift %.4f over %d px"
					% [i, g.title, label_px, plate_lift, npix])
				_grad_expect(label_px > 30,
					"label ink: panel %d (%s) renders its title (%d px of label ink)" % [i, g.title, label_px])
				# A panel mid-performance is exempt from the
				# plate leg: the settled power overlay owns the
				# face (a pair's On image stands in for it whole),
				# plate included, by design - the label above it
				# is still judged. The coverage leg in stage 1
				# keeps the exemption from swallowing the census.
				if _room.power_panel() == _room._panels[i]:
					printerr("GRAD INK: panel %d (%s) is performing - plate leg exempt" % [i, g.title])
				else:
					_grad_ink_plate_checked += 1
					_grad_expect(plate_lift > 0.01,
						"plate ink: panel %d (%s) stands on its nameplate (lift %.4f when the plate hides)" % [i, g.title, plate_lift])
				_grad_ink_label.visible = true
				_grad_ink_plate.visible = true
				_grad_ink_img_a = null
				_grad_ink_img_b = null
				_grad_ink_targets.pop_front()
				_grad_ink_stage = 1
				_grad_wait = 0


## The swing-glide legs (the GRAD FIX round): the drum's
## angle, sampled densely across two representative journeys -
## a held-scroll staircase (one column per 240 ms, the room's
## own hold cadence) and one long single swing (15 columns).
## The old per-step cubic ease-out settled between held steps
## and lunged at every restart: the ratchet. The legs judge
## the replacement spring on the sampled path itself, at the
## harness's own sampling rate: within every leg the approach
## is monotone (the deviation from the standing target never
## grows); mid-journey the deviation never reads zero (the
## old curve sat dead between held steps - its signature at
## any sampling rate); and arrivals land inside the old
## duration law's envelope, exactly on target.
## The journey's stations are COLUMNS (GRADFIX3 re-derivation:
## under the row-major fill, consecutive indices were
## consecutive columns; under the column-major fill a column
## is three consecutive indices, so the stations are named in
## columns and seated on the middle band - the journey's shape
## - one column per step, then a 15-column swing - is the one
## the GRAD FIX legs were written against).
func _grad_swing_step() -> void:
	match _grad_swing_stage:
		0:
			_room._set_focused(_room._panels[7]) ## column 2, middle band
			_grad_swing_stage = 1
			_grad_wait = 0
		1:
			_grad_wait += 1
			if not _room.page_slide_active() and _grad_wait > 20:
				_grad_swing_samples.clear()
				_grad_swing_cmds.clear()
				_grad_swing_cmd_i = 0
				_grad_swing_last_cmd = -240
				_grad_swing_t0 = Time.get_ticks_msec()
				_grad_swing_stage = 2
			elif _grad_wait > 3600:
				_grad_fail("swing glide: the drum never rested before the journey")
				_grad_phase = 3
		2:
			var now: int = Time.get_ticks_msec() - _grad_swing_t0
			_grad_swing_samples.append([now, _room.page_slide_yaw_deg(), rad_to_deg(_room._drum_yaw)])
			if _grad_swing_cmd_i < 6 and now - _grad_swing_last_cmd >= 240:
				_room._set_focused(_room._panels[(3 + _grad_swing_cmd_i) * 3 + 1]) ## columns 3..8, middle band: one column per step
				_grad_swing_cmds.append(now)
				_grad_swing_last_cmd = now
				_grad_swing_cmd_i += 1
			if _grad_swing_cmd_i >= 6 and not _room.page_slide_active():
				_grad_swing_eval_journey()
				_grad_swing_samples.clear()
				_grad_swing_cmds.clear()
				_grad_swing_t0 = Time.get_ticks_msec()
				_room._set_focused(_room._panels[23 * 3 + 1]) ## column 23: the 15-column swing
				_grad_swing_cmds.append(0)
				_grad_swing_stage = 3
			elif now > 8000:
				_grad_fail("swing glide: the held-scroll journey never settled")
				_grad_phase = 3
		3:
			var now2: int = Time.get_ticks_msec() - _grad_swing_t0
			_grad_swing_samples.append([now2, _room.page_slide_yaw_deg(), rad_to_deg(_room._drum_yaw)])
			if not _room.page_slide_active() and now2 > 100:
				_grad_swing_eval_long()
				_grad_phase = 12
				_grad_named_stage = 0
				_grad_named_i = 0
				_grad_named_wait = 0
			elif now2 > 5000:
				_grad_fail("swing glide: the long swing never settled")
				_grad_phase = 3


## Within-leg analysis: a leg runs from the first sample at
## or after its command through the sample taken at the next
## command's tick (that sample was recorded before the
## retarget was issued, so it still measures the old target).
func _grad_swing_legs_of(samples: Array, cmds: Array) -> Array:
	var legs: Array = []
	var start: int = -1
	for si: int in range(samples.size()):
		if int(samples[si][0]) >= int(cmds[0]):
			start = si
			break
	if start < 0:
		return legs
	for ci: int in range(cmds.size()):
		var end: int = samples.size() - 1
		if ci + 1 < cmds.size():
			end = samples.size() - 1
			for si: int in range(start, samples.size()):
				if int(samples[si][0]) >= int(cmds[ci + 1]):
					end = si
					break
		legs.append(samples.slice(start, end + 1))
		start = end + 1
		if start >= samples.size():
			break
	return legs


func _grad_swing_eval_journey() -> void:
	var samples: Array = _grad_swing_samples
	# The harness box samples this phase at ~10-17 ticks a
	# second (the room is heavy under llvmpipe) - the legs are
	# written to convict at that rate, and the sampling itself
	# is reported, per the brief.
	var span_ms: int = int(samples[samples.size() - 1][0]) if samples.size() > 1 else 0
	printerr("GRAD SWING: held-scroll journey - %d samples over %d ms (%.0f ms median pitch)"
		% [samples.size(), span_ms,
			float(span_ms) / float(maxi(1, samples.size() - 1))])
	_grad_expect(samples.size() >= 12,
		"swing glide: the held-scroll journey is densely sampled (%d samples)" % samples.size())
	# The drum's yaw itself never reverses mid-journey. (Its
	# deviation from the standing target may dip and rise as
	# it flows THROUGH an intermediate step point - that is
	# the glide working, not a reversal.)
	var worst_reverse: float = 0.0
	for k: int in range(1, samples.size()):
		worst_reverse = maxf(worst_reverse, float(samples[k - 1][2]) - float(samples[k][2]))
	_grad_expect(worst_reverse <= 0.05,
		"swing glide: the drum's travel never reverses mid-journey (worst %.3f deg)" % worst_reverse)
	# The ratchet's signature, read at the command instants:
	# each step's sample was recorded on the tick that issued
	# the NEXT command, before the retarget - it measures the
	# drum against the target it had chased for a full cadence
	# interval. The old curve read exactly zero there from the
	# second step on (settled dead at 195 ms of every 240 ms
	# leg). The spring always carries a residual - it is
	# still travelling when the next step lands.
	var residuals: Array = []
	for ci: int in range(1, _grad_swing_cmds.size()):
		for s: Variant in samples:
			if int((s as Array)[0]) == int(_grad_swing_cmds[ci]):
				residuals.append(float((s as Array)[1]))
				break
	var min_residual: float = INF
	for rv: Variant in residuals:
		min_residual = minf(min_residual, float(rv))
	printerr("GRAD SWING: command-instant residuals %s deg" % str(residuals))
	_grad_expect(residuals.size() >= 5 and min_residual > 0.05,
		"swing glide: the drum is still travelling at every step (smallest command-instant residual %.3f deg)" % min_residual)
	var total_ms: int = int(samples[samples.size() - 1][0]) if not samples.is_empty() else 0
	_grad_expect(total_ms <= 6 * 240 + 800,
		"swing glide: the held-scroll journey lands inside its envelope (%d ms)" % total_ms)


func _grad_swing_eval_long() -> void:
	var samples: Array = _grad_swing_samples
	if samples.size() < 5:
		_grad_fail("swing glide: the long swing is too thinly sampled (%d)" % samples.size())
		return
	var d0: float = float(samples[0][1])
	var worst_back: float = 0.0
	var t_arrive: int = -1
	var t_settle: int = int(samples[samples.size() - 1][0])
	for k: int in range(1, samples.size()):
		worst_back = maxf(worst_back, float(samples[k][1]) - float(samples[k - 1][1]))
		if t_arrive < 0 and float(samples[k][1]) <= 0.10 * d0:
			t_arrive = int(samples[k][0])
	printerr("GRAD SWING: long swing from %.1f deg, within a tenth at %d ms, settled by %d ms, worst backward %.3f, %d samples"
		% [d0, t_arrive, t_settle, worst_back, samples.size()])
	_grad_expect(worst_back <= 0.05,
		"swing glide: the long swing never steps backward (worst %.3f deg)" % worst_back)
	_grad_expect(t_arrive > 0 and t_arrive <= 353,
		"swing glide: the long swing is visibly arrived inside the old law's duration (within a tenth at %d ms of 353)" % t_arrive)
	_grad_expect(float(samples[samples.size() - 1][1]) == 0.0,
		"swing glide: the long swing lands exactly on target")
	_grad_expect(t_settle <= 560,
		"swing glide: the long swing settles inside its envelope (%d ms, tick-quantised)" % t_settle)


func _grad_measure_centre(c: int) -> void:
	var cam: Camera3D = _room._active_camera()
	if cam == null:
		return
	var rail_polys: Array = []
	for k: Variant in _room._rail_quads.keys():
		var rq: ClickableQuad = _room._rail_quads[k] as ClickableQuad
		if rq != null:
			rail_polys.append(_grad_quad_screen_points(rq.global_transform, rq.quad_size() * 0.5, cam))
	var status_poly: Array[Vector2] = []
	if _room._status_plate != null and _room._status_plate.mesh is QuadMesh:
		var sp: MeshInstance3D = _room._status_plate
		var sqm: QuadMesh = sp.mesh as QuadMesh
		status_poly = _grad_quad_screen_points(sp.global_transform, sqm.size * 0.5, cam)
	var centre_label_poly: Array[Vector2] = []
	# GRADFIX5 (item 4): the wall measure, once, at the
	# mid-library centre: how many drawn columns stand FULLY
	# inside the frame (2 px of grace - the top band's top
	# edge rides within a pixel of the frame's top at either
	# radius), and the centre card's angular width with the
	# pop scale divided out (the at-rest width the player
	# reads).
	if c == _room._panels.size() / 2 and _grad_wall_full_cols < 0:
		var vp: Vector2 = get_viewport().get_visible_rect().size
		var col_full: Dictionary = {}
		var col_seen: Dictionary = {}
		var col_out: Dictionary = {}
		for i2: int in range(_room._panels.size()):
			var p2: ClickableQuad = _room._panels[i2]
			if p2 == null or not p2.visible:
				continue
			if not _nav_on_screen(p2.global_position, cam):
				continue
			var col2: int = _room._grid_coord(i2).x
			col_seen[col2] = true
			var poly2: Array[Vector2] = _grad_quad_screen_points(p2.global_transform, p2.quad_size() * 0.5, cam)
			var inside: bool = poly2.size() == 4
			var worst_out: float = -1.0e9
			for pt: Vector2 in poly2:
				var ov: float = maxf(maxf(-pt.x, -pt.y), maxf(pt.x - vp.x, pt.y - vp.y))
				worst_out = maxf(worst_out, ov)
				if ov > 2.0:
					inside = false
			col_out[col2] = maxf(float(col_out.get(col2, -1.0e9)), worst_out)
			if not inside:
				col_full[col2] = false
			elif not col_full.has(col2):
				col_full[col2] = true
		var out_line: String = ""
		var sorted_cols: Array = col_out.keys()
		sorted_cols.sort()
		for k4: Variant in sorted_cols:
			out_line += " col %d: %+.0f px" % [int(k4), float(col_out[k4])]
		print("GRAD WALL columns (worst corner overflow, px; negative is inside margin):%s" % out_line)
		var full_n: int = 0
		for k3: Variant in col_full.keys():
			if bool(col_full[k3]):
				full_n += 1
		_grad_wall_full_cols = full_n
		var near_n: int = 0
		for k5: Variant in col_out.keys():
			if float(col_out[k5]) <= 24.0:
				near_n += 1
		_grad_wall_near_cols = near_n
		_grad_wall_drawn_cols = col_seen.size()
		var cp2: ClickableQuad = _room._panels[c]
		if cp2 != null:
			var gt2: Transform3D = cp2.global_transform
			var hs2: Vector2 = cp2.quad_size() * 0.5
			var d1: Vector3 = ((gt2 * Vector3(-hs2.x, hs2.y, 0.0)) - cam.global_position).normalized()
			var d2v: Vector3 = ((gt2 * Vector3(hs2.x, hs2.y, 0.0)) - cam.global_position).normalized()
			var amt2: float = _room._panel_pop[c] if c < _room._panel_pop.size() else 1.0
			var sc2: float = lerpf(1.0, RoomView.POP_OUT_SCALE, clampf(amt2, 0.0, 1.0))
			_grad_wall_card_deg = rad_to_deg(d1.angle_to(d2v)) / sc2
		print("GRAD WALL: radius %.2f m - %d of %d drawn columns fully in frame at the mid centre, %d within 24 px of full; centre card %.2f deg across at rest"
			% [RoomView.WALL_RADIUS, _grad_wall_full_cols, _grad_wall_drawn_cols, _grad_wall_near_cols, _grad_wall_card_deg])
	var long_id: String = str(_grad_manifest.get("long_id", ""))
	for i: int in range(_room._panels.size()):
		var panel: ClickableQuad = _room._panels[i]
		if panel == null or not panel.visible:
			continue
		var label: Label3D = _room._panel_labels[i] if i < _room._panel_labels.size() else null
		if label == null or not label.visible:
			continue
		if not _nav_on_screen(panel.global_position, cam):
			continue
		_grad_labels_measured += 1
		var aabb: AABB = _room.panel_label_world_aabb(i)
		if aabb.position.y < -0.0215:
			_grad_count("floor", "centre %d: panel %d's label bottom %.4f" % [c, i, aabb.position.y])
		var plate: MeshInstance3D = _room._panel_plates[i] if i < _room._panel_plates.size() else null
		if plate != null and plate.visible:
			var pa: AABB = plate.global_transform * plate.get_aabb()
			# The plate's floor line sits one plate-padding
			# BELOW the label's -0.0215 calibration: a grown
			# plate (GRADFIX2 item 1) backs its block with
			# 17 mm of plate beneath the ink by design, so a
			# plate at ink-floor minus its padding is the
			# plate standing exactly where its ink stands.
			# The label leg above keeps the -0.0215 line for
			# the ink itself; a plate past -0.042 is grown
			# or dropped BEYOND its padding (a five-line
			# bottom-band name would land near -0.088) and
			# still convicts here.
			if pa.position.y < -0.042:
				_grad_count("plate_floor", "centre %d: panel %d's nameplate bottom %.4f" % [c, i, pa.position.y])
		# The GRADFIX2 legs (items 1+5), in panel-local space
		# (centre-invariant: the same geometry at every
		# centre): the name BLOCK (the label's shaped AABB,
		# offset by the label's seat in the panel) must stand
		# wholly on its plate, clear of the Launch plinth's
		# rectangle wherever the plinth seats, and inside its
		# own card's silhouette. The shipped fault lived here:
		# the plate stayed one line tall and the plinth sat on
		# the block's last line - invisible to every leg that
		# judged the plate's presence or the label's world
		# position instead of the three rectangles' relation.
		# GRADFIX13 (item 2): the plinth is stripped - the
		# plinth-clearance count below stands vacuous in the
		# shipped build (no quad exists to run under), and
		# the platecover / cardbounds counts are the name
		# law now: a long multi-line block must stand whole
		# on its grown plate, inside its card, with nothing
		# left for it to collide with. The staleplate NC
		# (seat-time-only derivation) still fails them, and
		# the plinth NC re-arms the clearance count.
		var la2: AABB = label.get_aabb()
		if la2.size.y > 0.0:
			var block: Rect2 = Rect2(
				Vector2(la2.position.x + label.position.x, la2.position.y + label.position.y), Vector2(la2.size.x, la2.size.y))
			if plate != null and plate.mesh is QuadMesh:
				var pqm: QuadMesh = plate.mesh as QuadMesh
				var plate_rect: Rect2 = Rect2(
					Vector2(plate.position.x - pqm.size.x * 0.5, plate.position.y - pqm.size.y * 0.5), pqm.size)
				if plate_rect.position.y > block.position.y + 0.003 or plate_rect.end.y < block.end.y - 0.003:
					_grad_count("platecover", "centre %d: panel %d's name block (%.3f..%.3f) stands off its plate (%.3f..%.3f)"
						% [c, i, block.position.y, block.end.y, plate_rect.position.y, plate_rect.end.y])
			var lq3: ClickableQuad = _room._panel_launches[i] if i < _room._panel_launches.size() else null
			if lq3 != null:
				var lsz: Vector2 = lq3.quad_size()
				var launch_rect: Rect2 = Rect2(
					Vector2(lq3.position.x - lsz.x * 0.5, lq3.position.y - lsz.y * 0.5), lsz)
				if block.grow(-0.002).intersects(launch_rect):
					_grad_count("plinth", "centre %d: panel %d's name block (%.3f..%.3f) runs under its Launch plinth (%.3f..%.3f)"
						% [c, i, block.position.y, block.end.y, launch_rect.position.y, launch_rect.end.y])
			var card_half: float = panel.quad_size().x * 0.5
			if block.position.x < -card_half + 0.006 or block.end.x > card_half - 0.006:
				_grad_count("cardbounds", "centre %d: panel %d's name block (%.3f..%.3f) hugs its card's edge (half %.3f)"
					% [c, i, block.position.x, block.end.x, card_half])
		if panel.payload == long_id and aabb.position.y < _grad_long_min_bottom:
			_grad_long_min_bottom = aabb.position.y
		var lpoly: Array[Vector2] = _grad_label_poly(i, cam)
		for rp: Variant in rail_polys:
			if _grad_polys_overlap(lpoly, rp):
				# THE BROWSING ZONE: the drum's read model
				# is swing-to-centre; the furniture may
				# only be convicted inside +/-2 columns of
				# the centre - the cards a user reads
				# without turning. Beyond that the desk
				# camera's 70-degree frustum keystones
				# fringe labels across the rail's end
				# stops; the prototype's census acquitted
				# the same class by span (labels outside
				# its panel's azimuth span). Fringe
				# intrusions are still counted and printed
				# in the census line - surfaced, not hidden.
				var dcol: int = absi(_room._grid_coord(i).x - _room._grid_coord(c).x)
				if dcol > 2:
					_grad_fringe_rail += 1
					break
				_grad_count("rail", "centre %d: panel %d's label touches the rail" % [c, i])
				# Intrusion depth: how far the label's
				# bottom edge dips below the rail's top
				# edge, at the label corners inside the
				# rail's x-span.
				var rpoly: Array = rp
				var top0: Vector2 = rpoly[3]
				var top1: Vector2 = rpoly[2]
				for lp: Vector2 in [lpoly[0], lpoly[1]]:
					if lp.x >= minf(top0.x, top1.x) and lp.x <= maxf(top0.x, top1.x):
						var f: float = 0.0 if absf(top1.x - top0.x) < 0.01 else (lp.x - top0.x) / (top1.x - top0.x)
						var edge_y: float = lerpf(top0.y, top1.y, clampf(f, 0.0, 1.0))
						var depth: float = lp.y - edge_y
						if depth > _grad_rail_max_depth:
							_grad_rail_max_depth = depth
							_grad_rail_worst = "centre %d panel %d depth %.1fpx" % [c, i, depth]
							print("GRAD DEBUG worst: centre %d panel %d label %s rail %s panelpos %s labelaabb %s"
								% [c, i, str(lpoly), str(rpoly), str(panel.global_position), str(_room.panel_label_world_aabb(i))])
				break
		if not status_poly.is_empty() and _grad_polys_overlap(lpoly, status_poly):
			_grad_count("status", "centre %d: panel %d's label touches the status plate" % [c, i])
		if i == c:
			centre_label_poly = lpoly
	# The card flip's swept volume (GRADFIX6 item 1): the
	# turning card against every drawn neighbour, charged
	# ANALYTICALLY at every centre - the pivot's half-turn
	# sampled every 10 degrees, each sample's screen polygon
	# (the card's full frame size: the dressing sweeps too)
	# charged against every other visible panel's polygon,
	# depth-aware on the house rule (a nearer card covers;
	# it is not covered). The charge is the ADDED coverage
	# over the standing card's own resting footprint: a card
	# turning inside its own slot - edge-on at mid-flip -
	# adds nothing, and the honest expectation is zero
	# everywhere; the 8 px threshold absorbs projection
	# slivers between co-spherical surfaces (measured worst
	# across the census: 4.9 px; a genuine slot invasion -
	# the card's face crossing a neighbour's - would add
	# hundreds to thousands). The rendered turn itself is
	# proven separately, densely sampled, at the tournament
	# table (see _grad_tournament_step); this leg proves the
	# GEOMETRY at every centre the player can stand on. (It
	# replaces the wing/book coverage legs wholesale: there
	# is no companion left to cover anything - the only
	# moving surface is the card itself.)
	if c < _room._panels.size():
		var fc: ClickableQuad = _room._panels[c]
		if fc != null and fc.visible:
			_grad_flipsweep_samples += 1
			var fgt: Transform3D = fc.global_transform
			var fhalf: Vector2 = (fc.quad_size() + Vector2(0.035, 0.035)) * 0.5 ## the frame's excess over the face sweeps too (CARD_FRAME_SIZE - CARD_SIZE)
			var fdist: float = fgt.origin.distance_to(cam.global_position)
			var base_area: Dictionary = {}
			for step_i: int in range(0, 19):
				var ang: float = deg_to_rad(float(step_i) * 10.0)
				var ft: Transform3D = Transform3D(fgt.basis * Basis(Vector3.UP, ang), fgt.origin)
				var fpoly: Array[Vector2] = _grad_quad_screen_points(ft, fhalf, cam)
				if fpoly.is_empty():
					continue
				for j: int in range(_room._panels.size()):
					if j == c:
						continue
					var other: ClickableQuad = _room._panels[j]
					if other == null or not other.visible:
						continue
					if not _nav_on_screen(other.global_position, cam):
						continue
					if other.global_transform.origin.distance_to(cam.global_position) < fdist - 0.01:
						continue # the neighbour stands in front - it covers the turning card, it is not covered by it
					var cpoly: Array[Vector2] = _grad_quad_screen_points(other.global_transform, other.quad_size() * 0.5, cam)
					var area: float = 0.0
					if _grad_polys_overlap(fpoly, cpoly):
						area = _grad_poly_intersect_area(fpoly, cpoly)
					if step_i == 0:
						base_area[j] = area
						continue
					var excess: float = area - float(base_area.get(j, 0.0))
					_grad_flipsweep_worst = maxf(_grad_flipsweep_worst, excess)
					if excess > 8.0:
						_grad_count("flipsweep", "centre %d: the turning card sweeps panel %d's face (%.0f px added at %d deg)" % [c, j, excess, step_i * 10])
	# The popped centre's label against every neighbour's art.
	# Charged past the fringe bound (GRADFIX3): a popped
	# foreground card's nameplate grazing the art below it
	# by a few px is foreground occlusion, the same class
	# the room has always lived with between co-spherical
	# cards; a DRAPE - a plate genuinely hung over the
	# next card - is the fault. The fixture's worst case
	# (its 51-character title, seated by the column-major
	# fill over a card where row-major seated it over the
	# floor) measures 287 px; the bound stands at 512 and
	# the worst value prints with the census.
	if not centre_label_poly.is_empty():
		for j: int in range(_room._panels.size()):
			if j == c:
				continue
			var other: ClickableQuad = _room._panels[j]
			if other == null or not other.visible:
				continue
			if not _nav_on_screen(other.global_position, cam):
				continue
			var apoly: Array[Vector2] = _grad_quad_screen_points(other.global_transform, other.quad_size() * 0.5, cam)
			if _grad_polys_overlap(centre_label_poly, apoly):
				var parea: float = _grad_poly_intersect_area(centre_label_poly, apoly)
				_grad_pop_worst = maxf(_grad_pop_worst, parea)
				if parea > 512.0:
					_grad_count("pop", "centre %d: the popped label drapes panel %d's art (%.0f px)" % [c, j, parea])


## One label's screen polygon from its LOCAL aabb corners
## (the quad's own four corners, in order).
func _grad_label_poly(i: int, cam: Camera3D) -> Array[Vector2]:
	var label: Label3D = _room._panel_labels[i] if i < _room._panel_labels.size() else null
	if label == null:
		return []
	var la: AABB = label.get_aabb()
	var gt: Transform3D = label.global_transform
	var pts: Array[Vector2] = []
	for c: Vector3 in [la.position, la.position + Vector3(la.size.x, 0.0, 0.0),
			la.position + Vector3(la.size.x, la.size.y, 0.0), la.position + Vector3(0.0, la.size.y, 0.0)]:
		pts.append(cam.unproject_position(gt * c))
	return pts


## The census verdicts, one per surface, first example named.
func _grad_census_verdicts() -> void:
	var kinds: Array = [
		["floor", "census: no label under the floor at any centre"],
		["plate_floor", "census: no nameplate under the floor at any centre"],
		["rail", "census: no label touches the rail at any centre"],
		["status", "census: no label touches the status plate at any centre"],
		["pop", "census: the popped centre's label never drapes a neighbour's art (fringe bound 512 px)"],
		["flipsweep", "card flip: the turning card's swept volume adds no coverage over any neighbour at any centre"],
		["plinth", "plinth: no name block under its Launch plinth at any centre (GRADFIX13: the plinth is stripped - the count stands vacuous unless an NC restores the button)"],
		["platecover", "nameplate cover: every name block stands wholly on its plate at any centre"],
		["cardbounds", "nameplate bounds: every name block stands inside its own card at any centre"],
	]
	for pair: Variant in kinds:
		var kind: String = str((pair as Array)[0])
		var label_text: String = str((pair as Array)[1])
		var count: int = int(_grad_viol.get(kind, 0))
		if count == 0:
			_grad_expect(true, label_text)
		else:
			_grad_expect(false, "%s (%d violations; first: %s)"
				% [label_text, count, str(_grad_viol_first.get(kind, ""))])
	# GRADFIX6 (item 1): the flip's swept-volume margin, on
	# the record beside the count verdict above - the
	# turning card may add no coverage past its own
	# standing footprint (8 px of projection sliver between
	# co-spherical surfaces is the measured noise class;
	# the census's measured worst is printed in its line).
	_grad_expect(_grad_flipsweep_samples >= 20 and _grad_flipsweep_worst <= 8.0,
		"card flip: the swept turn stays in the card's own slot at every centre (worst added coverage %.1f px over %d centres; bound 8)"
			% [_grad_flipsweep_worst, _grad_flipsweep_samples])
	# GRADFIX5 (item 3) + GRADFIX6 (item 4, Console pass
	# 2): the Console verdicts - the bar's span, read off
	# the laid-out quads, against the pre-Console 4.225 m
	# and pass 1's 2.964 m; nothing dropped. Pass 2's span
	# is 2.687 m (79.3 degrees total at the rail's z -1.62);
	# the bound 2.75 sits between it and pass 1's number,
	# so pass-1 geometry fails here too. Under
	# PVLDS_GRADFIX5_NC=widebar these fail by name.
	var bar: Dictionary = _room.bar_state()
	var rail_span: float = float(bar.get("rail_span", 0.0))
	var strip_span: float = float(bar.get("strip_span", 0.0))
	var status_sz: Vector2 = bar.get("status_size", Vector2.ZERO)
	print("GRAD CONSOLE: rail span %.3f m (pre-Console 4.225, pass 1 2.964), strip span %.3f m, %d rail stops, %d strip slots, status plate %s, tile height %.3f m, rail/strip gap %.3f m"
		% [rail_span, strip_span, int(bar.get("rail_stops", 0)), int(bar.get("strip_slots", 0)), str(status_sz), float(bar.get("rail_tile_h", 0.0)), float(bar.get("rail_strip_gap", 0.0))])
	_grad_expect(rail_span > 0.0 and rail_span <= 2.75 and int(bar.get("rail_stops", 0)) == 11 and status_sz.x <= 2.0,
		"console bar: the rail is tightened to the pass-2 Console span and carries 11 stops (span %.3f m of the pre-Console 4.225 - %.0f%% - %d stops, status plate %.2f m wide; GRADFIX8 item 6: the count drops 12 -> 10 on Chris's order - the < > pager stops are removed, the page readout is not a stop and stays; GRADFIX11: the count rises 10 -> 11 on Chris's order - the NEW filter tile joins the rail)"
			% [rail_span, rail_span / 4.225 * 100.0, int(bar.get("rail_stops", 0)), status_sz.x])
	_grad_expect(strip_span > 0.0 and strip_span <= rail_span and int(bar.get("strip_slots", 0)) >= 27,
		"console bar: the strip condenses inside the bar's span and keeps every slot (strip %.3f m within rail %.3f m, %d slots)"
			% [strip_span, rail_span, int(bar.get("strip_slots", 0))])
	_grad_expect(float(bar.get("rail_strip_gap", 0.0)) >= 0.050 and float(bar.get("rail_tile_h", 0.0)) > 0.0 and float(bar.get("rail_tile_h", 0.0)) <= 0.120,
		"console bar: pass 2 gives the rows their air and slims the tiles (rail/strip gap %.3f m against pass 1's 0.025 - at least doubled - tile height %.3f m against pass 1's 0.135)"
			% [float(bar.get("rail_strip_gap", 0.0)), float(bar.get("rail_tile_h", 0.0))])
	# GRADFIX14 (item 1): the machined strip's verdicts - the
	# rail is ONE continuous graphite bar (a backing bar
	# stands, and no gap opens between neighbouring
	# sections), carrying the shipped sections in the
	# shipped order at the shipped proportions. Under
	# PVLDS_GF14_NC=tileboxes (per-tile boxes, 0.018 m gaps,
	# no bar) the one-piece leg fails by name.
	var want_keys: Array[String] = ["filter:all", "filter:vr", "filter:favorites", "filter:recents", "filter:new", "sort", "tournament", "page_label", "wovp_refresh", "desk", "exit"]
	var got_keys: Array = bar.get("rail_keys", []) as Array
	var keys_ok: bool = got_keys.size() == want_keys.size()
	if keys_ok:
		for ki: int in range(want_keys.size()):
			if str(got_keys[ki]) != want_keys[ki]:
				keys_ok = false
	var want_w: Array[float] = [0.194, 0.156, 0.285, 0.259, 0.156, 0.298, 0.285, 0.182, 0.207, 0.207, 0.182]
	var got_w: Array = bar.get("rail_widths", []) as Array
	var wsum: float = 0.0
	for wv: Variant in got_w:
		wsum += float(wv)
	var widths_ok: bool = got_w.size() == want_w.size() and wsum > 0.0
	if widths_ok:
		for wi: int in range(want_w.size()):
			if absf(float(got_w[wi]) / wsum - want_w[wi] / 2.411) > 0.01:
				widths_ok = false
	print("GRAD STRIP: bar pieces %d, widest section gap %.4f m, sections %s, lift target '%s', lifted %d"
		% [int(bar.get("rail_bar_count", 0)), float(bar.get("rail_gap_max", 0.0)), str(got_keys), str(bar.get("rail_lift_target", "")), int(bar.get("rail_lifted", 0))])
	_grad_expect(int(bar.get("rail_bar_count", 0)) == 1 and float(bar.get("rail_gap_max", 0.0)) <= 0.002,
		"machined strip: the rail is one continuous graphite bar - one backing bar, no gaps between sections (bar pieces %d, widest gap %.4f m against the shipped tiles' 0.018 m)"
			% [int(bar.get("rail_bar_count", 0)), float(bar.get("rail_gap_max", 0.0))])
	_grad_expect(keys_ok,
		"machined strip: the bar carries the shipped sections in the shipped order (%s)" % str(got_keys))
	_grad_expect(widths_ok,
		"machined strip: the sections keep the shipped proportions (widths %s)" % str(got_w))
	# GRADFIX5 (item 4): the wall verdict - the pushed-back
	# wall keeps its columns and the centre card reads
	# smaller. On the old 3.05 radius the card measure reads
	# 11.6 degrees and this leg fails on the number.
	_grad_expect(_grad_wall_full_cols >= 1 and _grad_wall_near_cols >= 3 and _grad_wall_card_deg > 9.5 and _grad_wall_card_deg < 11.0,
		"wall reach: the pushed-back wall (r %.2f) stands %d columns fully in frame and %d within 24 px of full, and the centre card reads %.2f deg across (the same measure on the 3.05 wall: card 11.98 deg, the centre column's worst corner +1 px past the frame's top against -2 px inside here, every drawn column's overflow larger)"
			% [RoomView.WALL_RADIUS, _grad_wall_full_cols, _grad_wall_near_cols, _grad_wall_card_deg])


## One panel's name verdicts in panel-local space (the
## census's plinth / plate-cover / card-bounds math,
## returned as words): empty when the name stands whole.
func _grad_panel_name_verdicts(i: int) -> Array:
	var out: Array = []
	if i < 0 or i >= _room._panels.size():
		return ["not on the shelf"]
	var label: Label3D = _room._panel_labels[i] if i < _room._panel_labels.size() else null
	var plate: MeshInstance3D = _room._panel_plates[i] if i < _room._panel_plates.size() else null
	if label == null:
		return ["no label"]
	var la: AABB = label.get_aabb()
	if la.size.y <= 0.0:
		return ["label unshaped"]
	var block: Rect2 = Rect2(Vector2(la.position.x + label.position.x, la.position.y + label.position.y), Vector2(la.size.x, la.size.y))
	if plate != null and plate.mesh is QuadMesh:
		var pqm: QuadMesh = plate.mesh as QuadMesh
		var plate_rect: Rect2 = Rect2(Vector2(plate.position.x - pqm.size.x * 0.5, plate.position.y - pqm.size.y * 0.5), pqm.size)
		if plate_rect.position.y > block.position.y + 0.003 or plate_rect.end.y < block.end.y - 0.003:
			out.append("block %.3f..%.3f off its plate %.3f..%.3f" % [block.position.y, block.end.y, plate_rect.position.y, plate_rect.end.y])
	var lq: ClickableQuad = _room._panel_launches[i] if i < _room._panel_launches.size() else null
	if lq != null:
		var lsz: Vector2 = lq.quad_size()
		var launch_rect: Rect2 = Rect2(Vector2(lq.position.x - lsz.x * 0.5, lq.position.y - lsz.y * 0.5), lsz)
		if block.grow(-0.002).intersects(launch_rect):
			out.append("block under its plinth %.3f..%.3f" % [launch_rect.position.y, launch_rect.end.y])
	var panel: ClickableQuad = _room._panels[i]
	var card_half: float = panel.quad_size().x * 0.5
	if block.position.x < -card_half + 0.006 or block.end.x > card_half - 0.006:
		out.append("block hugs its card's edge")
	return out


## The named cases (GRADFIX2, phase 12): the field
## session's own defect titles, centred one by one and
## judged BY NAME - the census proves the rule over the
## whole shelf; these prove the user's actual cards. A
## viewport grab of each stands beside the log.
func _grad_named_step() -> void:
	var named: Dictionary = _grad_manifest.get("named_ids", {}) as Dictionary
	var titles: Array = named.keys()
	if _grad_named_i >= titles.size():
		_grad_phase = 13
		_grad_sky_stage = 0
		_grad_wait = 0
		return
	var title: String = str(titles[_grad_named_i])
	var idx: int = _grad_panel_index(str(named[title]))
	match _grad_named_stage:
		0:
			_grad_expect(idx >= 0, "named case: '%s' is on the shelf" % title)
			if idx < 0:
				_grad_named_i += 1
				return
			_room._set_focused(_room._panels[idx])
			_grad_named_wait = 0
			_grad_named_stage = 1
		1:
			_grad_named_wait += 1
			if not _room.page_slide_active() and _grad_named_wait >= 14:
				var verdicts: Array = _grad_panel_name_verdicts(idx)
				_grad_expect(verdicts.is_empty(),
					"named case: '%s' stands whole on its plate, clear of its plinth, inside its card%s"
						% [title, "" if verdicts.is_empty() else " - " + str(verdicts)])
				var slug: String = title.to_lower().replace("'", "").replace("-", " ").replace(".", "")
				slug = "_".join(slug.split(" ", false)).substr(0, 24)
				_grad_save_grab("gradfix_" + slug + ".png")
				_grad_named_i += 1
				_grad_named_stage = 0
			elif _grad_named_wait > 1800:
				_grad_fail("named case: the drum never settled at '%s'" % title)
				_grad_named_i += 1
				_grad_named_stage = 0


## GRADFIX8 (item 4): the tournie border census. The
## expected set is re-derived HERE from the standing WoVP
## data (the harness fixture cache's challenges, matched
## to the library by VPS game id, soonest-closing per
## game, colour from RoomSpecs.challenge_type_color) -
## never read out of the room's own border bookkeeping -
## and the actual set is what the standing wall's cards
## were APPLIED with (RoomView.tourney_border_state).
## The leg is non-vacuous by construction: it first
## requires the manifest's tournament game to be in the
## expected set. Under PVLDS_GRADFIX8_NC=noborder no
## border is ever applied, the actual set is empty, and
## these legs fail by name ("tourney border:").
func _grad_leg_tourney_border() -> void:
	var expected: Dictionary = {}
	if _room != null and _room._scanner != null:
		for cv: Variant in _room._wovp_challenges:
			var ch: WovpChallenge = cv as WovpChallenge
			if ch == null or ch.table_external_id == "":
				continue
			var g: GameEntry = _room._scanner.game_by_id(ch.table_external_id)
			if g == null:
				continue
			var end_key: int = ch.end_unix if ch.end_unix > 0 else 2000000000
			var cur: Dictionary = expected.get(g.game_id, {}) as Dictionary
			var take: bool = cur.is_empty() or end_key < int(cur.get("end_key", 0)) \
				or (end_key == int(cur.get("end_key", 0)) and ch.challenge_id < str(cur.get("challenge_id", "")))
			if take:
				expected[g.game_id] = {
					"type_code": ch.type_code,
					"color": RoomSpecs.challenge_type_color(ch.type_code),
					"challenge_id": ch.challenge_id,
					"end_key": end_key,
				}
	var tid: String = str(_grad_manifest.get("tournament_id", ""))
	_grad_expect(expected.has(tid),
		"tourney border: the fixture challenge set stands live (the tournament game is among %d expected bordered games)" % expected.size())
	var actual: Dictionary = {}
	if _room != null:
		for i: int in range(_room._panels.size()):
			var gid: String = _room._panels[i].payload
			var st: Dictionary = _room.tourney_border_state(gid)
			if bool(st.get("on", false)):
				actual[gid] = st
	var exp_keys: Array = expected.keys()
	exp_keys.sort()
	var act_keys: Array = actual.keys()
	act_keys.sort()
	_grad_expect(exp_keys == act_keys,
		"tourney border: the bordered set equals the live challenge game set (expected %s, applied %s)" % [str(exp_keys), str(act_keys)])
	var colour_bad: String = ""
	for gid2: Variant in expected.keys():
		if not actual.has(gid2):
			continue
		var ec: Color = (expected[gid2] as Dictionary).get("color", Color.WHITE)
		var ac: Color = (actual[gid2] as Dictionary).get("color", Color.BLACK)
		if ec != ac:
			colour_bad = "game %s wears %s, its soonest-closing challenge's type colour is %s" % [str(gid2), str(ac), str(ec)]
			break
	_grad_expect(colour_bad == "",
		"tourney border: each border's colour is its soonest-closing challenge's type colour%s" % ("" if colour_bad == "" else " (" + colour_bad + ")"))


## GRADFIX8 (item 4), phase 15: stage 0 lands the fixture
## boards through Main's own fetch, stage 1 runs the
## border census and centres the bordered (tournament)
## card, and stages 2-3 take the motion pair - the drum
## settles, grab A lands, and grab B lands 400+ ms of
## wall clock later with the same card standing in the
## same place, so the only thing that can differ along
## the ring is the shader's phase. The last stage's
## frame span prints as the run's frame sample.
func _grad_gf8_border_step() -> void:
	var tid: String = str(_grad_manifest.get("tournament_id", ""))
	var idx: int = _grad_panel_index(tid)
	match _grad_gf8_stage:
		0:
			# The boards reach the room the production way:
			# Main's own fetch (the call entering the
			# Tournament Room emits) against the harness
			# stub serving the fixture challenges - its
			# landing also writes the WoVP disk cache, and
			# _push_wovp_data is what seats the borders.
			if _room._wovp_challenges.is_empty():
				if not _grad_gf8_fetch_asked:
					_grad_gf8_fetch_asked = true
					_grad_gf8_since = Time.get_ticks_msec()
					_wovp_fetch_boards()
				elif Time.get_ticks_msec() - _grad_gf8_since > 30000:
					_grad_fail("tourney border: the fixture challenge set never landed (fetch asked, none standing after 30 s)")
					_grad_phase = 4
					_grad_power_stage = 0
				return
			_grad_gf8_stage = 1
		1:
			_grad_leg_tourney_border()
			if idx < 0:
				_grad_fail("tourney border: the bordered card is on the shelf for the motion grabs")
				_grad_phase = 4
				_grad_power_stage = 0
				return
			_room._set_focused(_room._panels[idx])
			_grad_gf8_stage = 2
			_grad_gf8_since = Time.get_ticks_msec()
			_grad_gf8_frames = 0
		2:
			_grad_gf8_frames += 1
			if not _room.page_slide_active() and _grad_gf8_frames >= 12:
				_grad_save_grab("gradfix8_border_a.png")
				_grad_gf8_stage = 3
				_grad_gf8_since = Time.get_ticks_msec()
				_grad_gf8_frames = 0
			elif Time.get_ticks_msec() - _grad_gf8_since > 20000:
				_grad_fail("tourney border: the drum never settled for the motion grabs")
				_grad_phase = 4
				_grad_power_stage = 0
		3:
			_grad_gf8_frames += 1
			var elapsed: int = Time.get_ticks_msec() - _grad_gf8_since
			if elapsed >= 400:
				_grad_save_grab("gradfix8_border_b.png")
				print("  info - grad smoke: GF8 frame sample at the bordered centre: %d frames over %d ms (avg %.2f ms/frame)" % [_grad_gf8_frames, elapsed, float(elapsed) / maxf(1.0, float(_grad_gf8_frames))])
				_grad_expect(true,
					"tourney border: motion grabs taken %d ms apart at the bordered card (gradfix8_border_a.png / gradfix8_border_b.png)" % elapsed)
				_grad_phase = 4
				_grad_power_stage = 0


## GRADFIX6 (item 1): the flip, proven on the tournament
## table's card - the one card whose back is a live board.
## Stage 0 seats the focus; stage 1 presses Y (the real
## _info_focused_card path) and SAMPLES the turn every
## frame it is in flight - the dense-frame evidence for
## the animation: the angle must climb monotonically from
## 0 to 180 inside the turn's own envelope, with in-flight
## samples on both sides of edge-on, and grabs at the
## 45/90/135 crossings plus one with the back up; stage 2
## presses Y again and the card must come home to its
## front. Under PVLDS_GRADFIX6_NC=noflip the press is
## inert, no sample ever lands, and every leg here fails
## by name ("card flip:").
func _grad_tournament_step() -> void:
	var tid: String = str(_grad_manifest.get("tournament_id", ""))
	var idx: int = _grad_panel_index(tid)
	if idx < 0:
		_grad_fail("card flip: the tournament table is on the shelf")
		_grad_phase = 5
		return
	match _grad_power_stage:
		0:
			_room._set_focused(_room._panels[idx])
			_grad_power_stage = 1
			_grad_power_since = Time.get_ticks_msec()
		1:
			var elapsed: int = Time.get_ticks_msec() - _grad_power_since
			if elapsed > 30000:
				_grad_fail("card flip: the drum never settled at the tournament table")
				_grad_phase = 5
			elif not _room.page_slide_active():
				_grad_flip_angles.clear()
				_grad_flip_grabs = 0
				_room._info_focused_card()
				_grad_power_stage = 2
				_grad_power_since = Time.get_ticks_msec()
		2:
			var fs: Dictionary = _room.flip_state()
			var ang: float = float(fs.get("angle_deg", 0.0))
			_grad_flip_angles.append(ang)
			var thresholds: Array = [45.0, 90.0, 135.0]
			while _grad_flip_grabs < thresholds.size() and ang >= float(thresholds[_grad_flip_grabs]):
				_grad_save_grab("grad_flip_%d.png" % int(thresholds[_grad_flip_grabs]))
				_grad_flip_grabs += 1
			var elapsed2: int = Time.get_ticks_msec() - _grad_power_since
			if bool(fs.get("open", false)) and float(fs.get("t", 0.0)) >= 1.0:
				var mono: bool = true
				var in_flight: int = 0
				var prev: float = -1.0
				for a: Variant in _grad_flip_angles:
					var av: float = float(a)
					if av < prev - 0.01:
						mono = false
					if av > 2.0 and av < 178.0:
						in_flight += 1
					prev = av
				_grad_expect(str(fs.get("standing_key", "")).begins_with("wing|") and int(fs.get("idx", -1)) == idx,
					"card flip: the tournament table's card is the one turned (key %s)" % str(fs.get("standing_key", "")))
				_grad_expect(bool(fs.get("texture_real", false)) and bool(fs.get("back_visible", false)),
					"card flip: the back stands with the live board rendered on it")
				_grad_expect(not bool(fs.get("back_launch_pickable", true)),
					"no launch: the flipped back carries no Launch plinth (GRADFIX13 item 2 - the strip; the back's own Launch stood here through GRADFIX12)")
				# GRADFIX13 (item 1): the seated proof for
				# the back runs in stage 5 below - this
				# card's back is a board + data composition
				# (the tournament table's own challenge),
				# standing flipped in the room.
				_grad_expect(mono and in_flight >= 2,
					"card flip: the turn is one clean climb - %d frames sampled on this box, %d in flight, monotonic %s (first %.1f, last %.1f deg; the turn is 0.30 s of game time - about 3 frames at this harness box's rate, about 27 at the Quest's 90 Hz, where the density claim lives)"
						% [_grad_flip_angles.size(), in_flight, str(mono),
							float(_grad_flip_angles.front()) if not _grad_flip_angles.is_empty() else -1.0,
							float(_grad_flip_angles.back()) if not _grad_flip_angles.is_empty() else -1.0])
				_grad_expect(elapsed2 >= 200 and elapsed2 <= 1500,
					"card flip: the turn takes its own time - %d ms wall on this box (the animation is delta-driven: 0.30 s of game time; the harness box's frame rate stretches the wall clock, the Quest's 90 Hz does not)" % elapsed2)
				_grad_save_grab("grad_flip.png")
				_grad_power_stage = 5
				_grad_power_since = Time.get_ticks_msec()
			elif elapsed2 > 20000:
				_grad_fail("card flip: the card never completed its turn at the tournament table (last angle %.1f deg over %d samples)" % [ang, _grad_flip_angles.size()])
				_grad_phase = 5
		5:
			# GRADFIX13 (item 1): the seated proof for the
			# flipped back. At the pop distance the desk
			# camera's frame crops the card frame's top
			# edge, so the measure pulls the desk rig back
			# 0.55 m for its grab (the tournament smoke's
			# own shot seam, _desk_rig.position) and
			# restores it before the flip home. The extent
			# math is projection-based - the wider framing
			# does not bias it. The object is the back
			# FRAME (0.68x1.10, the back assembly's full
			# extent, concentric with the face). With the
			# plinth + its 140 px reservation gone (item
			# 2) the composition centres on the whole
			# card; through GRADFIX12 it centred over the
			# area above the footer and rode ~70 px high.
			var elapsed5: int = Time.get_ticks_msec() - _grad_power_since
			if elapsed5 < 50:
				_room._desk_rig.position = RoomView.EYE + Vector3(0.0, 0.0, -0.55)
			elif elapsed5 >= 200:
				var flip_img: Image = get_viewport().get_texture().get_image()
				var flip_cam: Camera3D = get_viewport().get_camera_3d()
				var grab_dir5: String = OS.get_environment("PVLDS_GRAB_DIR")
				if grab_dir5 != "" and flip_img != null and not flip_img.is_empty():
					flip_img.save_png(grab_dir5.path_join("gf13_back_grad.png"))
				var fnodes: Dictionary = _room._flip_nodes(idx)
				var fframe: MeshInstance3D = fnodes.get("back_frame") as MeshInstance3D if not fnodes.is_empty() else null
				var fres: Dictionary = _gf13_seated_extent(fframe.global_transform, RoomView.CARD_FRAME_SIZE, flip_img, flip_cam) if fframe != null else {"ok": false, "delta": 0.0, "why": "no back frame"}
				var fdelta: float = float(fres.get("delta", 0.0))
				print("GRADFIX13 SEATED back (tournament board + data): extent delta %.2f%% of frame height%s"
					% [100.0 * fdelta, "" if bool(fres.get("ok", false)) else " - " + str(fres.get("why", ""))])
				_grad_expect(bool(fres.get("ok", false)) and absf(fdelta) <= 0.02,
					"seated centre: the flipped back's composition centres on its card in the room grab (delta %.2f%% of frame height, tolerance 2%%)%s"
						% [100.0 * fdelta, "" if bool(fres.get("ok", false)) else " - " + str(fres.get("why", ""))])
				_room._desk_rig.position = RoomView.EYE
				_grad_power_stage = 3
				_grad_power_since = Time.get_ticks_msec()
		3:
			_room._info_focused_card()
			_grad_power_stage = 4
			_grad_power_since = Time.get_ticks_msec()
		4:
			var fs2: Dictionary = _room.flip_state()
			var elapsed3: int = Time.get_ticks_msec() - _grad_power_since
			if not bool(fs2.get("active", true)) and not bool(fs2.get("open", true)):
				_grad_expect(absf(float(fs2.get("angle_deg", 1.0))) <= 0.5,
					"card flip: a second Y brings the front home")
				_grad_power_stage = 0
				_grad_phase = 5
			elif elapsed3 > 20000:
				_grad_fail("card flip: the card never turned back")
				_grad_phase = 5

func _grad_power_step() -> void:
	var pair_idx: int = _grad_panel_index(str(_grad_manifest.get("pair_id", "")))
	var b2s_ids: Array = _grad_manifest.get("b2s_ids", [])
	var taxi_idx: int = _grad_panel_index(str(b2s_ids[0])) if b2s_ids.size() > 0 else -1
	var elapsed: int = Time.get_ticks_msec() - _grad_power_since
	match _grad_power_stage:
		0: # warm visit: centre the pair table so its faces fill
			if pair_idx < 0:
				_grad_fail("power: the pair table is on the shelf")
				_grad_phase = 14
				return
			_room._set_focused(_room._panels[pair_idx])
			_grad_power_stage = 1
			_grad_power_since = Time.get_ticks_msec()
		1: # the pair must be claimable before its measured
			# performance - a performance that starts while
			# the pair is still extracting grades the
			# backglass instead (the shipped restart law
			# covers players; the leg measures the real one)
			var g: GameEntry = _grad_game(str(_grad_manifest.get("pair_id", "")))
			if elapsed > 30000:
				_grad_fail("power: the pair table's pair never became claimable")
				_grad_phase = 14
			elif g != null and g.pair_on_art() != "" and not _room.page_slide_active() and elapsed > 500:
				_room._set_focused(_room._panels[mini(pair_idx + 1, _room._panels.size() - 1)])
				_grad_power_stage = 2
				_grad_power_since = Time.get_ticks_msec()
		2: # focus it again: the measured performance
			if elapsed > 20000:
				_grad_fail("power: the warm visit never ended")
				_grad_phase = 14
			elif _room.power_panel() == null and not _room.page_slide_active() and elapsed > 500:
				_room._set_focused(_room._panels[pair_idx])
				_grad_power_stage = 3
				_grad_power_since = Time.get_ticks_msec()
		3: # its performance starts, mode 3, pair crossfade
			if elapsed > 30000:
				_grad_fail("power: the pair table's performance never started")
				_grad_phase = 14
			elif _room.power_panel() == _room._panels[pair_idx]:
				_grad_expect(_room.power_mode() == 3 and _room.power_is_pair(),
					"power: the pair table performs its Off/On crossfade (mode %d)" % _room.power_mode())
				_grad_expect(_room.power_overlay_count() == 1,
					"power: the performance is one overlay quad")
				_grad_power_stage = 4
				_grad_power_since = Time.get_ticks_msec()
		4: # it settles (phase 2 stands, focus still resting)
			# and the card's own face under the standing
			# overlay is the author shot again, pixel-true;
			# focus loss then restores the card outright.
			if elapsed > 60000:
				_grad_fail("power: the pair performance never settled")
				_grad_phase = 14
			elif _room.power_phase() == 2 and elapsed > 1000:
				# The standing face's own key names the art
				# it was rendered from: the shot's cache
				# path must be in it - the resting face
				# under the standing overlay is the shot's.
				var g2: GameEntry = _grad_game(str(_grad_manifest.get("pair_id", "")))
				var fkey: String = str(_room._panel_face_key.get(g2.game_id, ""))
				_grad_expect(fkey.contains(ArtProvider.shot_cache_path_for(g2.shot_url)),
					"power: settled, the pair table wears its author shot again")
				_room._set_focused(_room._panels[mini(pair_idx + 1, _room._panels.size() - 1)])
				_grad_power_stage = 10
				_grad_power_since = Time.get_ticks_msec()
		10: # focus loss restored the performer
			if elapsed > 20000:
				_grad_fail("power: focus loss never restored the pair table")
				_grad_phase = 14
			elif _room.power_panel() == null:
				_grad_expect(true, "power: focus loss restores the shot-faced card")
				_grad_power_stage = 5
				_grad_power_since = Time.get_ticks_msec()
		5: # warm visit: a no-shot table, backglass filled
			if taxi_idx < 0:
				_grad_fail("power: the backglass-fallback table is on the shelf")
				_grad_phase = 14
				return
			_room._set_focused(_room._panels[taxi_idx])
			_grad_power_stage = 6
			_grad_power_since = Time.get_ticks_msec()
		6:
			var tg: GameEntry = _grad_game(str(b2s_ids[0])) if b2s_ids.size() > 0 else null
			if elapsed > 30000:
				_grad_fail("power: the fallback table's backglass never filled")
				_grad_phase = 14
			elif tg != null and tg.backglass_face_path() != "" and not _room.page_slide_active() and elapsed > 500:
				_room._set_focused(_room._panels[mini(taxi_idx + 1, _room._panels.size() - 1)])
				_grad_power_stage = 7
				_grad_power_since = Time.get_ticks_msec()
		7:
			if elapsed > 20000:
				_grad_fail("power: the fallback warm visit never ended")
				_grad_phase = 14
			elif _room.power_panel() == null and not _room.page_slide_active() and elapsed > 500:
				_room._set_focused(_room._panels[taxi_idx])
				_grad_power_stage = 8
				_grad_power_since = Time.get_ticks_msec()
		8:
			if elapsed > 30000:
				_grad_fail("power: the fallback table's performance never started")
				_grad_phase = 14
			elif _room.power_panel() == _room._panels[taxi_idx]:
				_grad_expect(_room.power_mode() == 2 and not _room.power_is_pair(),
					"power: the fallback table performs the mimic grade on its backglass (mode %d)" % _room.power_mode())
				if _room.power_time() > 0.25:
					_grad_save_grab("grad_fallback_power.png")
					_grad_power_stage = 9
					_grad_phase = 14


func _finish_grad_smoke() -> void:
	_grad_audit_labels("final")
	if _grad_failures == 0:
		print("PVLDS GRAD SMOKE: PASS")
		get_tree().quit(0)
	else:
		printerr("PVLDS GRAD SMOKE: FAIL (%d)" % _grad_failures)
		get_tree().quit(1)


# ---------------------------------------------------- xpress smoke (GRADFIX12 item 2)

## --pvlds-smoke-xpress: the X-press art-swap census (Chris's
## field report, GRADFIX12 item 2): pressing X to favourite
## flip-flopped the card between its standing art and an
## ALTERNATIVE art, and the star did not survive on the
## standing face. For every fixture face-source class -
## (a) db-shot standing with a backglass also present (the
## Bride pair table), (b) pair-chain (Big Chain Glass: a
## pair .directb2s, no shot), (c) plain-b2s chain (Taxi),
## (d) styled-only (Krull, the title-card fixture) - the
## driver focuses the card, lets the power performance
## settle, presses X through the REAL joypad poll path,
## and asserts the standard: favouriting changes NOTHING
## but the badge -
##   (a) "x-press art:" the quad texture's pixels outside
##       the badge region are identical before/after the
##       press, and the rendered grab's panel crop outside
##       the badge region is identical too;
##   (b) "x-press star:" the badge is present in the
##       RENDERED grab after the press, still present after
##       heal/warm time and a focus-leave/return cycle (the
##       power performance's settle included);
##   (c) "x-press star:" a second press removes the badge
##       and still changes no art.
## Every sample prints an XPRESS TRACE line (art file,
## face key, quad/rendered badge counts, power phase /
## panel / mode, the power subject's own badge count - the
## S1/S2 discriminator), so a failure names its mechanism.
## NC: PVLDS_GRADFIX12_NC=powerbadge restores the pre-fix
## power binding (the performance's subject / pair-On
## sources ignore the favourite state), and the
## "x-press star:" legs must fail by name.

func _drive_xpress_smoke() -> void:
	if _xpress_started:
		return
	if _room == null or not _room.visible or not _room.wall_ready:
		return
	_xpress_started = true
	_room._handle_rail("filter:all")
	var mpath: String = OS.get_environment("PVLDS_GRAD_MANIFEST")
	var f: FileAccess = FileAccess.open(mpath, FileAccess.READ)
	if f != null:
		var parsed: Variant = JSON.parse_string(f.get_as_text())
		if parsed is Dictionary:
			_xpress_manifest = parsed
	Input.warp_mouse(Vector2(512.0, 764.0))
	_xpress_run_async()


func _xpress_expect(cond: bool, label: String) -> void:
	if cond:
		print("  ok - xpress smoke: ", label)
	else:
		_xpress_failures += 1
		printerr("  FAIL - xpress smoke: ", label)


func _xpress_game_by_id(game_id: String) -> GameEntry:
	if _room == null or _room._scanner == null:
		return null
	for g: GameEntry in _room._scanner.games:
		if g.game_id == game_id:
			return g
	return null


func _xpress_game_by_title(title: String) -> GameEntry:
	if _room == null or _room._scanner == null:
		return null
	for g: GameEntry in _room._scanner.games:
		if g.title == title:
			return g
	return null


func _xpress_panel_index(g: GameEntry) -> int:
	if g == null or _room == null:
		return -1
	for i: int in range(_room._panels.size()):
		if _room._panels[i] != null and _room._panels[i].payload == g.game_id:
			return i
	return -1


## Wait (wall clock) until the named panel's power
## performance has settled: phase 2 standing on that panel.
## Returns false on timeout.
func _xpress_wait_settled(idx: int, timeout_sec: float) -> bool:
	var panel: ClickableQuad = _room._panels[idx]
	var t0: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - t0 < int(timeout_sec * 1000.0):
		if _room.power_panel() == panel and _room.power_phase() == 2:
			return true
		await get_tree().process_frame
	return _room.power_panel() == panel and _room.power_phase() == 2


## Wait until the panel's face honestly stands: a real
## texture, stamped with a face key that names want_path
## ("" = any stamped key; styled cards stamp their title).
func _xpress_wait_face(idx: int, g: GameEntry, want_path: String, timeout_sec: float) -> bool:
	var t0: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - t0 < int(timeout_sec * 1000.0):
		var tex: Texture2D = _room._panels[idx].current_texture()
		var key: String = str(_room._panel_face_key.get(g.game_id, ""))
		if tex != null and tex.get_width() > 16 and key != "" \
				and (want_path == "" or key.contains(want_path)):
			return true
		await get_tree().process_frame
	return false


## Wait until the panel's stamped face key carries (or
## drops) the favorite flag - the re-render the X press
## asked for has actually landed (the base trace showed a
## path-only wait passing on the STALE key while the fav
## render was still in the factory queue).
func _xpress_wait_favkey(g: GameEntry, want_fav: bool, timeout_sec: float) -> bool:
	var t0: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - t0 < int(timeout_sec * 1000.0):
		var key: String = str(_room._panel_face_key.get(g.game_id, ""))
		if key != "" and key.contains("|fav") == want_fav:
			return true
		await get_tree().process_frame
	return false


## After a face arrival on the performing panel: the
## arrival restores the performance and the candidate
## machinery restarts it - wait out the restart window,
## then for the re-settle. A panel whose performance was
## missed (no backglass to perform on) settles bare: no
## panel, phase 0, and that is a settled state too.
func _xpress_wait_resettle(idx: int, timeout_sec: float) -> bool:
	var panel: ClickableQuad = _room._panels[idx]
	var t0: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - t0 < 6000:
		if _room.power_panel() != panel or _room.power_phase() == 0:
			break
		await get_tree().process_frame
	t0 = Time.get_ticks_msec()
	while Time.get_ticks_msec() - t0 < int(timeout_sec * 1000.0):
		if _room.power_panel() == panel and _room.power_phase() == 2:
			return true
		if _room.power_panel() == null and _room.power_phase() == 0 \
				and Time.get_ticks_msec() - t0 > 3000:
			return true
		await get_tree().process_frame
	return _room.power_panel() == panel and _room.power_phase() == 2


func _xpress_wait_centre(idx: int, timeout_sec: float) -> bool:
	var t0: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - t0 < int(timeout_sec * 1000.0):
		if _room.centre_index() == idx and not _room.page_slide_active():
			return true
		await get_tree().process_frame
	return false


## Count pixels of (near-)exact colour c in img's region.
func _xpress_count_colour(img: Image, region: Rect2i, c: Color, tol: float) -> int:
	var count: int = 0
	var x0: int = maxi(0, region.position.x)
	var y0: int = maxi(0, region.position.y)
	var x1: int = mini(img.get_width(), region.position.x + region.size.x)
	var y1: int = mini(img.get_height(), region.position.y + region.size.y)
	for y: int in range(y0, y1):
		for x: int in range(x0, x1):
			var px: Color = img.get_pixel(x, y)
			if absf(px.r - c.r) < tol and absf(px.g - c.g) < tol and absf(px.b - c.b) < tol:
				count += 1
	return count


## Star-ISH pixels (the badge glyph's amber, loose enough
## to survive the power grade's shoulder) in a region of a
## RENDERED grab or a face texture.
func _xpress_count_starish(img: Image, region: Rect2i) -> int:
	var count: int = 0
	var x0: int = maxi(0, region.position.x)
	var y0: int = maxi(0, region.position.y)
	var x1: int = mini(img.get_width(), region.position.x + region.size.x)
	var y1: int = mini(img.get_height(), region.position.y + region.size.y)
	for y: int in range(y0, y1):
		for x: int in range(x0, x1):
			var px: Color = img.get_pixel(x, y)
			if px.r > 0.72 and px.g > 0.42 and px.g < 0.99 and px.b < 0.52 and px.r - px.b > 0.32:
				count += 1
	return count


## Pixel difference between two same-size images, split by
## a badge region: returns [diff_outside, total_outside,
## diff_inside, bbox_of_all_diffs (Rect2i, empty if none)].
## A pixel differs when any channel moves by more than tol.
func _xpress_diff(a: Image, b: Image, badge: Rect2i, tol: float) -> Array:
	var out_diff: int = 0
	var out_total: int = 0
	var in_diff: int = 0
	var have: bool = false
	var bb: Rect2i = Rect2i()
	if a.get_size() != b.get_size():
		return [-1, 0, -1, bb]
	for y: int in range(a.get_height()):
		for x: int in range(a.get_width()):
			var pa: Color = a.get_pixel(x, y)
			var pb: Color = b.get_pixel(x, y)
			var d: bool = absf(pa.r - pb.r) > tol or absf(pa.g - pb.g) > tol or absf(pa.b - pb.b) > tol
			var inside: bool = badge.has_point(Vector2i(x, y))
			if not inside:
				out_total += 1
			if d:
				if inside:
					in_diff += 1
				else:
					out_diff += 1
				if not have:
					bb = Rect2i(x, y, 1, 1)
					have = true
				else:
					bb = bb.expand(Vector2i(x, y))
	return [out_diff, out_total, in_diff, bb]


## The focused panel's screen bbox + badge bbox from its
## projected corners (the camera's own projection, as the
## grad census reads its quads).
func _xpress_panel_screen_rects(idx: int, badge_face: Rect2) -> Array:
	var panel: ClickableQuad = _room._panels[idx]
	var cam: Camera3D = _room._active_camera()
	var half: Vector2 = _room._panel_size * 0.5
	var pts: Array[Vector2] = _grad_quad_screen_points(panel.global_transform, half, cam)
	var rect: Rect2 = Rect2(pts[0], Vector2.ZERO)
	for p: Vector2 in pts:
		rect = rect.expand(p)
	# Badge rect in face UV -> panel-local -> screen.
	var fs: Vector2 = Vector2(RoomView.CARD_FACE_PX) ## xpress smoke fixture: the badge's face-pixel space IS the face size in force (GF18-HALFRES: follows the halved constant)
	var lp: Array[Vector2] = []
	for c: Vector2 in [badge_face.position, Vector2(badge_face.position.x + badge_face.size.x, badge_face.position.y),
			Vector2(badge_face.position.x + badge_face.size.x, badge_face.position.y + badge_face.size.y),
			Vector2(badge_face.position.x, badge_face.position.y + badge_face.size.y)]:
		var local: Vector3 = Vector3((c.x / fs.x - 0.5) * _room._panel_size.x,
			(0.5 - c.y / fs.y) * _room._panel_size.y, 0.0)
		lp.append(cam.unproject_position(panel.global_transform * local))
	var brect: Rect2 = Rect2(lp[0], Vector2.ZERO)
	for p2: Vector2 in lp:
		brect = brect.expand(p2)
	return [rect, brect]


func _xpress_grab() -> Image:
	await get_tree().process_frame
	await get_tree().process_frame
	return get_viewport().get_texture().get_image()


func _xpress_trace(tag: String, cls: String, idx: int, g: GameEntry, quad_img: Image, grab: Image) -> void:
	var badge_face: Rect2 = Rect2(386.0, 0.0, 110.0, 110.0)
	var rects: Array = _xpress_panel_screen_rects(idx, badge_face)
	var brect: Rect2 = rects[1]
	var subj: Texture2D = _room._power_subject_cached(g)
	var subj_star: int = -1
	if subj != null:
		var simg: Image = subj.get_image()
		if simg != null:
			subj_star = _xpress_count_starish(simg, Rect2i(simg.get_width() - 110, 0, 110, 110))
	print("XPRESS TRACE %s class=%s game=\"%s\" art_file=\"%s\" fkey=\"%s\" fav=%s power(panel=%s phase=%d mode=%d overlays=%d) quad_star=%d subject_star=%d rendered_star=%d" % [
		tag, cls, g.title, g.face_path_ready(),
		str(_room._panel_face_key.get(g.game_id, "")),
		str(_state.is_favorite(g.game_id)),
		str(_room.power_panel() == _room._panels[idx]),
		_room.power_phase(), _room.power_mode(), _room.power_overlay_count(),
		_xpress_count_starish(quad_img, Rect2i(quad_img.get_width() - 110, 0, 110, 110)) if quad_img != null else -1,
		subj_star,
		_xpress_count_starish(grab, Rect2i(brect)) if grab != null else -1])


func _xpress_run_async() -> void:
	# Fetcher drain first (the grad driver's law): shots
	# must have landed before any face is judged.
	var t0: int = Time.get_ticks_msec()
	while Time.get_ticks_msec() - t0 < 240000:
		if _shot_fetcher != null and not _shot_fetcher.is_fetching():
			break
		await get_tree().process_frame
	await get_tree().create_timer(2.0).timeout
	var pair_id: String = str(_xpress_manifest.get("pair_id", ""))
	var b2s_ids: Array = _xpress_manifest.get("b2s_ids", [])
	var classes: Array = []
	var bride: GameEntry = _xpress_game_by_id(pair_id)
	if bride != null:
		classes.append({"key": "shotpair", "game": bride, "styled": false})
	# (a2) db-shot standing with a SINGLE backglass present
	# (the harness lays Taxi's real .directb2s beside Aaron
	# Spelling's shot fixture): the pure subject seam - its
	# performance is the mimic grade on the backglass
	# subject render, no pair crossfade in the way.
	var aaron: GameEntry = _xpress_game_by_id("7O0Ir6NU")
	if aaron != null and aaron.backglass_source() != "" and aaron.pair_on_art() == "":
		classes.append({"key": "shotsubject", "game": aaron, "styled": false})
	var big: GameEntry = _xpress_game_by_title("Big Chain Glass")
	if big != null:
		classes.append({"key": "pairchain", "game": big, "styled": false})
	if b2s_ids.size() > 0:
		var taxi: GameEntry = _xpress_game_by_id(str(b2s_ids[0]))
		if taxi != null:
			classes.append({"key": "plainb2s", "game": taxi, "styled": false})
	var krull: GameEntry = _xpress_game_by_id(str(_xpress_manifest.get("titlecard_id", "")))
	if krull != null:
		classes.append({"key": "styled", "game": krull, "styled": true})
	_xpress_expect(classes.size() == 5,
		"x-press census: all five fixture classes resolve (got %d)" % classes.size())
	for entry_v: Variant in classes:
		var entry: Dictionary = entry_v as Dictionary
		await _xpress_class_async(entry)
	if _state != null:
		_state.save_to_disk()
	if _xpress_failures == 0:
		print("PVLDS XPRESS SMOKE: PASS")
		get_tree().quit(0)
	else:
		printerr("PVLDS XPRESS SMOKE: FAIL (%d)" % _xpress_failures)
		get_tree().quit(1)


func _xpress_class_async(entry: Dictionary) -> void:
	var cls: String = str(entry.get("key", "?"))
	var g: GameEntry = entry.get("game") as GameEntry
	var styled: bool = bool(entry.get("styled", false))
	var idx: int = _xpress_panel_index(g)
	_xpress_expect(idx >= 0, "x-press census: %s is on the shelf" % cls)
	if idx < 0:
		return
	if _state.is_favorite(g.game_id):
		_state.set_favorite(g.game_id, false)
		_state.save_to_disk()
	# ---- stand the face + settle the performance ----
	_room._set_centre(idx, true)
	_room._set_focused(_room._panels[idx])
	var centred: bool = await _xpress_wait_centre(idx, 30.0)
	_xpress_expect(centred, "x-press census: %s centres" % cls)
	var want_path: String = "" if styled else g.face_path_ready()
	if not styled:
		# Chain art may still be extracting: wait for the
		# ready probe, then for the stamped face.
		var wt0: int = Time.get_ticks_msec()
		while g.face_path_ready() == "" and Time.get_ticks_msec() - wt0 < 180000:
			await get_tree().process_frame
		want_path = g.face_path_ready()
		if cls == "shotpair" or cls == "pairchain":
			var wp0: int = Time.get_ticks_msec()
			while g.pair_on_art() == "" and Time.get_ticks_msec() - wp0 < 120000:
				await get_tree().process_frame
	var face_ok: bool = await _xpress_wait_face(idx, g, want_path, 120.0)
	_xpress_expect(face_ok, "x-press census: %s face stands (want '%s')" % [cls, want_path])
	var settled: bool = await _xpress_wait_settled(idx, 90.0)
	_xpress_expect(settled, "x-press census: %s power performance settles before the press (phase %d)" % [cls, _room.power_phase()])
	## xpress smoke fixture, in face pixels at the size in force. The
	## badges are FIXED-pixel Control layout (the art star's box is a
	## 62x62 box 14 px from the top-right corner; the panel chip row
	## flows from the top at fixed font sizes) - they do NOT scale
	## with the face, so the rects anchor to the face's edges at
	## their fixed offsets. At 496x864 these are exactly the original
	## literals; at the GF18-HALFRES 248x432 they still cover the
	## badge and only the badge.
	var badge_face: Rect2 = Rect2(float(RoomView.CARD_FACE_PX.x) - 110.0, 0.0, 110.0, 110.0)
	if styled:
		badge_face = Rect2(0.0, 240.0, float(RoomView.CARD_FACE_PX.x), 110.0) ## the styled face's badge is its FAVORITE chip row (base trace at 496x864: diff bbox (26,263)+(158,50))
	var quad_before: Image = _room._panels[idx].current_texture().get_image()
	var grab_before: Image = await _xpress_grab()
	_xpress_trace("before", cls, idx, g, quad_before, grab_before)
	var rects_before: Array = _xpress_panel_screen_rects(idx, badge_face)
	var crop_before: Rect2i = Rect2i(rects_before[0]).intersection(Rect2i(0, 0, grab_before.get_width(), grab_before.get_height()))
	# ---- press X through the real poll path ----
	await _nav_feed_button(JOY_BUTTON_X)
	_xpress_expect(_state.is_favorite(g.game_id),
		"x-press census: %s X press sets the favorite in the store" % cls)
	var favkey_ok: bool = await _xpress_wait_favkey(g, true, 60.0)
	_xpress_expect(favkey_ok, "x-press art: %s fav face re-stands after the press" % cls)
	var settled2: bool = await _xpress_wait_resettle(idx, 90.0)
	_xpress_expect(settled2, "x-press census: %s power performance re-settles after the press (phase %d)" % [cls, _room.power_phase()])
	# Heal/warm survival: real time passes (the heal ticks
	# on its 600 ms cadence the whole while).
	await get_tree().create_timer(3.0).timeout
	var quad_after: Image = _room._panels[idx].current_texture().get_image()
	var grab_after: Image = await _xpress_grab()
	_xpress_trace("after", cls, idx, g, quad_after, grab_after)
	if cls == "pairchain":
		grab_before.save_png(OS.get_environment("PVLDS_GRAB_DIR").path_join("xpress_pairchain_before.png"))
		grab_after.save_png(OS.get_environment("PVLDS_GRAB_DIR").path_join("xpress_pairchain_after.png"))
	var badge_recti: Rect2i = Rect2i(badge_face)
	var qd: Array = _xpress_diff(quad_before, quad_after, badge_recti, 0.02)
	print("XPRESS DIFF %s quad outside=%d/%d inside=%d bbox=%s" % [cls, int(qd[0]), int(qd[1]), int(qd[2]), str(qd[3])])
	_xpress_expect(int(qd[0]) == 0,
		"x-press art: %s quad art outside the badge region is identical after X (%d px moved)" % [cls, int(qd[0])])
	# Rendered crop comparison (panel crop, badge excluded).
	var rects_after: Array = _xpress_panel_screen_rects(idx, badge_face)
	var crop_after: Rect2i = Rect2i(rects_after[0]).intersection(Rect2i(0, 0, grab_after.get_width(), grab_after.get_height()))
	var crop_same: bool = crop_before.size == crop_after.size and crop_before.size.x > 40 and crop_before.size.y > 40
	_xpress_expect(crop_same, "x-press census: %s rendered crop is measurable" % cls)
	if crop_same:
		var cb: Image = grab_before.get_region(crop_before)
		var ca: Image = grab_after.get_region(crop_after)
		var badge_local: Rect2i = Rect2i(Rect2(rects_after[1]).position - Vector2(crop_after.position), Rect2(rects_after[1]).size)
		var rd: Array = _xpress_diff(cb, ca, badge_local, 0.05)
		var frac: float = float(int(rd[0])) / maxf(1.0, float(int(rd[1])))
		print("XPRESS DIFF %s rendered outside=%d/%d (%.4f) inside=%d" % [cls, int(rd[0]), int(rd[1]), frac, int(rd[2])])
		_xpress_expect(frac <= 0.02,
			"x-press art: %s rendered art outside the badge region is identical after X (%.4f moved)" % [cls, frac])
	# Badge in the rendered grab.
	var star_before: int = _xpress_count_starish(grab_before, Rect2i(rects_before[1]))
	var star_after: int = _xpress_count_starish(grab_after, Rect2i(rects_after[1]))
	if styled:
		var chip: Color = Color(0.55, 0.38, 0.08)
		var chip_q: int = _xpress_count_colour(quad_after, badge_recti, chip, 0.05)
		_xpress_expect(chip_q > 100,
			"x-press star: %s styled face carries its FAVORITE chip after X (%d px)" % [cls, chip_q])
		_xpress_expect(int(qd[2]) > 20,
			"x-press star: %s chip region changed with the press (%d px)" % [cls, int(qd[2])])
	else:
		_xpress_expect(star_after > 12 and star_after > star_before,
			"x-press star: %s star present in the rendered grab after X and the power settle (before %d, after %d)" % [cls, star_before, star_after])
	# ---- focus-leave / return cycle: the badge survives ----
	var other: int = mini(idx + 1, _room._panels.size() - 1)
	if other == idx:
		other = maxi(0, idx - 1)
	_room._set_focused(_room._panels[other])
	await _xpress_wait_centre(other, 30.0)
	await get_tree().create_timer(1.0).timeout
	_room._set_centre(idx, true)
	_room._set_focused(_room._panels[idx])
	await _xpress_wait_centre(idx, 30.0)
	var settled3: bool = await _xpress_wait_settled(idx, 90.0)
	_xpress_expect(settled3, "x-press census: %s performance re-settles after the return" % cls)
	await get_tree().create_timer(2.0).timeout
	var grab_back: Image = await _xpress_grab()
	_xpress_trace("returned", cls, idx, g, _room._panels[idx].current_texture().get_image(), grab_back)
	var rects_back: Array = _xpress_panel_screen_rects(idx, badge_face)
	if not styled:
		var star_back: int = _xpress_count_starish(grab_back, Rect2i(rects_back[1]))
		_xpress_expect(star_back > 12,
			"x-press star: %s star still present after heal/warm time and the focus return (got %d)" % [cls, star_back])
	# ---- second press: badge off, art still unchanged ----
	await _nav_feed_button(JOY_BUTTON_X)
	_xpress_expect(not _state.is_favorite(g.game_id),
		"x-press census: %s second X press clears the favorite" % cls)
	await _xpress_wait_favkey(g, false, 60.0)
	await _xpress_wait_resettle(idx, 90.0)
	await get_tree().create_timer(2.0).timeout
	var quad_off: Image = _room._panels[idx].current_texture().get_image()
	var grab_off: Image = await _xpress_grab()
	_xpress_trace("off", cls, idx, g, quad_off, grab_off)
	var qd2: Array = _xpress_diff(quad_before, quad_off, badge_recti, 0.02)
	_xpress_expect(int(qd2[0]) == 0,
		"x-press art: %s second press changes no art outside the badge region (%d px moved)" % [cls, int(qd2[0])])
	if not styled:
		var rects_off: Array = _xpress_panel_screen_rects(idx, badge_face)
		var star_off: int = _xpress_count_starish(grab_off, Rect2i(rects_off[1]))
		_xpress_expect(star_off <= star_before + 4,
			"x-press star: %s second press removes the star from the rendered grab (before %d, off %d)" % [cls, star_before, star_off])
	if cls == "pairchain":
		grab_off.save_png(OS.get_environment("PVLDS_GRAB_DIR").path_join("xpress_pairchain_off.png"))


# ---------------------------------------------------- nav smoke

## --pvlds-smoke-nav: the focus graph + wall clearance contract
## (Chris's field reports, 2026-10-24, from his seated headset
## view):
##   leg 1: sideways travel along the control rail walks the
##          rail's own order end to end, both directions, and
##          never lands on a wall card;
##   leg 2: UP from the rail enters the card grid; DOWN from
##          the grid's bottom row returns to the rail;
##   leg 3: from a seated eye, every Launch button clears its
##          card's name strip (panel-local arithmetic and the
##          screen projection agree), and the bottom row -
##          cards and buttons, flush and popped - clears the
##          rail in screen space;
##   leg 4: a title card's face still registers its content at
##          texture row 0 (the 71877f4 raise, undisturbed);
##   leg 5: the bumpers flip PAGES (Chris's clarification,
##          2026-10-24 - sections shift one page over, never
##          cycle filters): RB advances, LB retreats, both
##          clamp at the ends, focus keeps its place across a
##          flip (same grid slot / same rail stop / first panel
##          from no focus), and the bumpers are inert in the
##          load wait, on the SETUP placard, and in the detail
##          view. The leg runs async: each flip now rides the
##          page slide (the feel round), so the leg waits out
##          each glide and asserts the settle - and on the
##          first flip, the choreography itself: no swap at
##          the press, the swap lands mid-glide, the wall
##          returns to exact rest, and on the first frame after
##          the swap every rail quad wears a real (non-
##          placeholder) texture - the bar never pops;
##   leg 6: the cards-only focus contract (Chris's ruling,
##          2026-10-24): the wall-mode focusable set holds no
##          Launch button, a DOWN walk down one column visits
##          exactly its three row panels in order, and the
##          A/Y assignment (Chris's swap ruling, 2026-10-26:
##          A starts; Y's side REBOUND by GRADFIX6, 2026-10-31:
##          Y FLIPS the focused card to its data back and back
##          again): A on the pad launches the focused card's
##          default build through the Launch button's own
##          path - Y inert on a rail stop and in the detail
##          view, A inert as a launcher everywhere but a wall
##          card; the detail view opens from the pointer's
##          click on a card. The leg also
##          carries the marquee-leak assertions (2026-10-26):
##          no marquee stands while the detail view is open or
##          during a launch begun from it; a wall launch
##          raises it as always. The launch half runs async
##          against the harness's never-window stub with a
##          zero-length life: the spawn lands in the load wait
##          and the dead pid settles it FAILED, browsing resumes.
##   leg 7: a rail activation keeps focus on the bar (Chris's
##          field report, 2026-10-25): A on a filter stop or
##          the sort stop rebuilds the wall, and focus is still
##          that stop once the rebuild settles - pad path and
##          pointer path alike;
##   leg 8: X flags favorites (Chris's proposal, 2026-10-25):
##          X on a focused card toggles the favorite in the
##          store and the persisted file, the card's face
##          re-renders in place carrying the mark (the panel
##          face's FAVORITE chip; the art face's star badge,
##          pixel-proven through the factory), X is inert on a
##          rail stop and in the load wait, and X-ing OFF
##          inside the FAVORITES filter removes the card with
##          the stated landing - the panel that took its slot,
##          or the ALL fallback's first panel when the set
##          empties.
##   leg 9: THE VERTICAL WALL LAW (GRADFIX13 item 4): from
##          EVERY stop in RAIL_FOCUS_ORDER (wovp_refresh
##          judged in the library AND inside the Tournament
##          view - it is pickable in both since GRADFIX16
##          item 1), UP lands on the centre column's
##          card on the centre band - the centre panel
##          itself - and DOWN returns to the rail, with the
##          drum's seated column and the swing's target yaw
##          asserted identical across both moves; seat
##          variants cover the bottom band and the partial
##          last column, and the strip path (strip -> rail
##          -> rows and back) rides the same assertions.
##          The leg is async: it lets frames pass after each
##          press so _follow_centre can act on the landing -
##          under PVLDS_GF13_NC=oldascent the ascent falls
##          back to the projection walk and these legs fail
##          by name on those frames.
## The driver forces the ALL filter through the room's own rail
## handler so the wall always holds a full bottom row. Leg 5
## needs more pages than the dummy library's ten games give, so
## the harness adds a scratch folder of stub tables beside it.
func _drive_nav_smoke() -> void:
	match _nav_smoke_phase:
		0:
			if _room != null and _room.visible and _room.wall_ready:
				# Park the mouse in the corner: hover wins the
				# drum's centre over pad focus (the shipped
				# law, right in the headset), so a mouse left
				# mid-screen by the harness would drive the
				# shelf while the leg drives the pad.
				Input.warp_mouse(Vector2(512.0, 764.0))
				_room.set_desk_camera_height(RoomView.SEATED_EYE_Y)
				_room._handle_rail("filter:all")
				_nav_smoke_wait = 0
				_nav_smoke_phase = 1
			else:
				_nav_smoke_wait += 1
				if _nav_smoke_wait > 3600:
					_nav_smoke_fail("the room never came up")
					_finish_nav_smoke()
		1:
			_nav_smoke_wait += 1
			if _nav_smoke_wait > 3600:
				_nav_smoke_fail("the ALL-filter wall never settled")
				_finish_nav_smoke()
			elif _room != null and _room.wall_ready and _nav_smoke_wait >= 4:
				_nav_leg_rail_walk()
				_nav_leg_up_down()
				_nav_leg_cards_only()
				_nav_leg_clearance(false)
				_nav_check_faces()
				_nav_smoke_wait = 0
				_nav_smoke_phase = 2
		2:
			if not _nav_faces_done:
				return
			var panel: ClickableQuad = _nav_bottom_row_panel()
			if panel == null:
				_nav_smoke_fail("pop leg: the wall has no bottom-row panel to pop")
				_finish_nav_smoke()
				return
			_nav_pop_panel = panel
			_room._set_focused(panel)
			_nav_smoke_wait = 0
			_nav_smoke_phase = 3
		3:
			_nav_smoke_wait += 1
			var amt: float = _room.panel_pop_amount(_nav_pop_panel)
			if amt >= 0.999:
				_nav_leg_clearance(true)
				_nav_smoke_wait = 0
				_nav_smoke_phase = 4
			elif _nav_smoke_wait > 240:
				_nav_smoke_fail("pop leg: the bottom-row panel's pop never completed (amount %.3f)" % amt)
				_finish_nav_smoke()
		4:
			if _nav_bumpers_done:
				_nav_smoke_wait = 0
				_nav_smoke_phase = 5
				return
			_nav_smoke_wait += 1
			if _nav_smoke_wait > 7200:
				_nav_smoke_fail("the bumper leg never finished")
