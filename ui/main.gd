func _nav_expect(cond: bool, label: String) -> void:
	if cond:
		print("  ok - nav smoke: ", label)
	else:
		_nav_smoke_fail(label)


func _nav_smoke_fail(label: String) -> void:
	_nav_smoke_failures += 1
	printerr("  FAIL - nav smoke: ", label)


func _finish_nav_smoke() -> void:
	if _nav_smoke_failures == 0:
		print("PVLDS NAV SMOKE: PASS")
		get_tree().quit(0)
	else:
		printerr("PVLDS NAV SMOKE: FAIL (%d)" % _nav_smoke_failures)
		get_tree().quit(1)


## --pvlds-smoke-input: GRADFIX10 items 4+5 (see the flag's
## doc at the top of this file). Every press rides the Input
## singleton (Input.parse_input_event) into the room's real
## _process gamepad poll - the shipping input path, never a
## direct _move_focus / _trigger_anchor call. Focus seating
## between legs (_set_focused) is setup, not assertion path.
## D-pad Right's BACK is judged through a probe lambda on
## exit_requested (the tournament descent legs' pattern), so
## one boot can judge BACK in every context and survive.
func _drive_input_smoke() -> void:
	match _input_smoke_phase:
		0:
			if _room != null and _room.visible and _room.wall_ready:
				Input.warp_mouse(Vector2(512.0, 764.0))
				_room._handle_rail("filter:all")
				_input_smoke_wait = 0
				_input_smoke_phase = 1
			else:
				_input_smoke_wait += 1
				if _input_smoke_wait > 3600:
					_input_smoke_fail("the room never came up")
					_finish_input_smoke()
		1:
			if _input_done:
				_finish_input_smoke()
				return
			_input_smoke_wait += 1
			if _input_smoke_wait > 7200:
				_input_smoke_fail("the input legs never finished")
				_finish_input_smoke()
			elif not _input_started and _room != null and _room.wall_ready and _input_smoke_wait >= 4:
				_input_started = true
				_input_legs_async()


func _input_expect(cond: bool, label: String) -> void:
	if cond:
		print("  ok - input smoke: ", label)
	else:
		_input_smoke_fail(label)


func _input_smoke_fail(label: String) -> void:
	_input_smoke_failures += 1
	printerr("  FAIL - input smoke: ", label)


func _finish_input_smoke() -> void:
	if _input_smoke_failures == 0:
		print("PVLDS INPUT SMOKE: PASS")
		get_tree().quit(0)
	else:
		printerr("PVLDS INPUT SMOKE: FAIL (%d)" % _input_smoke_failures)
		get_tree().quit(1)


func _input_wait_frames(n: int) -> void:
	for i: int in range(n):
		await get_tree().process_frame


## The panel standing at an exact grid place, or null.
func _input_panel_at(col: int, band: int) -> ClickableQuad:
	if _room == null:
		return null
	for i: int in range(_room._panels.size()):
		if _room._grid_coord(i) == Vector2i(col, band):
			return _room._panels[i]
	return null


## The panel in a column whose band is nearest the preferred
## band (the trigger landing rule's own shape, mirrored for
## seating and for expected landings).
func _input_panel_in_column(col: int, pref_band: int) -> ClickableQuad:
	if _room == null:
		return null
	var best: ClickableQuad = null
	var best_d: int = 999
	for i: int in range(_room._panels.size()):
		var c: Vector2i = _room._grid_coord(i)
		if c.x != col:
			continue
		var d: int = absi(c.y - pref_band)
		if d < best_d:
			best_d = d
			best = _room._panels[i]
	return best


## Feed one joypad axis value through the Input singleton
## (the trigger / stick feeds): set, a few frames, and (for
## the caller) release is a second call at 0.0.
func _input_feed_axis(axis: JoyAxis, value: float) -> void:
	var ev: InputEventJoypadMotion = InputEventJoypadMotion.new()
	ev.device = 0
	ev.axis = axis
	ev.axis_value = value
	Input.parse_input_event(ev)
	await _input_wait_frames(3)


## D-pad Right in the standing context must perform BACK:
## in every wall context BACK is the rail EXIT path, so the
## witness is exit_requested itself, caught by a probe (the
## boot survives its own proof). The handler is restored
## before the assertion, whatever it says.
func _input_expect_dpad_right_back(context: String) -> void:
	_input_exit_fired = false
	var probe: Callable = func() -> void: _input_exit_fired = true
	_room.exit_requested.disconnect(Callable(self, "_on_exit_requested"))
	_room.exit_requested.connect(probe)
	await _nav_feed_button(JOY_BUTTON_DPAD_RIGHT)
	_room.exit_requested.disconnect(probe)
	_room.exit_requested.connect(Callable(self, "_on_exit_requested"))
	_input_expect(_input_exit_fired,
		"dpad-back %s: D-pad Right performs BACK (the exit path fires)" % context)



## One D-pad press against a held focus: the nuke's leg
## shape, shared by every context below.
func _input_expect_no_move(btn: JoyButton, btn_name: String, context: String, held: ClickableQuad) -> void:
	await _nav_feed_button(btn)
	_input_expect(_room.focused_quad() == held,
		"dpad-nuke %s: D-pad %s produces no focus movement" % [context, btn_name])


## The D-pad nuke legs (GRADFIX10 item 5): in every view,
## D-pad Left/Up/Down - fed as real InputEventJoypadButton
## events - produce NO focus movement, while the stick
## still moves focus and D-pad Right still performs BACK.
## Under PVLDS_INPUT_NC=dpadmove the room restores the old
## binding and these legs fail by name.
func _input_legs_async() -> void:
	# ---- library wall ----
	var cols: int = _room._columns
	var start: ClickableQuad = _input_panel_at(clampi(1, 0, maxi(0, cols - 1)), 1)
	if start == null:
		_input_smoke_fail("dpad-nuke library: no mid-wall start panel to seat")
		_input_done = true
		return
	_room._set_focused(start)
	await _input_wait_frames(4)
	await _input_expect_no_move(JOY_BUTTON_DPAD_LEFT, "LEFT", "library", start)
	await _input_expect_no_move(JOY_BUTTON_DPAD_UP, "UP", "library", start)
	await _input_expect_no_move(JOY_BUTTON_DPAD_DOWN, "DOWN", "library", start)
	# The stick is the surviving directional navigation.
	await _input_wait_frames(20) ## the stick step's cooldown (0.24 s) must not gate the guard leg
	await _input_feed_axis(JOY_AXIS_LEFT_X, -1.0)
	_input_expect(_room.focused_quad() == _input_panel_at(0, 1),
		"stick guard library: the left stick still moves focus (D-pad's replacement lives)")
	await _input_feed_axis(JOY_AXIS_LEFT_X, 0.0)
	_room._set_focused(start)
	await _input_wait_frames(4)
	await _input_expect_dpad_right_back("library")
	# ---- control rail ----
	var rail_stop: ClickableQuad = _room.rail_quad("sort")
	_room._set_focused(rail_stop)
	await _input_wait_frames(4)
	await _input_expect_no_move(JOY_BUTTON_DPAD_LEFT, "LEFT", "rail", rail_stop)
	await _input_expect_no_move(JOY_BUTTON_DPAD_UP, "UP", "rail", rail_stop)
	await _input_expect_no_move(JOY_BUTTON_DPAD_DOWN, "DOWN", "rail", rail_stop)
	await _input_expect_dpad_right_back("rail")
	# ---- letter strip ----
	var strip_q: ClickableQuad = null
	for k: Variant in _room._strip_quads.keys():
		if _room.strip_slot_pickable(str(k)):
			strip_q = _room.letter_quad(str(k))
			break
	if strip_q == null:
		_input_smoke_fail("dpad-nuke strip: no pickable strip slot to seat")
	else:
		_room._set_focused(strip_q)
		await _input_wait_frames(4)
		await _input_expect_no_move(JOY_BUTTON_DPAD_LEFT, "LEFT", "strip", strip_q)
		await _input_expect_no_move(JOY_BUTTON_DPAD_UP, "UP", "strip", strip_q)
		await _input_expect_no_move(JOY_BUTTON_DPAD_DOWN, "DOWN", "strip", strip_q)
		await _input_expect_dpad_right_back("strip")
	# ---- Tournament view ----
	_room._handle_rail("tournament")
	await _input_wait_frames(10)
	if not _room.tournament_active() or _room._panels.is_empty():
		_input_smoke_fail("dpad-nuke tournament: the Tournament view never stood with a panel")
	else:
		var tpanel: ClickableQuad = _room._panels[0]
		_room._set_focused(tpanel)
		await _input_wait_frames(4)
		await _input_expect_no_move(JOY_BUTTON_DPAD_LEFT, "LEFT", "tournament", tpanel)
		await _input_expect_no_move(JOY_BUTTON_DPAD_UP, "UP", "tournament", tpanel)
		await _input_expect_no_move(JOY_BUTTON_DPAD_DOWN, "DOWN", "tournament", tpanel)
		await _input_expect_dpad_right_back("tournament")
	_room._handle_rail("filter:all")
	await _input_wait_frames(10)
	# ---- detail view ----
	_room._open_detail(_room._visible_games[0])
	await _input_wait_frames(4)
	await _nav_feed_button(JOY_BUTTON_DPAD_LEFT)
	_input_expect(_room._mode == "detail" and _room.focused_quad() == null,
		"dpad-nuke detail: D-pad LEFT produces no focus movement")
	await _nav_feed_button(JOY_BUTTON_DPAD_UP)
	_input_expect(_room._mode == "detail" and _room.focused_quad() == null,
		"dpad-nuke detail: D-pad UP produces no focus movement")
	await _nav_feed_button(JOY_BUTTON_DPAD_DOWN)
	_input_expect(_room._mode == "detail" and _room.focused_quad() == null,
		"dpad-nuke detail: D-pad DOWN produces no focus movement")
	await _input_expect_dpad_right_back("detail")
	_room._on_detail_closed()
	await _input_wait_frames(6)
	# ---- SETUP panel ----
	_room.show_setup_panel()
	await _input_wait_frames(6)
	if not _room.is_setup_panel_up():
		_input_smoke_fail("dpad-nuke setup panel: the panel never stood")
	else:
		var sp_focus: ClickableQuad = _room.focused_quad()
		await _nav_feed_button(JOY_BUTTON_DPAD_LEFT)
		_input_expect(_room.focused_quad() == sp_focus and _room.is_setup_panel_up(),
			"dpad-nuke setup panel: D-pad LEFT produces no focus movement")
		await _nav_feed_button(JOY_BUTTON_DPAD_UP)
		_input_expect(_room.focused_quad() == sp_focus and _room.is_setup_panel_up(),
			"dpad-nuke setup panel: D-pad UP produces no focus movement")
		await _nav_feed_button(JOY_BUTTON_DPAD_DOWN)
		_input_expect(_room.focused_quad() == sp_focus and _room.is_setup_panel_up(),
			"dpad-nuke setup panel: D-pad DOWN produces no focus movement")
		# BACK on the panel closes it - and never exits.
		_input_exit_fired = false
		var probe2: Callable = func() -> void: _input_exit_fired = true
		_room.exit_requested.disconnect(Callable(self, "_on_exit_requested"))
		_room.exit_requested.connect(probe2)
		await _nav_feed_button(JOY_BUTTON_DPAD_RIGHT)
		_room.exit_requested.disconnect(probe2)
		_room.exit_requested.connect(Callable(self, "_on_exit_requested"))
		_input_expect(not _room.is_setup_panel_up() and not _input_exit_fired,
			"dpad-back setup panel: D-pad Right closes the panel (BACK, not exit)")
		_input_expect(_room.focused_quad() == _room.rail_quad("desk"),
			"dpad-back setup panel: focus lands on the rail's SETUP stop")
	await _input_leg_triggers_async()
	await _input_leg_gf16_refresh_async()
	_input_done = true


## The focused panel's grid coord, or (-1, -1) when focus
## is not on a panel.
func _input_focus_coord() -> Vector2i:
	if _room == null or _room.focused_quad() == null:
		return Vector2i(-1, -1)
	var idx: int = _room._panels.find(_room.focused_quad())
	if idx < 0:
		return Vector2i(-1, -1)
	return _room._grid_coord(idx)


## The smoke's own next-anchor arithmetic (the stated rule,
## computed here from the anchor list alone): the nearest
## anchor strictly in the travel direction, wrapping to the
## far anchor when none lies that way.
func _input_next_anchor(anchors: Array[int], from_col: int, step: int) -> int:
	if step > 0:
		for a: int in anchors:
			if a > from_col:
				return a
		return anchors[0]
	for i: int in range(anchors.size() - 1, -1, -1):
		if anchors[i] < from_col:
			return anchors[i]
	return anchors[anchors.size() - 1]


## One full trigger press (cross the threshold, frames,
## release below it, frames) with the landing asserted
## against the panel the stated rule predicts: the target
## anchor column's card nearest the band focus stood on.
func _input_trigger_step(axis: JoyAxis, anchors: Array[int], step: int, label: String) -> void:
	var before: Vector2i = _input_focus_coord()
	if before.x < 0:
		_input_smoke_fail(label + " (focus was not on a panel before the press)")
		return
	var want_col: int = _input_next_anchor(anchors, before.x, step)
	var want: ClickableQuad = _input_panel_in_column(want_col, before.y)
	await _input_feed_axis(axis, 1.0)
	await _input_feed_axis(axis, 0.0)
	_input_expect(_room.focused_quad() == want and want != null,
		"%s (want column %d band-nearest %d, got coord %s)" % [label, want_col, before.y, str(_input_focus_coord())])


## The trigger wall-anchor legs (GRADFIX10 item 4): LT/RT
## cycle the entire shelf's left / middle / right anchors,
## wrapping both directions, row preserved, edge columns
## landing on their nearest band; from a non-anchor column
## the first press goes to the next anchor in its
## direction; a held trigger steps exactly once; rail and
## strip focus hop their own zones' anchors (GRADFIX14
## item 3 - see _input_leg_gf14_grammar_async, called at
## the tail of these legs); the Tournament view follows
## its stated decision (its own card columns' anchors -
## this fixture stands a single state card, so the press
## is spent there). Under PVLDS_INPUT_NC=notrig the room
## never reads the triggers and these legs fail by name.
func _input_leg_triggers_async() -> void:
	var cols: int = _room._columns
	var expected: Array[int] = []
	if cols >= 1:
		expected.append(0)
	if cols >= 2:
		var mid: int = (cols - 1) / 2
		if not expected.has(mid):
			expected.append(mid)
		if not expected.has(cols - 1):
			expected.append(cols - 1)
	var anchors: Array[int] = _room.wall_anchor_columns()
	_input_expect(anchors == expected,
		"triggers anchors: the wall anchors are the shelf's left / middle / right columns %s of %d (got %s)" % [str(expected), cols, str(anchors)])
	if anchors.size() < 3:
		_input_smoke_fail("triggers: the fixture wall has fewer than three anchors to cycle")
		return
	# The forward cycle, row preserved: seat the left anchor
	# on the bottom band - the middle anchor's column is
	# full, so band 2 must survive the first hop exactly.
	var seat: ClickableQuad = _input_panel_at(anchors[0], 2)
	if seat == null:
		_input_smoke_fail("triggers: no left-anchor bottom-band panel to seat")
		return
	_room._set_focused(seat)
	await _input_wait_frames(4)
	await _input_trigger_step(JOY_AXIS_TRIGGER_RIGHT, anchors, 1,
		"triggers RT: left anchor -> middle anchor")
	_input_expect(_input_focus_coord() == Vector2i(anchors[1], 2),
		"triggers RT: the row is preserved - the landing keeps band 2 (got %s)" % str(_input_focus_coord()))
	await _input_trigger_step(JOY_AXIS_TRIGGER_RIGHT, anchors, 1,
		"triggers RT: middle anchor -> right-end anchor (the edge column lands on its nearest band)")
	await _input_trigger_step(JOY_AXIS_TRIGGER_RIGHT, anchors, 1,
		"triggers RT: right-end anchor wraps to the left anchor")
	# The backward cycle.
	await _input_trigger_step(JOY_AXIS_TRIGGER_LEFT, anchors, -1,
		"triggers LT: left anchor wraps to the right-end anchor")
	await _input_trigger_step(JOY_AXIS_TRIGGER_LEFT, anchors, -1,
		"triggers LT: right-end anchor -> middle anchor")
	await _input_trigger_step(JOY_AXIS_TRIGGER_LEFT, anchors, -1,
		"triggers LT: middle anchor -> left anchor")
	# From a non-anchor column, both directions.
	var non_anchor: int = -1
	for c: int in range(cols):
		if not anchors.has(c):
			non_anchor = c
			break
	if non_anchor < 0:
		_input_smoke_fail("triggers: the fixture wall has no non-anchor column for the from-non-anchor legs")
	else:
		var na_seat: ClickableQuad = _input_panel_in_column(non_anchor, 1)
		_room._set_focused(na_seat)
		await _input_wait_frames(4)
		await _input_trigger_step(JOY_AXIS_TRIGGER_RIGHT, anchors, 1,
			"triggers RT: from non-anchor column %d the first press goes to the next anchor in its direction" % non_anchor)
		_room._set_focused(na_seat)
		await _input_wait_frames(4)
		await _input_trigger_step(JOY_AXIS_TRIGGER_LEFT, anchors, -1,
			"triggers LT: from non-anchor column %d the first press goes to the next anchor in its direction" % non_anchor)
	# A held trigger steps exactly once (no auto-repeat).
	_room._set_focused(_input_panel_at(anchors[0], 1))
	await _input_wait_frames(4)
	await _input_feed_axis(JOY_AXIS_TRIGGER_RIGHT, 1.0)
	await _input_wait_frames(30)
	_input_expect(_input_focus_coord().x == anchors[1],
		"triggers held: a held RT steps exactly once, to the middle anchor, and never repeats (got column %d)" % _input_focus_coord().x)
	await _input_feed_axis(JOY_AXIS_TRIGGER_RIGHT, 0.0)
	# ---- GRADFIX14 item 3: the unified travel grammar ----
	# Controls follow focus in the bar countries too. Every
	# press below rides the real poll (buttons and trigger
	# axes through the Input singleton), and the wall state
	# (centre index, page, swing target) is asserted
	# byte-identical across every bar press - nothing in
	# the bar moves the wall. The NCs key to the three
	# supersession seams: PVLDS_GF14_NC=stripanchor fails
	# the strip bumper legs, =railwall fails the rail
	# bumper legs, =bartriginert fails the trigger legs.
	await _input_leg_gf14_grammar_async()
	# Tournament view: the block's own anchors (the stated
	# decision). This fixture stands one state card in one
	# column, so the decision's degenerate case applies.
	_room._handle_rail("tournament")
	await _input_wait_frames(10)
	if not _room.tournament_active() or _room._panels.is_empty():
		_input_smoke_fail("triggers tournament: the Tournament view never stood with a panel")
	else:
		var tpanel: ClickableQuad = _room._panels[0]
		_room._set_focused(tpanel)
		await _input_wait_frames(4)
		var tanchors: Array[int] = _room.wall_anchor_columns()
		if tanchors.size() < 2:
			await _input_feed_axis(JOY_AXIS_TRIGGER_RIGHT, 1.0)
			await _input_feed_axis(JOY_AXIS_TRIGGER_RIGHT, 0.0)
			_input_expect(_room.focused_quad() == tpanel,
				"triggers tournament: a single standing card column gives the triggers nothing to cycle - the press is spent (anchors %s)" % str(tanchors))
		else:
			await _input_trigger_step(JOY_AXIS_TRIGGER_RIGHT, tanchors, 1,
				"triggers tournament: RT cycles the block's own anchors")
		# GRADFIX14: tournament bumpers step within the
		# block - one card column (the pair grid's own
		# sideways step predicts the landing; this fixture's
		# single column clamps, so the step is spent here -
		# the multi-column block is judged in the tournament
		# smoke). Never a fall-through to the library's page
		# travel.
		_room._set_focused(tpanel)
		await _input_wait_frames(4)
		var twant: int = _room._tourn_side_step(0, 1)
		await _nav_feed_button(JOY_BUTTON_RIGHT_SHOULDER)
		_input_expect(_room.focused_quad() == _room._panels[twant],
			"gf14 grammar: tournament bumpers step within the block (RB from the first card lands on the next card column's card, or clamps on a one-column block)")
	_room._handle_rail("filter:all")
	await _input_wait_frames(10)


## Wait until the named rail section's lift settles (flush
## when sink, full when not), bounded; returns the amount
## reached.
func _input_gf16_wait_lift(key: String, sink: bool) -> float:
	var amt: float = _room.rail_lift_amount(key)
	var waited: int = 0
	while waited < 180:
		amt = _room.rail_lift_amount(key)
		if sink and amt <= 0.001:
			break
		if not sink and amt >= 0.999:
			break
		await get_tree().process_frame
		waited += 1
	return amt


## The REFRESH section's rendered brightness right now:
## mean luminance over the inner half of its screen rect
## in a fresh frame grab (saved beside the log under
## PVLDS_GRAB_DIR when set). -1 when it cannot be read.
func _input_gf16_refresh_mean(tag: String) -> float:
	var img: Image = get_viewport().get_texture().get_image()
	var dir: String = OS.get_environment("PVLDS_GRAB_DIR")
	if dir != "":
		img.save_png(dir.path_join("gf16_refresh_%s.png" % tag))
	var q: ClickableQuad = _room.rail_quad("wovp_refresh")
	var cam: Camera3D = _room._active_camera()
	if q == null or cam == null or img == null or img.is_empty():
		return -1.0
	var rect: Rect2 = _nav_screen_rect(q, cam)
	var inner: Rect2 = rect.grow_individual(-rect.size.x * 0.25, -rect.size.y * 0.25, -rect.size.x * 0.25, -rect.size.y * 0.25)
	var x0: int = clampi(int(inner.position.x), 0, img.get_width() - 1)
	var y0: int = clampi(int(inner.position.y), 0, img.get_height() - 1)
	var x1: int = clampi(int(inner.position.x + inner.size.x), x0 + 1, img.get_width())
	var y1: int = clampi(int(inner.position.y + inner.size.y), y0 + 1, img.get_height())
	var sum: float = 0.0
	var n: int = 0
	var x: int = x0
	while x < x1:
		var y: int = y0
		while y < y1:
			var px: Color = img.get_pixel(x, y)
			sum += (px.r + px.g + px.b) / 3.0
			n += 1
			y += 2
		x += 2
	if n == 0:
		return -1.0
	return sum / float(n)


## The lift proof at a REFRESH landing: the spring settles
## at full lift, the section stands exactly RAIL_STRIP_LIFT
## off its seat, it is the ONLY lifted section, and the
## RENDERED frame itself brightens over the section (its
## lifted gradient and white label swap in at half-rise) -
## visible evidence, not state alone.
func _input_gf16_prove_lift(rest_mean: float) -> void:
	var amt: float = await _input_gf16_wait_lift("wovp_refresh", false)
	_input_expect(amt >= 0.999,
		"gf16 refresh: REFRESH's lift settles at full over the library wall (amount %.3f)" % amt)
	var off: Vector3 = _room.rail_lift_offset("wovp_refresh")
	_input_expect(absf(off.length() - RoomView.RAIL_STRIP_LIFT) < 0.004,
		"gf16 refresh: REFRESH stands the full strip lift off its seat (offset %.4f, want %.3f)" % [off.length(), RoomView.RAIL_STRIP_LIFT])
	var bar: Dictionary = _room.bar_state()
	_input_expect(int(bar.get("rail_lifted", 0)) == 1,
		"gf16 refresh: exactly one rail section stands lifted while REFRESH holds focus (got %d)" % int(bar.get("rail_lifted", 0)))
	var lift_mean: float = _input_gf16_refresh_mean("lifted")
	_input_expect(rest_mean >= 0.0 and lift_mean > rest_mean + 0.02,
		"gf16 refresh: the RENDERED frame shows REFRESH lifted - its section brightens as the lifted gradient swaps in (rest %.3f, lifted %.3f)" % [rest_mean, lift_mean])


## One A press on the focused REFRESH stop, witnessed by a
## probe on the room's own signal: the refresh ask fires
## and focus stays on the stop that was pressed.
func _input_gf16_press_refresh(context: String) -> void:
	_room._set_focused(_room.rail_quad("wovp_refresh"))
	await _input_wait_frames(4)
	_input_refresh_fired = false
	var probe: Callable = func() -> void: _input_refresh_fired = true
	_room.tournament_refresh_requested.connect(probe)
	await _nav_feed_button(JOY_BUTTON_A)
	_room.tournament_refresh_requested.disconnect(probe)
	_input_expect(_input_refresh_fired,
		"gf16 refresh: A on REFRESH in the %s view fires the tournament refresh ask (Main re-pulls the WoVP boards)" % context)
	_input_expect(_nav_key_of(_room.focused_quad()) == "wovp_refresh",
		"gf16 refresh: A on REFRESH in the %s view leaves focus on REFRESH (got '%s')" % [context, _nav_key_of(_room.focused_quad())])


## The GRADFIX16 item 1 legs: REFRESH is a rail stop in
## EVERY view. A focus walk through the REAL input path
## (bumper button events and stick axis feeds through the
## Input singleton, walked by the room's own poll) visits
## every rail stop in RAIL_FOCUS_ORDER order in the library
## AND in the Tournament Room, both directions; at the
## library REFRESH landing the lift is proven in the
## rendered frame; and an A press on REFRESH in both views
## fires the refresh ask. Under PVLDS_GF16_NC=refreshgate
## the shipped tournament-only gating returns and the
## library legs fail by name.
func _input_leg_gf16_refresh_async() -> void:
	var order: Array[String] = []
	order.assign(RoomView.RAIL_FOCUS_ORDER)
	_input_expect(_room.rail_quad("wovp_refresh").pick_enabled,
		"gf16 refresh: REFRESH is pickable over the library wall")
	# Rest evidence: focus parked on the first stop and the
	# REFRESH section sunk flush before its brightness is
	# sampled for the lift comparison.
	_room._set_focused(_room.rail_quad(order[0]))
	await _input_gf16_wait_lift("wovp_refresh", true)
	var rest_mean: float = _input_gf16_refresh_mean("rest")
	# The library walk: right through every stop in drawn
	# order, clamp at the end, then left all the way back.
	for i: int in range(1, order.size()):
		await _nav_feed_button(JOY_BUTTON_RIGHT_SHOULDER)
		_input_expect(_nav_key_of(_room.focused_quad()) == order[i],
			"gf16 refresh: library rail walk RB step %d lands on %s (got '%s')" % [i, order[i], _nav_key_of(_room.focused_quad())])
		if order[i] == "wovp_refresh":
			await _input_gf16_prove_lift(rest_mean)
	await _nav_feed_button(JOY_BUTTON_RIGHT_SHOULDER)
	_input_expect(_nav_key_of(_room.focused_quad()) == order[order.size() - 1],
		"gf16 refresh: library rail walk clamps at the last stop (RB on exit stays)")
	for i: int in range(order.size() - 2, -1, -1):
		await _nav_feed_button(JOY_BUTTON_LEFT_SHOULDER)
		_input_expect(_nav_key_of(_room.focused_quad()) == order[i],
			"gf16 refresh: library rail walk LB step lands on %s (got '%s')" % [order[i], _nav_key_of(_room.focused_quad())])
	# The stick admits REFRESH too: one stick step right
	# from TOURNAMENT lands on it. The feed is a human tap -
	# the axis is released the frame focus moves - because
	# at this rig's frame rate the helper's fixed 3-frame
	# hold outlives the poll's 0.24 s step cooldown and
	# would fire a second step no thumb asked for.
	_room._set_focused(_room.rail_quad("tournament"))
	await _input_wait_frames(30) ## the stick poll's step cooldown must lapse first
	var stick_ev: InputEventJoypadMotion = InputEventJoypadMotion.new()
	stick_ev.device = 0
	stick_ev.axis = JOY_AXIS_LEFT_X
	stick_ev.axis_value = 1.0
	Input.parse_input_event(stick_ev)
	var stick_guard: int = 0
	while _nav_key_of(_room.focused_quad()) == "tournament" and stick_guard < 40:
		await get_tree().process_frame
		stick_guard += 1
	var stick_rel: InputEventJoypadMotion = InputEventJoypadMotion.new()
	stick_rel.device = 0
	stick_rel.axis = JOY_AXIS_LEFT_X
	stick_rel.axis_value = 0.0
	Input.parse_input_event(stick_rel)
	await _input_wait_frames(4)
	_input_expect(_nav_key_of(_room.focused_quad()) == "wovp_refresh",
		"gf16 refresh: a stick step right from TOURNAMENT lands on REFRESH in the library (got '%s')" % _nav_key_of(_room.focused_quad()))
	await _input_gf16_press_refresh("library")
	# The Tournament Room: the same full walk, both ways.
	_room._handle_rail("tournament")
	await _input_wait_frames(10)
	_input_expect(_room.tournament_active(),
		"gf16 refresh: the Tournament Room stands for its walk")
	_room._set_focused(_room.rail_quad(order[0]))
	await _input_wait_frames(4)
	for i: int in range(1, order.size()):
		await _nav_feed_button(JOY_BUTTON_RIGHT_SHOULDER)
		_input_expect(_nav_key_of(_room.focused_quad()) == order[i],
			"gf16 refresh: tournament rail walk RB step %d lands on %s (got '%s')" % [i, order[i], _nav_key_of(_room.focused_quad())])
		if order[i] == "wovp_refresh":
			var tamt: float = await _input_gf16_wait_lift("wovp_refresh", false)
			_input_expect(tamt >= 0.999,
				"gf16 refresh: REFRESH lifts in the Tournament Room too (amount %.3f)" % tamt)
	for i: int in range(order.size() - 2, -1, -1):
		await _nav_feed_button(JOY_BUTTON_LEFT_SHOULDER)
		_input_expect(_nav_key_of(_room.focused_quad()) == order[i],
			"gf16 refresh: tournament rail walk LB step lands on %s (got '%s')" % [order[i], _nav_key_of(_room.focused_quad())])
	await _input_gf16_press_refresh("tournament")
	_room._handle_rail("filter:all")
	await _input_wait_frames(10)


## The wall state the bar grammar legs hold byte-identical:
## [centre index, page, swing target]. Rail/strip focus
## never drives the drum, so any bar press that moves one
## of these has reached across countries - the exact fault
## GRADFIX14 item 3 removes.
func _input_wall_state() -> Array:
	return [_room.centre_index(), _room._page, _room.swing_target_rad()]


func _input_wall_state_matches(state: Array) -> bool:
	return _room.centre_index() == int(state[0]) and _room._page == int(state[1]) \
		and absf(_room.swing_target_rad() - float(state[2])) < 0.0001


## The strip key of a quad, or "" when it is not a strip
## slot.
func _input_strip_key_of(q: ClickableQuad) -> String:
	if q == null or _room == null:
		return ""
	for k: Variant in _room._strip_quads.keys():
		if _room._strip_quads[k] == q:
			return str(k)
	return ""


## One trigger press with a RAIL stop focused, asserted
## against the expected landing key (the grammar's rail
## anchor hop, driven through the real axis feed).
func _input_rail_trigger_step(axis: JoyAxis, want_key: String, label: String) -> void:
	await _input_feed_axis(axis, 1.0)
	await _input_feed_axis(axis, 0.0)
	_input_expect(_nav_key_of(_room.focused_quad()) == want_key,
		"%s (want rail stop '%s', got '%s')" % [label, want_key, _nav_key_of(_room.focused_quad())])


## The GRADFIX14 grammar legs (item 3): bumpers step
## within the focused bar zone, triggers hop its anchors,
## and the wall stands byte-identical across all of it.
## Supersession seams, each failing by name under its NC:
## (a) strip bumpers anchor-hopping again
##     (PVLDS_GF14_NC=stripanchor),
## (b) rail bumpers driving the wall again (=railwall),
## (c) triggers inert in the bar again (=bartriginert).
func _input_leg_gf14_grammar_async() -> void:
	var wall0: Array = _input_wall_state()
	# -- Rail bumpers: one stop at a time, wall untouched.
	_room._set_focused(_room.rail_quad("sort"))
	await _input_wait_frames(4)
	await _nav_feed_button(JOY_BUTTON_RIGHT_SHOULDER)
	_input_expect(_nav_key_of(_room.focused_quad()) == "tournament",
		"gf14 grammar: rail bumpers step the rail one stop (RB: sort -> tournament, got '%s')" % _nav_key_of(_room.focused_quad()))
	await _nav_feed_button(JOY_BUTTON_RIGHT_SHOULDER)
	_input_expect(_nav_key_of(_room.focused_quad()) == "wovp_refresh",
		"gf14 grammar: rail bumpers step the rail one stop (RB: tournament -> wovp_refresh, REFRESH standing in the library since GRADFIX16 item 1, got '%s')" % _nav_key_of(_room.focused_quad()))
	await _nav_feed_button(JOY_BUTTON_RIGHT_SHOULDER)
	_input_expect(_nav_key_of(_room.focused_quad()) == "desk",
		"gf14 grammar: rail bumpers step the rail one stop (RB: wovp_refresh -> desk, got '%s')" % _nav_key_of(_room.focused_quad()))
	await _nav_feed_button(JOY_BUTTON_LEFT_SHOULDER)
	await _nav_feed_button(JOY_BUTTON_LEFT_SHOULDER)
	await _nav_feed_button(JOY_BUTTON_LEFT_SHOULDER)
	_input_expect(_nav_key_of(_room.focused_quad()) == "sort",
		"gf14 grammar: rail bumpers step the rail one stop (LB three times returns desk -> sort, got '%s')" % _nav_key_of(_room.focused_quad()))
	_room._set_focused(_room.rail_quad("filter:all"))
	await _input_wait_frames(4)
	await _nav_feed_button(JOY_BUTTON_LEFT_SHOULDER)
	_input_expect(_nav_key_of(_room.focused_quad()) == "filter:all",
		"gf14 grammar: rail bumpers clamp at the rail's first stop (LB on filter:all stays, got '%s')" % _nav_key_of(_room.focused_quad()))
	await _input_wait_frames(6)
	_input_expect(_input_wall_state_matches(wall0),
		"gf14 grammar: rail bumpers leave the wall byte-identical (centre index, page and swing target unmoved - no page travel from the rail)")
	# -- Rail triggers: hop the rail's anchors, wrapping,
	# wall untouched.
	_input_expect(_room.rail_anchor_keys() == ["filter:all", "filter:new", "exit"],
		"gf14 grammar: the rail anchors are first / middle / last of the live stops (got %s)" % str(_room.rail_anchor_keys()))
	_room._set_focused(_room.rail_quad("sort"))
	await _input_wait_frames(4)
	await _input_rail_trigger_step(JOY_AXIS_TRIGGER_RIGHT, "exit",
		"gf14 grammar: rail triggers hop anchors (RT from non-anchor sort goes to the nearest anchor forward, exit)")
	await _input_rail_trigger_step(JOY_AXIS_TRIGGER_RIGHT, "filter:all",
		"gf14 grammar: rail triggers hop anchors (RT on the last anchor wraps to the first, filter:all)")
	await _input_rail_trigger_step(JOY_AXIS_TRIGGER_RIGHT, "filter:new",
		"gf14 grammar: rail triggers hop anchors (RT on the first anchor advances to the middle, filter:new)")
	await _input_rail_trigger_step(JOY_AXIS_TRIGGER_LEFT, "filter:all",
		"gf14 grammar: rail triggers hop anchors (LT on the middle anchor goes back to the first, filter:all)")
	await _input_rail_trigger_step(JOY_AXIS_TRIGGER_LEFT, "exit",
		"gf14 grammar: rail triggers hop anchors (LT on the first anchor wraps to the last, exit)")
	_room._set_focused(_room.rail_quad("sort"))
	await _input_wait_frames(4)
	await _input_rail_trigger_step(JOY_AXIS_TRIGGER_LEFT, "filter:new",
		"gf14 grammar: rail triggers hop anchors (LT from non-anchor sort goes to the nearest anchor backward, filter:new)")
	# A held rail trigger hops exactly once (the press
	# semantics are the wall's, preserved).
	_room._set_focused(_room.rail_quad("filter:all"))
	await _input_wait_frames(4)
	await _input_feed_axis(JOY_AXIS_TRIGGER_RIGHT, 1.0)
	await _input_wait_frames(30)
	_input_expect(_nav_key_of(_room.focused_quad()) == "filter:new",
		"gf14 grammar: rail triggers held - a held RT hops exactly once, to the middle anchor (got '%s')" % _nav_key_of(_room.focused_quad()))
	await _input_feed_axis(JOY_AXIS_TRIGGER_RIGHT, 0.0)
	await _input_wait_frames(6)
	_input_expect(_input_wall_state_matches(wall0),
		"gf14 grammar: rail triggers leave the wall byte-identical (the hop lands ON a stop, never presses it, never moves the drum)")
	# -- Strip bumpers: one slot at a time, wall untouched.
	var keys: Array[String] = _room._strip_pickable_keys()
	_input_expect(keys.size() >= 2,
		"gf14 grammar: the fixture strip has at least two pickable slots for the bumper legs (got %s)" % str(keys))
	if keys.size() >= 2:
		_room._set_focused(_room.letter_quad(keys[0]))
		await _input_wait_frames(4)
		await _nav_feed_button(JOY_BUTTON_RIGHT_SHOULDER)
		_input_expect(_input_strip_key_of(_room.focused_quad()) == keys[1],
			"gf14 grammar: strip bumpers step one slot (RB: %s -> %s, got '%s')" % [keys[0], keys[1], _input_strip_key_of(_room.focused_quad())])
		if keys.size() >= 3:
			await _nav_feed_button(JOY_BUTTON_RIGHT_SHOULDER)
			_input_expect(_input_strip_key_of(_room.focused_quad()) == keys[2],
				"gf14 grammar: strip bumpers step one slot (RB: %s -> %s, got '%s')" % [keys[1], keys[2], _input_strip_key_of(_room.focused_quad())])
			await _nav_feed_button(JOY_BUTTON_LEFT_SHOULDER)
			_input_expect(_input_strip_key_of(_room.focused_quad()) == keys[1],
				"gf14 grammar: strip bumpers step one slot (LB: %s -> %s, got '%s')" % [keys[2], keys[1], _input_strip_key_of(_room.focused_quad())])
		_room._set_focused(_room.letter_quad(keys[0]))
		await _input_wait_frames(4)
		await _nav_feed_button(JOY_BUTTON_LEFT_SHOULDER)
		_input_expect(_input_strip_key_of(_room.focused_quad()) == keys[0],
			"gf14 grammar: strip bumpers clamp at the strip's first pickable slot (LB on %s stays)" % keys[0])
		await _input_wait_frames(6)
		_input_expect(_input_wall_state_matches(wall0),
			"gf14 grammar: strip bumpers leave the wall byte-identical (no page turn, no anchor hop)")
	# -- Strip triggers: hop the pickable anchors,
	# recomputed live, clamp law kept, wall untouched.
	if keys.size() >= 2:
		var sanchors: Array[String] = LetterIndex.anchor_keys(keys)
		_input_expect(sanchors.size() >= 2,
			"gf14 grammar: the fixture strip has at least two anchors for the trigger legs (got %s over %s)" % [str(sanchors), str(keys)])
		if sanchors.size() >= 2:
			# From a non-anchor slot with an anchor ahead:
			# the hop lands exactly on anchor_target's say.
			var probed: bool = false
			for k: String in keys:
				var t: String = LetterIndex.anchor_target(keys, k, 1)
				if t != "" and t != k:
					_room._set_focused(_room.letter_quad(k))
					await _input_wait_frames(4)
					await _input_feed_axis(JOY_AXIS_TRIGGER_RIGHT, 1.0)
					await _input_feed_axis(JOY_AXIS_TRIGGER_RIGHT, 0.0)
					_input_expect(_input_strip_key_of(_room.focused_quad()) == t,
						"gf14 grammar: strip triggers hop pickable anchors (RT from %s lands on anchor %s, got '%s')" % [k, t, _input_strip_key_of(_room.focused_quad())])
					probed = true
					break
			_input_expect(probed, "gf14 grammar: strip triggers - the fixture offered a non-anchor slot with an anchor ahead to probe")
			# The clamp law: at the far anchor the press is
			# spent, both directions.
			_room._set_focused(_room.letter_quad(sanchors[sanchors.size() - 1]))
			await _input_wait_frames(4)
			await _input_feed_axis(JOY_AXIS_TRIGGER_RIGHT, 1.0)
			await _input_feed_axis(JOY_AXIS_TRIGGER_RIGHT, 0.0)
			_input_expect(_input_strip_key_of(_room.focused_quad()) == sanchors[sanchors.size() - 1],
				"gf14 grammar: strip triggers clamp at the last anchor (RT on %s stays - no wrap, the strip's clamp law)" % sanchors[sanchors.size() - 1])
			_room._set_focused(_room.letter_quad(sanchors[0]))
			await _input_wait_frames(4)
			await _input_feed_axis(JOY_AXIS_TRIGGER_LEFT, 1.0)
			await _input_feed_axis(JOY_AXIS_TRIGGER_LEFT, 0.0)
			_input_expect(_input_strip_key_of(_room.focused_quad()) == sanchors[0],
				"gf14 grammar: strip triggers clamp at the first anchor (LT on %s stays)" % sanchors[0])
			await _input_wait_frames(6)
			_input_expect(_input_wall_state_matches(wall0),
				"gf14 grammar: strip triggers leave the wall byte-identical (the hop lands on a slot, the drum never turns)")


## The rail key a quad answers to, or "" when it is not a rail
## quad (a wall panel, a Launch button, anything else).
func _nav_key_of(q: ClickableQuad) -> String:
	if q == null or _room == null:
		return ""
	for k: Variant in _room._rail_quads.keys():
		if _room._rail_quads[k] == q:
			return str(k)
	return ""


func _nav_leg_rail_walk() -> void:
	var order: Array[String] = [
		"filter:all", "filter:vr", "filter:favorites", "filter:recents", "filter:new",
		"sort", "tournament", "wovp_refresh", "desk", "exit"] ## GRADFIX8 (item 6): page_prev/page_next removed with the pager stops (Chris's order). GRADFIX11: filter:new walks with the rail after filter:recents (Chris's order)
	# TOURNAMENT walks with the rail always; REFRESH walks
	# too, in every view since GRADFIX16 item 1 (it was a
	# Tournament-only stop before, and this library walk
	# correctly never landed on it - Chris's field report
	# convicted exactly that).
	_room._set_focused(_room.rail_quad(order[0]))
	for i: int in range(1, order.size()):
		_room._move_focus(Vector2(1.0, 0.0))
		_nav_expect(_nav_key_of(_room.focused_quad()) == order[i],
			"rail walk right: step %d lands on %s (got '%s')" % [i, order[i], _nav_key_of(_room.focused_quad())])
	_room._move_focus(Vector2(1.0, 0.0))
	_nav_expect(_nav_key_of(_room.focused_quad()) == order[order.size() - 1],
		"rail walk right: the end of the rail holds focus")
	for i: int in range(order.size() - 2, -1, -1):
		_room._move_focus(Vector2(-1.0, 0.0))
		_nav_expect(_nav_key_of(_room.focused_quad()) == order[i],
			"rail walk left: step lands on %s (got '%s')" % [order[i], _nav_key_of(_room.focused_quad())])
	_room._move_focus(Vector2(-1.0, 0.0))
	_nav_expect(_nav_key_of(_room.focused_quad()) == order[0],
		"rail walk left: the start of the rail holds focus")


func _nav_leg_up_down() -> void:
	for key: String in ["sort", "filter:favorites", "desk"]:
		_room._set_focused(_room.rail_quad(key))
		_room._move_focus(Vector2(0.0, -1.0))
		var up: ClickableQuad = _room.focused_quad()
		_nav_expect(up != null and (_room._panels.has(up) or _room._panel_launches.has(up)),
			"up from %s enters the card grid" % key)
		var back: bool = false
		for press: int in range(3):
			_room._move_focus(Vector2(0.0, 1.0))
			var f: ClickableQuad = _room.focused_quad()
			if f != null and _nav_key_of(f) != "":
				back = true
				break
			_nav_expect(f != null and (_room._panels.has(f) or _room._panel_launches.has(f)),
				"down from the grid stays in the grid until the rail (from %s)" % key)
		_nav_expect(back, "down from the grid's bottom row returns to the rail (from %s)" % key)


## Leg 6a (the cards-only focus contract): the wall-mode
## focusable set holds NO Launch button - focus visits cards
## and rail stops only - and a DOWN walk down one column
## visits exactly that column's three row panels in order
## before the next DOWN lands on the rail. (The launch half
## of the leg is async; see _nav_leg_y_launch_async.)
func _nav_leg_cards_only() -> void:
	_room._refresh_focusables()
	for q: ClickableQuad in _room._focusables:
		_nav_expect(not _room._panel_launches.has(q),
			"cards-only: no Launch button is a focus stop")
	var stops: int = _room._panels.size()
	for k: Variant in _room._rail_quads.keys():
		var rq: ClickableQuad = _room._rail_quads[k] as ClickableQuad
		if rq != null and rq.pick_enabled:
			stops += 1
	# The alphabet strip's lit slots are stops too (the
	# letter-jump round): greyed slots are not pickable, so
	# they are not stops - the same rule as the rail's label.
	for k: Variant in _room._strip_quads.keys():
		var sq: ClickableQuad = _room._strip_quads[k] as ClickableQuad
		if sq != null and sq.visible and sq.pick_enabled:
			stops += 1
	_nav_expect(_room._focusables.size() == stops,
		"cards-only: the focus walk is exactly the %d cards + rail stops + lit letter slots (got %d)" % [_room._panels.size(), _room._focusables.size()])
	# One column's DOWN walk: the column's three row panels
	# in order. (Graduation amendment: the flat wall's column
	# was slots 1/5/9 of a 4x3 page; the drum's grid is the
	# shelf itself - the indices come from the room's own
	# grid math, the law - DOWN walks one column's rows in
	# order - is unchanged.)
	var c0: Vector2i = _room._grid_coord(1)
	_room._set_focused(_room._panels[_room._index_at(c0.x, 0)])
	for row: int in [1, 2]:
		_room._move_focus(Vector2(0.0, 1.0))
		_nav_expect(_room.focused_quad() == _room._panels[_room._index_at(c0.x, row)],
			"cards-only: DOWN walks the column - row %d next" % row)
	_room._move_focus(Vector2(0.0, 1.0))
	_nav_expect(_nav_key_of(_room.focused_quad()) != "",
		"cards-only: DOWN from the bottom row lands on the rail, never a Launch button")


func _nav_bottom_row_panel() -> ClickableQuad:
	if _room == null or _room._panels.is_empty():
		return null
	# The drum's bottom row: the panels on the shelf's bottom
	# band (grid row 2) - the middle one stands for the row.
	var bottom: Array = []
	for i: int in range(_room._panels.size()):
		if _room._grid_coord(i).y == 2:
			bottom.append(_room._panels[i])
	if bottom.is_empty():
		return null
	return bottom[bottom.size() / 2]


## A quad's screen-space rect from its collision box's corners,
## projected through the given camera.
func _nav_screen_rect(q: ClickableQuad, cam: Camera3D) -> Rect2:
	var size: Vector2 = Vector2.ZERO
	for child: Node in q.get_children():
		var cs: CollisionShape3D = child as CollisionShape3D
		if cs != null and cs.shape is BoxShape3D:
			var bs: BoxShape3D = cs.shape as BoxShape3D
			size = Vector2(bs.size.x, bs.size.y)
			break
	var half: Vector2 = size * 0.5
	var corners: Array[Vector3] = [
		Vector3(-half.x, -half.y, 0.0), Vector3(half.x, -half.y, 0.0),
		Vector3(-half.x, half.y, 0.0), Vector3(half.x, half.y, 0.0)]
	var rect: Rect2 = Rect2(cam.unproject_position(q.global_transform * corners[0]), Vector2.ZERO)
	for c: int in range(1, corners.size()):
		rect = rect.expand(cam.unproject_position(q.global_transform * corners[c]))
	return rect


## The y of a sampled screen-space edge at screen x x,
## linearly interpolated between the samples; INF when x
## lies outside the edge's span (no overlap, no constraint).
func _nav_edge_y_at(edge: Array[Vector2], x: float) -> float:
	var best_lo: Vector2 = Vector2(INF, INF)
	var best_hi: Vector2 = Vector2(-INF, INF)
	for p: Vector2 in edge:
		if p.x <= x and p.x > best_lo.x:
			best_lo = p
		if p.x >= x and p.x < best_hi.x:
			best_hi = p
	if best_lo.x == INF or best_hi.x == -INF:
		return INF
	if best_hi.x - best_lo.x < 0.001:
		return best_lo.y
	var f: float = (x - best_lo.x) / (best_hi.x - best_lo.x)
	return lerpf(best_lo.y, best_hi.y, f)


## A quad's screen-space rect from its VISUAL face (quad_size),
## not its collision box: the pick box is deliberately generous,
## and occlusion is a fact about what is seen, not what is
## clickable. (The graduation legs measure sight, not reach.)
func _nav_visual_rect(q: ClickableQuad, cam: Camera3D) -> Rect2:
	var size: Vector2 = q.quad_size()
	var half: Vector2 = size * 0.5
	var corners: Array[Vector3] = [
		Vector3(-half.x, -half.y, 0.0), Vector3(half.x, -half.y, 0.0),
		Vector3(-half.x, half.y, 0.0), Vector3(half.x, half.y, 0.0)]
	var rect: Rect2 = Rect2(cam.unproject_position(q.global_transform * corners[0]), Vector2.ZERO)
	for c: int in range(1, corners.size()):
		rect = rect.expand(cam.unproject_position(q.global_transform * corners[c]))
	return rect


## Whether a world point projects inside the viewport (with a
## small margin): projection legs only judge what the desk
## screen can actually show - a panel outside the frustum is
## the panel-space legs' subject, not the projection's.
func _nav_on_screen(p: Vector3, cam: Camera3D) -> bool:
	if cam.is_position_behind(p):
		return false
	var s: Vector2 = cam.unproject_position(p)
	var vp: Vector2 = cam.get_viewport().get_visible_rect().size
	return s.x > -60.0 and s.y > -60.0 and s.x < vp.x + 60.0 and s.y < vp.y + 60.0


func _nav_leg_clearance(popped_only: bool) -> void:
	var cam: Camera3D = _room._desk_camera
	if cam == null:
		_nav_smoke_fail("clearance: no desk camera")
		return
	# GRADFIX13 (item 2): the Launch-clearance legs below
	# stand vacuous in the shipped build - the plinth is
	# stripped, there is no button left to clear the
	# nameplate or the rail. The strip itself is the leg
	# here: no panel carries a Launch quad at all. (Under
	# the plinth NC the buttons return and the clearance
	# legs below re-arm; this leg then fails by name.)
	if not popped_only:
		var plinths: int = 0
		for lq9: ClickableQuad in _room._panel_launches:
			if lq9 != null:
				plinths += 1
		for blq9: ClickableQuad in _room._panel_back_launches:
			if blq9 != null:
				plinths += 1
		_nav_expect(plinths == 0,
			"no launch: no card carries a Launch plinth, front or back (found %d minted)" % plinths)
	var rail_rects: Array[Rect2] = []
	for k: Variant in _room._rail_quads.keys():
		var rq: ClickableQuad = _room._rail_quads[k] as ClickableQuad
		if rq != null:
			rail_rects.append(_nav_visual_rect(rq, cam))
	var rows: int = int(ceil(float(_room._panels.size()) / float(RoomView.PAGE_COLS)))
	var first_bottom: int = (rows - 1) * RoomView.PAGE_COLS
	for i: int in range(_room._panels.size()):
		var panel: ClickableQuad = _room._panels[i]
		var launch: ClickableQuad = _room._panel_launches[i] if i < _room._panel_launches.size() else null
		if not popped_only:
			# The nameplate clearance (graduation amendment):
			# the dome face carries no baked name strip - the
			# card's name rides its 3D plate + label, and the
			# Launch button must clear THAT, in panel space
			# first (exact, camera-free), then in projection.
			# Both seats are lawful: below the plate, or at
			# the card's top when a long title's plate grows
			# down over the low seat.
			if launch != null:
				var plate: MeshInstance3D = _room._panel_plates[i] if i < _room._panel_plates.size() else null
				if plate != null and plate.visible:
					var pq: QuadMesh = plate.mesh as QuadMesh
					var psz: Vector2 = pq.size if pq != null else Vector2.ZERO
					var plate_rect: Rect2 = Rect2(
						Vector2(plate.position.x, plate.position.y) - psz * 0.5, psz)
					var btn_rect: Rect2 = Rect2(
						Vector2(launch.position.x, launch.position.y) - RoomView.PANEL_LAUNCH_SIZE * 0.5,
						RoomView.PANEL_LAUNCH_SIZE)
					_nav_expect(not plate_rect.intersects(btn_rect),
						"panel %d: Launch button clears the nameplate in panel space (btn %s, plate %s)" % [i, str(btn_rect), str(plate_rect)])
					# The projection, measured on the EDGES
					# themselves (projected AABBs of slanted
					# quads intersect in their slack corners
					# where the quads themselves never meet):
					# sample the plate's near edge and the
					# button's near edge, and require the
					# button's edge to stay on its own side of
					# the plate's, wherever their screen
					# x-ranges overlap. Off-frustum panels are
					# the panel-space check's subject alone.
					if _nav_on_screen(panel.global_position, cam):
						var low_seat: bool = launch.position.y < plate.position.y
						var plate_edge: Array[Vector2] = []
						var btn_edge: Array[Vector2] = []
						for s: int in range(5):
							var f: float = float(s) / 4.0
							var px: float = plate_rect.position.x + plate_rect.size.x * f
							var py: float = plate_rect.position.y + (0.0 if low_seat else plate_rect.size.y)
							plate_edge.append(cam.unproject_position(
								panel.global_transform * Vector3(px, py, 0.012)))
							var bx: float = -RoomView.PANEL_LAUNCH_SIZE.x * 0.5 + RoomView.PANEL_LAUNCH_SIZE.x * f
							var by: float = (RoomView.PANEL_LAUNCH_SIZE.y * 0.5) if low_seat else (-RoomView.PANEL_LAUNCH_SIZE.y * 0.5)
							btn_edge.append(cam.unproject_position(
								launch.global_transform * Vector3(bx, by, 0.0)))
						var clear: bool = true
						for be: Vector2 in btn_edge:
							# The plate's edge height at this x,
							# interpolated from its samples.
							var pe_y: float = _nav_edge_y_at(plate_edge, be.x)
							if pe_y == INF:
								continue
							if low_seat and be.y < pe_y + 1.0:
								clear = false
							if not low_seat and be.y > pe_y - 1.0:
								clear = false
						_nav_expect(clear,
							"panel %d: Launch button projects clear of the nameplate (edge-sampled)" % i)
		if _room._grid_coord(i).y != 2:
			continue
		if popped_only and panel != _nav_pop_panel:
			continue
		# The bottom band vs the rail (graduation amendment):
		# on the flat wall the whole panel had to clear the
		# rail. On the drum the rail is NEAR furniture (z
		# -1.70) in front of far cards (r 3.40) - a card's ART
		# passing behind the bar in projection is depth
		# separation, not occlusion, and the pointer ray to
		# the card passes over the bar (see the rail's seat).
		# What must never be eaten is what the player reads
		# or presses: the panel's LABEL and its Launch
		# button. Those are the targets now.
		if launch != null and _nav_on_screen(panel.global_position, cam):
			# Edge-sampled, like the nameplate leg: the
			# button's bottom edge against each rail quad's
			# top edge, wherever their screen x-ranges meet.
			# (Projected AABBs of a slanted far button and a
			# flat near quad intersect in slack corners where
			# the quads themselves never meet - and where
			# they DO meet, this still convicts.)
			var btn_edge: Array[Vector2] = []
			var lsz: Vector2 = launch.quad_size()
			for s: int in range(5):
				var f2: float = float(s) / 4.0
				btn_edge.append(cam.unproject_position(launch.global_transform * Vector3(
					-lsz.x * 0.5 + lsz.x * f2, -lsz.y * 0.5, 0.0)))
			for k2: Variant in _room._rail_quads.keys():
				var rq2: ClickableQuad = _room._rail_quads[k2] as ClickableQuad
				if rq2 == null:
					continue
				var rsz: Vector2 = rq2.quad_size()
				var rail_edge: Array[Vector2] = []
				for s2: int in range(5):
					var f3: float = float(s2) / 4.0
					rail_edge.append(cam.unproject_position(rq2.global_transform * Vector3(
						-rsz.x * 0.5 + rsz.x * f3, rsz.y * 0.5, 0.0)))
				var clear2: bool = true
				for be2: Vector2 in btn_edge:
					var re_y: float = _nav_edge_y_at(rail_edge, be2.x)
					if re_y == INF:
						continue
					if be2.y > re_y - 1.0:
						clear2 = false
				_nav_expect(clear2,
					"bottom row panel %d (panel_launch) clears rail quad %s in screen space (edge-sampled)" % [i, str(k2)])
		var label: Label3D = _room._panel_labels[i] if i < _room._panel_labels.size() else null
		if label != null and label.visible and _nav_on_screen(panel.global_position, cam):
			var lab_rect: Rect2 = _nav_aabb_screen_rect(_room.panel_label_world_aabb(i), cam)
			for r2: int in range(rail_rects.size()):
				_nav_expect(not lab_rect.intersects(rail_rects[r2]),
					"bottom row panel %d (label) clears rail quad %d in screen space" % [i, r2])


## A world AABB's screen rect, projected corner by corner.
func _nav_aabb_screen_rect(aabb: AABB, cam: Camera3D) -> Rect2:
	var pts: Array[Vector3] = []
	for sx: float in [aabb.position.x, aabb.position.x + aabb.size.x]:
		for sy: float in [aabb.position.y, aabb.position.y + aabb.size.y]:
			for sz: float in [aabb.position.z, aabb.position.z + aabb.size.z]:
				pts.append(Vector3(sx, sy, sz))
	var rect: Rect2 = Rect2(cam.unproject_position(pts[0]), Vector2.ZERO)
	for k: int in range(1, pts.size()):
		rect = rect.expand(cam.unproject_position(pts[k]))
	return rect


## Leg 4 (async - the face render awaits a frame): a title
## card's content still starts at the texture's top row.
func _nav_check_faces() -> void:
	_nav_faces_done = false
	if _scanner == null or _scanner.games.is_empty():
		_nav_smoke_fail("faces: no scanned games to render")
		_nav_faces_done = true
		return
	var game: GameEntry = _scanner.games[0]
	var tex: Texture2D = await _factory.render_texture(RoomSpecs.panel_spec(game, _state), Vector2i(512, 640))
	var img: Image = tex.get_image() if tex != null else null
	if img == null or img.is_empty():
		_nav_smoke_fail("faces: the title-card render came back empty")
		_nav_faces_done = true
		return
	var bg: Color = RoomSpecs.CARD_BG
	var first_row: int = -1
	for y: int in range(img.get_height()):
		for x: int in range(0, img.get_width(), 8):
			var px: Color = img.get_pixel(x, y)
			if absf(px.r - bg.r) > 0.02 or absf(px.g - bg.g) > 0.02 or absf(px.b - bg.b) > 0.02:
				first_row = y
				break
		if first_row >= 0:
			break
	_nav_expect(first_row == 0, "faces: title card content registers at texture row 0 (got %d)" % first_row)
	_nav_faces_done = true


## Waits out the page slide a flip just started, then asserts
## the settle: the slide is over and the wall holder is back
## at EXACT rest - the focus rule's verdicts only mean
## anything on a settled wall.
func _nav_await_slide() -> void:
	var guard: int = 0
	while _room.page_slide_active() and guard < 2400:
		await get_tree().process_frame
		guard += 1
	_nav_expect(not _room.page_slide_active(), "slide: the wall settles after a flip")
	_nav_expect(_room.page_slide_yaw_deg() == 0.0,
		"slide: the wall returns to exact rest (yaw %.4f)" % _room.page_slide_yaw_deg())


## Await the drum's centre arriving at a shelf index (focus
## moves the centre on the drum - see RoomView._follow_centre)
## and the swing settling there.
func _nav_await_centre(idx: int) -> void:
	var guard: int = 0
	while _room.centre_index() != idx and guard < 2400:
		await get_tree().process_frame
		guard += 1
	_nav_expect(_room.centre_index() == idx, "centre arrives at shelf index %d" % idx)
	await _nav_await_slide()


## The swing's choreography proof, run on the bumper leg's
## first flip (graduation amendment): the flat wall swapped
## pages at a slide's far point; the drum has no swap - the
## centre commits at the press and the drum GLIDES to it.
## The proof's surviving intents: the travel is a glide, not
## a cut (the drum stands off rest mid-swing and settles at
## EXACT rest); the furniture never pops (every rail quad
## wears a real texture at the press frame itself, the rail
## being persistent); and the centre the press chose is the
## centre the drum lands on.
func _nav_flip_proof(step: int) -> void:
	var centre_before: int = _room.centre_index()
	_room._bumper_page(step)
	for k: Variant in _room._rail_quads.keys():
		var rq: ClickableQuad = _room._rail_quads[k] as ClickableQuad
		var tx: Texture2D = null
		if rq != null:
			tx = rq.current_texture()
		_nav_expect(tx != null and tx.get_width() > 4,
			"rail: %s wears a real texture on the flip's press frame" % str(k))
	var peak: float = 0.0
	var guard: int = 0
	while _room.page_slide_active() and guard < 2400:
		await get_tree().process_frame
		guard += 1
		peak = maxf(peak, absf(_room.page_slide_yaw_deg()))
	_nav_expect(peak > 1.0, "swing: the drum leaves rest mid-glide (peak deviation %.2f deg)" % peak)
	_nav_expect(not _room.page_slide_active(), "swing: the drum settles after the proof flip")
	_nav_expect(_room.page_slide_yaw_deg() == 0.0,
		"swing: the drum returns to exact rest after the proof flip")
	_nav_expect(_room.centre_index() != centre_before or step == 0,
		"swing: the press moved the centre")


## Leg 5: bumper page travel, driven through RoomView's
## _bumper_page - the same call the pad poll makes on a fresh
## shoulder edge - so the state gating (load wait, placard,
## detail view) is exercised exactly as the room enforces it.
## The harness library spans three pages on ALL (full, full,
## one-panel short), pinned by run_nav_smoke.sh's stub count.
##
## Graduation amendment: on the drum a "page" is a
## bookkeeping unit (12 shelf indices; the rail's readout
## derives from the centre), and the bumper law is the
## shelf's: a focused panel travels one page of shelf FROM
## ITSELF (index +/- PAGE_SIZE, clamped to the shelf's ends)
## and the centre lands on it; a focused rail stop steps
## one stop along the rail and the wall does not move
## (GRADFIX14 item 3 - the shipped law kept the stop and
## jumped the centre a page); no focus lands on the
## new page's first panel. The leg drives to known centres
## first (focus moves the drum now), because earlier legs
## leave the centre where their browsing left it.
func _nav_leg_bumpers_async() -> void:
	var pages: int = _room.page_count()
	_nav_expect(pages >= 3, "bumpers: the harness library spans at least 3 pages (got %d)" % pages)
	if pages < 2 or _room._visible_games.is_empty():
		_nav_bumpers_done = true
		return
	var filter0: String = _room._filter
	var sort0: String = _room._sort
	var last_idx: int = _room._visible_games.size() - 1
	# Drive to a known shelf place: focus panel 5, centre follows.
	_room._set_focused(_room._panels[5])
	await _nav_await_centre(5)
	_nav_expect(_room._page == 0, "bumpers: the leg starts at the shelf's head (page 1)")
	# Travel, focus riding one page of shelf from itself.
	# The first flip carries the swing's choreography proof.
	await _nav_flip_proof(1)
	_nav_expect(_room.centre_index() == 17 and _room._page == 1, "bumpers: RB advances a page of shelf")
	_nav_expect(_room.focused_quad() == _room._panels[17],
		"bumpers: focus lands a page of shelf from itself across the flip")
	_room._bumper_page(1)
	await _nav_await_slide()
	_nav_expect(_room.centre_index() == last_idx and _room._page == pages - 1, "bumpers: RB advances to the last page")
	_nav_expect(_room.focused_quad() == _room._panels[last_idx],
		"bumpers: the short last page clamps focus to its last panel")
	# Clamped at the far end: no wrap, focus instance untouched.
	var held: ClickableQuad = _room.focused_quad()
	_room._bumper_page(1)
	_nav_expect(_room.centre_index() == last_idx and _room._page == pages - 1, "bumpers: RB clamps on the last page (no wrap)")
	_nav_expect(_room.focused_quad() == held, "bumpers: a clamped RB leaves focus untouched")
	_room._bumper_page(-1)
	await _nav_await_slide()
	_nav_expect(_room.centre_index() == last_idx - 12 and _room._page == pages - 2, "bumpers: LB retreats a page")
	_room._bumper_page(-1)
	await _nav_await_slide()
	_nav_expect(_room.centre_index() == 0 and _room._page == 0, "bumpers: LB retreats to page 1")
	held = _room.focused_quad()
	_room._bumper_page(-1)
	_nav_expect(_room._page == 0, "bumpers: LB clamps on page 1 (no wrap)")
	_nav_expect(_room.focused_quad() == held, "bumpers: a clamped LB leaves focus untouched")
	_nav_expect(_room._filter == filter0 and _room._sort == sort0,
		"bumpers: page travel leaves filter and sort alone")
	# GRADFIX14 (item 3, supersession (b)): a bumper with a
	# rail stop focused steps the RAIL one stop and the
	# wall does not move at all - the shipped law kept the
	# stop and jumped the centre a page from here. Under
	# PVLDS_GF14_NC=railwall these legs fail by name.
	var rail_centre0: int = _room.centre_index()
	var rail_target0: float = _room.swing_target_rad()
	_room._set_focused(_room.rail_quad("sort"))
	_room._bumper_page(1)
	await _nav_await_slide()
	_nav_expect(_nav_key_of(_room.focused_quad()) == "tournament" and _room.centre_index() == rail_centre0 and _room._page == 0 and absf(_room.swing_target_rad() - rail_target0) < 0.0001,
		"gf14 grammar: rail bumpers step the rail one stop (sort -> tournament) and the wall does not move (centre, page and swing target unmoved)")
	_room._bumper_page(-1)
	await _nav_await_slide()
	_nav_expect(_nav_key_of(_room.focused_quad()) == "sort" and _room.centre_index() == rail_centre0 and _room._page == 0,
		"gf14 grammar: rail bumpers step the rail one stop back (tournament -> sort), wall still unmoved")
	# No focus lands on the new page's first panel.
	_room._set_focused(null)
	_room._bumper_page(1)
	await _nav_await_slide()
	_nav_expect(_room.centre_index() == 12 and _room._page == 1 and _room.focused_quad() == _room._panels[12],
		"bumpers: no focus lands on the new page's first panel")
	_room._bumper_page(-1)
	await _nav_await_slide()
	# Inert while the SETUP placard stands.
	_room.show_setup_placard("nav smoke")
	_room._bumper_page(1)
	_room._bumper_page(-1)
	_nav_expect(_room._page == 0, "bumpers: inert while the SETUP placard stands")
	_room.clear_setup_placard()
	# Inert in the detail view.
	var game: GameEntry = _room._visible_games[0]
	_room._open_detail(game)
	_room._bumper_page(1)
	_nav_expect(_room._mode == "detail" and _room._page == 0,
		"bumpers: inert in the detail view")
	_room._on_detail_closed()
	# Inert during the load wait. begin_launch is driven
	# directly: no launch was requested, so Main's hand-off
	# poll (which keys off a real spawn) never engages.
	_room.begin_launch(game)
	_room._bumper_page(1)
	_room._bumper_page(-1)
	_nav_expect(_room._page == 0 and _room.is_launch_in_wait(),
		"bumpers: inert during the load wait")
	_room.end_launch_failed(game, "nav smoke")
	_nav_expect(_room._page == 0 and _room._filter == filter0,
		"bumpers: the leg leaves the wall on page 1, filter untouched")
	_nav_bumpers_done = true


## Feeds one synthetic gamepad press through the Input
## singleton (the dpadexit smoke's feed), so the room's own
## _process poll reads the edge - the shipping input path is
## what the Y leg exercises, not a direct call. Press, two
## frames, release, two frames: the release matters, because
## the room's edge tracking keys off the poll seeing the
## button up again before the next press can count.
## The B exit (GRADFIX4 item 4, async): in the Tournament
## view, B returns to Table Select. B was unassigned in the
## room's wall mode before BACKSTEP (it served only the
## detail escape and the SETUP panel's close); the leg
## enters the Tournament view on the rail stop, feeds a real
## B press through the pad poll, and judges the landing.
## FOCUSFIX rewrote the landing: focus seats on the library
## wall's centred card (it used to rest on the bar's
## tournament stop while the top-left card stood popped -
## the drawn/real divergence Chris reported, 2026-11-06).
## BACKSTEP (2026-11-07) supersedes the leg's old second
## half ("a second B in the library does nothing"): B is
## BACK in the library now, so standing on the ALL wall the
## second press runs the exit - witnessed by a probe on
## exit_requested, the input smoke's pattern, so the boot
## survives its own proof. Under PVLDS_B_NC=nobexit the
## tournament press does nothing and the leg fails by name.
func _nav_leg_b_exit_async() -> void:
	_room._handle_rail("tournament")
	_nav_expect(_room.tournament_active(), "B exit: the TOURNAMENT stop raises the Tournament view")
	await _nav_feed_button(JOY_BUTTON_B)
	_nav_expect(not _room.tournament_active(),
		"B exit: B in the Tournament view returns to Table Select")
	_nav_expect(_room.focused_quad() != null and _room.focused_quad() == _room._panels[_room.centre_index()],
		"B exit: focus lands on the library wall's centred card")
	# BACKSTEP: the second B, in Table Select on the ALL
	# wall, is BACK - it runs the exit. (The pre-BACKSTEP
	# contract, "B in Table Select does nothing", is retired
	# by Chris's ruling; the filter-step half of the new law
	# is the backstep smoke's own legs.) The exit is caught
	# by a probe so the boot survives to finish the leg.
	_room._handle_rail("filter:all")
	_input_exit_fired = false
	var probe: Callable = func() -> void: _input_exit_fired = true
	_room.exit_requested.disconnect(Callable(self, "_on_exit_requested"))
	_room.exit_requested.connect(probe)
	await _nav_feed_button(JOY_BUTTON_B)
	_room.exit_requested.disconnect(probe)
	_room.exit_requested.connect(Callable(self, "_on_exit_requested"))
	_nav_expect(_input_exit_fired,
		"B exit: B in Table Select performs BACK (the exit path fires from the ALL wall)")
	_nav_b_done = true


## Leg 9 (GRADFIX13 item 4): THE VERTICAL WALL LAW - a
## purely vertical focus change between the rail and the
## card rows, either direction, NEVER changes the drum's
## seated column (the room states the law and the ascent
## landing rule at RoomView._ascend_to_rows). The leg is
## async by necessity: the convicted wall move is not the
## press itself but _follow_centre acting on the landing
## over the frames AFTER it, so every press here is
## followed by real frames before the verdict - a
## synchronous assert would pass trivially even under the
## NC. From every rail stop: UP must land exactly on the
## centre panel (the centre column's card on the centre
## band) with the centre index and the swing target yaw
## untouched; DOWN must return to the rail with the seated
## column and target still untouched. Seat variants: the
## centre standing on the bottom band, and the centre on
## the shelf's partial last column (its one card takes the
## landing - the column never yields to a neighbour). The
## strip path (strip -> rail -> rows and back down) rides
## the same assertions. wovp_refresh's round trip runs
## inside the Tournament view AND again in the library
## loop below (it is pickable in both since GRADFIX16
## item 1). Under PVLDS_GF13_NC=oldascent the ascent
## falls back to the projection walk, focus lands a column
## off centre, _follow_centre re-seats the drum - and
## these legs fail by name.
func _nav_leg_vertical_async() -> void:
	# Order note: the Tournament round trips run FIRST and
	# the partial-last-column seat LAST. This box's GLES3
	# teardown-class heap aborts strike late in long nav
	# runs (base d156f42 dies the same death in its phase
	# 7), and the far-end seat - a full-shelf swing plus the
	# centred card's power-on mimic starting - is the
	# heaviest moment in the leg; everything else must have
	# reported before the leg walks out there.
	# wovp_refresh, inside the Tournament view first (its
	# library round trip rides the main loop below).
	_room._handle_rail("tournament")
	await _nav_await_ready()
	if not _room.tournament_active() or _room._panels.is_empty():
		_nav_smoke_fail("vertical wall law: the Tournament view never stood for the wovp_refresh leg")
	else:
		_room._set_focused(_room._panels[0])
		await _nav_await_centre(0)
		await _nav_vertical_stop("wovp_refresh")
		await _nav_vertical_stop("tournament")
	_room._handle_rail("filter:all")
	await _nav_await_ready()
	# Seat the centre on a known middle-band panel.
	var seat_idx: int = _room._index_at(4, 1)
	_room._set_focused(_room._panels[seat_idx])
	await _nav_await_centre(seat_idx)
	for key: String in RoomView.RAIL_FOCUS_ORDER:
		await _nav_vertical_stop(key) ## wovp_refresh included: a library stop since GRADFIX16 item 1, judged in the Tournament view above as well
	# Seat variant: the centre standing on the bottom band -
	# the ascent must land on THAT band's card.
	var low_idx: int = _room._index_at(4, 2)
	_room._set_focused(_room._panels[low_idx])
	await _nav_await_centre(low_idx)
	await _nav_vertical_stop("sort")
	# The letter strip's path, up and back down.
	await _nav_vertical_strip()
	# Seat variant, last: the centre on the partial last
	# column (the fixture's last column holds a single
	# card - the landing is that column's card; the column
	# never yields to a neighbour).
	var last_idx: int = _room._panels.size() - 1
	_room._set_focused(_room._panels[last_idx])
	await _nav_await_centre(last_idx)
	await _nav_vertical_stop("sort")
	_nav_vertical_done = true


## One rail stop's vertical-law round trip (see
## _nav_leg_vertical_async): the ascent's landing asserted
## exactly - the centre panel itself - and the seated
## column + swing target asserted identical across the
## ascent and across the whole round trip.
func _nav_vertical_stop(key: String) -> void:
	var stop: ClickableQuad = _room.rail_quad(key)
	if stop == null or not stop.pick_enabled:
		_nav_smoke_fail("vertical wall law: rail stop %s is not standing/pickable in this view" % key)
		return
	var centre_idx: int = _room.centre_index()
	var centre_panel: ClickableQuad = _room._panels[centre_idx]
	var centre_col: int = _room._grid_coord(centre_idx).x
	var target0: float = _room.swing_target_rad()
	_room._set_focused(stop)
	for i: int in range(3):
		await get_tree().process_frame
	_nav_expect(_room.centre_index() == centre_idx and absf(_room.swing_target_rad() - target0) < 0.0001,
		"vertical wall law: focusing rail stop %s leaves the wall seated" % key)
	_room._move_focus(Vector2(0.0, -1.0))
	for i: int in range(6):
		await get_tree().process_frame
	_nav_expect(_room.focused_quad() == centre_panel,
		"vertical wall law: UP from %s lands on the centre column's card on the centre band" % key)
	_nav_expect(_room.centre_index() == centre_idx,
		"vertical wall law: UP from %s leaves the centre index seated" % key)
	_nav_expect(absf(_room.swing_target_rad() - target0) < 0.0001,
		"vertical wall law: UP from %s leaves the swing target unmoved" % key)
	# Back down: within-column band steps first when the
	# centre band is not the bottom, then the descent edge.
	var back: bool = false
	for press: int in range(3):
		_room._move_focus(Vector2(0.0, 1.0))
		for i: int in range(4):
			await get_tree().process_frame
		if _nav_key_of(_room.focused_quad()) != "":
			back = true
			break
	_nav_expect(back, "vertical wall law: DOWN from the rows returns to the rail (from %s)" % key)
	_nav_expect(_room._grid_coord(_room.centre_index()).x == centre_col and absf(_room.swing_target_rad() - target0) < 0.0001,
		"vertical wall law: the round trip from %s leaves the drum's seated column unchanged" % key)


## The strip's vertical-law round trip: strip -> rail ->
## rows, then back down rows -> rail -> strip, with the
## seated column and the swing target asserted unmoved at
## every rung (the ascent's landing is the centre card,
## exactly as from any rail stop).
func _nav_vertical_strip() -> void:
	var strip_q: ClickableQuad = null
	for k: Variant in _room._strip_quads.keys():
		if _room.strip_slot_pickable(str(k)):
			strip_q = _room.letter_quad(str(k))
			break
	if strip_q == null:
		_nav_smoke_fail("vertical wall law: no pickable strip slot for the strip path leg")
		return
	var centre_idx: int = _room.centre_index()
	var centre_col: int = _room._grid_coord(centre_idx).x
	var target0: float = _room.swing_target_rad()
	_room._set_focused(strip_q)
	for i: int in range(3):
		await get_tree().process_frame
	_room._move_focus(Vector2(0.0, -1.0))
	for i: int in range(6):
		await get_tree().process_frame
	_nav_expect(_nav_key_of(_room.focused_quad()) != "",
		"vertical wall law: UP from the strip lands on the rail")
	_nav_expect(_room._grid_coord(_room.centre_index()).x == centre_col and absf(_room.swing_target_rad() - target0) < 0.0001,
		"vertical wall law: strip -> rail leaves the drum's seated column unchanged")
	_room._move_focus(Vector2(0.0, -1.0))
	for i: int in range(6):
		await get_tree().process_frame
	_nav_expect(_room.focused_quad() == _room._panels[_room.centre_index()],
		"vertical wall law: rail -> rows after the strip lands on the centre card")
	_nav_expect(_room.centre_index() == centre_idx and absf(_room.swing_target_rad() - target0) < 0.0001,
		"vertical wall law: strip -> rail -> rows leaves the drum's seated column unchanged")
	var back_rail: bool = false
	for press: int in range(3):
		_room._move_focus(Vector2(0.0, 1.0))
		for i: int in range(4):
			await get_tree().process_frame
		if _nav_key_of(_room.focused_quad()) != "":
			back_rail = true
			break
	_nav_expect(back_rail, "vertical wall law: DOWN from the rows returns to the rail (strip path)")
	_room._move_focus(Vector2(0.0, 1.0))
	for i: int in range(6):
		await get_tree().process_frame
	_nav_expect(_room._is_strip_quad(_room.focused_quad()),
		"vertical wall law: DOWN from the rail returns to the strip")
	_nav_expect(_room._grid_coord(_room.centre_index()).x == centre_col and absf(_room.swing_target_rad() - target0) < 0.0001,
		"vertical wall law: the strip round trip leaves the drum's seated column unchanged")


func _nav_feed_button(btn: JoyButton) -> void:
	var press: InputEventJoypadButton = InputEventJoypadButton.new()
	press.device = 0
	press.button_index = btn
	press.pressed = true
	Input.parse_input_event(press)
	await get_tree().process_frame
	await get_tree().process_frame
	var rel: InputEventJoypadButton = InputEventJoypadButton.new()
	rel.device = 0
	rel.button_index = btn
	rel.pressed = false
	Input.parse_input_event(rel)
	await get_tree().process_frame
	await get_tree().process_frame


