## SCOREMARK smoke (--pvlds-smoke-scoremark): the front
## marks, judged on the RENDERED faces of the 5-game
## PINemHi fixture library (the ONETEN install: Apollo 13
## Personal+Best, Congo Personal+Best+PuP, Beetlejuice
## Personal+Best, Johnny Mnemonic Best ONLY, Indiana
## Jones neither; the runner's sixth table file stands as
## an unmatched local game and is not a target). The
## faces are panel kind on this harness (no downloadable
## art), so the mark's standing citizen is the PINemHi
## chip - judged by its band-colour pixels on the
## bound texture; the art citizen (the wordmark badge,
## MARKWORD - it replaced the "#1" medallion, which
## misread as a ranking) is judged on faces rendered
## through the room's own factory from the room's own
## flag, at wall size and at the detail size, by its
## ground + word pixels AND by the badge label's own
## state in the render path (the word reads "PINemHi",
## exact capitalization - no OCR); the detail view's
## inheritance is judged on its standing big face; and a
## heal leg pushes new rows at the standing room - a
## first score for Indy raises its mark, Apollo's rows
## leaving drops its mark, no rescan anywhere. Under
## PVLDS_SCOREMARK_NC=bestkey the flag keys on the Best
## rows, so Johnny gains a mark and the semantic legs
## fail by name; under =ghostmark every game is marked
## and the scoreless legs fail; under
## PVLDS_MARKWORD_NC=hash1 the "#1" glyph stands again
## and the wordmark legs fail by name.
const SM_TARGETS: Dictionary = {
	"dhgyex0l": true, # Apollo 13 - Personal (the real file) + Best
	"0-GeiE03": true, # Congo - Personal + Best, PuP
	"1vJ_ZQYe": true, # Beetlejuice - Personal (a full 10) + Best
	"-SbeVjPA": false, # Johnny Mnemonic - a Best file ONLY: NO mark (the semantic leg)
	"lkSumsrF": false, # Indiana Jones - no PINemHi files at all
}


func _sm_expect(cond: bool, label: String) -> void:
	if cond:
		print("  ok - scoremark smoke: ", label)
	else:
		_sm_failures += 1
		printerr("FAIL - scoremark smoke: ", label)


func _sm_game(game_id: String) -> GameEntry:
	if _room == null:
		return null
	for gv: Variant in _room._visible_games:
		var ge: GameEntry = gv as GameEntry
		if ge != null and ge.game_id == game_id:
			return ge
	return null


func _sm_visible_idx(game_id: String) -> int:
	if _room == null:
		return -1
	for i: int in range(_room._visible_games.size()):
		if (_room._visible_games[i] as GameEntry).game_id == game_id:
			return i
	return -1


func _sm_near(c: Color, target: Color, tol: float) -> bool:
	return absf(c.r - target.r) <= tol and absf(c.g - target.g) <= tol \
		and absf(c.b - target.b) <= tol and c.a >= 0.9


## The longest horizontal run of near-target pixels in a
## row band of the image - a chip's ground is one flat run.
func _sm_max_run(img: Image, y0: int, y1: int, target: Color, tol: float) -> int:
	var best: int = 0
	var w: int = img.get_width()
	for y: int in range(y0, mini(y1, img.get_height())):
		var run: int = 0
		for x: int in range(w):
			if _sm_near(img.get_pixel(x, y), target, tol):
				run += 1
				best = maxi(best, run)
			else:
				run = 0
	return best


func _sm_count_in(img: Image, rect: Rect2i, target: Color, tol: float) -> int:
	var n: int = 0
	for y: int in range(rect.position.y, mini(rect.end.y, img.get_height())):
		for x: int in range(rect.position.x, mini(rect.end.x, img.get_width())):
			if _sm_near(img.get_pixel(x, y), target, tol):
				n += 1
	return n


## One standing wall face: its face key's pmh segment and
## its rendered chip, judged against the fixture truth.
func _sm_judge_standing(game_id: String, marked: bool) -> void:
	var game: GameEntry = _sm_game(game_id)
	var idx: int = _sm_visible_idx(game_id)
	if game == null or idx < 0:
		_sm_expect(false, "fixture game %s never stood on the wall" % game_id)
		return
	var key: String = str(_room._panel_face_key.get(game_id, ""))
	_sm_expect(key.ends_with("|pmh") == marked,
		"the standing face key of %s %s the pmh segment (key '%s')" % [game.title, "carries" if marked else "carries NO", key])
	var tex: Texture2D = (_room._panels[idx] as ClickableQuad).current_texture()
	var img: Image = tex.get_image() if tex != null else null
	_sm_expect(img != null and not img.is_empty(), "the standing face of %s reads as an image" % game.title)
	if img == null or img.is_empty():
		return
	# The chips band (below the maker band, above the
	# file line): the PINemHi chip's ground is the
	# game's band colour - one flat run when it stands.
	var run: int = _sm_max_run(img, 95, 430, RoomSpecs.manufacturer_color(game.manufacturer), 0.03)
	if marked:
		_sm_expect(run >= 40, "%s: the PINemHi chip stands on the rendered standing face (band-colour run %d px)" % [game.title, run])
	else:
		_sm_expect(run < 40, "%s: NO PINemHi chip on the rendered standing face (band-colour run %d px)" % [game.title, run])


## The art citizen: each fixture game's front rendered
## through the room's factory from the room's own flag
## (Room._has_pinemhi_score - the production data path),
## at the wall size (strip suppressed) and at the detail
## size (strip standing). The wordmark badge's ground +
## word pixels judge its standing, and the badge label's
## own state on the factory's face judges the word
## itself; the renders land in the grabs dir as the
## close faces.
func _sm_judge_art() -> void:
	var art_img: Image = Image.create(496, 864, false, Image.FORMAT_RGBA8)
	art_img.fill(Color(0.32, 0.30, 0.27))
	art_img.fill_rect(Rect2i(0, 0, 496, 300), Color(0.45, 0.42, 0.38))
	art_img.fill_rect(Rect2i(0, 560, 496, 304), Color(0.22, 0.20, 0.24))
	var art_tex: Texture2D = ImageTexture.create_from_image(art_img)
	var grab_dir: String = OS.get_environment("PVLDS_SCOREMARK_GRABS")
	for game_id: Variant in SM_TARGETS.keys():
		var gid: String = str(game_id)
		var game: GameEntry = _sm_game(gid)
		if game == null:
			_sm_expect(false, "art face: fixture game %s never stood on the wall" % gid)
			continue
		var marked: bool = bool(SM_TARGETS[gid])
		var col: Color = RoomSpecs.manufacturer_color(game.manufacturer)
		var flag: bool = _room._has_pinemhi_score(game)
		_sm_expect(flag == marked, "art face: the room's mark flag for %s reads %s" % [game.title, str(marked)])
		var spec: Dictionary = RoomSpecs.art_spec(game, art_tex, _room._store, false, flag)
		var tex: Texture2D = await _room._factory.render_texture(spec, Vector2i(496, 864))
		_sm_expect(tex != null, "art face: %s renders at wall size" % game.title)
		if tex != null:
			var img: Image = tex.get_image()
			# The badge's seat (bottom-left, 14 px insets):
			# its band-colour ground in the corner rect,
			# the white word inside the badge's own rect.
			var ground: int = _sm_count_in(img, Rect2i(10, 798, 164, 56), col, 0.03)
			var word: int = _sm_count_in(img, Rect2i(24, 810, 136, 34), Color(0.98, 0.98, 1.0), 0.06)
			if marked:
				_sm_expect(ground >= 2500 and word >= 400,
					"art face: %s carries the PINemHi wordmark badge in its band colour (%d ground px, %d word px)" % [game.title, ground, word])
			else:
				_sm_expect(ground < 40 and word == 0,
					"art face: %s carries NO wordmark badge (%d ground px, %d word px)" % [game.title, ground, word])
			# The word itself, from the label's state on
			# the factory's face - the render path's own
			# witness, exact capitalization, no OCR. Under
			# PVLDS_MARKWORD_NC=hash1 the label reads "#1"
			# and this leg fails by name.
			var face: CardFace = _room._factory._face as CardFace
			_sm_expect(face != null and face._art_score.visible == marked \
					and face._art_score_label.text == "PINemHi",
				"wordmark: the art badge's label on %s's rendered face reads 'PINemHi' exactly and the badge stands %s (label '%s')" % [
					game.title, str(marked),
					face._art_score_label.text if face != null else "<no face>"])
			if grab_dir != "":
				img.save_png(grab_dir.path_join("face_" + gid + ".png"))
		var dspec: Dictionary = RoomSpecs.art_spec(game, art_tex, _room._store, true, flag)
		var dtex: Texture2D = await _room._factory.render_texture(dspec, Vector2i(640, 800))
		_sm_expect(dtex != null, "detail-size art face: %s renders" % game.title)
		if dtex != null:
			var dimg: Image = dtex.get_image()
			var dground: int = _sm_count_in(dimg, Rect2i(10, 734, 164, 56), col, 0.03)
			if marked:
				_sm_expect(dground >= 2500, "detail-size art face: %s carries the wordmark badge (%d ground px)" % [game.title, dground])
			else:
				_sm_expect(dground < 40, "detail-size art face: %s carries NO wordmark badge (%d ground px)" % [game.title, dground])
	_sm_judged = true


## The detail view's inheritance: open two games through
## the room's own door and judge the standing big face
## (either citizen counts - the flag's wiring is asserted
## beside the pixels).
func _sm_judge_detail() -> void:
	for game_id: String in ["dhgyex0l", "-SbeVjPA"]:
		var game: GameEntry = _sm_game(game_id)
		if game == null:
			_sm_expect(false, "detail: fixture game %s never stood on the wall" % game_id)
			continue
		var marked: bool = bool(SM_TARGETS[game_id])
		_room._open_detail(game)
		_sm_expect(_room._detail._scoremark == marked,
			"detail: the room handed the detail view the mark state %s for %s" % [str(marked), game.title])
		var first_tex: Texture2D = null
		var big: Texture2D = null
		for i: int in range(1200):
			await get_tree().process_frame
			var q: ClickableQuad = _room._detail._big_quad as ClickableQuad
			if q == null:
				continue
			var t: Texture2D = q.current_texture()
			if first_tex == null:
				first_tex = t
			elif t != null and t != first_tex and t.get_width() == 640:
				big = t
				break
		_sm_expect(big != null, "detail: the big face for %s rendered" % game.title)
		if big != null:
			# Let the render settle past the swap frame.
			for j: int in range(30):
				await get_tree().process_frame
			var settled: Texture2D = (_room._detail._big_quad as ClickableQuad).current_texture()
			var img: Image = (settled if settled != null else big).get_image()
			var col: Color = RoomSpecs.manufacturer_color(game.manufacturer)
			var run: int = _sm_max_run(img, 95, 430, col, 0.03)
			var badge: int = _sm_count_in(img, Rect2i(10, 734, 164, 56), col, 0.03)
			if marked:
				_sm_expect(run >= 40 or badge >= 2500,
					"detail: the detail view's front for %s carries the mark (chip run %d px, badge %d px)" % [game.title, run, badge])
			else:
				_sm_expect(run < 40 and badge < 40,
					"detail: the detail view's front for %s carries NO mark (chip run %d px, badge %d px)" % [game.title, run, badge])
			var grab_dir: String = OS.get_environment("PVLDS_SCOREMARK_GRABS")
			if grab_dir != "":
				img.save_png(grab_dir.path_join("detail_" + game_id + ".png"))
	_room._detail.handle_escape()
	_sm_judged = true


func _drive_scoremark_smoke() -> void:
	match _sm_phase:
		0:
			if _room != null and _room.visible and _room.wall_ready and _room._visible_games.size() >= SM_TARGETS.size():
				# Park the harness pointer off the wall (the
				# cardback driver's seat discipline).
				get_viewport().warp_mouse(Vector2(8.0, 592.0))
				_sm_phase = 1
				_sm_wait = 0
			else:
				_sm_wait += 1
				if _sm_wait > 7200:
					_sm_expect(false, "the room never came up on the real boot path")
					_finish_scoremark_smoke()
		1:
			for game_id: Variant in SM_TARGETS.keys():
				_sm_judge_standing(str(game_id), bool(SM_TARGETS[game_id]))
			_sm_judged = false
			_sm_judge_art()
			_sm_phase = 2
			_sm_wait = 0
		2:
			_sm_wait += 1
			if _sm_judged:
				var grab_dir: String = OS.get_environment("PVLDS_SCOREMARK_GRABS")
				if grab_dir != "":
					var wimg: Image = get_viewport().get_texture().get_image()
					wimg.save_png(grab_dir.path_join("wall.png"))
				_sm_judged = false
				_sm_judge_detail()
				_sm_phase = 3
				_sm_wait = 0
			elif _sm_wait > 3600:
				_sm_expect(false, "the art-face judging never landed")
				_finish_scoremark_smoke()
		3:
			_sm_wait += 1
			if _sm_judged:
				# The heal, first push: Indy's first score.
				var indy: GameEntry = _sm_game("lkSumsrF")
				var ikey: String = PinemhiScores.challenge_key(indy.title)
				var pushed: Dictionary = _room._pinemhi_rows.duplicate()
				pushed[ikey] = {"title": indy.title, "key": ikey, "rows": [
					{"rank": 1, "score": 424242, "score_text": "424,242", "player": "Kubrick", "when": "2026-11-07 10:00:00"}]}
				_room.set_pinemhi_rows(pushed)
				_sm_phase = 4
				_sm_wait = 0
			elif _sm_wait > 3600:
				_sm_expect(false, "the detail judging never landed")
				_finish_scoremark_smoke()
		4:
			_sm_wait += 1
			var ikey_now: String = str(_room._panel_face_key.get("lkSumsrF", ""))
			if ikey_now.ends_with("|pmh"):
				_sm_judge_standing("lkSumsrF", true)
				_sm_expect(true, "heal: a rows push adding Indiana Jones's first score raised its standing mark without a rescan")
				# The second push: Apollo's rows leave.
				var apollo: GameEntry = _sm_game("dhgyex0l")
				var akey: String = PinemhiScores.challenge_key(apollo.title)
				var pushed2: Dictionary = _room._pinemhi_rows.duplicate()
				pushed2.erase(akey)
				_room.set_pinemhi_rows(pushed2)
				_sm_phase = 5
				_sm_wait = 0
			elif _sm_wait > 1800:
				_sm_expect(false, "heal: Indy's standing mark never rose after the rows push (key '%s')" % ikey_now)
				_finish_scoremark_smoke()
		5:
			_sm_wait += 1
			var akey_now: String = str(_room._panel_face_key.get("dhgyex0l", ""))
			if not akey_now.ends_with("|pmh"):
				_sm_judge_standing("dhgyex0l", false)
				_sm_expect(true, "heal: a rows push removing Apollo 13's rows dropped its standing mark without a rescan")
				_finish_scoremark_smoke()
			elif _sm_wait > 1800:
				_sm_expect(false, "heal: Apollo's standing mark never dropped after the rows push (key '%s')" % akey_now)
				_finish_scoremark_smoke()


func _finish_scoremark_smoke() -> void:
	if _sm_done:
		return
	_sm_done = true
	if _sm_failures == 0:
		print("PVLDS SCOREMARK SMOKE: PASS")
		get_tree().quit(0)
	else:
		printerr("PVLDS SCOREMARK SMOKE: FAIL (%d)" % _sm_failures)
		get_tree().quit(1)


func _bootfocus_leg(panel: ClickableQuad) -> void:
	_bootfocus_expect(_room.focused_quad() == panel,
		"boot focus: the last-played card holds the boot focus (no input given)")
	_bootfocus_expect(panel.highlight_visible(),
		"boot focus: the boot-focused card's highlight frame shows")
	var mat: ShaderMaterial = _room._power_mat as ShaderMaterial
	var atlas: AtlasTexture = null
	if mat != null:
		atlas = mat.get_shader_parameter("face_tex") as AtlasTexture
	_bootfocus_expect(atlas != null and atlas.atlas == panel.current_texture(),
		"boot focus: the standing power overlay samples the face the card actually wears")
	var img: Image = get_viewport().get_texture().get_image()
	var dir: String = OS.get_environment("PVLDS_GRAB_DIR")
	if dir != "":
		img.save_png(dir.path_join("boot_focus.png"))
	var rect: Rect2i = _mimic_art_screen_rect(panel)
	# Judge the art's interior only: the focus frame rings the
	# rect's edge and the Launch button stands over its lower
	# rows - either would lend a flat fill a fake variance
	# (the first cut of this leg passed on exactly that).
	var inner: Rect2i = Rect2i(
		rect.position.x + rect.size.x / 4, rect.position.y,
		rect.size.x / 2, rect.size.y * 55 / 100)
	var sd: float = _bootfocus_region_stdev(img, inner)
	_bootfocus_expect(sd > 0.005,
		"boot focus: the boot-focused card's art renders its face, not a flat dark fill (interior stdev %.4f)" % sd)


## Luma stdev over a screen rect (stride 2): a flat fill -
## the placeholder, graded or not - has none; a rendered
## face (art or title card) always has some.
func _bootfocus_region_stdev(img: Image, rect: Rect2i) -> float:
	var n: int = 0
	var mean: float = 0.0
	var m2: float = 0.0
	var x: int = rect.position.x
	while x < rect.position.x + rect.size.x:
		var y: int = rect.position.y
		while y < rect.position.y + rect.size.y:
			if x >= 0 and y >= 0 and x < img.get_width() and y < img.get_height():
				var px: Color = img.get_pixel(x, y)
				var lum: float = 0.2126 * px.r + 0.7152 * px.g + 0.0722 * px.b
				n += 1
				var d1: float = lum - mean
				mean += d1 / float(n)
				m2 += d1 * (lum - mean)
			y += 2
		x += 2
	if n < 2:
		return 0.0
	return sqrt(m2 / float(n))


# -------------------------------------------------- tournament smoke

## --pvlds-smoke-tournament: the Tournament Room contract,
## against the harness's local WoVP stub (PVLDS_WOVP_BASE_URL
## - the league itself is never touched). Modes
## (PVLDS_WOVP_SMOKE_MODE):
##   full      - key in config, stub live: boards land,
##               his row renders highlighted, the not-owned
##               board cannot launch, REFRESH re-fetches,
##               the view enters/leaves without stranding
##               focus, and the SETUP panel's PASTE KEY /
##               TEST KEY work end to end. PINEMHI2: the
##               WoVP legs judge the five challenges; the
##               PINemHi weekly panels behind them are
##               judged in both of their settled shapes -
##               the one failure-state board (the harness's
##               dead weekly seam, no cache) in phase 1 and
##               the three contest boards (fixture contests
##               through Main's own push) in phases 17/18.
##   nokey     - no key in config: the view is the plain
##               "add your key in SETUP" state, not an error.
##   failfetch - key, dead base URL, no cache: the view is
##               the failure state, never boards dressed
##               as live.
##   errbody   - key, stub refuses with HTTP 400 and words
##               of its own in the body: the words, not
##               just the code, stand on the state panel
##               (the HTTP400 round's negative control - a
##               client that discards response bodies
##               fails this leg by name).
##   errempty  - key, stub refuses with HTTP 400 and an
##               empty body: the panel falls back to the
##               bare code, gracefully.
##   cache     - a second boot in a full boot's home, base
##               URL dead: the saved boards stand with their
##               stamp, stated as last-good.
##   layout    - key, stub serving the worst-case boards
##               (a 10-digit score under a 24-character name,
##               a promotion line and a cut line): a score
##               renders whole - measured, and inked to its
##               final digit - no Launch furniture stands on
##               a standing board (GRADFIX10: the footer band
##               the TR3 Launch parked in is gone; the button
##               lives on the card), and each board's content
##               ink centres on its FRAME.
##               PVLDS_BOARD_NC=oldlayout restores the
##               pre-TR3 presentation and both layout legs
##               must fail by name; PVLDS_GRADFIX10_NC=
##               deadplank restores the dead footer band and
##               the launch + frame-centred legs must fail
##               by name.
## PINEMHI2 smoke (--pvlds-smoke-pinemhi2, harness env
## PVLDS_PINEMHI2_MODE): parse - the weekly parser against
## the real captured fixtures, plus the hole-in-one shape
## and the his-name derivation; stub - the client against
## the harness's local stub (the PVLDS_PINEMHI_BASE_URL
## seam), the cache write, and the cache read back;
## cache - a boot whose fetch cannot land (a dead seam):
## the cache's boards stand, marked saved, with the
## failure recorded; room - the Tournament Room with
## fixture-backed weekly data pushed through Main's own
## door: three weekly board panels behind the WoVP rows,
## his-row accents, the WoVP boards untouched; failstate -
## no cache and the boot's own fetch failed (no seam: the
## site's own URL, unreachable from the harness box): the
## ONE plain-word failure-state board stands behind live
## WoVP boards, its face real and inked on its own panel.
## Negative controls (PVLDS_PINEMHI2_NC): stale - Main's
## push claims the cache-served boards are live, so the
## stale leg fails by name; golfscore - the parser reads
## golf distances as scores, so the golf-shape legs fail
## by name.
func _drive_pinemhi2_smoke() -> void:
	if _pinemhi2_smoke_phase == 0:
		_pinemhi2_smoke_deadline_msec = Time.get_ticks_msec() + 240000
		var mode: String = OS.get_environment("PVLDS_PINEMHI2_MODE")
		if mode == "":
			mode = "parse"
		if mode == "parse":
			_pinemhi2_run_parse_legs()
			_finish_pinemhi2_smoke()
			return
		_pinemhi2_smoke_phase = 1
	_pinemhi2_smoke_wait += 1
	if Time.get_ticks_msec() > _pinemhi2_smoke_deadline_msec:
		_pinemhi2_expect(false, "pinemhi2 smoke: deadline exceeded (mode %s)" % OS.get_environment("PVLDS_PINEMHI2_MODE"))
		_finish_pinemhi2_smoke()
		return
	match OS.get_environment("PVLDS_PINEMHI2_MODE"):
		"stub":
			if _pinemhi2_live:
				_pinemhi2_expect(true, "stub: the boot fetch through the base-url seam landed live")
				_pinemhi2_check_contests(_pinemhi2_contests, "stub")
				_pinemhi2_expect(FileAccess.file_exists(PinemhiWeeklyClient.cache_path()), "stub: the fetch wrote the weekly cache")
				var loaded: Dictionary = PinemhiWeeklyClient.load_cache()
				_pinemhi2_expect(bool(loaded.get("ok", false)), "stub: the written cache reads back")
				if bool(loaded.get("ok", false)):
					var lc: Variant = loaded.get("contests", [])
					if lc is Array:
						_pinemhi2_check_contests(lc, "stub-cache")
				_finish_pinemhi2_smoke()
		"cache":
			if _pinemhi2_fetch_error != "":
				_pinemhi2_expect(_pinemhi2_contests.size() == 3, "cache: the saved contests stand when the fetch cannot land (got %d)" % _pinemhi2_contests.size())
				_pinemhi2_expect(not _pinemhi2_live, "cache: the standing boards are the cache's, not live")
				_pinemhi2_expect(_pinemhi2_fetched_at > 0, "cache: the standing boards carry their saved stamp")
				_pinemhi2_check_contests(_pinemhi2_contests, "cache")
				_finish_pinemhi2_smoke()
		"room":
			_drive_pinemhi2_room()
		"failstate":
			_drive_pinemhi2_failstate()


func _pinemhi2_expect(cond: bool, label: String) -> void:
	if cond:
		print("PVLDS PINEMHI2 LEG PASS: ", label)
	else:
		_pinemhi2_smoke_failures += 1
		print("PVLDS PINEMHI2 LEG FAIL: ", label)


func _finish_pinemhi2_smoke() -> void:
	print("PVLDS PINEMHI2 SMOKE RESULT: ", "PASS" if _pinemhi2_smoke_failures == 0 else "FAIL (%d)" % _pinemhi2_smoke_failures)
	get_tree().quit(0 if _pinemhi2_smoke_failures == 0 else 1)


## STARFIELD smoke (--pvlds-smoke-starfield, harness env
## PVLDS_STARFIELD_MODE): field - the volume's census, the
## dial's standing sets, the drift sampled over real time,
## the parallax read off projected stars at two rig
## offsets, the quiet read off the sky-only grab, and the
## grabs themselves (PVLDS_STARFIELD_GRAB_DIR, default the
## dossier's grabs dir); gate - the same stepped travel run
## measured under off, flat and layered, frame costs
## printed side by side (the interface-speed gate's delta;
## under PVLDS_BG_NC=shells the layered run measures the
## OLD two-shell field, the base the gate compares to).
## Negative control (PVLDS_BG_NC=shells in field mode):
## layered stands the two old shells, so the
## "starfield volume:" legs fail by name.
func _drive_starfield_smoke() -> void:
	if _starfield_smoke_phase == 0:
		_starfield_smoke_deadline_msec = Time.get_ticks_msec() + 300000
		_starfield_smoke_phase = 1
		_starfield_smoke_wait = 0
		return
	if Time.get_ticks_msec() > _starfield_smoke_deadline_msec:
		_starfield_expect(false, "starfield smoke: deadline exceeded (phase %d)" % _starfield_smoke_phase)
		_finish_starfield_smoke()
		return
	if OS.get_environment("PVLDS_STARFIELD_MODE") == "gate":
		_drive_starfield_gate()
	else:
		_drive_starfield_field()


func _starfield_expect(cond: bool, label: String) -> void:
	if cond:
		print("PVLDS STARFIELD LEG PASS: ", label)
	else:
		_starfield_smoke_failures += 1
		print("PVLDS STARFIELD LEG FAIL: ", label)


func _finish_starfield_smoke() -> void:
	print("PVLDS STARFIELD SMOKE RESULT: ", "PASS" if _starfield_smoke_failures == 0 else "FAIL (%d)" % _starfield_smoke_failures)
	get_tree().quit(0 if _starfield_smoke_failures == 0 else 1)


func _starfield_room_ready() -> bool:
	return _room != null and _room.visible and _room.wall_ready and _room._visible_games.size() >= 1


## The full library standing: the room boots on the VR
## filter (3 of the letter fixtures), so the drivers press
## the ALL rail stop themselves and wait for the whole
## letter library to stand (14 tables in the fixture set).
func _starfield_library_stood() -> bool:
	return _room != null and _room.wall_ready and _room._visible_games.size() >= 12


func _starfield_grab(name: String) -> Image:
	var img: Image = get_viewport().get_texture().get_image()
	var dir: String = OS.get_environment("PVLDS_STARFIELD_GRAB_DIR")
	if dir == "":
		dir = ProjectSettings.globalize_path("res://").path_join("../pvlds-starfield/grabs")
	DirAccess.make_dir_recursive_absolute(dir)
	img.save_png(dir.path_join(name))
	print("PVLDS STARFIELD GRAB: ", dir.path_join(name))
	return img


func _drive_starfield_field() -> void:
	match _starfield_smoke_phase:
		1:
			if _starfield_room_ready():
				get_viewport().warp_mouse(Vector2(512.0, 764.0)) ## parked over the furniture: a drum park lets the resting hover drive the centre (the nav driver's lesson)
				_room._handle_rail("filter:all")
				_starfield_smoke_phase = 15
				_starfield_smoke_wait = 0
			else:
				_starfield_smoke_wait += 1
				if _starfield_smoke_wait > 7200:
					_starfield_expect(false, "starfield field: the room never came up on the real boot path")
					_finish_starfield_smoke()
		15:
			if _starfield_library_stood():
				_room.set_starfield_mode("layered")
				_starfield_smoke_phase = 2
				_starfield_smoke_wait = 0
			else:
				_starfield_smoke_wait += 1
				if _starfield_smoke_wait > 7200:
					_starfield_expect(false, "starfield field: the full letter library never stood")
					_finish_starfield_smoke()
		2:
			_starfield_smoke_wait += 1
			if _starfield_smoke_wait > 10:
				_starfield_field_census()
				var st: Dictionary = _room.starfield_drift_state()
				_starfield_drift_yaws0 = (st.get("band_yaws_deg", []) as Array).duplicate()
				_starfield_drift_t0 = Time.get_ticks_msec()
				_starfield_smoke_phase = 3
		3:
			if Time.get_ticks_msec() - _starfield_drift_t0 >= 4000:
				_starfield_field_drift_legs()
				_room.drum_node().visible = false
				_room._desk_rig.position = RoomView.EYE
				_starfield_smoke_phase = 4
				_starfield_smoke_wait = 0
		4:
			_starfield_smoke_wait += 1
			if _starfield_smoke_wait > 8:
				var cam: Camera3D = _room._active_camera()
				var bands: Array = _room.starfield_volume_bands()
				_starfield_yaws_a = (_room.starfield_drift_state().get("band_yaws_deg", []) as Array).duplicate()
				_starfield_pick["near"] = _starfield_find_star(cam, 0)
				_starfield_pick["far"] = _starfield_find_star(cam, bands.size() - 1)
				for key: String in ["near", "far"]:
					var pick: Array = _starfield_pick.get(key, [])
					if pick.size() == 2:
						_starfield_pos_a[key] = cam.unproject_position(_starfield_star_world(int(pick[0]), int(pick[1])))
				_starfield_sky_img = _starfield_grab("starfield_sky_a.png")
				_room._desk_rig.position = RoomView.EYE + Vector3(0.35, 0.0, 0.0)
				# Restore the rig-A band yaws in the same
				# frame, before any rig-B frame renders, so
				# the pair measures parallax, not drift.
				var bands2: Array = _room.starfield_volume_bands()
				for i: int in range(mini(bands2.size(), _starfield_yaws_a.size())):
					(bands2[i] as Node3D).rotation.y = deg_to_rad(float(_starfield_yaws_a[i]))
				_starfield_smoke_phase = 5
				_starfield_smoke_wait = 0
		5:
			_starfield_smoke_wait += 1
			if _starfield_smoke_wait > 8:
				_starfield_grab("starfield_sky_b.png")
				_starfield_field_parallax_legs()
				_starfield_quiet_leg(_starfield_sky_img)
				_starfield_round_leg(_starfield_sky_img)
				_room._desk_rig.position = RoomView.EYE
				_room.drum_node().visible = true
				_starfield_smoke_phase = 6
				_starfield_smoke_wait = 0
		6:
			_starfield_smoke_wait += 1
			if _starfield_smoke_wait > 10:
				_starfield_grab("starfield_room.png")
				_room.set_starfield_mode("flat")
				_starfield_smoke_phase = 7
				_starfield_smoke_wait = 0
		7:
			_starfield_smoke_wait += 1
			if _starfield_smoke_wait > 10:
				_starfield_grab("starfield_flat.png")
				_room.set_starfield_mode("layered")
				_starfield_smoke_phase = 8
				_starfield_smoke_wait = 0
		8:
			_starfield_smoke_wait += 1
			if _starfield_smoke_wait > 10:
				# Seat the focus on a card first (the boot's
				# rail press left it on the strip, where a
				# stick feed walks the strip, not the wall) -
				# the motion driver's own travel start.
				_motion_snap_to_travel_start()
				_input_feed_stick_x(1.0)
				_starfield_smoke_phase = 9
				_starfield_smoke_wait = 0
		9:
			_starfield_smoke_wait += 1
			if _room.swing_active():
				_starfield_grab("starfield_travel.png")
				_input_feed_stick_x(0.0)
				_starfield_smoke_phase = 10
				_starfield_smoke_wait = 0
			elif _starfield_smoke_wait > 1200:
				_starfield_expect(false, "starfield field: the travel grab's swing never started")
				_input_feed_stick_x(0.0)
				_finish_starfield_smoke()
		10:
			_starfield_smoke_wait += 1
			if not _room.swing_active() or _starfield_smoke_wait > 1200:
				_finish_starfield_smoke()


func _starfield_field_census() -> void:
	var st: Dictionary = _room.starfield_drift_state()
	_starfield_expect(bool(st.get("volume", false)),
		"starfield volume: the volume stands in layered")
	_starfield_expect(int(st.get("band_count", 0)) == RoomView.BG_VOLUME_RADII.size(),
		"starfield volume: %d bands stand (got %d)" % [RoomView.BG_VOLUME_RADII.size(), int(st.get("band_count", 0))])
	var radii: Array = st.get("band_radii", [])
	if radii.size() >= 2:
		var mono: bool = true
		for i: int in range(radii.size() - 1):
			if float(radii[i + 1]) <= float(radii[i]):
				mono = false
		_starfield_expect(mono and float(radii[0]) > RoomView.WALL_RADIUS and float(radii[radii.size() - 1]) >= 300.0,
			"starfield volume: the field spans just outside the wall (%.1f m) out to hundreds of metres (%.0f m), radii rising" % [float(radii[0]), float(radii[radii.size() - 1])])
	else:
		_starfield_expect(false, "starfield volume: band radii unreadable (%d)" % radii.size())
	_starfield_expect(int(st.get("star_count", 0)) >= 5000,
		"starfield volume: a deep field stands (%d stars)" % int(st.get("star_count", 0)))
	var rates: Array = st.get("band_rates_deg_s", [])
	if rates.size() >= 2:
		var dec: bool = true
		for i: int in range(rates.size() - 1):
			if float(rates[i + 1]) >= float(rates[i]):
				dec = false
		_starfield_expect(dec and absf(float(rates[0]) - RoomView.BG_DRIFT_NEAR_DEG) < 0.001 and absf(float(rates[rates.size() - 1]) - RoomView.BG_DRIFT_FAR_DEG) < 0.001,
			"starfield volume: drift rates fall with depth between the standing endpoints (near %.2f, far %.2f deg/s)" % [float(rates[0]), float(rates[rates.size() - 1])])
	else:
		_starfield_expect(false, "starfield volume: band rates unreadable (%d)" % rates.size())
	_starfield_expect(bool(st.get("backdrop_visible", false)),
		"starfield volume: the starless backdrop stands behind the field")
	var shells: Array = _room.background_layers()
	if shells.size() == 2:
		_room.set_starfield_mode("flat")
		_starfield_expect(not _room.starfield_volume_standing() and (shells[0] as Node3D).visible and not (shells[1] as Node3D).visible,
			"starfield dial: flat stands the far shell alone, volume down")
		_room.set_starfield_mode("off")
		_starfield_expect(not (shells[0] as Node3D).visible and not (shells[1] as Node3D).visible and not _room.starfield_volume_standing(),
			"starfield dial: off stands no stars")
		_room.set_starfield_mode("layered")
		_starfield_expect(_room.starfield_volume_standing() and not (shells[0] as Node3D).visible and not (shells[1] as Node3D).visible,
			"starfield dial: layered stands the volume with both shells down")
	else:
		_starfield_expect(false, "starfield dial: the shell pair is missing (%d)" % shells.size())
	# FIELDPASS (item 1): the tint census - the instance
	# colours' own mix, read off the bands' data: most
	# stars near-neutral, a faint warm and a faint blue
	# minority standing (his reference field's mix).
	var tint_total: int = 0
	var tint_warm: int = 0
	var tint_blue: int = 0
	var bands_t: Array = _room.starfield_volume_bands()
	for bi: int in range(bands_t.size()):
		var mm_t: MultiMesh = (bands_t[bi] as MultiMeshInstance3D).multimesh
		if mm_t == null:
			continue
		for si: int in range(mm_t.instance_count):
			var c: Color = _room.starfield_volume_star_color(bi, si)
			tint_total += 1
			if c.r - c.b > 0.02:
				tint_warm += 1
			elif c.b - c.r > 0.02:
				tint_blue += 1
	if tint_total > 0:
		var warm_frac: float = float(tint_warm) / float(tint_total)
		var blue_frac: float = float(tint_blue) / float(tint_total)
		_starfield_expect(warm_frac > 0.02 and warm_frac < 0.20 and blue_frac > 0.02 and blue_frac < 0.20,
			"starfield tint: a faint warm and a faint blue minority stand in a near-neutral field (warm %.1f%%, blue %.1f%% of %d stars)" % [warm_frac * 100.0, blue_frac * 100.0, tint_total])
	else:
		_starfield_expect(false, "starfield tint: no instance colours to census")


func _starfield_field_drift_legs() -> void:
	var st: Dictionary = _room.starfield_drift_state()
	var yaws1: Array = st.get("band_yaws_deg", [])
	var elapsed: float = float(Time.get_ticks_msec() - _starfield_drift_t0) / 1000.0
	if yaws1.size() >= 2 and _starfield_drift_yaws0.size() == yaws1.size():
		var near_adv: float = float(yaws1[0]) - float(_starfield_drift_yaws0[0])
		var far_adv: float = float(yaws1[yaws1.size() - 1]) - float(_starfield_drift_yaws0[_starfield_drift_yaws0.size() - 1])
		_starfield_expect(near_adv > 0.45 * elapsed * 0.5 and far_adv > 0.05,
			"starfield drift: both depth bands drift in world space (near +%.2f deg, far +%.2f deg over %.1f s)" % [near_adv, far_adv, elapsed])
		_starfield_expect(near_adv > far_adv * 1.5,
			"starfield drift: the near band drifts faster than the far band - the drift is depth-scaled (near +%.2f, far +%.2f)" % [near_adv, far_adv])
	else:
		_starfield_expect(false, "starfield drift: band yaws unreadable (%d vs %d)" % [yaws1.size(), _starfield_drift_yaws0.size()])


## One volume star's world position, off the band's own
## transform and the room's instance read.
func _starfield_star_world(band_idx: int, star_idx: int) -> Vector3:
	var bands: Array = _room.starfield_volume_bands()
	if band_idx < 0 or band_idx >= bands.size():
		return Vector3.ZERO
	return (bands[band_idx] as Node3D).global_transform * _room.starfield_volume_star(band_idx, star_idx)


func _starfield_in_frame(cam: Camera3D, world: Vector3) -> bool:
	var cs: Vector3 = cam.global_transform.affine_inverse() * world
	if cs.z > -0.1:
		return false
	var p: Vector2 = cam.unproject_position(world)
	var vp: Vector2 = get_viewport().get_visible_rect().size
	return p.x > 60.0 and p.x < vp.x - 60.0 and p.y > 60.0 and p.y < vp.y - 60.0


## The most eccentric in-frame star among the band's first
## eighty - parallax reads largest away from the view axis.
func _starfield_find_star(cam: Camera3D, band_idx: int) -> Array:
	var bands: Array = _room.starfield_volume_bands()
	if band_idx < 0 or band_idx >= bands.size():
		return []
	var mm: MultiMesh = (bands[band_idx] as MultiMeshInstance3D).multimesh
	if mm == null:
		return []
	var vp: Vector2 = get_viewport().get_visible_rect().size
	var best: Array = []
	var best_ecc: float = -1.0
	for s: int in range(mini(mm.instance_count, 80)):
		var world: Vector3 = _starfield_star_world(band_idx, s)
		if not _starfield_in_frame(cam, world):
			continue
		var p: Vector2 = cam.unproject_position(world)
		var ecc: float = absf(p.x - vp.x * 0.5) / (vp.x * 0.5)
		if ecc > best_ecc:
			best_ecc = ecc
			best = [band_idx, s]
	return best


func _starfield_field_parallax_legs() -> void:
	var cam: Camera3D = _room._active_camera()
	var shifts: Dictionary = {}
	for key: String in ["near", "far"]:
		var pick: Array = _starfield_pick.get(key, [])
		if pick.size() == 2 and _starfield_pos_a.has(key):
			var pb: Vector2 = cam.unproject_position(_starfield_star_world(int(pick[0]), int(pick[1])))
			shifts[key] = (_starfield_pos_a[key] as Vector2).distance_to(pb)
	_starfield_expect(shifts.has("near") and shifts.has("far"),
		"starfield parallax: a near star and a far star both stood in frame at both rig positions (picks %s)" % str(_starfield_pick))
	if shifts.has("near") and shifts.has("far"):
		var near_shift: float = float(shifts["near"])
		var far_shift: float = float(shifts["far"])
		_starfield_expect(near_shift > 5.0 and near_shift > far_shift * 1.5,
			"starfield parallax: a 0.35 m head move shifts the near star far more than the far star (near %.1f px, far %.1f px) - real positions, real depth" % [near_shift, far_shift])


## The quiet read: over the sky-only grab's top band, star
## pixels (luminance over the pinpoint threshold the sky
## proofs use) must be sparse, and their brightness must
## VARY - the instance colours carrying depth.
func _starfield_quiet_leg(img: Image) -> void:
	if img == null:
		_starfield_expect(false, "starfield quiet: no sky grab to read")
		return
	var star_px: int = 0
	var tot: int = 0
	var lums: Array[float] = []
	var y_max: int = int(float(img.get_height()) * 0.40)
	for y: int in range(0, y_max, 2):
		for x: int in range(0, img.get_width(), 2):
			tot += 1
			var lum: float = img.get_pixel(x, y).get_luminance()
			if lum > 0.30:
				star_px += 1
				lums.append(lum)
	var frac: float = float(star_px) / float(maxi(tot, 1))
	_starfield_expect(frac > 0.0005 and frac < 0.02,
		"starfield quiet: the field is sparse pinpoints over dark sky, not a wash (bright fraction %.4f)" % frac)
	lums.sort()
	if lums.size() >= 20:
		var med: float = lums[lums.size() / 2]
		var hi: float = lums[lums.size() - 1]
		_starfield_expect(hi > 0.55 and med < hi * 0.75,
			"starfield quiet: star brightness varies with depth - instance colours live (median %.2f, brightest %.2f)" % [med, hi])
	else:
		_starfield_expect(false, "starfield quiet: too few stars in frame to judge brightness (%d)" % lums.size())


## FIELDPASS (item 1): the round read - off the sky-only
## grab. For isolated bright stars, sample the luminance
## one pixel along the axes against one pixel along the
## diagonals (a longer step from the centre). Measured on
## this bench's renders, the two shapes separate cleanly:
## the soft points read a median diagonal/axis falloff of
## ~0.26-0.31, the flat tiles ~0.50 (their hard edges and
## plateau peaks smear the ratio up). The leg's bound sits
## between the two families. Under
## PVLDS_FIELDPASS_NC=squares the tiles return and this
## leg fails by name.
func _starfield_round_leg(img: Image) -> void:
	if img == null:
		_starfield_expect(false, "starfield round: no sky grab to read")
		return
	var w: int = img.get_width()
	var h: int = int(float(img.get_height()) * 0.45)
	var ratios: Array[float] = []
	for y: int in range(6, h - 6):
		for x: int in range(6, w - 6):
			var lum: float = img.get_pixel(x, y).get_luminance()
			if lum < 0.60:
				continue
			var peak: bool = true
			for dy: int in range(-1, 2):
				for dx: int in range(-1, 2):
					if dx == 0 and dy == 0:
						continue
					if img.get_pixel(x + dx, y + dy).get_luminance() > lum:
						peak = false
			if not peak:
				continue
			var iso: bool = true
			for dy2: int in range(-6, 7):
				for dx2: int in range(-6, 7):
					if maxi(absi(dx2), absi(dy2)) < 5:
						continue
					if img.get_pixel(x + dx2, y + dy2).get_luminance() > 0.35:
						iso = false
			if not iso:
				continue
			var axis: float = (img.get_pixel(x + 1, y).get_luminance() + img.get_pixel(x - 1, y).get_luminance()
				+ img.get_pixel(x, y + 1).get_luminance() + img.get_pixel(x, y - 1).get_luminance()) / 4.0
			var diag: float = (img.get_pixel(x + 1, y + 1).get_luminance() + img.get_pixel(x - 1, y + 1).get_luminance()
				+ img.get_pixel(x + 1, y - 1).get_luminance() + img.get_pixel(x - 1, y - 1).get_luminance()) / 4.0
			if axis > 0.10:
				ratios.append(diag / axis)
	ratios.sort()
	if ratios.size() >= 4:
		var med: float = ratios[ratios.size() / 2]
		_starfield_expect(med < 0.40,
			"starfield round: the stars are round soft points, not square tiles (median diagonal/axis falloff %.2f over %d isolated stars)" % [med, ratios.size()])
	else:
		_starfield_expect(false, "starfield round: too few isolated bright stars to judge the shape (%d)" % ratios.size())


## GATE mode: one stepped travel run per dial stop, frame
## stamps collected through the run; the mean frame cost
## per stop is printed at the end, layered judged against
## flat (today's shipped field) with a noise allowance.
func _drive_starfield_gate() -> void:
	match _starfield_smoke_phase:
		1:
			if _starfield_room_ready():
				get_viewport().warp_mouse(Vector2(512.0, 764.0)) ## parked over the furniture: a drum park lets the resting hover drive the centre (the nav driver's lesson)
				_room._handle_rail("filter:all")
				_starfield_gate = {"order": ["off", "flat", "layered"], "idx": 0, "rest": 0}
				_starfield_smoke_phase = 15
				_starfield_smoke_wait = 0
			else:
				_starfield_smoke_wait += 1
				if _starfield_smoke_wait > 7200:
					_starfield_expect(false, "starfield gate: the room never came up on the real boot path")
					_finish_starfield_smoke()
		15:
			if _starfield_library_stood():
				_starfield_smoke_phase = 2
				_starfield_smoke_wait = 0
			else:
				_starfield_smoke_wait += 1
				if _starfield_smoke_wait > 7200:
					_starfield_expect(false, "starfield gate: the full letter library never stood")
					_finish_starfield_smoke()
		2:
			var order: Array = _starfield_gate.get("order", [])
			var idx: int = int(_starfield_gate.get("idx", 0))
			if idx >= order.size():
				_starfield_gate_verdict()
				_finish_starfield_smoke()
				return
			_room.set_starfield_mode(str(order[idx]))
			_motion_snap_to_travel_start()
			_starfield_smoke_phase = 3
			_starfield_smoke_wait = 0
		3:
			_starfield_smoke_wait += 1
			if _starfield_smoke_wait > 40:
				# Two trains per stop - right, then back
				# left over the same ground - so the run
				# samples enough frames to mean anything and
				# direction bias cancels; the stamps run
				# unbroken across both trains and the settle
				# between them.
				_starfield_gate["trains"] = 0
				_starfield_gate["start_col"] = _room._grid_coord(_room.centre_index()).x
				_starfield_gate["run_t0"] = Time.get_ticks_msec()
				_starfield_gate_frames.clear()
				_input_feed_stick_x(1.0)
				_starfield_smoke_phase = 4
				_starfield_smoke_wait = 0
		4:
			_starfield_gate_frames.append(Time.get_ticks_usec())
			var col: int = _room._grid_coord(_room.centre_index()).x
			if absi(col - int(_starfield_gate.get("start_col", 0))) >= 3 or Time.get_ticks_msec() - int(_starfield_gate.get("run_t0", 0)) >= 9000:
				_input_feed_stick_x(0.0)
				_starfield_gate["rest"] = 0
				_starfield_smoke_phase = 5
				_starfield_smoke_wait = 0
		5:
			_starfield_gate_frames.append(Time.get_ticks_usec())
			if not _room.swing_active():
				_starfield_gate["rest"] = int(_starfield_gate.get("rest", 0)) + 1
			else:
				_starfield_gate["rest"] = 0
			if int(_starfield_gate.get("rest", 0)) >= 4 and int(_starfield_gate.get("trains", 0)) == 0:
				_starfield_gate["trains"] = 1
				_starfield_gate["start_col"] = _room._grid_coord(_room.centre_index()).x
				_starfield_gate["run_t0"] = Time.get_ticks_msec()
				_input_feed_stick_x(-1.0)
				_starfield_smoke_phase = 4
				_starfield_smoke_wait = 0
			elif (int(_starfield_gate.get("rest", 0)) >= 4 and int(_starfield_gate.get("trains", 0)) >= 1) or _starfield_smoke_wait > 2400:
				var order2: Array = _starfield_gate.get("order", [])
				var idx2: int = int(_starfield_gate.get("idx", 0))
				var mode_name: String = str(order2[idx2])
				var n: int = _starfield_gate_frames.size()
				var span_ms: float = float(_starfield_gate_frames[n - 1] - _starfield_gate_frames[0]) / 1000.0 if n >= 2 else 0.0
				var mean_ms: float = span_ms / float(maxi(n - 1, 1))
				_starfield_gate[mode_name] = {"frames": n, "mean_ms": mean_ms}
				print("PVLDS STARFIELD GATE: %s - %d frames over %.0f ms, mean %.2f ms/frame" % [mode_name, n, span_ms, mean_ms])
				_starfield_gate["idx"] = idx2 + 1
				_starfield_smoke_phase = 2
				_starfield_smoke_wait = 0
			_starfield_smoke_wait += 1


func _starfield_gate_verdict() -> void:
	var lv: Dictionary = _starfield_gate.get("layered", {})
	var fl: Dictionary = _starfield_gate.get("flat", {})
	var off: Dictionary = _starfield_gate.get("off", {})
	print("PVLDS STARFIELD GATE SUMMARY: off %s | flat %s | layered %s" % [str(off), str(fl), str(lv)])
	if RoomView.debug_bg_nc != "":
		# A seam boot (the gatebase run): its "layered" is
		# the OLD two-shell field - the numbers are the
		# dossier's base evidence, not the volume's verdict.
		print("PVLDS STARFIELD GATE: seam boot - verdict leg skipped by design")
		return
	if not lv.is_empty() and not fl.is_empty():
		_starfield_expect(float(lv.get("mean_ms", 0.0)) <= float(fl.get("mean_ms", 0.0)) * 1.25 + 1.0,
			"starfield gate: the volume's travel frame cost matches the flat field's (layered %.2f ms vs flat %.2f ms mean)" % [float(lv.get("mean_ms", 0.0)), float(fl.get("mean_ms", 0.0))])
	else:
		_starfield_expect(false, "starfield gate: a measured run is missing (layered %s, flat %s)" % [str(lv), str(fl)])


## The fixture directory the parse and room legs read
## (harness env, default the dossier's real captures).
func _pinemhi2_fixture_dir() -> String:
	var d: String = OS.get_environment("PVLDS_PINEMHI2_FIXTURE_DIR")
	if d == "":
		d = ProjectSettings.globalize_path("res://").path_join("../pvlds-pinemhi2/fixtures")
	return d


func _pinemhi2_fixture_contests() -> Array:
	var dir: String = _pinemhi2_fixture_dir()
	var out: Array = []
	var files: Dictionary = {"main": "week_challenge.html", "five": "week_challenge_5min.html", "golf": "week_challenge_golf.html"}
	for cid: String in ["main", "five", "golf"]:
		var path: String = dir.path_join(str(files[cid]))
		if not FileAccess.file_exists(path):
			_pinemhi2_expect(false, "fixtures: %s exists" % path)
			continue
		var parsed: Dictionary = PinemhiWeeklyClient.parse_page(FileAccess.get_file_as_string(path), cid)
		_pinemhi2_expect(bool(parsed.get("ok", false)), "fixtures: the %s page parses (%s)" % [cid, str(parsed.get("error", ""))])
		if bool(parsed.get("ok", false)):
			out.append(parsed["contest"])
	return out


## The contest census every mode judges by - the real
## captures' known contents (2026-11-07): the parser legs,
## the stub legs and the cache legs all read the same
## numbers. Under the golfscore negative control the golf
## legs here fail by name, as designed.
func _pinemhi2_check_contests(contests: Array, tag: String) -> void:
	var by_id: Dictionary = {}
	for cv: Variant in contests:
		var c: Dictionary = cv as Dictionary
		by_id[str(c.get("id", ""))] = c
	_pinemhi2_expect(by_id.size() == 3, "%s: three contests stand (got %d)" % [tag, by_id.size()])
	if by_id.has("main"):
		var m: Dictionary = by_id["main"]
		var mrows: Array = m.get("rows", []) as Array
		_pinemhi2_expect(str(m.get("table", "")) == "Rolling Stones", "%s main: table is Rolling Stones" % tag)
		_pinemhi2_expect(str(m.get("window_start", "")).begins_with("2026-11-01") and str(m.get("window_end", "")).begins_with("2026-11-08"), "%s main: window Nov 1 - Nov 8" % tag)
		_pinemhi2_expect(mrows.size() == 6, "%s main: 6 interim rows (got %d)" % [tag, mrows.size()])
		if not mrows.is_empty():
			var r0: Dictionary = mrows[0] as Dictionary
			_pinemhi2_expect(str(r0.get("name", "")) == "RetroGeek" and int(r0.get("value", 0)) == 8014130 and str(r0.get("value_text", "")) == "8.014.130", "%s main: row 1 is RetroGeek 8.014.130" % tag)
	if by_id.has("five"):
		var f: Dictionary = by_id["five"]
		var frows: Array = f.get("rows", []) as Array
		_pinemhi2_expect(str(f.get("table", "")) == "Bad Cats", "%s five: table is Bad Cats" % tag)
		_pinemhi2_expect(frows.size() == 4, "%s five: 4 interim rows (got %d)" % [tag, frows.size()])
		if not frows.is_empty():
			var fr0: Dictionary = frows[0] as Dictionary
			_pinemhi2_expect(str(fr0.get("name", "")) == "JB1980" and int(fr0.get("value", 0)) == 10725280, "%s five: row 1 is JB1980 10725280" % tag)
	if by_id.has("golf"):
		var g: Dictionary = by_id["golf"]
		var grows: Array = g.get("rows", []) as Array
		_pinemhi2_expect(str(g.get("table", "")) == "Rolling Stones", "%s golf: table is Rolling Stones" % tag)
		_pinemhi2_expect(str(g.get("pin", "")) == "43.900", "%s golf: the pin reads 43.900 (got '%s')" % [tag, str(g.get("pin", ""))])
		_pinemhi2_expect(grows.size() == 2, "%s golf: 2 interim rows (got %d)" % [tag, grows.size()])
		if grows.size() == 2:
			var g0: Dictionary = grows[0] as Dictionary
			var g1: Dictionary = grows[1] as Dictionary
			_pinemhi2_expect(str(g0.get("name", "")) == "Tucidides" and int(g0.get("value", 0)) == -620 and str(g0.get("value_text", "")) == "-620", "%s golf-shape: row 1 is Tucidides at -620, distance verbatim" % tag)
			_pinemhi2_expect(str(g1.get("name", "")) == "JB1980" and int(g1.get("value", 0)) == -1450 and str(g1.get("value_text", "")) == "-1.450", "%s golf-shape: row 2 is JB1980 at -1.450, page order preserved" % tag)


func _pinemhi2_run_parse_legs() -> void:
	var contests: Array = _pinemhi2_fixture_contests()
	_pinemhi2_check_contests(contests, "parse")
	# The hole-in-one shape: the golf capture with its
	# first distance cell swapped for the words - the row
	# must read as an ace (value 0, flagged), never a score.
	var golf_path: String = _pinemhi2_fixture_dir().path_join("week_challenge_golf.html")
	if FileAccess.file_exists(golf_path):
		var html: String = FileAccess.get_file_as_string(golf_path)
		var at: int = html.find("-620")
		_pinemhi2_expect(at >= 0, "hole-in-one: the golf fixture carries its -620 cell to swap")
		if at >= 0:
			var swapped: String = html.substr(0, at) + "Hole in One" + html.substr(at + "-620".length())
			var parsed: Dictionary = PinemhiWeeklyClient.parse_page(swapped, "golf")
			_pinemhi2_expect(bool(parsed.get("ok", false)), "hole-in-one: the swapped page still parses")
			if bool(parsed.get("ok", false)):
				var rows: Array = (parsed["contest"] as Dictionary).get("rows", []) as Array
				if not rows.is_empty():
					var r0: Dictionary = rows[0] as Dictionary
					_pinemhi2_expect(str(r0.get("value_text", "")) == "Hole in One" and int(r0.get("value", -1)) == 0 and bool(r0.get("hole_in_one", false)), "hole-in-one: the ace row reads value 0, flagged, words verbatim")
	# His name: three JB1980 bests and one Kubrick best in
	# a fabricated Personal shelf - the majority name is
	# his; an empty shelf answers "".
	var root: String = ProjectSettings.globalize_path("user://pinemhi2_name_test")
	var shelf: String = root.path_join("PINemHi LeaderBoard").path_join("TOP10_Personal")
	DirAccess.make_dir_recursive_absolute(shelf)
	var titles: Array = ["Rolling Stones", "Bad Cats", "Doctor Who", "Fish Tales"]
	var players: Array = ["JB1980", "JB1980", "JB1980", "Kubrick"]
	for i: int in range(titles.size()):
		var f: FileAccess = FileAccess.open(shelf.path_join("TOP10_Personal_%d.txt" % i), FileAccess.WRITE)
		if f != null:
			f.store_string("<<<%s>>>\n1   8.014.130      %s  2026-11-07 21:50:07\n2   475.500      Someone Else  2026-11-07 20:00:00\n" % [str(titles[i]), str(players[i])])
			f.close()
	var cfg: PvldsConfig = PvldsConfig.new()
	cfg.pinemhi_folder = root
	cfg.pinemhi_enabled = true
	_pinemhi2_expect(PinemhiScores.player_name_for_config(cfg) == "JB1980", "his-name: the majority best-row player is his name (got '%s')" % PinemhiScores.player_name_for_config(cfg))
	var cfg_empty: PvldsConfig = PvldsConfig.new()
	cfg_empty.pinemhi_folder = root.path_join("no_such_folder")
	_pinemhi2_expect(PinemhiScores.player_name_for_config(cfg_empty) == "", "his-name: no files, no name")


## The room variant's phases ride _pinemhi2_smoke_phase:
## 1 room up + tournie entered, 2 baseline recorded (no
## weekly data), 3 fixture data pushed, 4 legs + grab.
func _drive_pinemhi2_room() -> void:
	match _pinemhi2_smoke_phase:
		1:
			if _room != null and _room.visible and _room.wall_ready:
				# WoVP boards from fabricated challenges (the
				# tournament fixture's own shape), so the room
				# legs judge the weekly boards against real
				# standing WoVP boards.
				_wovp_challenges = [
					_pinemhi_fab_challenge("pinemhi2-alpha", "Apollo 13"),
					_pinemhi_fab_challenge("pinemhi2-beta", "Medieval Madness"),
					_pinemhi_fab_challenge("pinemhi2-gamma", "Twilight Zone"),
				]
				_wovp_user_id = "smoke-user"
				_wovp_boards_live = true
				_wovp_fetched_at = int(Time.get_unix_time_from_system())
				_pinemhi2_contests = []
				_pinemhi2_fetched_at = 0
				_pinemhi2_live = false
				_pinemhi2_fetch_error = ""
				_push_wovp_data()
				_room._handle_rail("tournament")
				_pinemhi2_expect(_room.tournament_active(), "room: the TOURNAMENT stop raises the Tournament Room")
				_pinemhi2_smoke_phase = 2
				_pinemhi2_smoke_wait = 0
		2:
			# The boot fetch settles first: its failure push
			# (dead seam, no cache) re-seeds the room's
			# failure row whenever it lands, so the baseline's
			# clean state is re-pushed only after the client
			# is idle - from then on nothing re-pushes until
			# the driver itself lands the fixture data.
			if _pinemhi_client != null and _pinemhi_client.is_busy():
				return
			if not _pinemhi2_smoke_baseline_reset:
				_pinemhi2_contests = []
				_pinemhi2_fetched_at = 0
				_pinemhi2_live = false
				_pinemhi2_fetch_error = ""
				_push_pinemhi2_data()
				_pinemhi2_smoke_baseline_reset = true
				_pinemhi2_smoke_wait = 0
				return
			# Baseline: the WoVP boards standing, no weekly
			# data - their keys and seats are the record the
			# unaffected leg compares against.
			var ready: bool = _room != null and _room.wall_ready
			if ready:
				for e: Variant in _room.board_state():
					var entry: Dictionary = e as Dictionary
					if str(entry.get("challenge_id", "")) != "":
						ready = ready and bool(entry.get("texture_real", false))
			if ready and _pinemhi2_smoke_wait > 30:
				_pinemhi2_smoke_boot_boards = []
				for e2: Variant in _room.board_state():
					var entry2: Dictionary = e2 as Dictionary
					if str(entry2.get("challenge_id", "")) != "":
						_pinemhi2_smoke_boot_boards.append({
							"challenge_id": entry2.get("challenge_id"),
							"card_coord": entry2.get("card_coord"),
							"board_coord": entry2.get("board_coord"),
							"standing_key": entry2.get("standing_key"),
						})
				_pinemhi2_expect(_pinemhi2_smoke_boot_boards.size() == 3, "room baseline: three WoVP boards stand (got %d)" % _pinemhi2_smoke_boot_boards.size())
				var pinemhi_rows: int = 0
				for rv: Variant in _room.tournament_rows():
					if str((rv as Dictionary).get("kind", "")) == "pinemhi":
						pinemhi_rows += 1
				_pinemhi2_expect(pinemhi_rows == 0, "room baseline: no weekly rows before data lands")
				_pinemhi2_smoke_baseline_done = true
				# The fixture data lands through Main's own
				# door, as a cache push would: saved stamp,
				# not live. His name comes from the harness's
				# Personal shelf (JB1980 bests) via the push.
				_pinemhi2_contests = _pinemhi2_fixture_contests()
				_pinemhi2_fetched_at = int(Time.get_unix_time_from_system()) - 3600
				_pinemhi2_live = false
				_pinemhi2_fetch_error = ""
				_push_pinemhi2_data()
				_pinemhi2_smoke_phase = 3
				_pinemhi2_smoke_wait = 0
		3:
			# The three weekly panels wear real board faces.
			var rows: Array = _room.tournament_rows()
			var all_real: bool = true
			var seen: int = 0
			for i: int in range(rows.size()):
				if str((rows[i] as Dictionary).get("kind", "")) != "pinemhi":
					continue
				seen += 1
				if i >= _room._panels.size():
					all_real = false
					continue
				var tex: Texture2D = _room._panels[i].current_texture()
				if tex == null or tex.get_size() != Vector2(RoomSpecs.board_face_px()):
					all_real = false
			if seen == 3 and all_real:
				_pinemhi2_room_legs()
				_pinemhi2_smoke_phase = 4
				_pinemhi2_smoke_wait = 0
		4:
			# FIELDPASS grab, first of the pair: the room as
			# the legs left it - focus standing on a WoVP
			# challenge card, its frame up, its board beside
			# it frameless (the flat camera does not follow
			# the drum, so the wall stands wide). Then focus
			# takes the Weekly 5-Minute panel, centred, for
			# the pair's second shot.
			if _pinemhi2_smoke_wait > 25:
				var grab4: String = OS.get_environment("PVLDS_PINEMHI2_GRAB")
				if grab4 != "":
					var img4: Image = get_viewport().get_texture().get_image()
					var wpath: String = grab4.replace(".png", "-wovp-focused.png")
					var werr: Error = img4.save_png(wpath)
					print("PVLDS PINEMHI2 GRAB: ", wpath, " err=", werr, " size=", img4.get_size())
				var rows4c: Array = _room.tournament_rows()
				for i4c: int in range(rows4c.size()):
					if str((rows4c[i4c] as Dictionary).get("kind", "")) == "pinemhi" \
							and str((_room._visible_games[i4c] as GameEntry).game_id) == "pinemhi:five":
						_room._set_centre(i4c, true)
						_room._set_focused(_room._panels[i4c])
						break
				_pinemhi2_smoke_phase = 5
				_pinemhi2_smoke_wait = 0
		5:
			# Grabs: the focused weekly panel's room shot,
			# plus each weekly panel's own rendered board
			# face - the pixels the panel shows - for the
			# legibility eyeball.
			if _pinemhi2_smoke_wait > 25:
				var grab: String = OS.get_environment("PVLDS_PINEMHI2_GRAB")
				if grab != "":
					var img: Image = get_viewport().get_texture().get_image()
					var err: Error = img.save_png(grab)
					print("PVLDS PINEMHI2 GRAB: ", grab, " err=", err, " size=", img.get_size())
					var rows4: Array = _room.tournament_rows()
					for i4: int in range(rows4.size()):
						if str((rows4[i4] as Dictionary).get("kind", "")) != "pinemhi":
							continue
						if i4 >= _room._panels.size():
							continue
						var ftex: Texture2D = _room._panels[i4].current_texture()
						if ftex == null:
							continue
						var cid4: String = str((_room._visible_games[i4] as GameEntry).game_id).trim_prefix("pinemhi:")
						var fpath: String = grab.replace(".png", "-" + cid4 + ".png")
						var ferr: Error = ftex.get_image().save_png(fpath)
						print("PVLDS PINEMHI2 GRAB: ", fpath, " err=", ferr, " size=", ftex.get_size())
				_finish_pinemhi2_smoke()


## failstate variant (the tournament-full flag's diagnosis):
## the boot's own weekly fetch fails with no cache standing
## (fresh harness home; the base URL is the site's own - on
## this sandbox direct egress is broken, which is exactly
## the flagged condition), while fabricated WoVP challenges
## stand live. The ONE weekly failure row must stand behind
## them, and its panel must carry a real rendered board
## face - the tournament standing-board checks, read off
## the panel the face actually lives on (a weekly row has
## no companion board; board_state() reports none for it,
## by design - see RoomView.board_state).
func _drive_pinemhi2_failstate() -> void:
	match _pinemhi2_smoke_phase:
		1:
			if _room != null and _room.visible and _room.wall_ready:
				_wovp_challenges = [
					_pinemhi_fab_challenge("pinemhi2-alpha", "Apollo 13"),
					_pinemhi_fab_challenge("pinemhi2-beta", "Medieval Madness"),
					_pinemhi_fab_challenge("pinemhi2-gamma", "Twilight Zone"),
				]
				_wovp_user_id = "smoke-user"
				_wovp_boards_live = true
				_wovp_fetched_at = int(Time.get_unix_time_from_system())
				_push_wovp_data()
				_room._handle_rail("tournament")
				_pinemhi2_expect(_room.tournament_active(), "failstate: the TOURNAMENT stop raises the Tournament Room")
				_pinemhi2_smoke_phase = 2
				_pinemhi2_smoke_wait = 0
		2:
			var settled: bool = _pinemhi_client != null and not _pinemhi_client.is_busy() \
				and _pinemhi2_fetch_error != "" and _pinemhi2_contests.is_empty() and _pinemhi2_fetched_at == 0
			if not settled:
				return
			var rows: Array = _room.tournament_rows()
			var pidx: int = -1
			var pcount: int = 0
			for i: int in range(rows.size()):
				if str((rows[i] as Dictionary).get("kind", "")) == "pinemhi":
					pcount += 1
					pidx = i
			if pidx < 0 or pidx >= _room._panels.size():
				return
			var tex: Texture2D = _room._panels[pidx].current_texture()
			var ready: bool = tex != null and tex.get_size() == Vector2(RoomSpecs.board_face_px()) and _room._tex_is_real(tex)
			if (ready and _pinemhi2_smoke_wait > 25) or _pinemhi2_smoke_wait > 900:
				print("PVLDS PINEMHI2 FAILSTATE ERROR: ", _pinemhi2_fetch_error)
				_pinemhi2_expect(pcount == 1, "failstate: exactly one weekly failure row stands behind the WoVP boards (got %d)" % pcount)
				var row: Dictionary = rows[pidx] as Dictionary
				var game: GameEntry = row.get("game") as GameEntry
				_pinemhi2_expect(game != null and game.game_id == "pinemhi:state" and game.title == "PINemHi Weekly",
					"failstate: the failure row is the PINemHi Weekly state panel")
				var spec: Dictionary = _room.pinemhi_board_spec_for(pidx)
				_pinemhi2_expect(str(spec.get("band_text", "")) == "PINEMHI - WEEKLY" and str(spec.get("title", "")) == "PINemHi Weekly",
					"failstate: the failure face spec wears the PINemHi band and title")
				var spec_joined: String = ""
				for rv: Variant in (spec.get("rows", []) as Array):
					spec_joined += str((rv as Dictionary).get("text", "")) + " "
				_pinemhi2_expect(spec_joined.contains("PINemHi weekly boards could not be fetched."),
					"failstate: the failure face says in plain words that the weekly boards could not be fetched")
				var ink: float = _tournament_tex_ink_stdev(tex)
				_pinemhi2_expect(_room._panels[pidx].visible and tex != null
						and tex.get_size() == Vector2(RoomSpecs.board_face_px()) and _room._tex_is_real(tex) and ink > 0.02,
					"failstate: the failure-state board stands open at rest - visible, %dx%d, real, inked (size %s, real %s, ink stdev %.3f)"
						% [RoomSpecs.BOARD_FACE_PX.x, RoomSpecs.BOARD_FACE_PX.y, str(tex.get_size()) if tex != null else "none", str(_room._tex_is_real(tex)), ink])
				_room._set_centre(pidx, true)
				_pinemhi2_smoke_phase = 3
				_pinemhi2_smoke_wait = 0
		3:
			if _pinemhi2_smoke_wait > 25:
				var grab: String = OS.get_environment("PVLDS_PINEMHI2_GRAB")
				if grab != "":
					var img: Image = get_viewport().get_texture().get_image()
					var err: Error = img.save_png(grab)
					print("PVLDS PINEMHI2 GRAB: ", grab, " err=", err, " size=", img.get_size())
					var rows3: Array = _room.tournament_rows()
					for i3: int in range(rows3.size()):
						if str((rows3[i3] as Dictionary).get("kind", "")) != "pinemhi":
							continue
						if i3 >= _room._panels.size():
							continue
						var ftex: Texture2D = _room._panels[i3].current_texture()
						if ftex == null:
							continue
						var fpath: String = grab.replace(".png", "-face.png")
						var ferr: Error = ftex.get_image().save_png(fpath)
						print("PVLDS PINEMHI2 GRAB: ", fpath, " err=", ferr, " size=", ftex.get_size())
				_finish_pinemhi2_smoke()


func _pinemhi2_room_legs() -> void:
	var rows: Array = _room.tournament_rows()
	var pinemhi_idx: Array = []
	var challenge_idx: Array = []
	for i: int in range(rows.size()):
		var kind: String = str((rows[i] as Dictionary).get("kind", ""))
		if kind == "pinemhi":
			pinemhi_idx.append(i)
		elif kind == "challenge":
			challenge_idx.append(i)
	_pinemhi2_expect(pinemhi_idx.size() == 3, "room: three weekly rows stand (got %d)" % pinemhi_idx.size())
	_pinemhi2_expect(challenge_idx.size() == 3 and (pinemhi_idx.is_empty() or int(pinemhi_idx[0]) > int(challenge_idx[challenge_idx.size() - 1])), "room: the weekly rows stand after the WoVP rows")
	var ids: Array = []
	for i2: Variant in pinemhi_idx:
		ids.append(str((_room._visible_games[int(i2)] as GameEntry).game_id))
	_pinemhi2_expect(ids == ["pinemhi:main", "pinemhi:five", "pinemhi:golf"], "room: weekly panels are main, five, golf in order (got %s)" % str(ids))
	# His name rode the push (the harness shelf's JB1980 bests).
	var state: Dictionary = _room.pinemhi_weekly_state()
	_pinemhi2_expect(str(state.get("player_name", "")) == "JB1980", "room: his name derived at push time is JB1980 (got '%s')" % str(state.get("player_name", "")))
	# The stale leg: this push was a cache push - not live -
	# and every weekly board carries the saved line. Under
	# PVLDS_PINEMHI2_NC=stale the push claims live and both
	# halves fail by name.
	_pinemhi2_expect(not bool(state.get("live", true)), "stale: the cache push reads not-live")
	if pinemhi_idx.size() == 3:
		var specs: Dictionary = {}
		for i3: Variant in pinemhi_idx:
			var sp: Dictionary = _room.pinemhi_board_spec_for(int(i3))
			specs[str(sp.get("band_text", ""))] = sp
		var main_spec: Dictionary = specs.get("PINEMHI - WEEKLY COMPETITION", {}) as Dictionary
		_pinemhi2_expect(not main_spec.is_empty(), "room: the main board spec stands")
		if not main_spec.is_empty():
			_pinemhi2_expect(str(main_spec.get("title", "")) == "Rolling Stones", "room main: title is the contest's table")
			_pinemhi2_expect(str(main_spec.get("sub", "")) == "Nov 1 - Nov 8", "room main: sub is the shortened window (got '%s')" % str(main_spec.get("sub", "")))
			var srows: Array = _pinemhi2_spec_score_rows(main_spec)
			_pinemhi2_expect(srows.size() == 6, "room main: 6 score rows (got %d)" % srows.size())
			if not srows.is_empty():
				var s0: Dictionary = srows[0] as Dictionary
				_pinemhi2_expect(str(s0.get("name_text", "")) == "RetroGeek" and str(s0.get("score_text", "")) == "8,014,130", "room main: row 1 RetroGeek 8,014,130")
			var his: Dictionary = _pinemhi2_spec_row_named(main_spec, "JB1980")
			_pinemhi2_expect(bool(his.get("accent", false)) and int(his.get("size", 0)) == 42, "room main: his row (JB1980) takes the accent")
			_pinemhi2_expect(_pinemhi2_spec_has_note(main_spec, "Saved standings - not yet refreshed"), "stale: the main board carries the saved-standings note")
		var five_spec: Dictionary = specs.get("PINEMHI - WEEKLY 5-MINUTE", {}) as Dictionary
		if not five_spec.is_empty():
			_pinemhi2_expect(str(five_spec.get("title", "")) == "Bad Cats", "room five: title is Bad Cats")
			var fhis: Dictionary = _pinemhi2_spec_row_named(five_spec, "JB1980")
			_pinemhi2_expect(str(fhis.get("score_text", "")) == "10,725,280" and bool(fhis.get("accent", false)), "room five: his row leads at 10,725,280, accented")
		# The golf-shape leg: distances ride VERBATIM - the
		# pin note first, then "-620" and "-1.450", never
		# comma-formatted scores. PVLDS_PINEMHI2_NC=golfscore
		# breaks exactly this leg by name.
		var golf_spec: Dictionary = specs.get("PINEMHI - WEEKLY GOLF", {}) as Dictionary
		_pinemhi2_expect(not golf_spec.is_empty(), "golf-shape: the golf board spec stands")
		if not golf_spec.is_empty():
			var grows2: Array = golf_spec.get("rows", []) as Array
			_pinemhi2_expect(not grows2.is_empty() and str((grows2[0] as Dictionary).get("kind", "")) == "note" and str((grows2[0] as Dictionary).get("text", "")) == "Pin is set at 43,900 - closest to the pin wins", "golf-shape: the pin note stands first")
			var gsrows: Array = _pinemhi2_spec_score_rows(golf_spec)
			_pinemhi2_expect(gsrows.size() == 2, "golf-shape: 2 distance rows (got %d)" % gsrows.size())
			if gsrows.size() == 2:
				_pinemhi2_expect(str((gsrows[0] as Dictionary).get("score_text", "")) == "-620", "golf-shape: row 1 distance is -620 verbatim (got '%s')" % str((gsrows[0] as Dictionary).get("score_text", "")))
				_pinemhi2_expect(str((gsrows[1] as Dictionary).get("score_text", "")) == "-1.450", "golf-shape: row 2 distance is -1.450 verbatim (got '%s')" % str((gsrows[1] as Dictionary).get("score_text", "")))
			var ghis: Dictionary = _pinemhi2_spec_row_named(golf_spec, "JB1980")
			_pinemhi2_expect(bool(ghis.get("accent", false)), "golf-shape: his distance row takes the accent")
	# The WoVP-unaffected leg: the standing WoVP boards'
	# keys and seats are the baseline's, unchanged by the
	# weekly rows standing behind them.
	var now_boards: Array = []
	for e: Variant in _room.board_state():
		var entry: Dictionary = e as Dictionary
		if str(entry.get("challenge_id", "")) != "":
			now_boards.append({
				"challenge_id": entry.get("challenge_id"),
				"card_coord": entry.get("card_coord"),
				"board_coord": entry.get("board_coord"),
				"standing_key": entry.get("standing_key"),
			})
	_pinemhi2_expect(now_boards == _pinemhi2_smoke_boot_boards, "room: WoVP boards' keys and seats unchanged with weekly data standing")
	# The weekly rows carry no companion board.
	var companions_clear: bool = true
	for e2: Variant in _room.board_state():
		var entry2: Dictionary = e2 as Dictionary
		var ridx: int = int(entry2.get("idx", -1))
		if ridx >= 0 and ridx < rows.size() and str((rows[ridx] as Dictionary).get("kind", "")) == "pinemhi":
			if bool(entry2.get("board_visible", true)) or str(entry2.get("standing_key", "x")) != "":
				companions_clear = false
	_pinemhi2_expect(companions_clear, "room: weekly rows stand with no companion board quad")
	# FIELDPASS (item 2): the focus dress of a weekly
	# panel. Its face is frameless, so a filled focus
	# frame behind it stands through the whole panel as
	# a solid slab (the field's cyan board). The weekly
	# panel carries NO highlight frame - its focus reads
	# off its pop and band - while a WoVP challenge CARD
	# keeps its frame exactly as before. Under
	# PVLDS_FIELDPASS_NC=slab the frame returns and the
	# weekly half fails by name. The legs leave focus on
	# the challenge card; the grab phases below take the
	# focused-WoVP shot first, then the focused-weekly one.
	if not pinemhi_idx.is_empty() and not challenge_idx.is_empty():
		var wpanel: ClickableQuad = _room._panels[int(pinemhi_idx[1])]
		_room._set_focused(wpanel)
		_pinemhi2_expect(not wpanel.highlight_visible(),
			"focus frame: a focused weekly panel shows no filled focus frame - frameless like a focused WoVP board")
		var cpanel: ClickableQuad = _room._panels[int(challenge_idx[0])]
		_room._set_focused(cpanel)
		_pinemhi2_expect(cpanel.highlight_visible(),
			"focus frame: a focused WoVP card still shows its highlight frame")
	# A-press on a centred weekly panel launches nothing:
	# its game has no builds and the tournament launch law
	# seats challenges only.
	if not pinemhi_idx.is_empty():
		_room.launch_requested.connect(func(_g: GameEntry) -> void: _pinemhi2_launch_seen = true)
		_room._set_centre(int(pinemhi_idx[0]), true)
		_room._a_press()
		_pinemhi2_expect(not _pinemhi2_launch_seen, "room: A-press on a weekly panel is inert (no launch)")


func _pinemhi2_spec_score_rows(spec: Dictionary) -> Array:
	var out: Array = []
	for rv: Variant in (spec.get("rows", []) as Array):
		var r: Dictionary = rv as Dictionary
		if str(r.get("kind", "")) == "score":
			out.append(r)
	return out


func _pinemhi2_spec_row_named(spec: Dictionary, player: String) -> Dictionary:
	for rv: Variant in (spec.get("rows", []) as Array):
		var r: Dictionary = rv as Dictionary
		if str(r.get("kind", "")) == "score" and str(r.get("name_text", "")) == player:
			return r
	return {}


func _pinemhi2_spec_has_note(spec: Dictionary, text: String) -> bool:
	for rv: Variant in (spec.get("rows", []) as Array):
		var r: Dictionary = rv as Dictionary
		if str(r.get("kind", "")) == "note" and str(r.get("text", "")) == text:
			return true
	return false


## The honesty and his-row legs double as the negative
## controls' targets: PVLDS_WOVP_NC=clientid makes the
## client send Studio's id (the honesty leg fails by name);
## the stub's baduser variant renames his board rows (the
## his-row legs fail by name).
func _drive_tournament_smoke() -> void:
	match _tournament_smoke_mode:
		"pinemhi":
			_drive_tournament_pinemhi()
		"nokey":
			_drive_tournament_state_mode(false)
		"failfetch", "errbody", "errempty":
			_drive_tournament_state_mode(true)
		"cache":
			_drive_tournament_cache_mode()
		"layout":
			_drive_tournament_layout()
		_:
			_drive_tournament_full()


## pinemhi mode (NEXTROUND item 4): the personal-best board
## line. No stub - the challenges are fabricated in the
## driver and pushed through Main's own push, and the
## harness config points pinemhi_folder at a fixture install
## holding the REAL apollo13.txt plus a fabricated Medieval
## Madness file. Legs: the line lands on the matching
## boards with the file's own dotted score, subordinate
## (a note row, last, never a score row); the unmatched
## challenge stays clean; the rendered boards' content keys
## carry the best; clearing the bests re-renders it away
## and a re-push restores it. PVLDS_PINEMHI_NC=nobest drops
## the line in the spec - the spec legs fail by name.
func _drive_tournament_pinemhi() -> void:
	match _tournament_smoke_phase:
		0:
			if _room != null and _room.visible and _room.wall_ready:
				var apollo: WovpChallenge = _pinemhi_fab_challenge("pinemhi-apollo", "Apollo 13")
				var medieval: WovpChallenge = _pinemhi_fab_challenge("pinemhi-medieval", "Medieval Madness")
				var twilight: WovpChallenge = _pinemhi_fab_challenge("pinemhi-twilight", "Twilight Zone")
				_wovp_challenges = [apollo, medieval, twilight]
				_wovp_user_id = "smoke-user"
				_wovp_boards_live = true
				_wovp_fetched_at = int(Time.get_unix_time_from_system())
				_push_wovp_data()
				_tournament_leg_pinemhi_specs(apollo, medieval, twilight)
				_room._handle_rail("tournament")
				_tournament_expect(_room.tournament_active(), "pinemhi: the TOURNAMENT stop raises the Tournament Room")
				_tournament_smoke_deadline_msec = Time.get_ticks_msec() + 45000
				_tournament_smoke_phase = 1
			else:
				_tournament_smoke_wait += 1
				if _tournament_smoke_wait > 3600:
					_tournament_fail("the room never came up")
					_finish_tournament_smoke()
		1:
			var ea: Dictionary = _pinemhi_board_entry("pinemhi-apollo")
			var em: Dictionary = _pinemhi_board_entry("pinemhi-medieval")
			var et: Dictionary = _pinemhi_board_entry("pinemhi-twilight")
			if bool(ea.get("texture_real", false)) and bool(em.get("texture_real", false)) and bool(et.get("texture_real", false)):
				_tournament_expect(str(ea.get("texture_key", "")).contains("|pb:1.638.803.870"),
					"pinemhi: the rendered Apollo 13 board's content carries the personal best (key: %s)" % str(ea.get("texture_key", "")))
				_tournament_expect(str(em.get("texture_key", "")).contains("|pb:2.345.678.901"),
					"pinemhi: the rendered Medieval Madness board's content carries its personal best")
				_tournament_expect(not str(et.get("texture_key", "")).contains("|pb:"),
					"pinemhi: the unmatched Twilight Zone board carries no best line")
				_room.set_pinemhi_bests({})
				_tournament_smoke_deadline_msec = Time.get_ticks_msec() + 30000
				_tournament_smoke_phase = 2
			elif Time.get_ticks_msec() > _tournament_smoke_deadline_msec:
				_tournament_fail("pinemhi: the boards never rendered")
				_finish_tournament_smoke()
		2:
			var ea2: Dictionary = _pinemhi_board_entry("pinemhi-apollo")
			if bool(ea2.get("texture_real", false)) and not str(ea2.get("texture_key", "")).contains("|pb:"):
				_tournament_expect(true, "pinemhi: clearing the bests re-renders the line away (the toggle-off / no-folder case)")
				_push_wovp_data()
				_tournament_smoke_deadline_msec = Time.get_ticks_msec() + 30000
				_tournament_smoke_phase = 3
			elif Time.get_ticks_msec() > _tournament_smoke_deadline_msec:
				_tournament_fail("pinemhi: the cleared board never re-rendered")
				_finish_tournament_smoke()
		3:
			var ea3: Dictionary = _pinemhi_board_entry("pinemhi-apollo")
			if bool(ea3.get("texture_real", false)) and str(ea3.get("texture_key", "")).contains("|pb:1.638.803.870"):
				_tournament_expect(true, "pinemhi: a fresh push restores the line")
				_finish_tournament_smoke()
			elif Time.get_ticks_msec() > _tournament_smoke_deadline_msec:
				_tournament_fail("pinemhi: the restored board never re-rendered")
				_finish_tournament_smoke()


## One fabricated challenge for the pinemhi mode: two league
## rows, the second his, on a season board ending in 3 days.
func _pinemhi_fab_challenge(cid: String, table: String) -> WovpChallenge:
	var ch: WovpChallenge = WovpChallenge.new()
	ch.challenge_id = cid
	ch.name = table + " - Season Challenge"
	ch.table_name = table
	ch.type_code = WovpChallenge.TYPE_SEASON
	ch.end_unix = int(Time.get_unix_time_from_system()) + 3 * 86400
	var r1: WovpScoreRow = WovpScoreRow.new()
	r1.position = 1
	r1.participant_name = "Leader"
	r1.score = 2000000000.0
	var r2: WovpScoreRow = WovpScoreRow.new()
	r2.position = 2
	r2.participant_name = "Smoke"
	r2.score = 1000000000.0
	r2.user_id = "smoke-user"
	ch.rows = [r1, r2]
	return ch


## The pinemhi mode's spec legs: the board spec each
## challenge would render with, fed the best the room
## itself was handed by the push.
func _tournament_leg_pinemhi_specs(apollo: WovpChallenge, medieval: WovpChallenge, twilight: WovpChallenge) -> void:
	var bests: Dictionary = _room._pinemhi_bests
	_tournament_expect(bests.size() == 2,
		"pinemhi: two personal bests were read from the fixture install (got %d)" % bests.size())
	var now_unix: int = int(Time.get_unix_time_from_system())
	var cases: Array = [
		[apollo, "Your PINemHi best: 1.638.803.870", "Apollo 13"],
		[medieval, "Your PINemHi best: 2.345.678.901", "Medieval Madness"],
		[twilight, "", "Twilight Zone"],
	]
	for case_v: Variant in cases:
		var case_a: Array = case_v
		var ch: WovpChallenge = case_a[0] as WovpChallenge
		var want: String = str(case_a[1])
		var tname: String = str(case_a[2])
		var best: Dictionary = bests.get(PinemhiScores.challenge_key(ch.table_name), {}) as Dictionary
		var spec: Dictionary = RoomSpecs.tournament_board_spec(ch, false, _wovp_user_id, now_unix, true, best)
		var rows: Array = spec.get("rows", []) as Array
		var found_at: int = -1
		var score_carries: bool = false
		for i: int in range(rows.size()):
			var rd: Dictionary = rows[i] as Dictionary
			if str(rd.get("text", "")) == want and want != "":
				found_at = i
			if str(rd.get("kind", "")) == "score" and str(rd.get("text", "")).contains("PINemHi"):
				score_carries = true
		if want == "":
			_tournament_expect(found_at == -1 and not score_carries,
				"pinemhi: the unmatched challenge (%s) shows no best line" % tname)
		else:
			_tournament_expect(found_at == rows.size() - 1 and str((rows[found_at] as Dictionary).get("kind", "")) == "note",
				"pinemhi: %s board ends with the subordinate best line '%s'" % [tname, want])
			_tournament_expect(not score_carries,
				"pinemhi: %s best never rides a league score row" % tname)


## A standing board's state entry by challenge id (the
## pinemhi mode's rendered-path read).
func _pinemhi_board_entry(cid: String) -> Dictionary:
	if _room == null:
		return {}
	for e: Variant in _room.board_state():
		var ed: Dictionary = e
		if str(ed.get("challenge_id", "")) == cid:
			return ed
	return {}


## layout mode: the board-presentation contract against the
## stub's worst-case boards - the score column's law, the
## no-Launch-furniture law (GRADFIX10: the standing board
## reserves no footer band) and the frame-centring law,
## proven on measured layout and on rendered ink, not on
## how the code reads.
func _drive_tournament_layout() -> void:
	match _tournament_smoke_phase:
		0:
			if _room != null and _room.visible and _room.wall_ready:
				_room._handle_rail("tournament")
				_tournament_expect(_room.tournament_active(), "layout: the TOURNAMENT stop raises the Tournament Room")
				_tournament_smoke_deadline_msec = Time.get_ticks_msec() + 45000
				_tournament_smoke_phase = 1
			else:
				_tournament_smoke_wait += 1
				if _tournament_smoke_wait > 3600:
					_tournament_fail("the room never came up")
					_finish_tournament_smoke()
		1:
			if _wovp_boards_live and _wovp_client != null and not _wovp_client.is_busy() and _room._panels.size() >= 2 \
					and _pinemhi_settled() and _tournament_weekly_panels_ready():
				_tournament_leg_layout_boards()
				_layout_start_probes()
				_layout_wing_probe_start()
				_tournament_smoke_deadline_msec = Time.get_ticks_msec() + 30000
				_tournament_smoke_phase = 2
			elif Time.get_ticks_msec() > _tournament_smoke_deadline_msec:
				_tournament_fail("layout: the boards never went live against the stub")
				_finish_tournament_smoke()
		2:
			if not _layout_probes_in_flight and _layout_probe_results.size() >= 2 and _layout_wing_probe_done:
				_tournament_leg_layout()
				_tournament_leg_wing_board()
				_tournament_sky_begin()
			elif Time.get_ticks_msec() > _tournament_smoke_deadline_msec:
				_tournament_fail("layout: the board layout probes never landed")
				_finish_tournament_smoke()
		3:
			_tournament_smoke_wait += 1
			if _tournament_smoke_wait > 10:
				_tournament_leg_sky_nadir()
				_finish_tournament_smoke()
			elif Time.get_ticks_msec() > _tournament_smoke_deadline_msec:
				_tournament_fail("layout sky: the nadir frame never settled")
				_finish_tournament_smoke()


## The GRADFIX5 sky-nadir stage's setup (layout phase 3):
## the drum steps out, the camera pitches to the nadir -
## the Tournament Room's down view, judged on the same
## density measures as the library's. (GRADFIX9: the
## wireframe shell that used to step out here no longer
## exists - Chris's 2026-10-31 order dropped it entirely,
## so there is nothing to hide and nothing to restore.)
func _tournament_sky_begin() -> void:
	var cam: Camera3D = _room._active_camera()
	if cam != null:
		cam.rotation_degrees = Vector3(-90.0, 0.0, 0.0)
	if _room.drum_node() != null:
		_room.drum_node().visible = false
	_tournament_smoke_wait = 0
	_tournament_smoke_deadline_msec = Time.get_ticks_msec() + 30000
	_tournament_smoke_phase = 3


func _tournament_leg_sky_nadir() -> void:
	# GRADFIX5 (item 2): the Tournament Room shares the
	# library's sky and shared its fault - the retired floor
	# slab ate the lower half here too (his verdict named
	# both rooms). Straight down with the drum hidden: the
	# grad smoke's nadir questions, asked in this view.
	# Under PVLDS_GRADFIX5_NC=floor (the slab restored)
	# this leg fails by name.
	var img: Image = get_viewport().get_texture().get_image()
	var grab_dir: String = OS.get_environment("PVLDS_GRAB_DIR")
	if grab_dir != "" and img != null and not img.is_empty():
		img.save_png(grab_dir.path_join("tournament_sky_nadir.png"))
	var dd: Vector2 = _grad_sky_density(img)
	_tournament_expect(dd.x > 0.45 and dd.x < 2.2,
		"layout sky: looking straight down in the Tournament Room, the stars are still there - no bare lower half (coverage centre/ring %.2f)" % dd.x)
	_tournament_expect(dd.y > 0.35 and dd.y < 5.0,
		"layout sky: the Tournament Room's nadir star count stays even (count-density centre/ring %.2f; STARFIELD calibration as at the grad nadir leg, bound 5.0)" % dd.y)
	# GRADFIX9: the wireframe shell is GONE from this view
	# too (one room, one environment - the Tournament Room
	# is the same Room re-dressed): zero shell nodes by
	# census, and the nadir grab shows stars only, no
	# dim-line convergence at the centre (Chris's
	# 2026-10-31 order: drop the shell entirely).
	_tournament_expect(_room.wireframe_shell_count() == 0,
		"layout sky: zero wireframe shell nodes stand in the room (Tournament view; got %d - GRADFIX9: the shell is removed entirely, Chris's 2026-10-31 order)" % _room.wireframe_shell_count())
	var tline: float = _grad_sky_line_ratio(img)
	_tournament_expect(tline > 0.25 and tline < 2.50,
		"layout sky: no wireframe lines converge at the Tournament Room's nadir - stars only (dim-line centre/ring %.2f; GRADFIX9: shell removed, Chris's 2026-10-31 order; STARFIELD floor re-based at 0.25 as at the grad nadir leg)" % tline)
	var cam: Camera3D = _room._active_camera()
	if cam != null:
		cam.rotation_degrees = Vector3.ZERO
	if _room.drum_node() != null:
		_room.drum_node().visible = true


## GRADFIX7 item 2 helpers: the standing boards' state for
## one row, the side the layout law assigns it, the side
## assertion every centre judge makes, and an ink measure
## for a board texture (luminance stdev over a coarse grid -
## a real rendered board has text ink; the factory's
## fallback solid, and the solidboard NC's counterfeit,
## have none).
func _tournament_board_entry(idx: int) -> Dictionary:
	var bs: Array = _room.board_state()
	if idx < 0 or idx >= bs.size():
		return {}
	return bs[idx] as Dictionary


## PINEMHI2 harness contract: the Tournament Room's rows are
## the WoVP challenges FIRST and the PINemHi weekly panels
## behind them (RoomView._build_tournament_rows). The WoVP
## legs judge the challenge subset; the weekly legs judge
## the weekly panels. A weekly panel's face lives on its
## own panel (it has no companion board - board_state()
## reports none for it, by design), so its standing checks
## read the panel's texture, never board_state().
func _tournament_challenge_indices(rows: Array) -> Array[int]:
	var out: Array[int] = []
	for i: int in range(rows.size()):
		if str((rows[i] as Dictionary).get("kind", "")) == "challenge":
			out.append(i)
	return out


func _tournament_weekly_indices(rows: Array) -> Array[int]:
	var out: Array[int] = []
	for i: int in range(rows.size()):
		if str((rows[i] as Dictionary).get("kind", "")) == "pinemhi":
			out.append(i)
	return out


## The boot/refresh weekly fetch has answered (live, from
## cache, or with a stated failure) and none is in flight -
## the moment the weekly rows on the wall are the settled
## ones, not a shape a landing push is about to replace.
func _pinemhi_settled() -> bool:
	return _pinemhi_client != null and not _pinemhi_client.is_busy() \
		and (_pinemhi2_live or _pinemhi2_fetch_error != "" or _pinemhi2_fetched_at > 0 or not _pinemhi2_contests.is_empty())


## Every standing weekly panel wears a real rendered board
## face at the board's size (vacuously true when none stand).
func _tournament_weekly_panels_ready() -> bool:
	var rows: Array = _room.tournament_rows()
	for idx: int in _tournament_weekly_indices(rows):
		if idx >= _room._panels.size():
			return false
		var tex: Texture2D = _room._panels[idx].current_texture()
		if tex == null or tex.get_size() != Vector2(RoomSpecs.board_face_px()) or not _room._tex_is_real(tex):
			return false
	return true


## GRADFIX15 frameless judge, shared by the standing
## companion boards and the weekly panels: the face is its
## text block on transparency - corners clear, a real share
## of sampled pixels transparent. Under PVLDS_GF15_NC=
## panelfill the fill returns and this leg fails by name.
func _tournament_expect_frameless(tex: Texture2D, tname: String) -> void:
	var fimg: Image = tex.get_image() if tex != null else null
	var corners_clear: bool = false
	var transp_pct: int = 0
	if fimg != null and not fimg.is_empty():
		var fw: int = fimg.get_width()
		var fh: int = fimg.get_height()
		corners_clear = fimg.get_pixel(0, 0).a == 0.0 and fimg.get_pixel(fw - 1, 0).a == 0.0 \
			and fimg.get_pixel(0, fh - 1).a == 0.0 and fimg.get_pixel(fw - 1, fh - 1).a == 0.0
		var samp_n: int = 0
		var samp_t: int = 0
		for sy: int in range(0, fh, 16):
			for sx: int in range(0, fw, 16):
				samp_n += 1
				if fimg.get_pixel(sx, sy).a == 0.0:
					samp_t += 1
		transp_pct = int(round(100.0 * float(samp_t) / float(maxi(1, samp_n))))
	_tournament_expect(corners_clear and transp_pct >= 10,
		"frameless board: '%s' board face is its text block on transparency - corners clear %s, %d%% of sampled pixels transparent (PVLDS_GF15_NC=panelfill restores the panel fill and this leg fails by name)"
			% [tname, str(corners_clear), transp_pct])


## PINEMHI2 harness contract: the weekly panels' legs, in
## whichever shape the settled weekly state legitimately
## stands - three contest boards when weekly data is
## present, the ONE plain-word failure-state board when a
## dead fetch left nothing and no cache stands (a designed
## state, judged with the same standing-board checks as any
## board: visible, the board's size, real, inked, frameless
## - read off the panel, the surface its face lives on).
func _tournament_leg_weekly_panels() -> void:
	var rows: Array = _room.tournament_rows()
	var ch_idx: Array[int] = _tournament_challenge_indices(rows)
	var w_idx: Array[int] = _tournament_weekly_indices(rows)
	if not _pinemhi2_contests.is_empty():
		_tournament_expect(w_idx.size() == _pinemhi2_contests.size(),
			"weekly boards: the weekly boards stand behind the WoVP rows (%d contests, %d panels)" % [_pinemhi2_contests.size(), w_idx.size()])
	elif _pinemhi2_fetch_error != "" and _pinemhi2_fetched_at == 0:
		_tournament_expect(w_idx.size() == 1,
			"weekly boards: the one PINemHi failure-state board stands behind the WoVP rows (got %d panels)" % w_idx.size())
	else:
		_tournament_expect(w_idx.is_empty(),
			"weekly boards: no weekly panels stand before the first weekly fetch lands (got %d)" % w_idx.size())
	if not ch_idx.is_empty() and not w_idx.is_empty():
		_tournament_expect(w_idx[0] > ch_idx[ch_idx.size() - 1],
			"weekly boards: the weekly panels stand after the WoVP rows")
	for idx: int in w_idx:
		var tname: String = _tournament_row_table_name(rows[idx] as Dictionary)
		var tex: Texture2D = _room._panels[idx].current_texture() if idx < _room._panels.size() else null
		var ink: float = _tournament_tex_ink_stdev(tex)
		_tournament_expect(idx < _room._panels.size() and _room._panels[idx].visible and tex != null
				and tex.get_width() == RoomSpecs.BOARD_FACE_PX.x and tex.get_height() == RoomSpecs.BOARD_FACE_PX.y
				and _room._tex_is_real(tex) and ink > 0.02,
			"standing board: '%s' board stands open at rest - visible, %dx%d, real, inked (size %s, real %s, ink stdev %.3f)"
				% [tname, RoomSpecs.BOARD_FACE_PX.x, RoomSpecs.BOARD_FACE_PX.y, str(tex.get_size()) if tex != null else "none", str(_room._tex_is_real(tex)), ink])
		_tournament_expect_frameless(tex, tname)


## PINEMHI2 harness contract (full mode phases 17/18): the
## weekly-present shape - after the fixture contests land
## through Main's own push, the three weekly boards stand
## after the WoVP rows in the client's order, each face
## judged by the weekly legs, the board contents match
## their contests (golf's distances verbatim), and the
## WoVP boards' keys and seats are the pre-push record's.
func _tournament_leg_weekly_present() -> void:
	var rows: Array = _room.tournament_rows()
	var w_idx: Array[int] = _tournament_weekly_indices(rows)
	var ids: Array = []
	for idx: int in w_idx:
		ids.append(str((_room._visible_games[idx] as GameEntry).game_id))
	_tournament_expect(ids == ["pinemhi:main", "pinemhi:five", "pinemhi:golf"],
		"weekly present: the weekly panels are main, five, golf in order (got %s)" % str(ids))
	_tournament_leg_weekly_panels()
	var by_band: Dictionary = {}
	for idx2: int in w_idx:
		var sp: Dictionary = _room.pinemhi_board_spec_for(idx2)
		by_band[str(sp.get("band_text", ""))] = sp
	var main_spec: Dictionary = by_band.get("PINEMHI - WEEKLY COMPETITION", {}) as Dictionary
	_tournament_expect(str(main_spec.get("title", "")) == "Rolling Stones",
		"weekly present: the Weekly Competition board names its table (Rolling Stones)")
	var five_spec: Dictionary = by_band.get("PINEMHI - WEEKLY 5-MINUTE", {}) as Dictionary
	_tournament_expect(str(five_spec.get("title", "")) == "Bad Cats",
		"weekly present: the Weekly 5-Minute board names its table (Bad Cats)")
	var golf_spec: Dictionary = by_band.get("PINEMHI - WEEKLY GOLF", {}) as Dictionary
	var golf_texts: Array = []
	for rv: Variant in (golf_spec.get("rows", []) as Array):
		var rd: Dictionary = rv as Dictionary
		if str(rd.get("kind", "")) == "score":
			golf_texts.append(str(rd.get("score_text", "")))
	_tournament_expect(golf_texts == ["-620", "-1.450"],
		"weekly present: the Weekly Golf board carries its distances verbatim (got %s)" % str(golf_texts))
	var now_boards: Array = []
	for e: Variant in _room.board_state():
		var ed: Dictionary = e as Dictionary
		if str(ed.get("challenge_id", "")) != "":
			now_boards.append({
				"challenge_id": ed.get("challenge_id"),
				"card_coord": ed.get("card_coord"),
				"board_coord": ed.get("board_coord"),
				"standing_key": ed.get("standing_key"),
			})
	_tournament_expect(now_boards == _tournament_weekly_baseline,
		"weekly present: the WoVP boards' keys and seats are unchanged with the weekly boards standing")


func _tournament_expected_board_left(i: int, n: int) -> bool:
	var g: int = i / 2
	var groups: int = maxi(1, int(ceil(float(maxi(1, n)) / 2.0)))
	var gc: float = float(groups - 1) / 2.0
	return float(g) < gc


func _tournament_expect_board_side(i: int, row: Dictionary) -> void:
	var rows: Array = _room.tournament_rows()
	var entry: Dictionary = _tournament_board_entry(i)
	var tname: String = _tournament_row_table_name(row)
	if entry.is_empty():
		_tournament_expect(false, "standing board side: '%s' has a standing board" % tname)
		return
	var card: Vector2i = entry.get("card_coord", Vector2i(-1, -1)) as Vector2i
	var board: Vector2i = entry.get("board_coord", Vector2i(-1, -1)) as Vector2i
	var actual_left: bool = board.x < card.x
	# PINEMHI2: the pair geometry derives from the challenge
	# count alone (the weekly panels never join the pairing -
	# RoomView._tourn_pair_coords), so the side law's n is
	# the challenge subset's size, never the row count.
	var expected_left: bool = _tournament_expected_board_left(i, maxi(1, _tournament_challenge_indices(rows).size()))
	var label: String = "standing board side: '%s' board stands %s of its card (board col %d, card col %d)" % [
		tname, "LEFT" if actual_left else "RIGHT", board.x, card.x]
	if actual_left != expected_left or board.y != card.y:
		label += " - expected %s, on its card's band" % ("LEFT" if expected_left else "RIGHT")
	_tournament_expect(actual_left == expected_left and board.y == card.y, label)


func _tournament_tex_ink_stdev(tex: Texture2D) -> float:
	if tex == null:
		return -1.0
	var img: Image = tex.get_image()
	if img == null or img.is_empty():
		return -1.0
	var mean: float = 0.0
	var cnt: int = 0
	for yy: int in range(0, img.get_height(), 16):
		for xx: int in range(0, img.get_width(), 16):
			mean += img.get_pixel(xx, yy).get_luminance()
			cnt += 1
	mean /= float(maxi(cnt, 1))
	var varr: float = 0.0
	for yy2: int in range(0, img.get_height(), 16):
		for xx2: int in range(0, img.get_width(), 16):
			var d: float = img.get_pixel(xx2, yy2).get_luminance() - mean
			varr += d * d
	return sqrt(varr / float(maxi(cnt, 1)))


func _tournament_boards_all_real() -> bool:
	var bs: Array = _room.board_state()
	if bs.is_empty():
		return false
	for e: Variant in bs:
		var ed: Dictionary = e as Dictionary
		if str(ed.get("challenge_id", "")) == "":
			continue
		if not bool(ed.get("texture_real", false)):
			return false
	return true


## The standing judge (GRADFIX7 item 2): at rest, with no Y
## ever pressed, every challenge's board stands visible
## beside its card - real texture at the board's face size,
## with real ink on it.
func _tournament_leg_standing_boards() -> void:
	var rows: Array = _room.tournament_rows()
	for i: int in range(rows.size()):
		# PINEMHI2: a weekly row's board IS its panel - it has
		# no companion board for board_state() to report, so
		# the companion checks below would measure a surface
		# that does not exist. The weekly panels are judged
		# after this loop, off their panels, by
		# _tournament_leg_weekly_panels.
		if str((rows[i] as Dictionary).get("kind", "")) != "challenge":
			continue
		var entry: Dictionary = _tournament_board_entry(i)
		var tname: String = _tournament_row_table_name(rows[i] as Dictionary)
		var tex: Texture2D = entry.get("texture") as Texture2D
		var ink: float = _tournament_tex_ink_stdev(tex)
		_tournament_expect(bool(entry.get("board_visible", false)) and tex != null
				and tex.get_width() == RoomSpecs.BOARD_FACE_PX.x and tex.get_height() == RoomSpecs.BOARD_FACE_PX.y
				and bool(entry.get("texture_real", false)) and ink > 0.02,
			"standing board: '%s' board stands open at rest - visible, %dx%d, real, inked (size %s, real %s, ink stdev %.3f)"
				% [tname, RoomSpecs.BOARD_FACE_PX.x, RoomSpecs.BOARD_FACE_PX.y, str(tex.get_size()) if tex != null else "none", str(bool(entry.get("texture_real", false))), ink])
		# GRADFIX15 (items 1+2): the standing board's face is
		# FRAMELESS - its corners are clear and a real share
		# of its pixels are transparent, because the texture
		# is the text block alone, with no panel fill and no
		# spine line behind it. (The grad smoke's census
		# judges every pixel; this leg samples the standing
		# texture in the room.) Under PVLDS_GF15_NC=panelfill
		# the fill returns, the corners go opaque and this
		# leg fails by name.
		_tournament_expect_frameless(tex, tname)
	_tournament_leg_weekly_panels()


func _tournament_leg_layout_boards() -> void:
	var rows: Array = _room.tournament_rows()
	# PINEMHI2: the layout legs judge the two seeded
	# challenges; the weekly panels behind them are judged
	# by the weekly legs at this function's end.
	var ch_idx: Array[int] = _tournament_challenge_indices(rows)
	_tournament_expect(ch_idx.size() == 2, "layout: the two seeded worst-case challenges stand (got %d)" % ch_idx.size())
	var owned_flags: Array = []
	for ci: int in ch_idx:
		owned_flags.append(bool((rows[ci] as Dictionary).get("owned", false)))
	_tournament_expect(owned_flags == [true, true],
		"layout: both seeded boards are his tables (owned - his rows stand on them; GRADFIX10: no footer stands on a standing board)")
	# The redesign's shape (the GRAD FIX round, amending the
	# TR3 leg with cause; GRADFIX6 completes it): challenges
	# stand as full art CARDS at the card size, and the board
	# lives on the centred card's BACK - there is no standing
	# companion panel left to size.
	if _room._panels.size() >= 1:
		var psz: Vector2 = _room._panels[0].quad_size()
		_tournament_expect(psz == Vector2(0.62, 1.08),
			"layout size: tournament challenges stand as full art cards (%s), not board panels" % str(psz))
	# GRADFIX7 (item 2): the board stands OPEN beside its
	# card at the board's own size - this leg convicts a
	# standing board at any other size, and the side
	# assertion below convicts one on the inward slot.
	var bs_all: Array = _room.board_state()
	var size_ok: bool = bs_all.size() == rows.size()
	for e: Variant in bs_all:
		if ((e as Dictionary).get("board_size", Vector2.ZERO) as Vector2) != RoomSpecs.board_panel_size():
			size_ok = false
	_tournament_expect(size_ok,
		"layout standing: every standing board's quad is the board size %s (GRADFIX8: widened 0.62 -> 0.72)" % str(RoomSpecs.board_panel_size()))
	for li: int in ch_idx:
		_tournament_expect_board_side(li, rows[li] as Dictionary)
	if ch_idx.size() >= 1:
		var ch0: WovpChallenge = (rows[ch_idx[0]] as Dictionary).get("challenge") as WovpChallenge
		_tournament_expect(ch0 != null and _room.centre_index() >= 0,
			"layout pairing: the centred challenge's card stands beside its board")
	_tournament_leg_weekly_panels()


func _layout_start_probes() -> void:
	_layout_probes_in_flight = true
	var rows: Array = _room.tournament_rows()
	var now_unix: int = int(Time.get_unix_time_from_system())
	# PINEMHI2: probes render challenge boards only - a
	# weekly row carries no challenge to spec from.
	for i: int in _tournament_challenge_indices(rows):
		var rd: Dictionary = rows[i]
		var spec: Dictionary = RoomSpecs.tournament_board_spec(
			rd["challenge"] as WovpChallenge, bool(rd.get("owned", false)), _wovp_user_id, now_unix)
		_layout_probe_results[i] = await _room.board_layout_probe(spec)
	_layout_probes_in_flight = false


func _tournament_leg_layout() -> void:
	# The score leg, on the season board (probe 0): the
	# 10-digit score's measured need fits its column at the
	# rendered font, and the rendered texture inks the final
	# digit with nothing spilling past the column.
	var p0: Dictionary = _layout_probe_results.get(0, {})
	var target: Dictionary = {}
	for rv: Variant in (p0.get("rows", []) as Array):
		var rd: Dictionary = rv
		if str(rd.get("kind", "")) == "score" and str(rd.get("score_text", "")) == "1,234,567,890":
			target = rd
	_tournament_expect(not target.is_empty(), "layout: the seeded 10-digit score stands on the season board")
	if not target.is_empty():
		var need: float = float(target.get("score_need_px", 0.0))
		var allot: float = float(target.get("score_allot_px", 0.0))
		var ink: bool = _layout_digit_ink(p0.get("texture") as Texture2D, target)
		_tournament_expect(need <= allot + 1.0 and ink,
			"layout score: a 10-digit score renders whole, never clipped (need %.0fpx <= allot %.0fpx at %dpx font, final digit inked, no spill)" % [need, allot, int(target.get("font_px", 0))])
		# Keep the worst-case board's rendered face as a
		# grab beside the boot, for the human verdict.
		var grab_dir: String = OS.get_environment("PVLDS_GRAB_DIR")
		var gtex: Texture2D = p0.get("texture") as Texture2D
		if grab_dir != "" and gtex != null:
			var gimg: Image = gtex.get_image()
			if gimg != null and not gimg.is_empty():
				gimg.save_png(grab_dir.path_join("tournament_board_worst.png"))
	# The launch leg, restated (GRADFIX10 item 1): through
	# TR3 a standing board's Launch sat in a footer band the
	# face reserved, and this leg asserted the button inside
	# that band, clear of the text. Since GRADFIX7 the
	# standing board carries no Launch (it stands open beside
	# its card; the button lives on the card) - but the spec
	# kept reserving the 140 px band, a dead dark plank the
	# content centred above, which is the composition Chris
	# convicted ("tournie text still not centered on frame").
	# GRADFIX10 removes the reservation; the leg now convicts
	# the reservation itself: no footer band on either
	# board's face, at the widened board face size.
	# PVLDS_BOARD_NC=oldlayout fails it by name (the legacy
	# 512x640 face) and PVLDS_GRADFIX10_NC=deadplank fails it
	# by name (the band reserved again).
	if OS.has_environment("PVLDS_LAYOUT_DEBUG"):
		var dbg: Dictionary = _layout_probe_results.get(0, {})
		for rv3: Variant in (dbg.get("rows", []) as Array):
			var rd3: Dictionary = rv3
			print("LAYOUTDBG row ", str(rd3.get("kind", "")), " rect ", str(rd3.get("rect", Rect2())))
		print("LAYOUTDBG footer ", str(dbg.get("footer_panel_rect", Rect2())), " (no band may stand)")
	var launch_ok: bool = true
	var launch_why: String = ""
	for idx: int in range(2):
		var p: Dictionary = _layout_probe_results.get(idx, {})
		if p.is_empty():
			launch_ok = false
			launch_why = "probe %d missing" % idx
			break
		if p.has("footer_panel_rect"):
			launch_ok = false
			launch_why = "board %d reserves a footer band %s for a Launch it does not carry" % [idx, str(p["footer_panel_rect"])]
			break
		var ptex: Texture2D = p.get("texture") as Texture2D
		if ptex == null or ptex.get_size() != Vector2(RoomSpecs.BOARD_FACE_PX):
			launch_ok = false
			launch_why = "board %d's face is %s, not the widened board face %s" % [idx, str(ptex.get_size()) if ptex != null else "none", str(RoomSpecs.BOARD_FACE_PX)]
			break
	_tournament_expect(launch_ok,
		"layout launch: no Launch furniture stands on a standing board - no footer band reserved on season or battle-royale boards, at the widened %dx%d face (the Launch lives on the card)%s"
			% [RoomSpecs.BOARD_FACE_PX.x, RoomSpecs.BOARD_FACE_PX.y, "" if launch_ok else " - " + launch_why])
	# The frame-centring leg (GRADFIX10 item 1): each probe
	# board's rendered content ink, centroided against the
	# FRAME's centre (the face's own size - never the
	# content's bounds), tolerance 2% of frame height. The
	# plinth is excluded from the ink when one is reserved,
	# so under PVLDS_GRADFIX10_NC=deadplank the high-riding
	# content fails this leg by name, not masked by its own
	# dead band.
	# GRADFIX13 (item 1) restates it on the EXTENT ruler,
	# like the grad legs: the mass centroid passed boards
	# whose visible composition rode high.
	var fc_ok: bool = true
	var fc_why: String = ""
	var fc_worst: float = 0.0
	for idx2: int in range(2):
		var p2: Dictionary = _layout_probe_results.get(idx2, {})
		var tex2: Texture2D = p2.get("texture") as Texture2D
		if tex2 == null:
			fc_ok = false
			fc_why = "probe %d has no texture" % idx2
			break
		var ex2: Rect2 = p2.get("footer_face_rect", Rect2())
		var ink2: Vector2 = _board_ink_extent(tex2, ex2)
		var fh2: float = float(tex2.get_height())
		var d2: float = ink2.x - fh2 * 0.5
		fc_worst = maxf(fc_worst, absf(d2))
		print("GRADFIX13 LAYOUT EXTENT board %d: centre %.1f, frame centre %.1f, delta %.1f px (%.2f%% of frame height), ink %d px, rows %d"
			% [idx2, ink2.x, fh2 * 0.5, d2, 100.0 * d2 / maxf(1.0, fh2), int(ink2.y), (p2.get("rows", []) as Array).size()])
		if ink2.y <= 0.0 or absf(d2) > fh2 * 0.02:
			fc_ok = false
			fc_why = "board %d's ink extent rides %.1f px from its frame centre (tolerance %.1f px)" % [idx2, d2, fh2 * 0.02]
			break
	_tournament_expect(fc_ok,
		"layout frame-centred: both boards' content ink EXTENT centres on the FRAME (worst delta %.1f px, tolerance 2%% of frame height)%s"
			% [fc_worst, "" if fc_ok else " - " + fc_why])
	# GRADFIX13 (item 1): the seated leg - the same extent
	# judged on a rendered grab OF THE SEATED BOARD through
	# the room path (the centred challenge's board, standing
	# beside its card), not on a factory texture. The
	# texture legs above are the record; this is the proof
	# shape the field judges.
	var sc_idx: int = _room.centre_index()
	if sc_idx >= 0 and sc_idx < _room._board_nodes.size():
		_gf13_seated_board_leg(sc_idx, "layout centre")


## Rendered-ink check for the layout score leg: within the
## score row's band, the score column's rightmost slice must
## carry text ink (the final digit), and the strip between
## the column's right edge and the face's edge must carry
## none (nothing ran off the board).
func _layout_digit_ink(tex: Texture2D, row: Dictionary) -> bool:
	if tex == null:
		return false
	var img: Image = tex.get_image()
	if img == null or img.is_empty():
		return false
	var sr: Rect2 = row["score_rect"]
	var rr: Rect2 = row["rect"]
	var y0: int = clampi(int(rr.position.y) + 4, 0, img.get_height())
	var y1: int = clampi(int(rr.position.y + rr.size.y) - 4, 0, img.get_height())
	var dx1: int = clampi(int(sr.position.x + sr.size.x), 0, img.get_width())
	var dx0: int = clampi(dx1 - 18, 0, img.get_width())
	var ink: int = 0
	for x: int in range(dx0, dx1):
		for y: int in range(y0, y1):
			var px: Color = img.get_pixel(x, y)
			if px.r + px.g + px.b > 1.7:
				ink += 1
	var spill: int = 0
	for x2: int in range(mini(dx1 + 4, img.get_width()), img.get_width()):
		for y2: int in range(y0, y1):
			var px2: Color = img.get_pixel(x2, y2)
			if px2.r + px2.g + px2.b > 1.7:
				spill += 1
	return ink >= 3 and spill == 0


## The block (GRADFIX4 item 3): the challenges compose a
## shelf section of their own - a two-band block starting
## TOURN_BLOCK_COL0 columns in - instead of the skinny
## single column the fin removal left behind. Judged from
## the room's own seat map: every challenge inside the
## block, every seat distinct, the block's first column
## exactly the pad, its width the two-band fill's width.
func _tournament_leg_block() -> void:
	var rows: Array = _room.tournament_rows()
	# PINEMHI2: the pair block is the challenges' alone -
	# the weekly panels stand in their own run after it
	# (RoomView._pinemhi_coord) and are not block seats.
	var ch_idx: Array[int] = _tournament_challenge_indices(rows)
	_tournament_expect(ch_idx.size() >= 4,
		"tourn layout: the seeded challenges stand to compose the block (got %d)" % ch_idx.size())
	var n: int = ch_idx.size()
	var groups: int = maxi(1, int(ceil(float(maxi(1, n)) / 2.0)))
	var seen: Dictionary = {}
	var min_col: int = 1 << 30
	var max_col: int = -1
	var bad: String = ""
	for p: int in range(n):
		var i: int = ch_idx[p]
		var entry: Dictionary = _tournament_board_entry(i)
		if entry.is_empty():
			bad = "challenge %d has no standing board state" % i
			break
		var card: Vector2i = entry.get("card_coord", Vector2i(-1, -1)) as Vector2i
		var board: Vector2i = entry.get("board_coord", Vector2i(-1, -1)) as Vector2i
		for seat: Vector2i in [card, board]:
			if seat.x < RoomView.TOURN_BLOCK_COL0 or seat.x >= RoomView.TOURN_BLOCK_COL0 + 2 * groups \
					or seat.y < RoomView.TOURN_BAND0 or seat.y >= RoomView.TOURN_BAND0 + RoomView.TOURN_BAND_COUNT:
				bad = "challenge %d stands at %s, outside the pair block" % [i, str(seat)]
				break
			if seen.has(str(seat)):
				bad = "two seats share %s" % str(seat)
				break
			seen[str(seat)] = true
			min_col = mini(min_col, seat.x)
			max_col = maxi(max_col, seat.x)
		if bad != "":
			break
		var expected_left: bool = _tournament_expected_board_left(p, n)
		var actual_left: bool = board.x < card.x
		if actual_left != expected_left or board.y != card.y:
			bad = "standing board side: '%s' board stands %s of its card (board col %d, card col %d)" % [
				_tournament_row_table_name(rows[i] as Dictionary),
				"LEFT" if actual_left else "RIGHT", board.x, card.x]
			break
	if bad == "":
		var want_cols: int = 2 * groups
		if min_col != RoomView.TOURN_BLOCK_COL0 or max_col - min_col + 1 != want_cols:
			bad = "the pair block spans columns %d..%d, want %d columns from %d" % [min_col, max_col, want_cols, RoomView.TOURN_BLOCK_COL0]
	var label: String = bad if bad.begins_with("standing board side:") else \
		"tourn layout: the challenges compose the two-band pair block (pad %d, bands %d-%d, card+board seats distinct, block width 2*ceil(n/2))%s" % [
			RoomView.TOURN_BLOCK_COL0, RoomView.TOURN_BAND0, RoomView.TOURN_BAND0 + RoomView.TOURN_BAND_COUNT - 1,
			"" if bad == "" else " - " + bad]
	_tournament_expect(bad == "", label)


## GRADFIX14 (item 3): tournament bumpers step WITHIN the
## block - one card column per press (the pair grid's own
## sideways step, _tourn_side_step, predicts every landing),
## ends clamped, focus always on a block card. Pre-fix a
## bumper here ran the library page law (index ± PAGE_SIZE
## clamped), which on this block is a jump to the far end.
## Focus is restored to its entry quad at the end - this
## leg borrows the room mid-phase.
func _tournament_leg_gf14_bumpers() -> void:
	var entry_focus: ClickableQuad = _room.focused_quad()
	var cols: Array[int] = _room._card_columns()
	_tournament_expect(cols.size() >= 2,
		"gf14 tournament bumpers: the block stands in at least two card columns for the step legs (got %s)" % str(cols))
	if cols.size() >= 2 and not _room._panels.is_empty():
		# Seat the leftmost card column's first card.
		var start_idx: int = -1
		for i: int in range(_room._panels.size()):
			if _room._grid_coord(i).x == cols[0]:
				start_idx = i
				break
		_room._set_focused(_room._panels[start_idx])
		var cur: int = start_idx
		for press: int in range(cols.size() + 1):
			var want: int = _room._tourn_side_step(cur, 1)
			_room._bumper_page(1)
			var got_idx: int = _room._panels.find(_room.focused_quad())
			_tournament_expect(got_idx == want,
				"gf14 tournament bumpers: RB steps one card column within the block (press %d: panel %d -> %d, got %d)" % [press, cur, want, got_idx])
			cur = want
		_tournament_expect(_room._grid_coord(cur).x == cols[cols.size() - 1],
			"gf14 tournament bumpers: repeated RB clamps on the block's last card column (ended at column %d of %s)" % [_room._grid_coord(cur).x, str(cols)])
		var want_back: int = _room._tourn_side_step(cur, -1)
		_room._bumper_page(-1)
		_tournament_expect(_room._panels.find(_room.focused_quad()) == want_back,
			"gf14 tournament bumpers: LB steps one card column back within the block")
	if entry_focus != null:
		_room._set_focused(entry_focus)


func _drive_tournament_full() -> void:
	match _tournament_smoke_phase:
		0:
			if _room != null and _room.visible and _room.wall_ready:
				_room._handle_rail("tournament")
				_tournament_expect(_room.tournament_active(), "enter: the TOURNAMENT stop raises the Tournament Room")
				_tournament_expect(_room.focused_quad() == _room.rail_quad("tournament"),
					"enter: focus lands on the TOURNAMENT stop that was pressed")
				# GRADFIX6 (item 3): the first-entry window -
				# the freeze's own measurement ground. Phase 16
				# watches the driver's own frame gaps and
				# presses navigation before any art can land.
				_tournament_entry_msec = Time.get_ticks_msec()
				_tournament_entry_last_msec = _tournament_entry_msec
				_tournament_entry_gap_max = 0
				_tournament_entry_frames = 0
				_tournament_entry_moved = false
				_tournament_smoke_phase = 16
			else:
				_tournament_smoke_wait += 1
				if _tournament_smoke_wait > 3600:
					_tournament_fail("the room never came up")
					_finish_tournament_smoke()
		16:
			# First entry, judged on the driver's own clock:
			# this driver runs on the main thread, exactly
			# like the room's input poll - a synchronous
			# extraction on the seat path starves BOTH, so
			# the worst inter-frame gap inside the window IS
			# the freeze, measured rather than described.
			# Bound: no single gap over 500 ms in the first
			# 2.5 s. And on frame 3 a real navigation press
			# (the room's own _move_focus, the pad poll's
			# call) must move focus or centre - before the
			# centre card's real art has landed (its face
			# still the styled card or placeholder at that
			# frame is recorded, not required: on a warm
			# fixture the art may already stand, and the law
			# is that input never waits for it).
			# PVLDS_TOURN_NC=coldfill restores the synchronous
			# face read on the seat path and both legs fail
			# by name against it.
			var now16: int = Time.get_ticks_msec()
			_tournament_entry_gap_max = maxi(_tournament_entry_gap_max, now16 - _tournament_entry_last_msec)
			_tournament_entry_last_msec = now16
			_tournament_entry_frames += 1
			if _tournament_entry_frames == 3:
				var before_q: ClickableQuad = _room.focused_quad()
				var before_c: int = _room.centre_index()
				_room._move_focus(Vector2(0.0, -1.0))
				_tournament_entry_moved = _room.focused_quad() != before_q or _room.centre_index() != before_c
			if now16 - _tournament_entry_msec >= 2500:
				_tournament_expect(_tournament_entry_gap_max <= 500,
					"first entry: no frame gap over 500 ms in the first 2.5 s after entry (worst %d ms over %d frames - the freeze is a main-thread block, and the driver shares that thread with the input poll)" % [_tournament_entry_gap_max, _tournament_entry_frames])
				_tournament_expect(_tournament_entry_moved,
					"first entry: navigation input in the first frames moves focus - input never waits for art")
				_tournament_smoke_deadline_msec = Time.get_ticks_msec() + 45000
				_tournament_smoke_phase = 1
		1:
			if _wovp_boards_live and _wovp_client != null and not _wovp_client.is_busy() and _tournament_boards_all_real() \
					and _pinemhi_settled() and _tournament_weekly_panels_ready():
				_tournament_leg_boards()
				_tournament_leg_block()
				_tournament_leg_standing_boards()
				_tournament_leg_gf14_bumpers()
				_tournament_smoke_deadline_msec = Time.get_ticks_msec() + 20000
				_tournament_smoke_phase = 2
			elif Time.get_ticks_msec() > _tournament_smoke_deadline_msec:
				_tournament_fail("the boards never went live against the stub")
				_finish_tournament_smoke()
		2:
			# The REFRESH leg's verdict: the stub saw a second
			# search after the rail press in _tournament_leg_boards.
			if _tournament_search_count() >= 2 and _wovp_client != null and not _wovp_client.is_busy() and _room.wall_ready:
				_tournament_expect(true, "refresh: REFRESH on the rail re-fetches the boards")
				_tournament_smoke_wait = 0
				_tournament_smoke_deadline_msec = Time.get_ticks_msec() + 60000
				_tournament_smoke_phase = 17
			elif Time.get_ticks_msec() > _tournament_smoke_deadline_msec:
				_tournament_fail("refresh: REFRESH never produced a second search")
				_finish_tournament_smoke()
		17:
			# PINEMHI2 harness contract, weekly-present shape:
			# the settled failure shape was judged in phase 1;
			# now the fixture weekly contests land through
			# Main's own push (the pinemhi2 room legs' road),
			# so the three weekly boards standing in this same
			# room are judged in phase 18. The REFRESH above
			# re-fired the weekly fetch too - wait for it to
			# settle first, so its answer cannot overwrite
			# the fixture push mid-judgement.
			if _pinemhi_client != null and _pinemhi_client.is_busy():
				if Time.get_ticks_msec() > _tournament_smoke_deadline_msec:
					_tournament_fail("weekly present: the weekly fetch never settled before the fixture push")
					_tournament_smoke_phase = 13
			else:
				_tournament_weekly_baseline = []
				for e: Variant in _room.board_state():
					var ed: Dictionary = e as Dictionary
					if str(ed.get("challenge_id", "")) != "":
						_tournament_weekly_baseline.append({
							"challenge_id": ed.get("challenge_id"),
							"card_coord": ed.get("card_coord"),
							"board_coord": ed.get("board_coord"),
							"standing_key": ed.get("standing_key"),
						})
				var contests: Array = _pinemhi2_fixture_contests()
				_tournament_expect(contests.size() == 3, "weekly present: the fixture weekly contests load (got %d)" % contests.size())
				if contests.size() == 3:
					_pinemhi2_contests = contests
					_pinemhi2_fetched_at = int(Time.get_unix_time_from_system())
					_pinemhi2_live = true
					_pinemhi2_fetch_error = ""
					_push_pinemhi2_data()
				_tournament_smoke_deadline_msec = Time.get_ticks_msec() + 30000
				_tournament_smoke_phase = 18
		18:
			var rows18: Array = _room.tournament_rows()
			if _tournament_weekly_indices(rows18).size() == 3 and _tournament_weekly_panels_ready():
				_tournament_leg_weekly_present()
				_tournament_smoke_phase = 13
			elif Time.get_ticks_msec() > _tournament_smoke_deadline_msec:
				_tournament_fail("weekly present: the three weekly boards never stood rendered")
				_tournament_smoke_phase = 13
		3:
			# The rendered legs read the season board off the
			# board STANDING beside the season card (GRADFIX7
			# item 2): centre the card, prove Y turns nothing
			# here (ROOMSUBMIT: it opens the submit panel
			# instead - judged standing, then closed), and
			# judge only once the standing board's texture
			# is really rendered.
			_tournament_smoke_wait += 1
			match _tournament_rendered_flip:
				0:
					if _room.wall_ready and _tournament_smoke_wait >= 4:
						_room._set_focused(_room._panels[0])
						_tournament_rendered_flip = 1
						_tournament_smoke_wait = 0
				1:
					if _room.centre_index() == 0 and not _room.page_slide_active() and _tournament_smoke_wait >= 6:
						# The Y judge (GRADFIX7 item 2, ROOMSUBMIT):
						# a Y press on a focused tournie card turns
						# nothing - the flip stays refused in
						# tournie, permanently - and every board
						# still stands. What Y does since
						# ROOMSUBMIT is open the submit panel for
						# the focused challenge: judged standing
						# here, then closed, and the run goes on.
						_room._info_focused_card()
						var yfs: Dictionary = _room.flip_state()
						_tournament_expect(not bool(yfs.get("active", true)) and absf(float(yfs.get("angle_deg", 1.0))) <= 0.5,
							"Y no-flip: Y on a focused tournie card flips nothing (no turn stands, every angle 0)")
						var ybs: Array = _room.board_state()
						var yrows: Array = _room.tournament_rows()
						var y_standing: bool = ybs.size() == yrows.size()
						# PINEMHI2: "every standing board" is the
						# challenges' companion boards; a weekly
						# row's board is its panel, whose standing
						# witness is the panel's own visibility.
						for yi: int in range(yrows.size()):
							var ykind: String = str((yrows[yi] as Dictionary).get("kind", ""))
							if ykind == "challenge":
								if not bool((ybs[yi] as Dictionary).get("board_visible", false)):
									y_standing = false
							elif ykind == "pinemhi":
								if yi >= _room._panels.size() or not _room._panels[yi].visible:
									y_standing = false
						_tournament_expect(y_standing,
							"Y no-flip: every standing board still stands after the Y press")
						var yrow0: Dictionary = _room.tournament_rows()[0] as Dictionary if _room.tournament_rows().size() >= 1 else {}
						var ych0: WovpChallenge = yrow0.get("challenge") as WovpChallenge
						_tournament_expect(_room.is_submit_panel_up() and ych0 != null and _room.submit_panel_challenge_id() == ych0.challenge_id,
							"Y submit: Y on a focused tournie card opens the submit panel for that challenge (ROOMSUBMIT)")
						_room.hide_submit_panel()
						_tournament_expect(not _room.is_submit_panel_up() and _room.focused_quad() == _room._panels[0],
							"Y submit: the panel's BACK lands focus back on the challenge's card")
						_tournament_rendered_flip = 2
						_tournament_smoke_wait = 0
					elif _tournament_smoke_wait > 900:
						_tournament_fail("rendered: the season card never centred")
						_finish_tournament_smoke()
				2:
					var rentry: Dictionary = _tournament_board_entry(0)
					var rrows: Array = _room.tournament_rows()
					var rseason: WovpChallenge = (rrows[0] as Dictionary).get("challenge") as WovpChallenge if rrows.size() >= 1 else null
					if rseason != null and str(rentry.get("challenge_id", "")) == rseason.challenge_id \
							and bool(rentry.get("texture_real", false)):
						_tournament_leg_rendered()
						_tournament_smoke_wait = 0
						_tournament_smoke_phase = 4
					elif _tournament_smoke_wait > 900:
						_tournament_fail("rendered: the season board never stood rendered beside its card")
						_finish_tournament_smoke()
		13:
			# The standing pair (GRADFIX7 item 2 - the
			# redesign's core law, restated for open boards):
			# each card stands beside its OWN board, on the
			# outward side. GRADFIX13 (item 2): the plinth is
			# stripped everywhere, so centring either
			# challenge - owned or not - shows NO Launch
			# anywhere: none on the card's front, none on its
			# board. (Through GRADFIX12 the owned card's
			# front carried the pair's one Launch; ownership
			# no longer changes the furniture - A launches
			# the focused card, and the tournament A-gate
			# keeps not-owned challenges inert.)
			# The phase ends front-up and board-open, so the
			# selection walk starts clean.
			var rows13: Array = _room.tournament_rows()
			match _tournament_pairing_stage:
				0:
					if _room._panels.size() >= 5:
						# Park the mouse over the furniture
						# first (the walk phase's own lesson):
						# a pointer left resting over a card
						# steals the centre back every frame.
						get_viewport().warp_mouse(Vector2(512, 764))
						_room._set_centre(4, false)
						_room._set_focused(_room._panels[4])
						_tournament_pairing_stage = 1
						_tournament_smoke_wait = 0
				1:
					_tournament_smoke_wait += 1
					if _room.centre_index() == 4 and not _room.page_slide_active() and _tournament_smoke_wait >= 6:
						_tournament_pairing_stage = 5
						_tournament_smoke_wait = 0
					elif _tournament_smoke_wait > 900:
						_tournament_fail("pairing: the not-owned challenge never centred")
						_finish_tournament_smoke()
				5:
					_tournament_smoke_wait += 1
					var p4: Dictionary = _tournament_board_entry(4)
					if bool(p4.get("texture_real", false)) and _tournament_smoke_wait >= 6:
						_tournament_expect_board_side(4, rows13[4] as Dictionary)
						_tournament_expect(_room._panel_launches[4] == null or (not _room._panel_launches[4].visible and not _room._panel_launches[4].pick_enabled),
							"no launch: the not-owned challenge stands with no Launch - none on its card's front, and its board carries none (GRADFIX13 item 2)")
						_tournament_pairing_stage = 3
						_tournament_smoke_wait = 0
					elif _tournament_smoke_wait > 900:
						_tournament_fail("pairing: the not-owned challenge's board never stood rendered")
						_finish_tournament_smoke()
				3:
					# Let the pair PRESENT before the grab - a
					# grab on the condition's own tick reads the
					# previous frame.
					_tournament_smoke_wait += 1
					if _tournament_smoke_wait >= 12 and not _room.page_slide_active():
						_grad_save_grab("tournament_pairing_unowned.png")
						_grad_save_grab("tournament_block_end.png") ## GRADFIX4: the block's far end, composed
						_room._set_centre(0, false)
						_room._set_focused(_room._panels[0])
						_tournament_pairing_stage = 2
						_tournament_smoke_wait = 0
				2:
					_tournament_smoke_wait += 1
					if _room.centre_index() == 0 and not _room.page_slide_active() and _tournament_smoke_wait >= 6:
						_tournament_pairing_stage = 6
						_tournament_smoke_wait = 0
