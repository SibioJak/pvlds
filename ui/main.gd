	var bits_walk: Array = ArtProvider.inspect_vpx_images(fx_bits)
	_expect(bits_walk.size() == 2 and str((bits_walk[0] as Dictionary)["kind"]) == "bits",
		"embedded: inspect reports BITS payloads as their own kind", failures)
