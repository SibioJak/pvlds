## The selection walk (GRADFIX2 item 4, full mode phase
## 14): the pairing legs teleport the centre with
## _set_centre; this leg proves the PAD can get there.
## Starting from the TOURNAMENT rail stop (where entering
## the room leaves focus), it expands the focus graph
## through the room's own _move_focus - the exact call the
## pad poll makes - and asserts every challenge panel is
## landed on by stick steps alone. Then, per challenge, it
## selects the panel and judges the STANDING pair
## (GRADFIX7: the board stands open beside its card): the
## board is this challenge's own, really rendered, on the
## outward side, the card's front Launch standing exactly
## when owned, and no challenge hidden or borrowed at that
## centre. Under
## PVLDS_TOURN_NC=oldseat the projection focus walk is
## restored (its board-borrow half died with the board)
## and the reach legs fail by name.
func _tournament_walk_step() -> void:
	var rows: Array = _room.tournament_rows()
	match _tw_stage:
		0:
			match _tw_sub:
				0:
					if _tw_queue.is_empty():
						# PINEMHI2: reachability is judged for
						# the challenge panels - the walk's
						# pair verification below is a challenge
						# contract; the weekly panels behind
						# them are judged by the weekly legs.
						for i: int in _tournament_challenge_indices(rows):
							_tournament_expect(_tw_visited.has(i),
								"selection walk: '%s' can be selected on the tournie screen (stick steps from the TOURNAMENT stop reach it)" % _tournament_row_table_name(rows[i]))
						_tw_stage = 1
						_tw_pair_i = 0
						_tw_sub = 0
						_tw_wait = 0
						return
					_tw_current = _tw_queue.pop_front()
					_tw_expanded[(_tw_current as Object).get_instance_id()] = true
					_room._set_focused(_tw_current as ClickableQuad)
					_tw_wait = 0
					_tw_sub = 1
				1:
					_tw_wait += 1
					if _tw_wait >= 6:
						_tw_dir_i = 0
						_tw_sub = 2
				2:
					if _tw_dir_i >= 4:
						_tw_current = null
						_tw_sub = 0
						return
					var dirs: Array[Vector2] = [Vector2(-1, 0), Vector2(1, 0), Vector2(0, -1), Vector2(0, 1)]
					_room._set_focused(_tw_current as ClickableQuad)
					_room._move_focus(dirs[_tw_dir_i])
					_tw_dir_i += 1
					var landed: ClickableQuad = _room.focused_quad()
					if landed == null:
						return
					var li: int = _room._panels.find(landed)
					if li >= 0:
						_tw_visited[li] = true
					if not _tw_expanded.has(landed.get_instance_id()) and not _tw_queue.has(landed):
						_tw_queue.append(landed)
		1:
			# PINEMHI2: the pair verification visits the
			# challenge panels only - a weekly panel has no
			# companion board to pair-verify (its face stands
			# on its own panel, judged by the weekly legs).
			var ch_idx: Array[int] = _tournament_challenge_indices(rows)
			if _tw_pair_i >= ch_idx.size():
				_tw_stage = 2
				_tw_sub = 0
				_tw_wait = 0
				return
			var pidx: int = ch_idx[_tw_pair_i]
			var row: Dictionary = rows[pidx]
			var ch: WovpChallenge = row.get("challenge") as WovpChallenge
			match _tw_sub:
				0:
					_room._set_focused(_room._panels[pidx])
					_tw_wait = 0
					_tw_sub = 1
				1:
					# GRADFIX7: selection seats the centre;
					# the pair is judged STANDING - the board
					# beside the card, once the drum settles
					# and its texture is really rendered.
					_tw_wait += 1
					var wentry: Dictionary = _tournament_board_entry(pidx)
					if _room.centre_index() == pidx and not _room.page_slide_active() and _tw_wait >= 6 \
							and bool(wentry.get("texture_real", false)):
						_tournament_walk_judge_centre(pidx, row)
						_tw_pair_i += 1
						_tw_sub = 0
					elif _tw_wait > 900:
						_tournament_fail("selection walk: '%s' never centred with its board rendered when selected" % _tournament_row_table_name(row))
						_tw_pair_i += 1
						_tw_sub = 0
		2:
			var br_idx: int = -1
			for i: int in range(rows.size()):
				var ch2: WovpChallenge = (rows[i] as Dictionary).get("challenge") as WovpChallenge
				if ch2 != null and ch2.type_code == WovpChallenge.TYPE_TOURNAMENT:
					br_idx = i
					break
			if br_idx < 0:
				_tw_stage = 3
				_tw_sub = 0
				_tw_wait = 0
				return
			match _tw_sub:
				0:
					_room._set_focused(_room._panels[br_idx])
					_tw_wait = 0
					_tw_sub = 1
				1:
					# The BR pair, centred for its grab: the
					# board the player reads stands beside
					# its card.
					_tw_wait += 1
					if _room.centre_index() == br_idx and not _room.page_slide_active() and _tw_wait >= 6:
						_tw_sub = 2
						_tw_wait = 0
					elif _tw_wait > 900:
						_tournament_fail("selection walk: the Battle Royale card never centred for its grab")
						_tw_stage = 3
						_tw_sub = 0
						_tw_wait = 0
				2:
					_tw_wait += 1
					var br_entry: Dictionary = _tournament_board_entry(br_idx)
					var ch3: WovpChallenge = (rows[br_idx] as Dictionary).get("challenge") as WovpChallenge
					if ch3 != null and str(br_entry.get("challenge_id", "")) == ch3.challenge_id \
							and bool(br_entry.get("texture_real", false)) and _tw_wait >= 12:
						_grad_save_grab("tournament_walk_br.png")
						_tw_stage = 3
						_tw_sub = 0
						_tw_wait = 0
					elif _tw_wait > 900:
						_tournament_fail("selection walk: the Battle Royale board never stood rendered for its grab")
						_tw_stage = 3
						_tw_sub = 0
						_tw_wait = 0
		3:
			# Hand the room back centred on the season
			# table - the rendered legs read its standing
			# board themselves.
			match _tw_sub:
				0:
					_room._set_focused(_room._panels[0])
					_tw_wait = 0
					_tw_sub = 1
				1:
					_tw_wait += 1
					if _room.centre_index() == 0 and not _room.page_slide_active() and _tw_wait >= 12:
						_tw_desc_sub = 0
						_tournament_smoke_phase = 15
					elif _tw_wait > 900:
						_tournament_fail("selection walk: the season card never re-centred for the rendered legs")
						_tw_desc_sub = 0
						_tournament_smoke_phase = 15


func _tournament_row_table_name(row: Dictionary) -> String:
	var g: GameEntry = row.get("game") as GameEntry
	if g != null and g.title != "":
		return g.title
	var ch: WovpChallenge = row.get("challenge") as WovpChallenge
	return ch.table_name if ch != null else "?"


## A focusable's name for the descent legs' reports: a
## panel names its table, a rail stop its payload, a strip
## slot its letter.
func _tw_quad_name(q: ClickableQuad) -> String:
	if q == null:
		return "<none>"
	var pi: int = _room._panels.find(q)
	if pi >= 0 and pi < _room._visible_games.size():
		return "card '%s'" % (_room._visible_games[pi] as GameEntry).title
	if _room._is_rail_quad(q):
		return "rail stop '%s'" % q.payload
	if _room._is_strip_quad(q):
		return "letter '%s'" % _letters_key_of(q)
	return "quad '%s'" % q.action_id


## The focus-descent legs (GRADFIX3 item 3, full mode
## phase 15): the field's trap, in the user's words -
## "cant't exit tournie screen, cant get back down to bar
## once up top". The selection walk proves the pad can
## REACH every challenge; these legs prove the pad can
## always come back DOWN: from every challenge card,
## repeated DOWN presses (the room's own _move_focus, one
## press per beat, the drum settling between them as it
## does under a real thumb) must land on the desk bar.
## From the bar, the standing exits must work: BACK (the
## D-pad Right path, _handle_rail("exit")) fires
## exit_requested - caught here by a probe lambda so the
## boot survives its own proof - and a filter press
## leaves the tournie screen for the library. The room is
## then re-entered and re-paired for the rendered legs.
## Under PVLDS_TOURN_NC=trap the shipped grid-step's
## clamped band hop is restored and the legs fail by name.
func _tournament_descent_step() -> void:
	var rows: Array = _room.tournament_rows()
	match _tw_desc_sub:
		0:
			_tw_desc_starts.clear()
			for p: Variant in _room._panels:
				_tw_desc_starts.append(p)
			_tw_desc_i = 0
			# The descent is judged from a displaced eye -
			# a headset player's head sits off the drum's
			# axis and toward the wall, never on the desk
			# camera's spot. The shipped descent scored its
			# targets through that camera's screen
			# projection; the fixed descent is a graph edge
			# and must hold from here exactly as from the
			# axis. (The trap NC restores the shipped edge:
			# on this box's mono desk camera its projection
			# still lands, so the NC is documented, in
			# _descent_legacy's terms, as restoring the
			# dependence rather than reproducing the
			# headset's failure - the fix removes the
			# dependence itself.)
			_room._desk_rig.position = RoomView.EYE + Vector3(0.55, -0.08, -0.85)
			_tw_desc_sub = 1
		1:
			if _tw_desc_i >= _tw_desc_starts.size():
				_room._desk_rig.position = RoomView.EYE
				# The exits, from the bar: BACK first (the
				# probe lambda stands in for the quit
				# handler), then the filter press that
				# leaves the screen.
				_tw_desc_exit_fired = false
				var probe: Callable = func() -> void: _tw_desc_exit_fired = true
				_room.exit_requested.disconnect(Callable(self, "_on_exit_requested"))
				_room.exit_requested.connect(probe)
				_room._handle_rail("exit")
				_room.exit_requested.disconnect(probe)
				_room.exit_requested.connect(Callable(self, "_on_exit_requested"))
				_tournament_expect(_tw_desc_exit_fired,
					"focus descent: BACK from the bar fires the exit (the D-pad Right path)")
				_room._set_focused(_room.rail_quad("filter:all"))
				_room._activate(_room.rail_quad("filter:all"))
				_tournament_expect(not _room.tournament_active(),
					"focus descent: a filter press on the bar exits the tournie screen")
				_room._handle_rail("tournament")
				_tw_desc_wait = 0
				_tw_desc_sub = 3
				return
			_room._set_focused(_tw_desc_starts[_tw_desc_i] as ClickableQuad)
			_tw_desc_presses = 0
			_tw_desc_wait = 0
			_tw_desc_sub = 2
		2:
			_tw_desc_wait += 1
			if _tw_desc_wait >= 3:
				_tw_desc_wait = 0
				var f: ClickableQuad = _room.focused_quad()
				if f != null and _room._is_rail_quad(f):
					_tournament_expect(true,
						"focus descent: DOWN from %s reaches the bar (%d presses, landed on %s)"
							% [_tw_quad_name(_tw_desc_starts[_tw_desc_i] as ClickableQuad), _tw_desc_presses, _tw_quad_name(f)])
					_tw_desc_i += 1
					_tw_desc_sub = 1
				elif _tw_desc_presses >= 10:
					_tournament_expect(false,
						"focus descent: DOWN from %s reaches the bar (10 presses, stuck on %s)"
							% [_tw_quad_name(_tw_desc_starts[_tw_desc_i] as ClickableQuad), _tw_quad_name(f)])
					_tw_desc_i += 1
					_tw_desc_sub = 1
				else:
					_room._move_focus(Vector2(0.0, 1.0))
					_tw_desc_presses += 1
		3:
			# Re-entered after the exit legs: the room is
			# whole again when the Tournament view stands with
			# its wall ready and settled (the rendered legs
			# seat the season card and read its standing board).
			_tw_desc_wait += 1
			if _room.tournament_active() and _room.wall_ready \
					and not _room.page_slide_active() and _tw_desc_wait >= 30:
				_tournament_smoke_phase = 3
			elif _tw_desc_wait > 900:
				_tournament_fail("focus descent: the room never re-settled after the exit legs")
				_tournament_smoke_phase = 3


## One centre's standing-state verdicts (the walk's stage
## 1, judged with the pair STANDING - GRADFIX7): the board
## beside the card is this centre's own, on the outward
## side, and a real rendered board (never the factory's
## fallback solid standing blank - under
## PVLDS_GRADFIX4_NC=solidboard every standing-board render
## lands the solid and counts it, and the blank-board leg
## fails by name at every centre), its card's front Launch
## stands exactly when the challenge is his, no challenge
## (panel or board) is hidden or borrowed away by anything,
## and the tournament shelf stands without its bookend
## fins (GRADFIX3 item 2, the user's order) at every centre
## the walk visits.
func _tournament_walk_judge_centre(i: int, row: Dictionary) -> void:
	var tname: String = _tournament_row_table_name(row)
	var ch: WovpChallenge = row.get("challenge") as WovpChallenge
	var owned: bool = bool(row.get("owned", false))
	var entry: Dictionary = _tournament_board_entry(i)
	_tournament_expect(ch != null and str(entry.get("challenge_id", "")) == ch.challenge_id
			and str(entry.get("standing_key", "")).contains(ch.challenge_id),
		"selection walk: '%s' stands beside its own board" % tname)
	_tournament_expect_board_side(i, row)
	var hidden: Array = []
	for j: int in range(_room._panels.size()):
		var p: ClickableQuad = _room._panels[j]
		if p == null or not p.visible or not p.pick_enabled:
			hidden.append(j)
	for j2: int in range(_room._board_nodes.size()):
		var bn: MeshInstance3D = _room._board_nodes[j2] as MeshInstance3D
		# PINEMHI2: a null companion node is a weekly/state
		# row's by-design shape (its board is its panel) -
		# never a hidden board.
		if bn != null and not bn.visible:
			hidden.append("board %d" % j2)
	_tournament_expect(hidden.is_empty(),
		"selection walk: no challenge is hidden or borrowed at '%s' (hidden %s)" % [tname, str(hidden)])
	var btex: Texture2D = entry.get("texture") as Texture2D
	var bink: float = _tournament_tex_ink_stdev(btex)
	_tournament_expect(btex != null and btex.get_width() == RoomSpecs.BOARD_FACE_PX.x
			and btex.get_height() == RoomSpecs.BOARD_FACE_PX.y and bink > 0.02,
		"blank board: '%s' standing board face is a real rendered board (size %s, ink stdev %.3f)" % [tname, str(btex.get_size()) if btex != null else "none", bink])
	# GRADFIX13 (item 2): the strip is total - the front
	# carries NO Launch whatever the ownership (through
	# GRADFIX12 this leg asserted the front carried the
	# pair's one Launch exactly when the challenge was
	# his). The pair's launch path is A, gated on
	# ownership in the room's A-law.
	var front_launch: bool = i < _room._panel_launches.size() and _room._panel_launches[i] != null and _room._panel_launches[i].visible and _room._panel_launches[i].pick_enabled
	_tournament_expect(not front_launch,
		"no launch: selection walk: '%s' card front carries no Launch plinth (owned %s - the strip is total, GRADFIX13 item 2)" % [tname, str(owned)])
	_tournament_expect(_room.bookend_fin_count() == 0,
		"pairing ends: no bookend fin stands in the Tournament view at '%s' (GRADFIX8: fins removed entirely, both views)" % tname)
	# GRADFIX13 (item 1): the seated-centre proof for this
	# board, on this grab - the pair stands centred and
	# settled here, which is exactly the field's view.
	_gf13_seated_board_leg(i, "selection walk")

## GRADFIX13 (item 1): the seated-extent measure - the
## centring proof the field actually judges. Given a
## standing object's global transform and size, a rendered
## grab of the room, and the room's camera, it walks
## vertical profile lines across the object's own face in
## the grab (projected from the object's 3D extent, so
## perspective is the room's own), calls a sample ink when
## its colour leaves the line's modal colour (the face's
## page, which is constant down a column - the same ruling
## as TextureFactory.ink_extent), and returns the ink
## EXTENT's centre as a fraction of the object's height:
## delta 0.0 is dead centre, -0.02 is 2% of the object's
## height high. The outer 3% of each line is ignored (the
## cover border / a card's frame lip lives there). This
## replaces texture-space proof as the headline evidence:
## GF8 measured the content's own box, GF10 its mass, and
## the field convicted both - the seated object is the
## only honest frame.
func _gf13_seated_extent(gt: Transform3D, size: Vector2, img: Image, cam: Camera3D) -> Dictionary:
	if img == null or img.is_empty() or cam == null:
		return {"ok": false, "delta": 0.0, "why": "no grab or camera"}
	var iw: float = float(img.get_width())
	var ih: float = float(img.get_height())
	for cx: float in [-0.5, 0.5]:
		for cy: float in [-0.5, 0.5]:
			var c3: Vector3 = gt * Vector3(size.x * cx, size.y * cy, 0.0)
			if cam.is_position_behind(c3):
				return {"ok": false, "delta": 0.0, "why": "a corner stands behind the camera"}
			var sp: Vector2 = cam.unproject_position(c3)
			if sp.x < 2.0 or sp.y < 2.0 or sp.x > iw - 3.0 or sp.y > ih - 3.0:
				return {"ok": false, "delta": 0.0, "why": "a corner stands outside the grab (at %s in a %dx%d grab)" % [str(sp), int(iw), int(ih)]}
	var fracs: Array[float] = [0.18, 0.30, 0.42, 0.58, 0.70, 0.82]
	var samples: int = 240
	var margin: int = int(float(samples) * 0.03)
	var lines_hit: int = 0
	var top_t: float = 1.0
	var bot_t: float = 0.0
	for fx: float in fracs:
		var lx: float = lerpf(-size.x * 0.5, size.x * 0.5, fx)
		var top3: Vector3 = gt * Vector3(lx, size.y * 0.5, 0.0)
		var bot3: Vector3 = gt * Vector3(lx, -size.y * 0.5, 0.0)
		var sp_top: Vector2 = cam.unproject_position(top3)
		var sp_bot: Vector2 = cam.unproject_position(bot3)
		var buckets: Array[int] = []
		buckets.resize(samples)
		var counts: Dictionary = {}
		var best_key: int = -1
		var best_n: int = -1
		for si: int in range(samples):
			var t: float = float(si) / float(samples - 1)
			var p: Vector2 = sp_top.lerp(sp_bot, t)
			var px: Color = img.get_pixel(
				clampi(int(round(p.x)), 0, int(iw) - 1),
				clampi(int(round(p.y)), 0, int(ih) - 1))
			var key: int = ((int(px.r * 255.0) >> 3) << 10) | ((int(px.g * 255.0) >> 3) << 5) | (int(px.b * 255.0) >> 3)
			buckets[si] = key
			var n: int = int(counts.get(key, 0)) + 1
			counts[key] = n
			if n > best_n:
				best_n = n
				best_key = key
		var first_i: int = -1
		var last_i: int = -1
		for sj: int in range(margin, samples - margin):
			if buckets[sj] != best_key:
				if first_i < 0:
					first_i = sj
				last_i = sj
		if first_i >= 0:
			lines_hit += 1
			top_t = minf(top_t, float(first_i) / float(samples - 1))
			bot_t = maxf(bot_t, float(last_i) / float(samples - 1))
	if lines_hit < 3:
		return {"ok": false, "delta": 0.0, "why": "only %d of %d profile lines found ink" % [lines_hit, fracs.size()]}
	return {"ok": true, "delta": (top_t + bot_t) * 0.5 - 0.5, "why": "", "lines": lines_hit}


## GRADFIX15: the standing boards' seated-centre grab leg
## is RETIRED, openly, here. Its ruler (_gf13_seated_extent)
## called a grab sample ink when its colour left the
## profile line's modal colour - and on a board that modal
## colour was the board's own PANEL FILL. GRADFIX15 nuked
## the fill at Chris's order ("lets nuke the grey line and
## background color. problem solved"), so the lines now
## profile the room behind the board and every delta is a
## measurement of the starfield, not the text. The property
## the leg guarded - the text block not riding high on its
## object - no longer exists as a visible fault: there is
## no frame left to be off-centre against. The composition
## itself stays guarded where it lives, in texture space:
## the ink-extent legs on the rendered faces (which pass
## exactly), and the board's presence and framelessness in
## the room are guarded by the GRADFIX15 "frameless board:"
## legs. This stub stays so the two call sites stand and
## the log says, every run, that the leg is retired and
## why - it registers no expectation.
func _gf13_seated_board_leg(i: int, tag: String) -> void:
	print("GRADFIX15: seated centre board leg RETIRED (%s, board %d) - its ruler's premise was the panel fill GRADFIX15 removed; centring is guarded by the texture-space extent legs" % [tag, i])


## The wing-sized board probe (layout mode, GRADFIX2
## item 2): the field's own board - the Phantom extra from
## the repo's real-shaped fixture, parsed by the
## production parser - rendered at the WING's pixel size.
## Its band is the longest in the league's set ("SEASON -
## EXTRA - Phantom of the Opera"): at the GRAD FIX wing's
## squash it ran off the canvas; here the band must ink
## whole with nothing touching the canvas's right edge,
## and every score must fit its column. Under
## PVLDS_GRADFIX_NC=oldband the band's fit is off and the
## leg fails by name.
## GRADFIX3 note: the Standing Book made the wing the
## board's OWN size, so the 1:1 render's band now fits
## even unfit - the squash the field failure lived in is
## gone from the product. The probe therefore ALSO renders
## the same spec at the GRADFIX2 wing's squashed width
## (440 px): the fit law itself stays under test there -
## production scales the band whole, oldband lets it run
## off the edge and fails by name.
func _layout_wing_probe_start() -> void:
	_layout_wing_probe_done = false
	_layout_wing_probe = {}
	var text: String = FileAccess.get_file_as_string("res://data/wovp/challenges_search.json")
	var parsed: Dictionary = WovpClient.parse_challenges(text)
	if not bool(parsed.get("ok", false)):
		_layout_wing_probe_done = true
		return
	var phantom: WovpChallenge = null
	for cv: Variant in (parsed.get("challenges", []) as Array):
		var cand: WovpChallenge = cv as WovpChallenge
		if cand != null and cand.type_code == WovpChallenge.TYPE_EXTRA:
			phantom = cand
			break
	if phantom == null:
		_layout_wing_probe_done = true
		return
	var now_unix: int = int(Time.get_unix_time_from_system())
	var spec: Dictionary = RoomSpecs.tournament_board_spec(phantom, true, _wovp_user_id, now_unix)
	# GRADFIX6: the board's home is the card's back, at the
	# card's own face size - the probe renders at exactly
	# that size (the old wing-size derivation died with
	# the wing; since GRADFIX3 the two were the same number).
	# GRADFIX8: the standing board widened (0.72 m) and the
	# back's size decoupled into BACK_FACE_PX - the probe
	# judges the BACK's width, so it reads that constant.
	var px: Vector2i = RoomSpecs.BACK_FACE_PX
	var tex: Texture2D = await _room._factory.render_texture(spec, px)
	var metrics: Dictionary = _room._factory.face_board_metrics()
	var narrow_tex: Texture2D = await _room._factory.render_texture(spec, Vector2i(440, 720))
	_layout_wing_probe = {"texture": tex, "rows": metrics.get("rows", []), "px": px,
		"band_text": str(spec.get("band_text", "")), "narrow_texture": narrow_tex}
	_layout_wing_probe_done = true


func _tournament_leg_wing_board() -> void:
	_tournament_expect(not _layout_wing_probe.is_empty(),
		"board whole: the Phantom board rendered at the card back's size to be judged")
	if _layout_wing_probe.is_empty():
		return
	var scores_ok: bool = true
	var score_why: String = ""
	for rv: Variant in (_layout_wing_probe.get("rows", []) as Array):
		var rd: Dictionary = rv
		if str(rd.get("kind", "")) != "score":
			continue
		var need: float = float(rd.get("score_need_px", 0.0))
		var allot: float = float(rd.get("score_allot_px", 0.0))
		if need > allot + 1.0:
			scores_ok = false
			score_why = "score '%s' needs %.0fpx, allotted %.0fpx" % [str(rd.get("score_text", "")), need, allot]
			break
	_tournament_expect(scores_ok,
		"board whole: at the card back's width every Phantom score fits its column%s" % ("" if scores_ok else " - " + score_why))
	var tex: Texture2D = _layout_wing_probe.get("texture") as Texture2D
	var img: Image = tex.get_image() if tex != null else null
	_tournament_expect(img != null and not img.is_empty(),
		"board whole: the card-back-sized Phantom render carries an image")
	if img == null or img.is_empty():
		return
	var w: int = img.get_width()
	var band_ink: int = 0
	var edge_ink: int = 0
	for x: int in range(30, w):
		for y: int in range(10, 58):
			var px2: Color = img.get_pixel(x, y)
			if px2.r + px2.g + px2.b > 1.7:
				band_ink += 1
				if x >= w - 3:
					edge_ink += 1
	_tournament_expect(band_ink > 40 and edge_ink == 0,
		"board whole: the band '%s' renders whole at the card back's width (band ink %d, edge ink %d)"
			% [str(_layout_wing_probe.get("band_text", "")), band_ink, edge_ink])
	# The fit law's guard at the GRADFIX2 squash width (see
	# the probe's header): the same spec rendered 440 px
	# wide - the band fits only because the fit scales it.
	var ntex: Texture2D = _layout_wing_probe.get("narrow_texture") as Texture2D
	var nimg: Image = ntex.get_image() if ntex != null else null
	_tournament_expect(nimg != null and not nimg.is_empty(),
		"board whole: the narrow render of the Phantom board carries an image")
	if nimg != null and not nimg.is_empty():
		var nw: int = nimg.get_width()
		var nband: int = 0
		var nedge: int = 0
		for x2: int in range(30, nw):
			for y2: int in range(10, 58):
				var np2: Color = nimg.get_pixel(x2, y2)
				if np2.r + np2.g + np2.b > 1.7:
					nband += 1
					if x2 >= nw - 3:
						nedge += 1
		_tournament_expect(nband > 40 and nedge == 0,
			"board whole: the band '%s' renders whole at the old squash width too - the fit law's guard (band ink %d, edge ink %d)"
				% [str(_layout_wing_probe.get("band_text", "")), nband, nedge])
	var grab_dir: String = OS.get_environment("PVLDS_GRAB_DIR")
	if grab_dir != "":
		img.save_png(grab_dir.path_join("tournament_board_phantom_wing.png"))


func _tournament_leg_boards() -> void:
	var rows: Array = _room.tournament_rows()
	# PINEMHI2 harness contract: the WoVP legs judge the
	# challenge subset - the weekly panels standing behind
	# the challenges are the room as it now legitimately is,
	# judged by the weekly legs, not intruders in this count.
	var ch_rows: Array = []
	var state_rows: int = 0
	for r: Variant in rows:
		var rd: Dictionary = r
		if str(rd.get("kind", "")) == "challenge":
			ch_rows.append(rd)
		elif str(rd.get("kind", "")) == "state":
			state_rows += 1
	_tournament_expect(ch_rows.size() == 5, "boards: five live challenges stand on the wall (got %d)" % ch_rows.size())
	var owned_flags: Array = []
	for r2: Variant in ch_rows:
		owned_flags.append(bool((r2 as Dictionary).get("owned", false)))
	_tournament_expect(state_rows == 0, "boards: no WoVP state panel stands among the live data (the panels behind the challenges are the PINemHi weekly boards, judged by the weekly legs)")
	_tournament_expect(owned_flags == [true, true, true, true, false],
		"boards: four challenges matched his library by VPS id; the fifth is not owned")
	if ch_rows.size() == 5:
		var first_game: GameEntry = (ch_rows[0] as Dictionary).get("game") as GameEntry
		_tournament_expect(first_game != null and first_game.game_id == "aT_GONvw",
			"boards: the season board is his Addams Family (matched by its VPS game id)")
		var last_game: GameEntry = (ch_rows[4] as Dictionary).get("game") as GameEntry
		_tournament_expect(last_game != null and last_game.game_id.begins_with("wovp:none:"),
			"boards: the not-owned board stands on a synthetic, unlaunchable entry")
		var season: WovpChallenge = (ch_rows[0] as Dictionary).get("challenge") as WovpChallenge
		_tournament_expect(season != null and season.his_row(_wovp_user_id) != null and season.his_row(_wovp_user_id).position == 6,
			"his row: his scoreboard row is identified by the validated userId, mid-board")
	_tournament_expect(_room._banner_line().contains("updated"),
		"boards: the banner stamps when the boards landed")
	# The honesty leg: the stub recorded how the client
	# announced itself. PVLDS_WOVP_NC=clientid must fail this
	# by name.
	var entries: Array = _tournament_stub_entries()
	var saw_validate: bool = false
	var saw_search: bool = false
	var honest: bool = true
	for e: Variant in entries:
		var ed: Dictionary = e
		if str(ed.get("x_client_id", "")) != "pvlds":
			honest = false
		if str(ed.get("path", "")).ends_with("validate-apikey"):
			saw_validate = true
		if str(ed.get("path", "")).ends_with("challenges/search"):
			saw_search = true
			if not bool(ed.get("authorization_present", false)):
				honest = false
	_tournament_expect(saw_validate and saw_search, "honesty: the stub saw both read-side calls (validate, then search)")
	_tournament_expect(honest, "honesty: the client identified itself to WoVP as pvlds on every call, and the key rode only in the search's Authorization header")
	_tournament_expect(_room.rail_quad("wovp_refresh").pick_enabled,
		"refresh: REFRESH is a live stop while the Tournament Room stands")
	# Fire the refresh for phase 2's count.
	_room._activate(_room.rail_quad("wovp_refresh"))


func _tournament_leg_rendered() -> void:
	# His row, in the rendered pixels: the season board
	# STANDING beside the season card carries a full row on
	# the accent ground (CardFace's board accent). The NC
	# that renames his rows (the stub's baduser variant)
	# leaves no accent row to find - this leg fails by name
	# there. (Amended in GRADFIX7 with cause: the board's
	# texture stands beside its card now - phase 3 centred
	# the pair before this leg runs.)
	if _room._panels.size() >= 5:
		var rows: Array = _room.tournament_rows()
		var entry: Dictionary = _tournament_board_entry(0)
		var season0: WovpChallenge = (rows[0] as Dictionary).get("challenge") as WovpChallenge if rows.size() >= 1 else null
		_tournament_expect(season0 != null and str(entry.get("challenge_id", "")) == season0.challenge_id,
			"pairing: the standing board beside the centred card is the centred challenge's (his season table)")
		_tournament_expect_board_side(0, rows[0] as Dictionary)
		_tournament_expect(bool(entry.get("texture_real", false)) and (entry.get("texture") as Texture2D) != null,
			"pairing: the standing board carries its rendered board face")
		var tex: Texture2D = entry.get("texture") as Texture2D
		var accent_px: int = 0
		if tex != null:
			var img: Image = tex.get_image()
			if img != null and not img.is_empty():
				# The rows' region only: the band above it is a
				# palette color that can sit in the accent
				# window, and it must not be able to fake this
				# leg - his row or nothing.
				# The window is centred on the TR3 accent
				# ground itself (Color(0.66, 0.46, 0.10) in
				# CardFace, measured (0.659, 0.459, 0.098) in
				# the captured texture) with margin on every
				# side; the steel-blue band (b 0.55), the gold
				# border (1.0, 0.80, 0.30) and the promotion
				# green all stay outside it.
				for x: int in range(0, img.get_width(), 3):
					for y: int in range(150, mini(740, img.get_height()), 3):
						var px: Color = img.get_pixel(x, y)
						if px.r >= 0.56 and px.r <= 0.76 and px.g >= 0.36 and px.g <= 0.56 and px.b <= 0.20:
							accent_px += 1
		_tournament_expect(accent_px >= 60,
			"his row: the rendered season board carries his row on the accent ground (%d accent samples)" % accent_px)
		# The Launch law (GRADFIX7 item 2, RESTATED by
		# GRADFIX13 item 2): the plinth is stripped - NO
		# challenge's front carries a Launch, owned or not,
		# and no board carries one either (a board is a
		# plain mesh, not a quad). A launches the focused
		# owned card directly; the not-owned A-leg below is
		# the gate's proof.
		var launch_bad: String = ""
		for li: int in range(rows.size()):
			var lowned: bool = bool((rows[li] as Dictionary).get("owned", false))
			var lfront: bool = li < _room._panel_launches.size() and _room._panel_launches[li] != null and _room._panel_launches[li].visible and _room._panel_launches[li].pick_enabled
			if lfront:
				launch_bad = "challenge %d front carries a Launch plinth (owned %s)" % [li, str(lowned)]
				break
			var lbn: Node = _room._board_nodes[li] as Node if li < _room._board_nodes.size() else null
			if lbn != null and lbn is ClickableQuad:
				launch_bad = "challenge %d's board is a pickable quad" % li
				break
		_tournament_expect(launch_bad == "",
			"no launch: no challenge's front carries a Launch plinth, owned or not, and no board carries one (GRADFIX13 item 2)%s" % ("" if launch_bad == "" else " - " + launch_bad))
		# A on the not-owned card: nothing starts, nothing
		# opens - the card is information, not a door.
		_room._set_focused(_room._panels[4])
		_room._a_press()
		_tournament_expect(not _launch_pending and _room._mode == "wall" and _room.tournament_active(),
			"not-owned: A on a not-owned card starts nothing and opens nothing")
		# Focus is never stranded in the view: DOWN from a
		# card walks to the rail by the room's own ladder.
		_room._set_focused(_room._panels[0])
		var reached_rail: bool = false
		for i: int in range(3):
			_room._move_focus(Vector2(0.0, 1.0))
			if _nav_key_of(_room.focused_quad()) != "":
				reached_rail = true
				break
			_tournament_expect(_room._panels.has(_room.focused_quad()),
				"navigation: DOWN from a card stays on cards until the rail")
		_tournament_expect(reached_rail,
			"navigation: DOWN from a card reaches the rail - focus is never stranded in the view")
	# Leaving: a filter press restores the library wall,
	# focus on the pressed stop. REFRESH stays a stop over
	# the library wall (GRADFIX16 item 1 - it was disarmed
	# here before, the shipped gating Chris convicted).
	_room._handle_rail("filter:all")
	_tournament_expect(not _room.tournament_active() and _room.tournament_rows().is_empty(),
		"leaving: a filter press leaves the Tournament Room")
	_tournament_expect(_room.focused_quad() == _room.rail_quad("filter:all"),
		"leaving: focus lands on the filter stop that was pressed")
	_tournament_expect(_room.rail_quad("wovp_refresh").pick_enabled,
		"leaving: REFRESH stays a live stop over the library wall (GRADFIX16 item 1)")


## nokey / failfetch share one shape: ONE state panel, its
## lines in plain words, no launch anywhere, and a banner
## that names the state.
func _drive_tournament_state_mode(expect_failure: bool) -> void:
	match _tournament_smoke_phase:
		0:
			if _room != null and _room.visible and _room.wall_ready:
				_room._handle_rail("tournament")
				_tournament_smoke_deadline_msec = Time.get_ticks_msec() + 30000
				_tournament_smoke_phase = 1
			else:
				_tournament_smoke_wait += 1
				if _tournament_smoke_wait > 3600:
					_tournament_fail("the room never came up")
					_finish_tournament_smoke()
		1:
			# PINEMHI2: the weekly fetch settles too before
			# the row census - the weekly panels stand behind
			# the WoVP state panel in this shape as well, and
			# a landing push must not change the count
			# mid-judgement.
			var ready: bool = _room.wall_ready and (not expect_failure or _wovp_fetch_error != "") \
				and _pinemhi_settled() and _tournament_weekly_panels_ready()
			if ready:
				var rows: Array = _room.tournament_rows()
				var state_idx: int = -1
				var state_count: int = 0
				for si: int in range(rows.size()):
					if str((rows[si] as Dictionary).get("kind", "")) == "state":
						state_count += 1
						state_idx = si
				_tournament_expect(state_count == 1,
					"state: exactly one state panel stands (got %d state rows among %d)" % [state_count, rows.size()])
				var lines: Array = (rows[state_idx] as Dictionary).get("lines", []) if state_idx >= 0 else []
				var joined: String = ""
				for lv: Variant in lines:
					joined += str(lv) + " "
				if expect_failure:
					_tournament_expect(joined.contains("Could not reach WoVP"),
						"state: the failure state says WoVP could not be reached, in plain words")
					_tournament_expect(_room._banner_line().contains("could not reach WoVP"),
						"state: the banner names the failure - no boards dressed as live")
					if _tournament_smoke_mode == "errbody":
						# The HTTP400 round's negative control:
						# the stub refused with words of its
						# own, and the words - not just the
						# code - must stand on the panel. A
						# client that discards response
						# bodies fails this leg by name.
						_tournament_expect(joined.contains("WOVP-STUB-REFUSAL"),
							"error body: WoVP's own words for its refusal stand on the state panel, not just the HTTP code")
					elif _tournament_smoke_mode == "errempty":
						_tournament_expect(joined.contains("HTTP 400") and not joined.contains("WoVP said"),
							"error body: an empty refusal falls back to the bare HTTP code, gracefully")
				else:
					_tournament_expect(joined.contains("No WoVP key yet"),
						"state: the no-key state says to add the key in SETUP, plainly")
					_tournament_expect(_room._banner_line().contains("no WoVP key yet"),
						"state: the banner names the no-key state")
				_tournament_expect(_room._panels.size() == rows.size() and state_idx >= 0 and state_idx < _room._panel_launches.size() and (_room._panel_launches[state_idx] == null or not _room._panel_launches[state_idx].visible),
					"no launch: the state panel carries no Launch button (GRADFIX13 item 2)")
				_tournament_leg_weekly_panels()
				_finish_tournament_smoke()
			elif Time.get_ticks_msec() > _tournament_smoke_deadline_msec:
				_tournament_fail("the state never settled (mode %s)" % _tournament_smoke_mode)
				_finish_tournament_smoke()


func _drive_tournament_cache_mode() -> void:
	match _tournament_smoke_phase:
		0:
			if _room != null and _room.visible and _room.wall_ready:
