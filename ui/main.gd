	var stop_warmer: ArtWarmer = ArtWarmer.new()
	stop_warmer.warm_library(stop_entries)
	var swait: int = 0
	while int(count_cached.call(stop_entries)) == 0 and swait < 10000:
		OS.delay_msec(10)
		swait += 10
