				_finish_nav_smoke()
				return
			_nav_smoke_wait += 1
			if _nav_smoke_wait > 7200:
				_nav_smoke_fail("the vertical-law leg never finished")
				_finish_nav_smoke()
			elif not _nav_vertical_started and _room != null and _room.wall_ready and _nav_smoke_wait >= 4:
				_nav_vertical_started = true
