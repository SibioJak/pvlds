					_finish_tournament_smoke()
		1:
			if _wovp_fetch_error != "" and _pinemhi_settled() and _tournament_weekly_panels_ready():
				var rows: Array = _room.tournament_rows()
				# PINEMHI2: the saved boards are the challenge
				# subset - the weekly failure-state board
				# stands behind them (this home's weekly fetch
				# is dead and no weekly cache stands), judged
				# by the weekly legs below.
				_tournament_expect(_tournament_challenge_indices(rows).size() == 5,
					"cache: the saved boards stand on the wall (got %d challenge rows)" % _tournament_challenge_indices(rows).size())
				_tournament_expect(_room._banner_line().contains("last good boards"),
					"cache: the banner says these are the last good boards - the failed refresh is stated, not hidden")
				_tournament_leg_weekly_panels()
				_finish_tournament_smoke()
			elif Time.get_ticks_msec() > _tournament_smoke_deadline_msec:
				_tournament_fail("cache: the dead-URL refresh never reported its failure")
				_finish_tournament_smoke()


func _tournament_stub_entries() -> Array:
	var path: String = OS.get_environment("PVLDS_WOVP_STUB_LOG")
	if path == "" or not FileAccess.file_exists(path):
		return []
	var out: Array = []
	for line: String in FileAccess.get_file_as_string(path).split("\n"):
		var parsed: Variant = JSON.parse_string(line.strip_edges())
		if parsed is Dictionary:
			out.append(parsed)
	return out


func _tournament_search_count() -> int:
	var n: int = 0
	for e: Variant in _tournament_stub_entries():
		if str((e as Dictionary).get("path", "")).ends_with("challenges/search"):
			n += 1
	return n


func _tournament_validate_count() -> int:
	var n: int = 0
	for e: Variant in _tournament_stub_entries():
		if str((e as Dictionary).get("path", "")).ends_with("validate-apikey"):
			n += 1
	return n


func _tournament_expect(cond: bool, label: String) -> void:
	if cond:
		print("  ok - tournament smoke: ", label)
	else:
		_tournament_fail(label)


func _tournament_fail(label: String) -> void:
	_tournament_smoke_failures += 1
	printerr("  FAIL - tournament smoke: ", label)


func _finish_tournament_smoke() -> void:
	if _tournament_smoke_failures == 0:
		print("PVLDS TOURNAMENT SMOKE: PASS")
		get_tree().quit(0)
	else:
		printerr("PVLDS TOURNAMENT SMOKE: FAIL (%d)" % _tournament_smoke_failures)
		get_tree().quit(1)


# -------------------------------------------------- sweep smoke

## --pvlds-smoke-sweep: the blank-face contract (GRADFIX6
## item 2), driven over the graduation fixture library from
## a cold home. The driver sweeps the centre across the
## whole shelf at one panel per frame - a fast alphabet
## sweep the fill cannot pace - sampling the room's
## face_state() every frame. THE BOUND: a card inside
## +/-3 columns of the centre may not stay on an unpainted
## face (the placeholder, or a texture too small to be a
## face - the factory fallback solid the field captures
## wore) for more than 1000 ms after it first enters that
## zone; a styled title card counts as painted - it is the
## deliberate fallback, not a failure. At the sweep's end
## + 2 s of settle, no visible card may be unpainted.
## PVLDS_GRADFIX6_NC=blackface (target in
## PVLDS_GF6_NC_TARGET) restores the pre-fix
## accept-and-stamp bookkeeping for one game, and its
## dwell leg fails by name.
var _smoke_sweep: bool = false ## --pvlds-smoke-sweep
var _sweep_phase: int = 0
var _sweep_failures: int = 0
var _sweep_idx: int = 0 ## the centre the sweep has reached
var _sweep_first_unreal: Dictionary = {} ## game_id -> msec it first stood unpainted inside the judged zone
var _sweep_violated: Dictionary = {} ## game_id -> true once its dwell leg has been charged
var _sweep_worst_dwell: int = 0 ## the worst dwell actually observed (ms), printed with the verdict
var _sweep_settle_since: int = 0
const SWEEP_DWELL_BOUND_MS: int = 1000


func _sweep_expect(cond: bool, label: String) -> void:
	if cond:
		print("  ok - sweep smoke: ", label)
	else:
		_sweep_fail(label)


func _sweep_fail(label: String) -> void:
	_sweep_failures += 1
	printerr("  FAIL - sweep smoke: ", label)


func _finish_sweep_smoke() -> void:
	if _sweep_failures == 0:
		print("PVLDS SWEEP SMOKE: PASS (worst dwell %d ms against the %d ms bound)" % [_sweep_worst_dwell, SWEEP_DWELL_BOUND_MS])
		get_tree().quit(0)
	else:
		printerr("PVLDS SWEEP SMOKE: FAIL (%d)" % _sweep_failures)
		get_tree().quit(1)


func _drive_sweep_smoke() -> void:
	match _sweep_phase:
		0:
			if _room != null and _room.visible and _room.wall_ready and _room._panels.size() > 10:
				Input.warp_mouse(Vector2(512.0, 764.0)) ## parked: hover would drive the centre
				_room._set_centre(0, true)
				_sweep_idx = 0
				_sweep_phase = 1
			# (no timeout leg: a room that never comes up is
			# the runner's timeout, as in the grad driver)
		1:
			# One panel per frame, the whole shelf, no
			# waiting for fills - the sweep a player's thumb
			# makes, at machine speed.
			if _sweep_idx < _room._panels.size() - 1:
				_sweep_idx += 1
				_room._set_centre(_sweep_idx, false)
			_sweep_sample_faces()
			if _sweep_idx >= _room._panels.size() - 1:
				_sweep_phase = 2
				_sweep_settle_since = Time.get_ticks_msec()
		2:
			_sweep_sample_faces()
			if Time.get_ticks_msec() - _sweep_settle_since >= 2000:
				var left: Array = []
				for st: Variant in _room.face_state():
					var sd: Dictionary = st as Dictionary
					if bool(sd.get("is_unreal", false)):
						left.append(str(sd.get("title", "")))
				_sweep_expect(left.is_empty(),
					"sweep settle: no visible card stands unpainted 2 s after the sweep ends%s"
						% ("" if left.is_empty() else " - still unpainted: " + ", ".join(left.slice(0, 5))))
				_finish_sweep_smoke()


## One frame's face sample: charge any card inside the
## judged zone (+/-3 columns of the centre) that has stood
## unpainted past the bound, once per game, by title.
func _sweep_sample_faces() -> void:
	var now: int = Time.get_ticks_msec()
	var centre_col: int = _room._grid_coord(_room.centre_index()).x
	for st: Variant in _room.face_state():
		var sd: Dictionary = st as Dictionary
		if absi(int(sd.get("col", 0)) - centre_col) > 3:
			continue
		var gid: String = str(sd.get("game_id", ""))
		if bool(sd.get("is_unreal", false)):
			if not _sweep_first_unreal.has(gid):
				_sweep_first_unreal[gid] = now
			var dwell: int = now - int(_sweep_first_unreal[gid])
			_sweep_worst_dwell = maxi(_sweep_worst_dwell, dwell)
			if dwell > SWEEP_DWELL_BOUND_MS and not _sweep_violated.has(gid):
				_sweep_violated[gid] = true
				_sweep_fail("sweep face dwell: '%s' stayed unpainted %d ms inside the judged zone (bound %d ms)"
					% [str(sd.get("title", "")), dwell, SWEEP_DWELL_BOUND_MS])
		else:
			_sweep_first_unreal.erase(gid)


# -------------------------------------------------- desk smoke

## --pvlds-smoke-desk: the desk's session switch is a live
## setting - flipping it must rewrite the config file on disk
## immediately, with no Save & Scan. The boot route with this
## flag lands on the desk and stays there (no scan, no room).
## The driver asserts the stricken close/hold controls are
## absent, flips the herding checkbox through its real toggled
## signal, then re-reads the config FILE with a fresh
## PvldsConfig and asserts what landed - plus that the fields a
## flip does not own (exe path, folders) survived, and that the
## saved file carries none of the stricken keys.
func _drive_desk_smoke() -> void:
	match _desk_smoke_phase:
		0:
			if _desk != null:
				# The starting point, straight off the disk the
				# boot read (the harness's scratch config beside
				# the exported binary).
				var before: PvldsConfig = PvldsConfig.new()
				_desk_expect(before.load_from_disk(), "the scratch config loads")
				_desk_expect(not before.focus_herding, "the scratch config starts with herding off")
				# The stricken controls are ABSENT: no Close VPX
				# checkbox (the watchdog's close duty is
				# unconditional now), no Hold-to-exit checkbox,
				# no hold-button picker (there is no hold gesture).
				_desk_expect(_desk._close_check == null, "the desk has no Close VPX checkbox")
				_desk_expect(_desk._hold_check == null, "the desk has no Hold-to-exit checkbox")
				_desk_expect(_desk._hold_button_picker == null, "the desk has no hold-button picker")
				# Flip the one surviving switch through its real
				# control and signal.
				_desk._herding_check.button_pressed = true
				_desk_smoke_wait = 0
				_desk_smoke_phase = 1
			else:
				_desk_smoke_wait += 1
				if _desk_smoke_wait > 600:
					_desk_smoke_fail("the desk never came up")
					_finish_desk_smoke()
		1:
			_desk_smoke_wait += 1
			if _desk_smoke_wait >= 3:
				# In memory first: Main's own config is the truth
				# the contract mirrors at the next launch.
				_desk_expect(_config.focus_herding, "the herding flip is in Main's config immediately")
				# Then the file itself - the whole point of the round.
				var after: PvldsConfig = PvldsConfig.new()
				_desk_expect(after.load_from_disk(), "the config file still loads after the flip")
				_desk_expect(after.focus_herding, "the config FILE has herding on, no Save & Scan pressed")
				_desk_expect(after.vpx_exe_path == _config.vpx_exe_path and after.table_folders == _config.table_folders,
					"fields the flip does not own (exe path, folders) are untouched on disk")
				# And the save is clean of the stricken keys: the
				# simplified exit model writes no close/hold fields.
				var raw: String = FileAccess.get_file_as_string(PvldsConfig.existing_path())
				_desk_expect(not raw.contains("close_vpx_on_table_exit"), "the saved config carries no close_vpx_on_table_exit key")
				_desk_expect(not raw.contains("hold_exit_enabled"), "the saved config carries no hold_exit_enabled key")
				_desk_expect(not raw.contains("hold_exit_button"), "the saved config carries no hold_exit_button key")
				# Missing-backglass row (this round): the count
				# line + Open list button beside the scan summary.
				# This boot never runs a scan, so the driver feeds
				# counts through the same apply_missing_b2s call
				# _finish_scan makes in a real boot, then presses
				# the REAL button - the emit runs the desk's
				# pressed -> handler -> OS.shell_open wiring end
				# to end (the open itself lands outside, on the
				# OS's default handler, unobservable headless;
				# reaching _finish_desk_smoke is the proof the
				# press ran clean).
				_desk_expect(_desk._b2s_button != null and _desk._b2s_button.text == "Open list",
					"the desk has an Open list button")
				_desk_expect(_desk._b2s_button != null and _desk._b2s_button.disabled,
					"the Open list button starts disabled (no scan yet)")
				_desk_expect(_desk._b2s_label != null and _desk._b2s_label.text.contains("not scanned yet"),
					"the missing-backglass line starts unscanned")
				_desk.apply_missing_b2s(3)
				_desk_expect(_desk._b2s_label.text.contains("3 table file(s)"),
					"the missing-backglass line shows the applied count")
				_desk_expect(not _desk._b2s_button.disabled,
					"the Open list button arms once a count lands")
				_desk.apply_missing_b2s(0)
				_desk_expect(_desk._b2s_label.text.contains("none - every table file"),
					"a zero count says none plainly")
				var smoke_paths: Array[String] = ["/tables/Alpha.vpx", "/tables/Beta.vpx", "/other/Gamma.vpx"]
				_desk_expect(MissingB2sList.write_file(smoke_paths, "2026-10-23") == OK
					and FileAccess.file_exists(MissingB2sList.FILE_PATH),
					"the list file exists at the path the button opens")
				_desk_expect(MissingB2sList.globalized_path().ends_with("missing_b2s.txt"),
					"the button's open path resolves to missing_b2s.txt")
				_desk.apply_missing_b2s(3)
				_desk._b2s_button.pressed.emit()
				# Couldn't-place row (IDENTITY): the same shape
				# as the backglass row, fed through the same
				# apply_unplaced call _finish_scan makes.
				_desk_expect(_desk._unplaced_button != null and _desk._unplaced_button.text == "Open list",
					"the desk has an unplaced-files Open list button")
				_desk_expect(_desk._unplaced_button != null and _desk._unplaced_button.disabled,
					"the unplaced Open list button starts disabled (no scan yet)")
				_desk_expect(_desk._unplaced_label != null and _desk._unplaced_label.text.contains("not scanned yet"),
					"the couldn't-place line starts unscanned")
				_desk.apply_unplaced(2)
				_desk_expect(_desk._unplaced_label.text.contains("2 table file(s)"),
					"the couldn't-place line shows the applied count")
				_desk_expect(not _desk._unplaced_button.disabled,
					"the unplaced Open list button arms once a count lands")
				_desk.apply_unplaced(0)
				_desk_expect(_desk._unplaced_label.text.contains("none - every table file"),
					"a zero unplaced count says none plainly")
				var unplaced_paths: Array[String] = ["/tables/Alpha.vpx", "/tables/Beta.vpx"]
				_desk_expect(UnplacedFilesList.write_file(unplaced_paths, "2026-11-04") == OK
					and FileAccess.file_exists(UnplacedFilesList.FILE_PATH),
					"the unplaced list file exists at the path the button opens")
				_desk_expect(UnplacedFilesList.globalized_path().ends_with("unplaced_files.txt"),
					"the unplaced button's open path resolves to unplaced_files.txt")
				_desk.apply_unplaced(2)
				_desk._unplaced_button.pressed.emit()
				# The WoVP section (the Tournament Room round):
				# a masked key field; Save key lands the key in
				# the config FILE on the spot; Test key answers
				# through Main's client - the harness points it
				# at its stub (PVLDS_WOVP_BASE_URL), so phase 2
				# waits for the verdict on the status line.
				_desk_expect(_desk._wovp_edit != null and _desk._wovp_edit.secret,
					"wovp: the desk's key field exists and is masked (it is a secret)")
				_desk_expect(_desk._wovp_save_button != null and _desk._wovp_test_button != null,
					"wovp: the desk has Save key and Test key")
				_desk._wovp_edit.text = "PVLDS-WOVP-SENTINEL-KEY-00000001"
				_desk._wovp_save_button.pressed.emit()
				var wovp_after: PvldsConfig = PvldsConfig.new()
				_desk_expect(wovp_after.load_from_disk() and wovp_after.wovp_api_key == "PVLDS-WOVP-SENTINEL-KEY-00000001",
					"wovp: Save key writes the key to the config FILE immediately, no Save & Scan")
				_desk_expect(_desk._wovp_label.text.contains("saved"),
					"wovp: the desk says the key saved, in words")
				if OS.has_environment("PVLDS_WOVP_BASE_URL"):
					_desk._wovp_test_button.pressed.emit()
					_desk_smoke_wait = 0
					_desk_smoke_phase = 2
				else:
					print("  info - desk smoke: no PVLDS_WOVP_BASE_URL in env - the Test key leg belongs to the harness run")
					_finish_desk_smoke()
		2:
			_desk_smoke_wait += 1
			if _desk._wovp_label.text.contains("Fixture Player"):
				_desk_expect(true, "wovp: Test key names whose key it is, on the status line")
				_desk_smoke_phase = 3
			elif _desk_smoke_wait == 240 and _wovp_client != null and not _wovp_client.is_busy():
				# The save's own board fetch may have held the
				# client when the first press landed - press
				# again now that it is idle.
				_desk._wovp_test_button.pressed.emit()
			elif _desk_smoke_wait > 1200:
				_desk_expect(false, "wovp: Test key never answered (status line: %s)" % _desk._wovp_label.text)
				_finish_desk_smoke()
		3:
			# The 32-character rule (the HTTP400 round): a
			# wrong-length key still SAVES - with the warning
			# on the line - but Test refuses it in words and
			# sends nothing; the stub's request log is the
			# witness (its count must not move).
			_desk_expect(OS.has_environment("PVLDS_WOVP_STUB_LOG"),
				"wovp: the harness gave the desk smoke the stub's request log to witness against")
			var stub_requests_before: int = _desk_stub_request_count()
			_desk._wovp_edit.text = "SHORTKEY123"
			_desk._wovp_save_button.pressed.emit()
			var short_after: PvldsConfig = PvldsConfig.new()
			_desk_expect(short_after.load_from_disk() and short_after.wovp_api_key == "SHORTKEY123",
				"wovp: a wrong-length key still saves (his pasteboard, his call)")
			_desk_expect(_desk._wovp_label.text.contains("11 characters - WoVP keys are 32"),
				"wovp: the save line warns about the key's length, in words")
			_desk._wovp_test_button.pressed.emit()
			_desk_expect(_desk._wovp_label.text.contains("11 characters - WoVP keys are 32"),
				"wovp: Test key refuses a wrong-length key in plain words")
			_desk_expect(_desk_stub_request_count() == stub_requests_before,
				"wovp: the refused save and test sent nothing - the stub saw no new request")
			# Leave the desk as the passing legs left it.
			_desk._wovp_edit.text = "PVLDS-WOVP-SENTINEL-KEY-00000001"
			_desk._wovp_save_button.pressed.emit()
			_finish_desk_smoke()


## How many requests the harness's WoVP stub has logged so
## far (the desk legs' no-send witness). The stub never logs
## key values - paths only.
func _desk_stub_request_count() -> int:
	var path: String = OS.get_environment("PVLDS_WOVP_STUB_LOG")
	if path == "" or not FileAccess.file_exists(path):
		return 0
	var n: int = 0
	for line: String in FileAccess.get_file_as_string(path).split("\n"):
		if JSON.parse_string(line.strip_edges()) is Dictionary:
			n += 1
	return n


func _desk_expect(cond: bool, label: String) -> void:
	if cond:
		print("  ok - desk smoke: ", label)
	else:
		_desk_smoke_fail(label)


func _desk_smoke_fail(label: String) -> void:
	_desk_smoke_failures += 1
	printerr("  FAIL - desk smoke: ", label)


func _finish_desk_smoke() -> void:
	if _desk_smoke_failures == 0:
		print("PVLDS DESK SMOKE: PASS")
		get_tree().quit(0)
	else:
		printerr("PVLDS DESK SMOKE: FAIL (%d)" % _desk_smoke_failures)
		get_tree().quit(1)


# -------------------------------------------------- dpadexit smoke

## --pvlds-smoke-dpadexit: the room half of the two-rule exit
## model. A FRESH D-pad Right press in the room (browsing) is the
## BACK-out: it must run the rail EXIT path - disarm ("room Exit")
## + quit - through the room's real gamepad poll, fed here by a
## synthetic InputEventJoypadButton (the lockout smoke's feed).
## Success quits the process from inside _on_exit_requested
## before this driver can print a verdict, so the PASS evidence
## lives outside: the harness sees exit code 0 and reads the
## disarm + its reason off the contract file. If the press does
## nothing, the driver survives to phase 2 and fails loudly.
## The held leg (--pvlds-smoke-dpadexit-held) drives the
## baseline-arming contract instead: the button was pinned in
## _ready, before the room instance's first poll, so no exit may
## fire while it sits pressed (the driver surviving the pinned
## stretch IS the assertion - a phantom exit kills the driver
## with the app, and the harness fails on the missing survival
## line); after the release, a fresh press must exit as usual.
func _drive_dpadexit_smoke() -> void:
	if _dpadexit_held_leg:
		_drive_dpadexit_held()
	else:
		_drive_dpadexit_fresh()


func _drive_dpadexit_fresh() -> void:
	match _dpadexit_smoke_phase:
		0:
			if _room != null and _room.visible and _room.wall_ready:
				# BACKSTEP determinism: the contract is a fresh
				# press on the MAIN screen. The shared user
				# data's persisted view could stand in a filter
				# view (where the press now steps home first),
				# so the driver puts the wall on ALL through
				# the room's own rail handler before injecting.
				_room._handle_rail("filter:all")
				var press: InputEventJoypadButton = InputEventJoypadButton.new()
				press.device = 0
				press.button_index = JOY_BUTTON_DPAD_RIGHT
				press.pressed = true
				Input.parse_input_event(press)
				print("  info - dpadexit smoke: fresh D-pad Right injected into the room")
				_dpadexit_smoke_wait = 0
				_dpadexit_smoke_phase = 1
			else:
				_dpadexit_smoke_wait += 1
				if _dpadexit_smoke_wait > 3600:
					printerr("PVLDS DPAD EXIT SMOKE: FAIL - the room never came up")
					get_tree().quit(1)
		1:
			_dpadexit_smoke_wait += 1
			if _dpadexit_smoke_wait == 2:
				var release: InputEventJoypadButton = InputEventJoypadButton.new()
				release.device = 0
				release.button_index = JOY_BUTTON_DPAD_RIGHT
				release.pressed = false
				Input.parse_input_event(release)
			if _dpadexit_smoke_wait > 30:
				printerr("PVLDS DPAD EXIT SMOKE: FAIL - a fresh D-pad Right press in the room did not exit the app")
				get_tree().quit(1)


func _drive_dpadexit_held() -> void:
	match _dpadexit_smoke_phase:
		0:
			# Room up: start counting the pinned stretch. The
			# button has read pressed since before this instance
			# existed - if the exit were going to fire on it, it
			# fires in the first polls after the room comes up.
			# (BACKSTEP: the wall is put on ALL first, through
			# the room's own rail handler - the leg's contract
			# is the main-screen press; see the fresh leg.)
			if _room != null and _room.visible and _room.wall_ready:
				_room._handle_rail("filter:all")
				_dpadexit_smoke_wait = 0
				_dpadexit_smoke_phase = 1
			else:
				_dpadexit_smoke_wait += 1
				if _dpadexit_smoke_wait > 3600:
					printerr("PVLDS DPAD EXIT SMOKE: FAIL - the room never came up (held leg)")
					get_tree().quit(1)
		1:
			_dpadexit_smoke_wait += 1
			if _dpadexit_smoke_wait >= 90:
				# Survived 90 frames pinned. (A phantom exit would
				# have killed the process - and this driver - long
				# before this print; the harness asserts the line.)
				print("  info - dpadexit smoke: held leg survived 90 frames pinned - releasing")
				var release: InputEventJoypadButton = InputEventJoypadButton.new()
				release.device = 0
				release.button_index = JOY_BUTTON_DPAD_RIGHT
				release.pressed = false
				Input.parse_input_event(release)
				_dpadexit_smoke_wait = 0
				_dpadexit_smoke_phase = 2
		2:
			_dpadexit_smoke_wait += 1
			if _dpadexit_smoke_wait >= 10:
				# Released polls witnessed: a fresh press now must
				# exit through the rail path, arming or not.
				var press: InputEventJoypadButton = InputEventJoypadButton.new()
				press.device = 0
				press.button_index = JOY_BUTTON_DPAD_RIGHT
				press.pressed = true
				Input.parse_input_event(press)
				print("  info - dpadexit smoke: held leg - fresh D-pad Right injected after the release")
				_dpadexit_smoke_wait = 0
				_dpadexit_smoke_phase = 3
		3:
			_dpadexit_smoke_wait += 1
			if _dpadexit_smoke_wait == 2:
				var release2: InputEventJoypadButton = InputEventJoypadButton.new()
				release2.device = 0
				release2.button_index = JOY_BUTTON_DPAD_RIGHT
				release2.pressed = false
				Input.parse_input_event(release2)
			if _dpadexit_smoke_wait > 30:
				printerr("PVLDS DPAD EXIT SMOKE: FAIL - after a witnessed release, a fresh D-pad Right press did not exit the app (held leg)")
				get_tree().quit(1)


# -------------------------------------------------- backstep smoke

## --pvlds-smoke-backstep: BACKSTEP's contract, driven
## through the room's real gamepad poll with real
## InputEventJoypadButton events (the input smoke's feed):
##   - standing in a FILTER VIEW (FAVORITES / VR / RECENTS /
##     NEW), a BACK press - D-pad Right or B - steps home
##     to the ALL wall: the room's filter reads ALL, the
##     rail's standing section is ALL, the wall shows the
##     full set, and NO exit fires;
##   - on the ALL wall itself, either press runs the exit
##     (witnessed by a probe on exit_requested - the boot
##     survives its own proof);
##   - SORT is not a view: BACK from a sorted ALL wall
##     exits, it does not step;
##   - B carries the baseline-release arming law, judged
##     by the held variant (--pvlds-smoke-backstep-held):
##     B pinned pressed from _ready, before the room
##     instance's first poll, fires nothing across the
##     pinned stretch; after a witnessed release the same
##     press from ALL exits (the dpadexit held pattern).
## The walk arranges its own state through the room's store
## (two favorites, two recents) and the rail's own handlers,
## in a fresh user-data home where every fixture file is
## newly stamped (the NEW view stands full). Under
## PVLDS_BACKSTEP_NC=oldback the step never happens and the
## step legs fail by name; under =nobind B stays unbound in
## the wall and the B legs fail by name.
func _drive_backstep_smoke() -> void:
	match _bs_phase:
		0:
			if _room != null and _room.visible and _room.wall_ready:
				Input.warp_mouse(Vector2(512.0, 764.0))
				_bs_wait = 0
				_bs_phase = 1
			else:
				_bs_wait += 1
				if _bs_wait > 3600:
					_bs_expect(false, "boot: the room never came up")
					_bs_finish_smoke()
		1:
			if _bs_done:
				_bs_finish_smoke()
				return
			_bs_wait += 1
			if _bs_wait > 7200:
				_bs_expect(false, "boot: the backstep legs never finished")
				_bs_finish_smoke()
			elif not _bs_started and _room != null and _room.wall_ready and _bs_wait >= 4:
				_bs_started = true
				if _bs_held_leg:
					_bs_held_legs_async()
				else:
					_bs_legs_async()


func _bs_expect(cond: bool, label: String) -> void:
	if cond:
		print("  ok - backstep smoke: ", label)
	else:
		_bs_failures += 1
		printerr("  FAIL - backstep smoke: ", label)


func _bs_finish_smoke() -> void:
	if _room != null and _bs_probe.is_valid() and _room.exit_requested.is_connected(_bs_probe):
		_room.exit_requested.disconnect(_bs_probe)
		_room.exit_requested.connect(Callable(self, "_on_exit_requested"))
	if _bs_failures == 0:
		print("PVLDS BACKSTEP SMOKE: PASS")
		get_tree().quit(0)
	else:
		printerr("PVLDS BACKSTEP SMOKE: FAIL (%d)" % _bs_failures)
		get_tree().quit(1)


func _bs_wait_frames(n: int) -> void:
	for i: int in range(n):
		await get_tree().process_frame


func _bs_inject(btn: JoyButton, pressed: bool) -> void:
	var ev: InputEventJoypadButton = InputEventJoypadButton.new()
	ev.device = 0
	ev.button_index = btn
	ev.pressed = pressed
	Input.parse_input_event(ev)


## One full press through the real poll: down for a few
## frames (the edge fires), up, then a settle long enough
## for the rebuild the press may have started.
func _bs_feed_button(btn: JoyButton) -> void:
	_bs_inject(btn, true)
	await _bs_wait_frames(3)
	_bs_inject(btn, false)
	await _bs_wait_frames(18)


## The standing view, read the way it renders: the filter
## the wall's set is collected under AND the rail accent
## that names that section standing (the strip face wears
## the same accent).
func _bs_standing(f: String) -> bool:
	if _room == null or _room._filter != f:
		return false
	return bool(_room._rail_label_accent("filter:" + f)[1])


func _bs_legs_async() -> void:
	# The exit probe stands for the whole run: a press that
	# runs the exit is witnessed, never obeyed, so one boot
	# judges every leg.
	_bs_probe = func() -> void: _bs_exit_fired = true
	_room.exit_requested.disconnect(Callable(self, "_on_exit_requested"))
	_room.exit_requested.connect(_bs_probe)
	# Fixture state, through the room's own store: two
	# favorites, two recents, on four distinct games.
	var games: Array[GameEntry] = _scanner.games
	if games.size() < 4:
		_bs_expect(false, "fixture: the library holds fewer than four games")
		_bs_done = true
		return
	_room._store.set_favorite(games[0].game_id, true)
	_room._store.set_favorite(games[1].game_id, true)
	_room._store.touch_recent(games[2].game_id)
	_room._store.touch_recent(games[3].game_id)
	_room._store.save_to_disk()
	var all_count: int = games.size()
	# ---- FAVORITES, stepped home by D-pad Right ----
	_room._handle_rail("filter:favorites")
	await _bs_wait_frames(10)
	_bs_expect(_bs_standing("favorites") and _room._visible_games.size() == 2,
		"favorites: the FAVORITES view stands with its two games")
	_grad_save_grab("backstep_favorites.png")
	_bs_exit_fired = false
	await _bs_feed_button(JOY_BUTTON_DPAD_RIGHT)
	_bs_expect(not _bs_exit_fired and _bs_standing("all") and _room._visible_games.size() == all_count,
		"favorites dpad: BACK lands on ALL (standing section + full wall), no exit")
	_bs_expect(_room.focused_quad() == _room.rail_quad("filter:all"),
		"favorites dpad: focus lands on the ALL stop, as a filter press lands")
	_grad_save_grab("backstep_all.png")
	# ---- FAVORITES, stepped home by B ----
	_room._handle_rail("filter:favorites")
	await _bs_wait_frames(10)
	_bs_exit_fired = false
	await _bs_feed_button(JOY_BUTTON_B)
	_bs_expect(not _bs_exit_fired and _bs_standing("all") and _room._visible_games.size() == all_count,
		"favorites b: BACK lands on ALL (standing section + full wall), no exit")
	# ---- VR, stepped home by D-pad Right ----
	var vr_count: int = 0
	for g: GameEntry in games:
		if g.is_vr_tagged():
			vr_count += 1
	_room._handle_rail("filter:vr")
	await _bs_wait_frames(10)
	_bs_expect(_bs_standing("vr") and _room._visible_games.size() == vr_count,
		"vr: the VR view stands with the VR-tagged set")
	_bs_exit_fired = false
	await _bs_feed_button(JOY_BUTTON_DPAD_RIGHT)
	_bs_expect(not _bs_exit_fired and _bs_standing("all"),
		"vr dpad: BACK lands on ALL, no exit")
	# ---- RECENTS, stepped home by B ----
	_room._handle_rail("filter:recents")
	await _bs_wait_frames(10)
	_bs_expect(_bs_standing("recents") and _room._visible_games.size() == 2,
		"recents: the RECENTS view stands with its two games")
	_bs_exit_fired = false
	await _bs_feed_button(JOY_BUTTON_B)
	_bs_expect(not _bs_exit_fired and _bs_standing("all"),
		"recents b: BACK lands on ALL, no exit")
	# ---- NEW, stepped home by D-pad Right ----
	_room._handle_rail("filter:new")
	await _bs_wait_frames(10)
	_bs_expect(_bs_standing("new") and _room._visible_games.size() == all_count,
		"new: the NEW view stands (fresh home: every file newly stamped)")
	_bs_exit_fired = false
	await _bs_feed_button(JOY_BUTTON_DPAD_RIGHT)
	_bs_expect(not _bs_exit_fired and _bs_standing("all"),
		"new dpad: BACK lands on ALL, no exit")
	# ---- SORT is not a view: BACK from a sorted ALL exits ----
	_room._handle_rail("sort")
	await _bs_wait_frames(10)
	_bs_exit_fired = false
	await _bs_feed_button(JOY_BUTTON_DPAD_RIGHT)
	_bs_expect(_bs_exit_fired,
		"sort dpad: BACK from a sorted ALL wall exits - sort is not a view")
	# ---- The ALL wall itself: either press runs the exit ----
	_bs_exit_fired = false
	await _bs_feed_button(JOY_BUTTON_DPAD_RIGHT)
	_bs_expect(_bs_exit_fired, "all dpad: BACK from ALL exits")
	_bs_exit_fired = false
	await _bs_feed_button(JOY_BUTTON_B)
	_bs_expect(_bs_exit_fired, "all b: BACK from ALL exits")
	# ---- B's arming is NOT judged here: it is the held
	# variant's whole boot (--pvlds-smoke-backstep-held,
	# B pinned from _ready - the dpadexit pattern). An
	# in-boot state surgery cannot reproduce the phantom:
	# a released poll re-arms B before any injected press
	# lands, which the first run of this leg proved by
	# failing. ----
	_bs_done = true


## The held variant's legs: B has read pressed since
## before this room instance existed (pinned in _ready).
## The probe stands before anything can fire - while the
## button sits pinned and unarmed, nothing CAN fire - and
## the driver surviving the pinned stretch with the probe
## silent IS the assertion. Then the release is witnessed
## and a fresh press from the ALL wall must exit.
func _bs_held_legs_async() -> void:
	_bs_probe = func() -> void: _bs_exit_fired = true
	_room.exit_requested.disconnect(Callable(self, "_on_exit_requested"))
	_room.exit_requested.connect(_bs_probe)
	_room._handle_rail("filter:all")
	_bs_exit_fired = false
	await _bs_wait_frames(90)
	_bs_expect(not _bs_exit_fired and _bs_standing("all"),
		"arming b held: a B pinned from before the room's first poll fires no exit")
	_bs_inject(JOY_BUTTON_B, false)
	await _bs_wait_frames(10)
	_bs_exit_fired = false
	await _bs_feed_button(JOY_BUTTON_B)
	_bs_expect(_bs_exit_fired,
		"arming b held: after a witnessed release, B from ALL exits")
	_bs_done = true


