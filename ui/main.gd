			cb_empty_rows += 1
	_expect(str(cb_kv.get("Designer", "")) == "Mark Ritchie" and str(cb_srcs.get("Designer", "")) == "db",
		"cardback: the db well's designer row stands with its db dot (got '%s' / '%s')" % [str(cb_kv.get("Designer", "<none>")), str(cb_srcs.get("Designer", "<none>"))], failures)
	_expect(str(cb_kv.get("Design", "")) == "Mark Ritchie, Doug Watson" and str(cb_srcs.get("Design", "")) == "ipdb",
		"cardback: the IPDB design row stands BESIDE the db row - the disagreement is shown, never merged (got '%s')" % str(cb_kv.get("Design", "<none>")), failures)
	_expect(str(cb_kv.get("Units produced", "")) == "12,716" and str(cb_kv.get("Body", "")) == "Widebody",
		"cardback: the IPDB production / body rows stand in the grid", failures)
	# BACKTRIM: the grid ends at Units produced - the
	# three rows after it (Fun rating, Features, IPDB
	# entry) are cut from the render; Indy's sheet is
	# exactly 11 kv rows now (14 before the trim). The
	# facts themselves stay cached (the ipdbfix legs
	# above still read fun_rating off the snapshot).
	_expect(not cb_kv.has("Fun rating") and not cb_kv.has("Features") and not cb_kv.has("IPDB entry"),
		"backtrim: no Fun rating, Features or IPDB entry rows stand past Units produced", failures)
	_expect(cb_kv.size() == 11,
		"backtrim: Indy's grid is exactly the 11 rows through Units produced (got %d)" % cb_kv.size(), failures)
	_expect(str(cb_kv.get("Type", "")) == "Solid State" and str(cb_srcs.get("Type", "")) == "db" and str(cb_kv.get("MPU", "")) == "Williams WPC (DCS)",
		"cardback: the db machine rows stand in the grid with db dots", failures)
	_expect(cb_empty_rows == 0, "cardback: the grid carries no empty rows", failures)
	var cb_spec_db: Dictionary = RoomSpecs.wing_spec(cb_dbonly, null, "", 1700000000, {})
	var cb_ipdb_rows: int = 0
	var cb_db_empty: int = 0
	for rv2: Variant in (cb_spec_db.get("rows", []) as Array):
		var rd2: Dictionary = rv2 as Dictionary
		if str(rd2.get("kind", "")) != "kv":
			continue
		if str(rd2.get("src", "")) == "ipdb":
			cb_ipdb_rows += 1
		if str(rd2.get("v", "")) == "":
			cb_db_empty += 1
	_expect(cb_ipdb_rows == 0, "cardback: a game with no cached IPDB facts shows NO ipdb rows (degrades honestly)", failures)
	_expect(cb_db_empty == 0, "cardback: the db-only back carries no empty rows either", failures)

	# BACKFINE: the PINemHi back, refined - the date is
	# out, the local TOP10_Best file is in. ONETEN: the
	# back's final shape - his #1 personal row ALONE,
	# then the Best section WHOLE (divider + #1 + rows
	# #2-10) - judged here at every personal count.
	# Spec-level legs over synthetic records (the boot
	# smoke judges the same contract standing in the
	# room).
	var bf_game: GameEntry = GameEntry.new()
	bf_game.game_id = "backfine"
	bf_game.title = "Backfine Test"
	bf_game.manufacturer = "Williams"
	bf_game.year = 1995
	var bf_rec := func(n: int, player: String, top: int) -> Dictionary:
		var rs: Array = []
		for i: int in range(n):
			rs.append({"rank": i + 1, "score": top - i * 1000000, "score_text": "", "player": player, "when": "2026-07-06 20:15:24"})
		return {"title": "Backfine Test", "rows": rs}
	var bf_kinds := func(spec: Dictionary) -> Array:
		var ks: Array = []
		for rv: Variant in (spec.get("rows", []) as Array):
			ks.append(str((rv as Dictionary).get("kind", "")))
		return ks
	var bf_scores := func(spec: Dictionary) -> Array:
		var ss: Array = []
		for rv: Variant in (spec.get("rows", []) as Array):
			var rd: Dictionary = rv as Dictionary
			if str(rd.get("kind", "")) == "score":
				ss.append(str(rd.get("score_text", "")))
		return ss
	var bf_world1 := func(spec: Dictionary) -> Array:
		var ws: Array = []
		for rv: Variant in (spec.get("rows", []) as Array):
			var rd: Dictionary = rv as Dictionary
			if str(rd.get("kind", "")) == "score":
				ws.append(bool(rd.get("world1", false)))
		return ws
	# The date is nuked: a personal row's name is the
	# player alone (under PVLDS_BACKFINE_NC=dateback this
	# leg fails by name - the date rides again).
	var bf_spec8: Dictionary = RoomSpecs.pinemhi_back_spec(bf_game, bf_rec.call(8, "Kubrick", 1638803870))
	var bf_first: Dictionary = ((bf_spec8.get("rows", []) as Array)[0] as Dictionary)
	_expect(str(bf_first.get("name_text", "")) == "Kubrick",
		"backfine: a personal row's name is the player ALONE - no date rides it (got '%s')" % str(bf_first.get("name_text", "<none>")), failures)
	# ONETEN: the personal block is his #1 ALONE and the
	# Best section stands WHOLE at every personal count
	# (under PVLDS_ONETEN_NC=allpersonal the personal
	# legs fail by name - every row rides again; under
	# =best1only the full-ten legs fail by name - the
	# section stops at its #1 again). The synthetic
	# Best file's ten, in file order:
	var bf_best10: Array = ["2,000,000,000", "1,999,000,000", "1,998,000,000", "1,997,000,000", "1,996,000,000", "1,995,000,000", "1,994,000,000", "1,993,000,000", "1,992,000,000", "1,991,000,000"]
	# 8 personal (the real Apollo file's count behind
	# its #1) + 10 Best: ONE personal row - the file's
	# #1, value-checked - then the ten whole.
	var bf_spec8b: Dictionary = RoomSpecs.pinemhi_back_spec(bf_game, bf_rec.call(8, "Kubrick", 1638803870), bf_rec.call(10, "Online", 2000000000))
	var bf_s8b: Array = bf_scores.call(bf_spec8b)
	var bf_w8b: Array = bf_world1.call(bf_spec8b)
	_expect(bf_s8b == ["1,638,803,870"] + bf_best10 and bf_kinds.call(bf_spec8b).has("divider"),
		"oneten: 8 personal + 10 Best stands his #1 alone, then the full ten (scores: %s)" % str(bf_s8b), failures)
	_expect(not bf_s8b.has("1,637,803,870"),
		"oneten: the personal file's #2 does NOT stand - the personal block is one row, not the file's list", failures)
	_expect(bf_w8b.size() == 11 and not bool(bf_w8b[0]) and bool(bf_w8b[1]) and not bf_w8b.slice(2).has(true),
		"oneten: the Best #1 alone wears the world1 ground, first under the divider (flags: %s)" % str(bf_w8b), failures)
	# 1 personal + 10 Best: the Lost in Space shape -
	# the back Chris pointed at all along.
	var bf_spec1b: Dictionary = RoomSpecs.pinemhi_back_spec(bf_game, bf_rec.call(1, "Kubrick", 264985480), bf_rec.call(10, "Online", 2000000000))
	_expect(bf_scores.call(bf_spec1b) == ["264,985,480"] + bf_best10,
		"oneten: 1 personal + 10 Best (the Lost in Space shape) stands his #1, then the full ten (scores: %s)" % str(bf_scores.call(bf_spec1b)), failures)
	# 10 personal + 10 Best: still ONE personal row -
	# the shape never follows the count.
	var bf_spec10b: Dictionary = RoomSpecs.pinemhi_back_spec(bf_game, bf_rec.call(10, "Kubrick", 1638803870), bf_rec.call(10, "Online", 2000000000))
	_expect(bf_scores.call(bf_spec10b) == ["1,638,803,870"] + bf_best10,
		"oneten: 10 personal + 10 Best stands his #1 alone, then the full ten (scores: %s)" % str(bf_scores.call(bf_spec10b)), failures)
	# No Best record: no divider, no Best rows - his
	# #1 stands alone (the ghostbest NC's room seam
	# fails the matching boot legs by name).
	_expect(not bf_kinds.call(bf_spec8).has("divider") and bf_scores.call(bf_spec8) == ["1,638,803,870"],
		"oneten: no Best file, no Best section - his #1 stands alone", failures)
	# Best alone: the honest empty line stands above
	# the divider and the whole ten - 12 entries.
	var bf_spec0b: Dictionary = RoomSpecs.pinemhi_back_spec(bf_game, {"title": "Backfine Test", "rows": []}, bf_rec.call(10, "Online", 2000000000))
	var bf_k0b: Array = bf_kinds.call(bf_spec0b)
	_expect(bf_k0b.size() == 12 and str(bf_k0b[0]) == "note" and str(bf_k0b[1]) == "divider" and bf_scores.call(bf_spec0b) == bf_best10,
		"oneten: Best alone stands whole under the empty personal line (kinds: %s)" % str(bf_k0b), failures)
	# The Best reader's folder doors: a fabricated
	# install in the proven file shape (the same shape
	# the Personal fixture proved) - the Best shelf
	# loads by title key, the shelves never leak into
	# each other. (No REAL Best file exists in this
	# workspace: the parse stands as a same-writer
	# assumption, flagged in BACKFINE's STATUS.md.)
	var bf_root: String = "user://core_test_pinemhi_best"
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(bf_root + "/PINemHi LeaderBoard/TOP10_Best"))
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(bf_root + "/PINemHi LeaderBoard/TOP10_Personal"))
	_expect(_write_text_file(bf_root + "/PINemHi LeaderBoard/TOP10_Best/backfine.txt",
		"PINEMHI ONLINE LEADERBOARD\n\n<<< Backfine Test >>>\n\n\nTOP 10 Best Scores\n1   2.000.000.000      Online  2026-09-30 22:41:07\n2   1.999.000.000      Online  2026-08-19 03:12:55\n"),
		"backfine: the fabricated Best fixture writes", failures)
	_expect(_write_text_file(bf_root + "/PINemHi LeaderBoard/TOP10_Personal/backfine.txt",
		"PINEMHI ONLINE LEADERBOARD\n\n<<< Backfine Test >>>\n\n\nTOP 10 Personal Best Scores\n1   1.638.803.870      Kubrick  2026-07-06 20:15:24\n"),
		"backfine: the fabricated Personal fixture writes", failures)
	var bf_best_map: Dictionary = PinemhiScores.load_folder_best_rows(ProjectSettings.globalize_path(bf_root))
	var bf_pers_map: Dictionary = PinemhiScores.load_folder_rows(ProjectSettings.globalize_path(bf_root))
	var bf_best_rec: Dictionary = bf_best_map.get("backfine test", {}) as Dictionary
	var bf_best_rows: Array = bf_best_rec.get("rows", []) as Array
	_expect(bf_best_rows.size() == 2 and int((bf_best_rows[0] as Dictionary).get("score", 0)) == 2000000000,
		"backfine: the Best shelf loads by title key, its #1 on top (got %s)" % str(bf_best_rows), failures)
	var bf_pers_rec: Dictionary = bf_pers_map.get("backfine test", {}) as Dictionary
	_expect((bf_pers_rec.get("rows", []) as Array).size() == 1,
		"backfine: the Personal shelf loads its own file beside the Best shelf", failures)
	_expect(int(((bf_pers_rec.get("rows", []) as Array)[0] as Dictionary).get("score", 0)) == 1638803870,
		"backfine: the shelves never leak - the Personal read holds the Personal score, not the Best one", failures)

	# SCOREMARK: the front mark's semantics + spec shape.
	# The mark keys on the player's OWN Personal rows
	# alone (under PVLDS_SCOREMARK_NC=bestkey the Best
	# rows key it instead and the semantic leg fails by
	# name; under =ghostmark every game is marked and the
	# scoreless legs fail by name). The maps key by
	# challenge_key(title), the backs' own join.
	var sm_key: String = PinemhiScores.challenge_key(bf_game.title)
	var sm_pers: Dictionary = {sm_key: bf_rec.call(2, "Kubrick", 1638803870)}
	var sm_best: Dictionary = {sm_key: bf_rec.call(10, "Online", 2000000000)}
	_expect(RoomSpecs.pinemhi_marked(bf_game, sm_pers, {}),
		"scoremark: a game holding the player's own Personal rows is marked", failures)
	_expect(not RoomSpecs.pinemhi_marked(bf_game, {}, sm_best),
		"scoremark: a Best file but NO personal rows earns NO mark - that table still needs a scoring", failures)
	_expect(not RoomSpecs.pinemhi_marked(bf_game, {}, {}),
		"scoremark: a game with no PINemHi files at all is unmarked", failures)
	_expect(not RoomSpecs.pinemhi_marked(bf_game, {sm_key: {"title": bf_game.title, "rows": []}}, {}),
		"scoremark: a Personal record with an empty row list is no score - unmarked", failures)
	_expect(RoomSpecs.pinemhi_marked(bf_game, sm_pers, sm_best),
		"scoremark: personal rows mark even when a Best file also stands", failures)
	# The specs carry the flag + the band colour; the
	# defaults carry neither (every existing caller is
	# untouched).
	var sm_art: Dictionary = RoomSpecs.art_spec(bf_game, null, null, true, true)
	_expect(bool(sm_art.get("scoremark", false)) and (sm_art.get("scoremark_color", Color()) as Color) == RoomSpecs.manufacturer_color(bf_game.manufacturer),
		"scoremark: the art spec carries the mark in the game's own back-band colour", failures)
	_expect(not bool(RoomSpecs.art_spec(bf_game, null, null).get("scoremark", true)),
		"scoremark: the art spec's default carries no mark", failures)
	var sm_panel: Dictionary = RoomSpecs.panel_spec(bf_game, null, true)
	var sm_chip_found: bool = false
	var sm_chip_color_ok: bool = false
	for cv: Variant in (sm_panel.get("chips", []) as Array):
		var cd: Dictionary = cv as Dictionary
		if str(cd.get("text", "")) == "PINemHi":
			sm_chip_found = true
			sm_chip_color_ok = (cd.get("color", Color()) as Color) == RoomSpecs.manufacturer_color(bf_game.manufacturer)
	_expect(sm_chip_found and sm_chip_color_ok,
		"scoremark: the panel spec carries the PINemHi chip in the band colour", failures)
	var sm_chip_default: bool = false
	for cv2: Variant in (RoomSpecs.panel_spec(bf_game, null).get("chips", []) as Array):
		if str((cv2 as Dictionary).get("text", "")) == "PINemHi":
			sm_chip_default = true
	_expect(not sm_chip_default,
		"scoremark: the panel spec's default carries no PINemHi chip", failures)

	if failures.is_empty():
		print("CORE TEST: PASS")
		get_tree().quit(0)
	else:
		printerr("CORE TEST: FAIL (%d)" % failures.size())
		get_tree().quit(1)
