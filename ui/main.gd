## THE VERTICAL WALL LAW on the strip's own route
## (GRADFIX13 item 4): from a strip slot, UP climbs to the
## rail, and UP again must land on the CENTRE column's
## card - the centre panel itself - with the centre column
## exactly where it stood. State-level, like the other
## phase-1 legs; the nav smoke's leg 9 judges the same law
## over frames from every rail stop. Under
## PVLDS_GF13_NC=oldascent the ascent falls back to the
## projection walk, focus lands a column off centre, and
## this leg fails by name on the landing itself.
func _letters_leg_vertical_wall() -> void:
	var centre_idx: int = _room.centre_index()
	var centre_col: int = _room._grid_coord(centre_idx).x
	var slot: String = ""
	for k: String in ["A", "F", "W", "THE", "#"]:
		if _room.strip_slot_pickable(k):
			slot = k
			break
	_letters_expect(slot != "", "vertical wall law: a pickable strip slot stands for the climb")
	if slot == "":
		return
	_room._set_focused(_room.letter_quad(slot))
	_room._move_focus(Vector2(0.0, -1.0))
	_letters_expect(_nav_key_of(_room.focused_quad()) != "",
		"vertical wall law: UP from the strip lands on the rail (from slot %s)" % slot)
	_room._move_focus(Vector2(0.0, -1.0))
	_letters_expect(_room.focused_quad() == _room._panels[_room.centre_index()],
		"vertical wall law: UP from the rail lands on the centre column's card (centre %d, focus panel %d)" % [_room.centre_index(), _room._panels.find(_room.focused_quad())])
	_letters_expect(_room.centre_index() == centre_idx and _room._grid_coord(_room.centre_index()).x == centre_col,
		"vertical wall law: the strip -> rail -> rows climb leaves the centre column seated")


## Fault 1's legs (Chris, 2026-10-27: the highlight "doesn't
## make it down to letters. It disappears."). The country leg
## above proved the strip is reachable in STATE; these legs
## walk the player's actual route - bottom-row card, DOWN to
## the rail, DOWN to the strip - and then prove the highlight
## is DRAWN on the letter: the quad's own frame flag, and blue
## frame pixels in a rendered grab. A focus that exists in
## state but draws nothing is a failed delivery.
## A card at the bottom of its column, under the standing
## mapping (GRADFIX3: the column-major fill moved which
## index that is - the legs derive it from the mapping,
## never from a remembered index).
func _letters_bottom_card() -> ClickableQuad:
	for bi: int in range(_room._panels.size()):
		var bc: Vector2i = _room._grid_coord(bi)
		if bc.y == 2 or _room._index_at(bc.x, bc.y + 1) == bi:
			return _room._panels[bi]
	return null


func _letters_leg_strip_entry() -> void:
	_letters_pick("A") ## a plain wall: title sort, page 1, no net
	_room._set_focused(_letters_bottom_card()) ## a bottom-row card
	_room._move_focus(Vector2(0.0, 1.0))
	_letters_expect(_nav_key_of(_room.focused_quad()) != "",
		"strip entry: DOWN from a bottom-row card lands on the rail (got '%s')" % _nav_key_of(_room.focused_quad()))
	_room._move_focus(Vector2(0.0, 1.0))
	var key: String = _letters_key_of(_room.focused_quad())
	_letters_expect(key != "",
		"strip entry: DOWN from the rail lands on the strip (got key '%s')" % key)
	var fq: ClickableQuad = _room.focused_quad()
	_letters_expect(fq != null and fq.highlight_visible(),
		"strip visual: the focused letter's highlight frame is flagged showing (key '%s')" % key)
	# Steer right to the row's drawn far end (#), then one
	# step back to the wide THE slot for the photograph: its
	# frame ring is the broadest on the strip.
	for i: int in range(30):
		_room._move_focus(Vector2(1.0, 0.0))
	_letters_expect(_letters_key_of(_room.focused_quad()) == "#",
		"strip visual: the walk right from the entry holds at #, the drawn far end (got '%s')" % _letters_key_of(_room.focused_quad()))
	_room._move_focus(Vector2(-1.0, 0.0))
	_letters_focus_key = _letters_key_of(_room.focused_quad())
	_letters_expect(_letters_focus_key == "THE",
		"strip visual: one step left from # lands on THE for the grab (got '%s')" % _letters_focus_key)
	_letters_expect(_room.focused_quad() != null and _room.focused_quad().highlight_visible(),
		"strip visual: THE's highlight frame is flagged showing for the grab")


## Grab the live frame and count focus-frame-blue pixels in
## the ring band around the named slot (which must hold the
## focus - anything else counts zero). The grab is saved
## beside the log under PVLDS_GRAB_DIR.
func _letters_grab_ring(key: String, file_name: String) -> int:
	var fq: ClickableQuad = _room.letter_quad(key)
	if fq == null or _room.focused_quad() != fq:
		return 0
	var img: Image = get_viewport().get_texture().get_image()
	var dir: String = OS.get_environment("PVLDS_GRAB_DIR")
	if dir != "":
		img.save_png(dir.path_join(file_name))
	return _letters_ring_blue_count(img, fq, _room._strip_slot_size(key))


## The rendered half of fault 1: grab the actual frame and
## count focus-frame-blue pixels in the band the frame ring
## occupies (the frame quad is 1.055x its face, riding just
## behind it, so the ring lives between the face's edge and
## ~7% beyond it). The letter face itself is never that blue.
func _letters_leg_strip_grab() -> void:
	var fq: ClickableQuad = _room.focused_quad()
	if fq == null or _letters_focus_key == "":
		_letters_smoke_fail("strip visual: no focused letter to photograph")
		return
	var img: Image = get_viewport().get_texture().get_image()
	var dir: String = OS.get_environment("PVLDS_GRAB_DIR")
	if dir != "":
		img.save_png(dir.path_join("strip_focus.png"))
	var blue: int = _letters_ring_blue_count(img, fq, _room._strip_slot_size(_letters_focus_key))
	_letters_expect(blue >= 6,
		"strip visual: the rendered frame shows the focus frame around '%s' (%d frame-blue band samples)" % [_letters_focus_key, blue])


func _letters_is_frame_blue(img: Image, x: int, y: int) -> bool:
	if x < 0 or y < 0 or x >= img.get_width() or y >= img.get_height():
		return false
	var px: Color = img.get_pixel(x, y)
	# ClickableQuad.FOCUS_COLOR (0.35, 0.75, 1.0), unshaded.
	return px.b > 0.8 and px.g > 0.55 and px.r < 0.6 and px.b > px.r + 0.25


func _letters_ring_blue_count(img: Image, quad: ClickableQuad, size: Vector2) -> int:
	var cam: Camera3D = get_viewport().get_camera_3d()
	if cam == null:
		return 0
	var half: Vector2 = size * 0.5
	var pts: Array[Vector2] = []
	for c: Vector2 in [Vector2(-half.x, -half.y), Vector2(half.x, -half.y), Vector2(-half.x, half.y), Vector2(half.x, half.y)]:
		pts.append(cam.unproject_position(quad.global_transform * Vector3(c.x, c.y, 0.0)))
	var mn: Vector2 = pts[0]
	var mx: Vector2 = pts[0]
	for p: Vector2 in pts:
		mn = mn.min(p)
		mx = mx.max(p)
	var inner: Rect2 = Rect2(mn, mx - mn).grow_individual(-2.0, -2.0, -2.0, -2.0)
	var outer: Rect2 = Rect2(mn, mx - mn)
	outer = outer.grow_individual(outer.size.x * 0.075, outer.size.y * 0.075, outer.size.x * 0.075, outer.size.y * 0.075)
	var count: int = 0
	var x: int = int(outer.position.x)
	while x < int(outer.position.x + outer.size.x):
		var y: int = int(outer.position.y)
		while y < int(outer.position.y + outer.size.y):
			if not inner.has_point(Vector2(float(x), float(y))):
				if _letters_is_frame_blue(img, x, y):
					count += 1
			y += 1
		x += 1
	return count


## Fault 2's legs (Chris, 2026-10-27: turning a page with the
## rail's arrows "resets to wall cards, upper area and you
## have to tap-tap-tap back down to arrow"). One step per
## _process call; returns true when the legs are done. Every
## press is the pad's real route: focus the arrow, press A.
## The pager legs' step machine. The settle reads poll the
## room's page_slide_active() seam (the dome's swing) -
## GRADUATION AMENDMENT: they used to read the flat wall's
## _slide_phase field, which the dome port removed; the
## seam is the same question asked of the room's current
## travel state.
func _letters_leg_pager_step() -> bool:
	match _letters_step:
		0:
			_letters_pick("A") ## page 1 of 2, title sort, no net
			_room._set_focused(_room.rail_quad("sort"))
			_room._handle_rail("page_next")
			_letters_step = 1
			_letters_smoke_wait = 0
		1:
			_letters_smoke_wait += 1
			if not _room.page_slide_active() and _letters_smoke_wait >= 8:
				_letters_expect(_room._page == 1,
					"pager: NEXT turns to the second page (got %d)" % _room._page)
				_letters_expect(_room.focused_quad() == _room.rail_quad("sort"),
					"pager: focus survives a NEXT page turn (no drop, no steal)")
				_room._handle_rail("page_next") ## clamped: page 2 of 2 is the last
				_letters_step = 2
				_letters_smoke_wait = 0
			elif _letters_smoke_wait > 3600:
				_letters_smoke_fail("pager: the NEXT slide never settled")
				return true
		2:
			_letters_smoke_wait += 1
			if _letters_smoke_wait >= 12:
				_letters_expect(_room._page == 1,
					"pager: a clamped NEXT stays on the last page (got %d)" % _room._page)
				_letters_expect(_room.focused_quad() == _room.rail_quad("sort"),
					"pager: a clamped NEXT at the last page keeps the player's focus")
				_room._handle_rail("page_prev")
				_letters_step = 3
				_letters_smoke_wait = 0
		3:
			_letters_smoke_wait += 1
			if not _room.page_slide_active() and _letters_smoke_wait >= 8:
				_letters_expect(_room._page == 0,
					"pager: PREV turns back to the first page (got %d)" % _room._page)
				_letters_expect(_room.focused_quad() == _room.rail_quad("sort"),
					"pager: focus survives a PREV page turn (no drop, no steal)")
				_room._handle_rail("page_prev") ## clamped at the first page
				_letters_step = 4
				_letters_smoke_wait = 0
			elif _letters_smoke_wait > 3600:
				_letters_smoke_fail("pager: the PREV slide never settled")
				return true
		4:
			_letters_smoke_wait += 1
			if _letters_smoke_wait >= 12:
				_letters_expect(_room._page == 0,
					"pager: a clamped PREV stays on the first page (got %d)" % _room._page)
				_letters_expect(_room.focused_quad() == _room.rail_quad("sort"),
					"pager: a clamped PREV at the first page keeps the player's focus")
				return true
	return false


# -------------------------------------------------- jump bench

## --pvlds-smoke-jumpbench: the pick-latency bench (the
## focus-law round, 2026-10-27 - Chris: "tapping letter
## switched to correct wall, but it took awhile to load,
## grinding gear. not sure if one-time thing or what").
## Boots a field-scale fixture library (360 stub tables over
## verbatim real VPS records, sidecar art on every game),
## waits out the scan + warm drain, then times the player's
## own routes end to end - the press to the wall settled
## (wall_ready): a COLD letter pick (a page never shown this
## session), a WARM re-pick of the same letter, a plain page
## turn for comparison, and the THE / # net picks. The
## numbers are the deliverable (JUMPBENCH lines); the room's
## BENCH fill lines (PVLDS_BENCH) attribute each fill's cost
## to the banner, the furniture, and the panels. Sanity
## failures (wrong library size, a pick landing wrong) fail
## the boot - a broken bench must not masquerade as data.
func _drive_jumpbench_smoke() -> void:
	if _jumpbench_after >= 0:
		_jumpbench_wait += 1
		_jumpbench_frames += 1
		if _room != null and _room.wall_ready and not _room.page_slide_active():
			print("JUMPBENCH: %s: %d ms (%d frames)" % [_jumpbench_label, Time.get_ticks_msec() - _jumpbench_t0, _jumpbench_frames])
			_jumpbench_phase = _jumpbench_after
			_jumpbench_after = -1
			_jumpbench_wait = 0
		elif _jumpbench_wait > 7200:
			_jumpbench_fail("the measurement '%s' never settled" % _jumpbench_label)
			_finish_jumpbench_smoke()
		return
	match _jumpbench_phase:
		0:
			if _room != null and _room.visible and _room.wall_ready and not _scan_active \
					and (_art_warmer == null or _art_warmer.is_idle()):
				var games: int = _scanner.games.size() if _scanner != null else -1
				print("JUMPBENCH: library games=%d files=%d warm_drain=%dms boot_settle=%dms" % [
					games, _scanner.total_files if _scanner != null else -1,
					_art_warmer.last_pass_msec if _art_warmer != null else -1,
					Time.get_ticks_msec() - _jumpbench_boot_msec])
				if games < 330 or games > 390:
					_jumpbench_fail("the bench library holds %d games, not field scale (~360)" % games)
					_finish_jumpbench_smoke()
					return
				_jumpbench_phase = 1
			else:
				_jumpbench_wait += 1
				if _jumpbench_wait > 21600:
					_jumpbench_fail("the bench room never settled (scan/warm)")
					_finish_jumpbench_smoke()
		1:
			# The room boots into the VR filter by design; the
			# bench times the FULL shelf, so stand in ALL first
			# (the letters smoke does the same). The press is a
			# full rebuild - its timing is honest data too.
			_jumpbench_measure("filter ALL (bench setup)", Callable(self, "_jumpbench_press_all"), 2)
		2:
			_jumpbench_measure("pick S (cold page)", Callable(self, "_jumpbench_press_s"), 3)
		3:
			_jumpbench_measure("pick A (boot page, warm)", Callable(self, "_jumpbench_press_a"), 4)
		4:
			_jumpbench_measure("pick S (warm page)", Callable(self, "_jumpbench_press_s"), 5)
		5:
			_jumpbench_measure("page turn NEXT", Callable(self, "_jumpbench_press_next"), 6)
		6:
			_jumpbench_measure("pick THE (net)", Callable(self, "_jumpbench_press_the"), 7)
		7:
			if _room.strip_slot_pickable("#"):
				_jumpbench_measure("pick # (net)", Callable(self, "_jumpbench_press_hash"), 8)
			else:
				_jumpbench_fail("the # slot is not pickable on the bench shelf in ALL (the sample holds 3 non-letter starters)")
				_jumpbench_phase = 8
		8:
			_finish_jumpbench_smoke()


func _jumpbench_measure(label: String, press: Callable, after: int) -> void:
	_jumpbench_label = label
	_jumpbench_frames = 0
	_jumpbench_wait = 0
	_jumpbench_t0 = Time.get_ticks_msec()
	press.call()
	_jumpbench_after = after


func _jumpbench_press_all() -> void:
	_room._handle_rail("filter:all")
	if _room._filter != "all":
		_jumpbench_fail("the bench could not stand in the ALL filter")


func _jumpbench_press_s() -> void:
	_letters_pick("S")
	var idx: int = -1
	for i: int in range(_room._visible_games.size()):
		if LetterIndex.letter_of(_room._visible_games[i].title) == "S":
			idx = i
			break
	if idx < 0 or _room._page != idx / _room.PAGE_SIZE:
		_jumpbench_fail("pick S landed on page %d, expected %d" % [_room._page, idx / _room.PAGE_SIZE if idx >= 0 else -1])


func _jumpbench_press_a() -> void:
	_letters_pick("A")


func _jumpbench_press_next() -> void:
	var before: int = _room._page
	# GRADFIX8 item 6: the page_next arrow quad is gone;
	# the bench takes the direct route the press took.
	_room._handle_rail("page_next")
	if _room._page == before and not _room.page_slide_active():
		_jumpbench_fail("page turn NEXT never started its slide")


func _jumpbench_press_the() -> void:
	_letters_pick("THE")
	if _room.active_letter_net() != "THE":
		_jumpbench_fail("pick THE did not raise the net")


func _jumpbench_press_hash() -> void:
	_letters_pick("#")
	if _room.active_letter_net() != "#":
		_jumpbench_fail("pick # did not raise the net")


func _jumpbench_fail(label: String) -> void:
	_jumpbench_failures += 1
	printerr("  FAIL - jumpbench: ", label)


func _finish_jumpbench_smoke() -> void:
	if _jumpbench_failures == 0:
		print("PVLDS JUMPBENCH: DONE")
		get_tree().quit(0)
	else:
		printerr("PVLDS JUMPBENCH: FAILED (%d)" % _jumpbench_failures)
		get_tree().quit(1)


# -------------------------------------------------- boot focus smoke

## --pvlds-smoke-bootfocus: fault 3's harness (Chris,
## 2026-10-27: "Upon initial launch, the highlighter defaults
## to last played table, but the card is dark and art is not
## visible till highlighter is moved."). The runner seeds the
## state file with a last-played record; this driver then
## touches NOTHING - no _set_focused, no _move_focus, no
## presses - and judges the room the real boot path built:
## the boot-focused card must hold the focus, wear its real
## face, carry the standing power performance ON that face,
## and render art (pixel variance) in a grab, all with zero
## input.
## --pvlds-smoke-motion: the pop's dense-frame smoothness
## trace (per-frame pop amounts PLUS rendered grabs whose
## amber centre-frame edge is measured frame to frame -
## leg name "pop smoothness:"), then the OPTIMIZE legs,
## every one prefixed "optimize:" so failures name
## themselves:
##   - gait coercion + config coercion: the room's gait is
##     STEPPED however it is set, and a config file carrying
##     the old SMOOTH gait loads as STEPPED (saves write
##     STEPPED back).
##   - "optimize: radius": RoomView.WALL_RADIUS is 3.60 and
##     the booted room's telemetry header records 3.60.
##   - "optimize: single step settle": one tap's step,
##     dense-traced; its settle must land in the driver-law
##     range 150-300 ms and on its column exactly.
##   - "optimize: hold steps only": the stick held ~3 s
##     through the REAL pad poll - the centre advances in
##     discrete steps with settle plateaus (>= 80 ms of yaw
##     rest between steps) and NO continuous-roll run.
##   - "optimize: steps stay dressed": mid-step, every
##     drawn panel presents a real face (face_state's
##     honest read - never a blank or placeholder).
##   - "optimize: applies capped": across a letter jump +
##     a step train, the room's per-frame art-apply account
##     never exceeds the cap in one frame.
## The OPTIMIZE negative controls ride PVLDS_OPT_NC (set in
## _ready, before any room exists): smoothcruise restores
## the continuous roll so the hold leg fails by name;
## costume blanks faces during travel so the dressed leg
## fails by name; oldradius restores WALL_RADIUS 3.40 (Main
## applies it in _ready, the oldwall mechanism) so the
## radius leg fails by name; streamahead lifts the apply
## cap during travel so the applies leg fails by name.

func _drive_motion_smoke() -> void:
	match _motion_phase:
		0:
			if _room != null and _room.visible and _room.wall_ready:
				# Park the pointer in the bottom-left corner,
				# off every card: the room's follow law gives
				# the pointer's hover precedence over pad
				# focus, and this smoke's presses are pad
				# presses - they must not fight a resting ray
				# the player never aimed.
				Input.warp_mouse(Vector2(4, 372))
				_motion_phase = 1
				_motion_wait = 0
			else:
				_motion_wait += 1
				if _motion_wait > 7200:
					_motion_fail("pop smoothness: the room never came up")
					_finish_motion_smoke()
		1:
			_motion_wait += 1
			_motion_pace_stamps.append(Time.get_ticks_msec())
			if _motion_pace_stamps.size() > 40:
				_motion_pace_stamps.pop_front()
			if _motion_wait == 1:
				var c: int = _room.centre_index()
				var col: int = _room._grid_coord(c).x
				var other: int = -1
				for cand: int in [c + 1, c - 1, c + 2, c - 2]:
					if cand >= 0 and cand < _room._panels.size() and _room._grid_coord(cand).x == col:
						other = cand
						break
				if other < 0:
					_motion_fail("pop smoothness: no same-column neighbour panel for the pop trace")
					_finish_motion_smoke()
					return
				_motion_from_idx = c
				_motion_to_idx = other
				_room._set_centre(c, true)
				_room._set_focused(_room._panels[c])
			if _motion_wait > 20 and _room.panel_pop_amount(_room._panels[_motion_from_idx]) >= 0.999:
				# The pacing this box actually ran at, from
				# the settle's own frame stamps (median
				# interval): the pop legs judge the travel
				# against it, so a contended llvmpipe box and
				# a clean 90 Hz rig are held to the same
				# SHAPE, not the same frame count.
				if _motion_pace_stamps.size() >= 6:
					var ivals: Array[int] = []
					for si: int in range(1, _motion_pace_stamps.size()):
						ivals.append(int(_motion_pace_stamps[si]) - int(_motion_pace_stamps[si - 1]))
					ivals.sort()
					_motion_pacing_ms = float(ivals[ivals.size() / 2])
				print("MOTION PACING: median frame %.1f ms during the settle" % _motion_pacing_ms)
				_motion_phase = 2
				_motion_wait = 0
				_motion_trace.clear()
				_motion_grabs.clear()
			elif _motion_wait > 3600:
				_motion_fail("pop smoothness: the origin pop never settled")
				_finish_motion_smoke()
		2:
			if _motion_wait == 0:
				_motion_t0_msec = Time.get_ticks_msec()
				_room._set_focused(_room._panels[_motion_to_idx])
			_motion_wait += 1
			var now2: int = Time.get_ticks_msec()
			_motion_trace.append([now2 - _motion_t0_msec,
				_room.panel_pop_amount(_room._panels[_motion_to_idx]),
				_room.panel_pop_amount(_room._panels[_motion_from_idx]),
				rad_to_deg(_room.drum_yaw_rad()),
				_room.panel_pop_offset(_room._panels[_motion_to_idx]).length() / RoomView.POP_OUT_DISTANCE])
			var amt2: float = _room.panel_pop_amount(_room._panels[_motion_to_idx])
			if (amt2 >= 0.999 and _motion_wait >= 6) or _motion_wait > 900:
				_motion_judge_pop()
				# The grab trace pops BACK to the origin panel:
				# a second, independent pop, sampled on the
				# rendered output itself.
				_motion_grabs.clear()
				_motion_phase = 7
				_motion_wait = 0
		7:
			if _motion_wait == 0:
				_motion_t0_msec = Time.get_ticks_msec()
				_room._set_focused(_room._panels[_motion_from_idx])
			_motion_wait += 1
			_motion_grabs.append(get_viewport().get_texture().get_image())
			_motion_grab_msec.append(Time.get_ticks_msec() - _motion_t0_msec)
			var amt7: float = _room.panel_pop_amount(_room._panels[_motion_from_idx])
			if (amt7 >= 0.999 and _motion_wait >= 4) or _motion_wait > 900:
				_motion_judge_pop_grabs()
				_motion_phase = 3
				_motion_wait = 0
		3:
			# OPTIMIZE standing facts (gait + config coercion,
			# radius), then arm the single-step trace.
			_motion_wait += 1
			if _motion_wait == 1:
				_opt_leg_config_and_radius()
			if _motion_wait > 10 and not _room.page_slide_active():
				var from_idx: int = _motion_travel_start()
				var to_idx: int = _motion_single_target(from_idx)
				if to_idx < 0:
					_motion_fail("optimize: single step settle: no same-row panel one column over for the step trace")
					_finish_motion_smoke()
					return
				_motion_begin_trace("opt_single_step", "optimize: single step settle:", from_idx, to_idx)
				_motion_phase = 20
				_motion_wait = 0
			elif _motion_wait > 3600:
				_motion_fail("optimize: single step settle: the step trace never armed (the drum never settled)")
				_finish_motion_smoke()
		20:
			# Single step settle: dense-trace one tap's step
			# and judge its settle against the driver law.
			_motion_wait += 1
			if _motion_sample_trace():
				_motion_store_trace("opt_single_step")
				var stats20: Dictionary = _motion_tr_stats.get("opt_single_step", {}) as Dictionary
				var settle20: int = int(stats20.get("settle_ms", 0))
				_motion_expect(settle20 >= 150 and settle20 <= 300,
					"optimize: single step settle: one tap's step settled in %d ms (the driver-law range is 150-300 ms on this llvmpipe bench)" % settle20)
				_motion_expect(float(stats20.get("final_err_deg", 999.0)) < 0.05,
					"optimize: single step settle: the step landed exactly on its column (final yaw error %.3f deg)" % float(stats20.get("final_err_deg", 999.0)))
				# Arm the hold: seat the travel start at rest,
				# then hold the stick on the real pad poll.
				var start_idx20: int = _motion_travel_start()
				_room._set_centre(start_idx20, true)
				_room._set_focused(_room._panels[start_idx20])
				_opt_hold_trace.clear()
				_opt_hold_t0_msec = Time.get_ticks_msec()
				_opt_hold_start_col = _room._grid_coord(start_idx20).x
				_opt_dressed_frames = 0
				_opt_dressed_bad = 0
				_input_feed_stick_x(1.0)
				_motion_phase = 21
				_motion_wait = 0
			elif _motion_wait > 3600:
				_motion_fail("optimize: single step settle: the step never settled")
				_finish_motion_smoke()
		21:
			# Hold steps only: sample the drum yaw for ~3 s
			# of held stick; mid-step frames also sample the
			# drawn window's faces (steps stay dressed).
			_motion_wait += 1
			var now21: int = Time.get_ticks_msec()
			_opt_hold_trace.append([now21 - _opt_hold_t0_msec, _room.drum_yaw_deg()])
			if _room.swing_active():
				var states21: Array = _room.face_state()
				if not states21.is_empty():
					_opt_dressed_frames += 1
					for sv21: Variant in states21:
						var st21: Dictionary = sv21 as Dictionary
						if bool(st21.get("is_unreal", true)) or bool(st21.get("is_placeholder", true)):
							_opt_dressed_bad += 1
			if now21 - _opt_hold_t0_msec >= 3000:
				_input_feed_stick_x(0.0)
				_opt_rest_frames = 0
				_motion_phase = 22
				_motion_wait = 0
			elif _motion_wait > 7200:
				_input_feed_stick_x(0.0)
				_motion_fail("optimize: hold steps only: the 3 s hold sampling never completed")
				_finish_motion_smoke()
		22:
			# The release settle, then the hold + dressed
			# verdicts; arm the applies journey's letter jump.
			_motion_wait += 1
			_opt_hold_trace.append([Time.get_ticks_msec() - _opt_hold_t0_msec, _room.drum_yaw_deg()])
			if not _room.swing_active():
				_opt_rest_frames += 1
			else:
				_opt_rest_frames = 0
			if _opt_rest_frames >= 3:
				_opt_judge_hold()
				var from_col22: int = _room._grid_coord(_room.centre_index()).x
				var best_key: String = ""
				var best_dist: int = 1 << 30
				for li: int in range(26):
					var key: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"[li]
					for gi: int in range(_room._visible_games.size()):
						if LetterIndex.letter_of(_room._visible_games[gi].title) == key:
							var gcol: int = _room._grid_coord(gi).x
							var dist: int = absi(gcol - from_col22)
							if dist >= 10 and dist < best_dist:
								best_dist = dist
								best_key = key
							break
				if best_key == "":
					_motion_fail("optimize: applies capped: no letter stands 10+ columns away for the journey's jump")
					_finish_motion_smoke()
					return
				_opt_letter_key = best_key
				_opt_saw_swing = false
				_opt_rest_frames = 0
				_letters_pick(best_key)
				_motion_phase = 23
				_motion_wait = 0
			elif _motion_wait > 7200:
				_motion_fail("optimize: hold steps only: the release settle never completed")
				_finish_motion_smoke()
		23:
			# Applies journey, the jump: wait for the letter
			# swing to travel and settle, then feed the train.
			_motion_wait += 1
			if _room.swing_active():
				_opt_saw_swing = true
			if _opt_saw_swing and not _room.swing_active() and not _room.page_slide_active():
				_opt_rest_frames += 1
			else:
				_opt_rest_frames = 0
			if _opt_rest_frames >= 5:
				_motion_expect(_opt_saw_swing,
					"optimize: applies capped: the letter jump to %s swung the drum (a real travel, not a teleport)" % _opt_letter_key)
				_opt_train_start_col = _room._grid_coord(_room.centre_index()).x
				_opt_train_dir = 1.0 if _opt_train_start_col <= _room._columns / 2 else -1.0
				_opt_train_t0_msec = Time.get_ticks_msec()
				_input_feed_stick_x(_opt_train_dir)
				_motion_phase = 24
				_motion_wait = 0
			elif _motion_wait > 7200:
				_motion_fail("optimize: applies capped: the letter jump to %s never settled" % _opt_letter_key)
				_finish_motion_smoke()
		24:
			# Applies journey, the train: hold the stick
			# until the centre has stepped four columns (or
			# 2.5 s - a shelf end can starve the count).
			_motion_wait += 1
			var col24: int = _room._grid_coord(_room.centre_index()).x
			if absi(col24 - _opt_train_start_col) >= 4 or Time.get_ticks_msec() - _opt_train_t0_msec >= 2500:
				_input_feed_stick_x(0.0)
				_opt_rest_frames = 0
				_motion_phase = 25
				_motion_wait = 0
			elif _motion_wait > 7200:
				_input_feed_stick_x(0.0)
				_motion_fail("optimize: applies capped: the step train never ran")
				_finish_motion_smoke()
		25:
			# Applies journey, the verdict: settle, then read
			# the room's per-frame apply account.
			_motion_wait += 1
			if not _room.swing_active():
				_opt_rest_frames += 1
			else:
				_opt_rest_frames = 0
			if _opt_rest_frames >= 3:
				var astats: Dictionary = _room.art_frame_stats()
				var max_one: int = int(astats.get("max_applies_one_frame", -1))
				_motion_expect(max_one >= 0 and max_one <= 2,
					"optimize: applies capped: across the letter jump + step train, one frame applied at most %d art faces (cap 2 - the room's per-frame apply budget; applies total %d, during travel %d)" % [max_one, int(astats.get("applies_total", 0)), int(astats.get("applies_during_travel", 0))])
				_finish_motion_smoke()
			elif _motion_wait > 7200:
				_motion_fail("optimize: applies capped: the journey never settled")
				_finish_motion_smoke()



## The travel legs' shared start: a panel six columns left of
## the shelf's middle band area - snapped to, drum at rest.
func _motion_travel_start() -> int:
	var mid: int = _room._panels.size() / 2
	var col: int = _room._grid_coord(mid).x
	var want_col: int = maxi(0, col - 3)
	for i: int in range(_room._panels.size()):
		if _room._grid_coord(i).x == want_col and _room._grid_coord(i).y == _room._grid_coord(mid).y:
			return i
	return mid


func _motion_travel_target() -> int:
	var start: int = _motion_travel_start()
	var col: int = _room._grid_coord(start).x
	var want_col: int = col + 6
	for i: int in range(_room._panels.size()):
		if _room._grid_coord(i).x == want_col and _room._grid_coord(i).y == _room._grid_coord(start).y:
			return i
	return start


func _motion_snap_to_travel_start() -> void:
	var start: int = _motion_travel_start()
	_room._set_centre(start, true)
	_room._set_focused(_room._panels[start])


## The panel one column over from a panel, same band (the
## single-column traces' target), or -1 when there is none.
func _motion_single_target(from_idx: int) -> int:
	var col: int = _room._grid_coord(from_idx).x
	var row: int = _room._grid_coord(from_idx).y
	for i: int in range(_room._panels.size()):
		if _room._grid_coord(i).x == col + 1 and _room._grid_coord(i).y == row:
			return i
	return -1


## The panel `offset` columns over from a panel, same band.
func _motion_panel_at_col_offset(from_idx: int, offset: int) -> int:
	var col: int = _room._grid_coord(from_idx).x
	var row: int = _room._grid_coord(from_idx).y
	for i: int in range(_room._panels.size()):
		if _room._grid_coord(i).x == col + offset and _room._grid_coord(i).y == row:
			return i
	return -1


## Begin a dense trace (GRADFIX12): snap to the start panel
## at rest, then press to the target panel and sample the
## drum's yaw through the room's accessor every frame until
## the swing settles.
func _motion_begin_trace(name: String, leg: String, from_idx: int, to_idx: int) -> void:
	_motion_tr_name = name
	_motion_tr_leg = leg
	_room._set_centre(from_idx, true)
	_room._set_focused(_room._panels[from_idx])
	_motion_tr_y0 = _room.drum_yaw_deg()
	_motion_tr.clear()
	_motion_t0_msec = Time.get_ticks_msec()
	_room._set_focused(_room._panels[to_idx])
	# The target yaw from the column delta itself: the
	# room's standing swing target only updates when its
	# follow law centres on the new focus (its next
	# _process), so reading swing_target_rad() here would
	# capture the PREVIOUS travel's target.
	_motion_tr_y1 = _motion_tr_y0 + float(_room._grid_coord(to_idx).x - _room._grid_coord(from_idx).x) * 13.5


## Sample one frame of the standing trace. Returns true
## once the swing has settled (the caller judges).
func _motion_sample_trace() -> bool:
	_motion_tr.append([Time.get_ticks_msec() - _motion_t0_msec, _room.drum_yaw_deg(), _room.swing_velocity_deg_s()])
	return _motion_tr.size() >= 3 and not _room.swing_active()


## Reduce a dense trace to its verdict numbers: sample and
## moving counts, settle time (the last sample still more
## than 0.05 deg from the target, plus one), peak interval
## velocity, the interval velocity at each intermediate
## slot-boundary crossing, the longest run of non-moving
## samples between first motion and settle, the final yaw
## error and the effective sample rate.
func _motion_trace_stats(trace: Array, y0: float, y1: float) -> Dictionary:
	var n: int = trace.size()
	var moving: int = 0
	var peak: float = 0.0
	var max_gap: int = 0
	var last_out: int = -1
	var stall_run: int = 0
	var max_stall_run: int = 0
	var started: bool = false
	var vels: Array[float] = []
	for i: int in range(n):
		var t: int = int((trace[i] as Array)[0])
		var y: float = float((trace[i] as Array)[1])
		if absf(y - y1) > 0.05:
			last_out = i
		if i > 0:
			var tprev: int = int((trace[i - 1] as Array)[0])
			var yprev: float = float((trace[i - 1] as Array)[1])
			max_gap = maxi(max_gap, t - tprev)
			var dt: float = maxf(float(t - tprev), 1.0) / 1000.0
			var v: float = (y - yprev) / dt
			vels.append(v)
			if absf(y - yprev) > 0.005:
				moving += 1
				started = true
				stall_run = 0
				peak = maxf(peak, absf(v))
			elif started and last_out >= i:
				stall_run += 1
				max_stall_run = maxi(max_stall_run, stall_run)
	var settle_ms: int = 0
	if last_out >= 0 and last_out + 1 < n:
		settle_ms = int((trace[last_out + 1] as Array)[0])
	elif last_out >= 0:
		settle_ms = int((trace[last_out] as Array)[0])
	var span: float = y1 - y0
	var dir: float = signf(span)
	# The velocity AT each sample: the trace's own velocity
	# channel when it carries one (the driver's standing
	# velocity - the honest measure on a box whose frame
	# pacing bursts, where interval velocities over clustered
	# samples inflate), else the interval velocity.
	var vel_at: Array[float] = []
	for vi: int in range(n):
		var row_v: Array = trace[vi] as Array
		if row_v.size() > 2:
			vel_at.append(float(row_v[2]))
		elif vi > 0:
			vel_at.append(vels[vi - 1])
		else:
			vel_at.append(vels[0] if not vels.is_empty() else 0.0)
	if not vel_at.is_empty():
		peak = 0.0
		for va: float in vel_at:
			peak = maxf(peak, absf(va))
	var boundary_vels: Array[float] = []
	if absf(span) > 13.5 + 0.01 and n > 1:
		var k: int = 1
		while float(k) * 13.5 < absf(span) - 0.01:
			var b: float = y0 + dir * float(k) * 13.5
			for i2: int in range(1, n):
				var ya: float = float((trace[i2 - 1] as Array)[1])
				var yb: float = float((trace[i2] as Array)[1])
				if (ya - b) * (yb - b) <= 0.0 and absf(yb - ya) > 0.0001:
					boundary_vels.append(absf(vel_at[i2]))
					break
			k += 1
	var bmin: float = -1.0
	for bv: float in boundary_vels:
		if bmin < 0.0 or bv < bmin:
			bmin = bv
	var dur_ms: int = int((trace[n - 1] as Array)[0]) if n > 0 else 0
	return {
		"samples": n,
		"moving": moving,
		"settle_ms": settle_ms,
		"peak_deg_s": peak,
		"boundary_min_deg_s": bmin,
		"boundary_vels": boundary_vels,
		"max_gap_ms": max_gap,
		"max_stall_run": max_stall_run,
		"final_err_deg": absf(float((trace[n - 1] as Array)[1]) - y1) if n > 0 else 999.0,
		"rate_per_s": float(n) * 1000.0 / maxf(float(dur_ms), 1.0),
	}


func _motion_print_stats(name: String, stats: Dictionary) -> void:
	var peak: float = float(stats.get("peak_deg_s", 0.0))
	var bmin: float = float(stats.get("boundary_min_deg_s", -1.0))
	print("MOTION TRACE %s: samples %d, moving %d, settle %d ms, peak %.1f deg/s, boundary-min %s, rate %.1f/s, final err %.3f deg, max stall run %d"
		% [name, int(stats.get("samples", 0)), int(stats.get("moving", 0)), int(stats.get("settle_ms", 0)), peak,
			("%.1f deg/s (%.0f%% of peak)" % [bmin, 100.0 * bmin / maxf(peak, 0.001)]) if bmin >= 0.0 else "n/a (no intermediate slot)",
			float(stats.get("rate_per_s", 0.0)), float(stats.get("final_err_deg", 999.0)), int(stats.get("max_stall_run", 0))])


## Store the standing trace's stats under a key and print
## them (the per-trace table the GRADFIX12 report quotes).
func _motion_store_trace(key: String) -> void:
	var stats: Dictionary = _motion_trace_stats(_motion_tr, _motion_tr_y0, _motion_tr_y1)
	_motion_tr_stats[key] = stats
	_motion_print_stats(key, stats)
	var raw: String = ""
	for ri: int in range(_motion_tr.size()):
		var row: Array = _motion_tr[ri] as Array
		raw += " [%dms %.2f v%.0f]" % [int(row[0]), float(row[1]), float(row[2]) if row.size() > 2 else 0.0]
	print("MOTION TRACE RAW %s (y0 %.2f -> y1 %.2f):" % [key, _motion_tr_y0, _motion_tr_y1], raw)


## The OPTIMIZE standing facts (motion phase 3): the gait
## is STEPPED however it is set, the config coerces any
## stored gait to STEPPED and persists it, and the wall
## stands at the OPTIMIZE radius - in the room's static and
## in the telemetry header the booted room wrote. Under
## PVLDS_OPT_NC=oldradius Main restored 3.40 before the room
## existed and the radius expects fail by this leg's name.
func _opt_leg_config_and_radius() -> void:
	_room.set_wall_motion_mode("smooth")
	_motion_expect(_room.wall_motion_mode() == "stepped",
		"optimize: gait coercion: set_wall_motion_mode(\"smooth\") leaves the standing gait STEPPED (got %s)" % _room.wall_motion_mode())
	_room.set_wall_motion_mode("bogus")
	_motion_expect(_room.wall_motion_mode() == "stepped",
		"optimize: gait coercion: an invalid mode coerces to STEPPED (got %s)" % _room.wall_motion_mode())
	_motion_expect(_room.wall_driver_mode() == "stepped",
		"optimize: gait coercion: the wall driver is the stepped driver (got %s)" % _room.wall_driver_mode())
	if _config != null:
		# Save writes STEPPED even when a caller left the old
		# gait standing in the var.
		_config.wall_motion_mode = "smooth"
		_config.save_to_disk()
		var saved: PvldsConfig = PvldsConfig.new()
		var ok_saved: bool = saved.load_from_disk()
		_motion_expect(ok_saved and saved.wall_motion_mode == "stepped",
			"optimize: gait coercion: a save writes STEPPED to the config file")
		# A config file carrying the old SMOOTH gait (a
		# shipped build's file) loads as STEPPED, no error.
		var cfg_path: String = PvldsConfig.save_path()
		var wf: FileAccess = FileAccess.open(cfg_path, FileAccess.WRITE)
		if wf != null:
			wf.store_string(JSON.stringify({"wall_motion_mode": "smooth"}))
			wf.close()
		var reloaded: PvldsConfig = PvldsConfig.new()
		var ok: bool = reloaded.load_from_disk()
		_motion_expect(ok and reloaded.wall_motion_mode == "stepped",
			"optimize: gait coercion: a config file carrying the old SMOOTH gait loads as STEPPED")
		_config.wall_motion_mode = "stepped"
		_config.save_to_disk()
	_motion_expect(absf(RoomView.WALL_RADIUS - 3.60) < 0.001,
		"optimize: radius: RoomView.WALL_RADIUS is 3.60 (got %.2f)" % RoomView.WALL_RADIUS)
	var header: Dictionary = _opt_telemetry_header()
	_motion_expect(not header.is_empty() and absf(float(header.get("wall_radius", -1.0)) - 3.60) < 0.001,
		"optimize: radius: the booted room's telemetry header records wall_radius 3.60 (got %s)" % str(header.get("wall_radius", "none")))


## The first line of the scroll telemetry the booted room
## is writing (its header record), or {} when unreadable.
func _opt_telemetry_header() -> Dictionary:
	if not FileAccess.file_exists(ScrollTelemetry.LOG_PATH):
		return {}
	var text: String = FileAccess.get_file_as_string(ScrollTelemetry.LOG_PATH)
	var nl: int = text.find("\n")
	var first: String = text.substr(0, nl) if nl >= 0 else text
	var parsed: Variant = JSON.parse_string(first)
	if parsed is Dictionary:
		var d: Dictionary = parsed
		return d
	return {}


## Judge the OPTIMIZE hold trace (motion phases 21-22):
## the centre must have advanced in discrete steps - rest
## plateaus of at least 80 ms (yaw within 0.02 deg between
## samples) BETWEEN steps, and no continuous moving run
## longer than one step's travel - and every mid-step face
## sample must have found a real face on every drawn card.
## Under PVLDS_OPT_NC=smoothcruise the hold rolls
## continuously (one long moving run, no plateaus) and the
## hold leg fails by name; under PVLDS_OPT_NC=costume the
## dressed leg's counter fails by its own name.
func _opt_judge_hold() -> void:
	var trace: Array = _opt_hold_trace
	var eps: float = 0.02
	var runs: Array = [] ## [is_moving, duration_ms] segments of the hold
	var run_moving: bool = false
	var run_start_t: int = 0
	var prev_t: int = 0
	for i: int in range(trace.size()):
		var t: int = int((trace[i] as Array)[0])
		if i == 0:
			run_start_t = t
			prev_t = t
			continue
		var yprev: float = float((trace[i - 1] as Array)[1])
		var y: float = float((trace[i] as Array)[1])
		var moving_i: bool = absf(y - yprev) > eps
		if moving_i != run_moving:
			runs.append([run_moving, prev_t - run_start_t])
			run_moving = moving_i
			run_start_t = prev_t
		prev_t = t
	runs.append([run_moving, prev_t - run_start_t])
	var plateaus: int = 0
	var longest_plateau_ms: int = 0
	var longest_move_ms: int = 0
	for ri: int in range(runs.size()):
		var run: Array = runs[ri] as Array
		var dur: int = int(run[1])
		if bool(run[0]):
			longest_move_ms = maxi(longest_move_ms, dur)
		else:
			longest_plateau_ms = maxi(longest_plateau_ms, dur)
			# A plateau counts only BETWEEN steps: a moving
			# run on both sides of it.
			if ri > 0 and ri < runs.size() - 1 and dur >= 80:
				plateaus += 1
	var final_col: int = _room._grid_coord(_room.centre_index()).x
	print("OPTIMIZE HOLD TRACE: %d samples, %d segments, plateaus>=80ms between steps %d, longest plateau %d ms, longest moving run %d ms, columns advanced %d"
		% [trace.size(), runs.size(), plateaus, longest_plateau_ms, longest_move_ms, final_col - _opt_hold_start_col])
	_motion_expect(final_col - _opt_hold_start_col >= 3,
		"optimize: hold steps only: the held stick advanced the centre %d columns" % (final_col - _opt_hold_start_col))
	_motion_expect(plateaus >= 2,
		"optimize: hold steps only: between steps the yaw rested on settle plateaus of at least 80 ms (%d found, longest %d ms)" % [plateaus, longest_plateau_ms])
	_motion_expect(longest_move_ms <= 400,
		"optimize: hold steps only: no continuous roll - the longest unbroken moving run was %d ms (one step's travel; a cruise rolls for seconds)" % longest_move_ms)
	_motion_expect(_opt_dressed_frames >= 3 and _opt_dressed_bad == 0,
		"optimize: steps stay dressed: every drawn panel presented a real face mid-step (%d bad card-frames over %d sampled mid-step frames)" % [_opt_dressed_bad, _opt_dressed_frames])



func _input_feed_stick_x(value: float) -> void:
	var ev: InputEventJoypadMotion = InputEventJoypadMotion.new()
	ev.device = 0
	ev.axis = JOY_AXIS_LEFT_X
	ev.axis_value = value
	Input.parse_input_event(ev)


func _motion_judge_pop() -> void:
	var n: int = _motion_trace.size()
	var first_move: int = -1
	var complete_ms: int = -1
	var prev_amt: float = 0.0
	var prev_applied: float = 0.0
	var applied_stalls: int = 0
	var reversals: int = 0
	var max_step: float = 0.0
	var moving: int = 0
	for i: int in range(n):
		var amt: float = float((_motion_trace[i] as Array)[1])
		var applied: float = float((_motion_trace[i] as Array)[4])
		if amt > 0.001 and first_move < 0:
			first_move = i
		if i > 0 and applied - prev_applied > 0.002 and complete_ms < 0:
			moving += 1
		if amt >= 0.999 and complete_ms < 0:
			complete_ms = int((_motion_trace[i] as Array)[0])
		if amt > 0.001 and amt < 0.999:
			max_step = maxf(max_step, applied - prev_applied)
			if applied - prev_applied < -0.005:
				reversals += 1
			elif applied - prev_applied < 0.0005 and amt - prev_amt > 0.01 and prev_amt > 0.02:
				# The amount travelled but the APPLIED
				# transform stood still: a quantised step
				# is being held back (the NC's shape - and
				# the write-guard failure class generally).
				applied_stalls += 1
		prev_amt = amt
		prev_applied = applied
	print("MOTION POP TRACE: %d frames sampled, %d moving, complete at %d ms (pacing %.1f ms), max applied step %.3f, applied stalls %d, reversals %d"
		% [n, moving, complete_ms, _motion_pacing_ms, max_step, applied_stalls, reversals])
	var raw: String = ""
	for i2: int in range(n):
		raw += " [%dms %.3f/%.3f]" % [int((_motion_trace[i2] as Array)[0]), float((_motion_trace[i2] as Array)[1]), float((_motion_trace[i2] as Array)[4])]
	print("MOTION POP RAW (ms amount/applied):", raw)
	# The travel-time leg: the fixed spring's travel lasts
	# ~0.41 s of wall time at ANY pacing (its tail is the
	# butter); the convicted fixed 0.15 s linear ramp is over
	# by 0.15 s + at most one frame of sampling slop. The
	# bound charges the trace's own largest frame gap as
	# that slop, so the shape, not the box, is judged.
	var max_gap: int = 0
	for gi: int in range(n):
		var tprev: int = 0 if gi == 0 else int((_motion_trace[gi - 1] as Array)[0])
		max_gap = maxi(max_gap, int((_motion_trace[gi] as Array)[0]) - tprev)
	_motion_expect(complete_ms >= 180 + max_gap,
		"pop smoothness: the pop's travel lasts at least %d ms (got %d ms - a fixed 0.15 s ramp ending within one frame of 150 ms is the convicted jitter)"
		% [180 + max_gap, complete_ms])
	_motion_expect(moving >= 3,
		"pop smoothness: the applied pop changes on at least 3 frames at the measured pacing (got %d - a pop that lands in 1-2 applied steps is the convicted jitter)" % moving)
	_motion_expect(applied_stalls == 0,
		"pop smoothness: the applied pop never stalls while the amount travels (got %d - a quantised applied step is the convicted jitter)" % applied_stalls)
	_motion_expect(reversals == 0,
		"pop smoothness: the applied pop never reverses (got %d)" % reversals)
	_motion_expect(absf(float((_motion_trace[n - 1] as Array)[1]) - 1.0) < 0.002,
		"pop smoothness: the pop completed (final amount %.3f)" % float((_motion_trace[n - 1] as Array)[1]))
	# The old centre's card settles back flush in the same window.
	_motion_expect(float((_motion_trace[n - 1] as Array)[2]) < 0.002,
		"pop smoothness: the previous card settled flush as the new one popped")


## The rendered-edge half of the pop proof: the amber centre
## frame's pixel width inside a window around the popping
## card (the origin panel, popping back in during the grab
## phase), measured on the actual grabs - the edge travels,
## never jumps backwards, over at least 4 measured frames.
## (The centre frame, not the blue focus ring: the card's
## own frame quad stands in front of the ClickableQuad
## highlight ring and covers it - the amber frame is the
## ring the renderer actually shows for the centred card,
## and it rides the card's pop.)
func _motion_judge_pop_grabs() -> void:
	var cam: Camera3D = _room._active_camera()
	var panel: ClickableQuad = _room._panels[_motion_from_idx]
	if cam == null or panel == null or _motion_grabs.is_empty():
		_motion_fail("pop smoothness: no rendered grabs to judge")
		return
	var centre2d: Vector2 = cam.unproject_position(panel.global_position)
	var corner2d: Vector2 = cam.unproject_position(panel.global_position + Vector3(0.45, 0.65, 0.0))
	var grab_dir: String = OS.get_environment("PVLDS_MOTION_GRAB_DIR")
	if grab_dir != "" and not _motion_grabs.is_empty():
		var last_img: Image = _motion_grabs[_motion_grabs.size() - 1] as Image
		var amber_n: int = 0
		var amber_lo: Vector2i = Vector2i(100000, 100000)
		var amber_hi: Vector2i = Vector2i(-1, -1)
		for yy: int in range(last_img.get_height()):
			for xx: int in range(last_img.get_width()):
				var pp: Color = last_img.get_pixel(xx, yy)
				if pp.r > 0.72 and pp.g > 0.42 and pp.g < 0.85 and pp.b < 0.38:
					amber_n += 1
					amber_lo.x = mini(amber_lo.x, xx)
					amber_lo.y = mini(amber_lo.y, yy)
					amber_hi.x = maxi(amber_hi.x, xx)
					amber_hi.y = maxi(amber_hi.y, yy)
		print("MOTION GRAB DEBUG: centre2d=%s corner2d=%s panel_global=%s focused=%s highlight=%s amber_px=%d amber_bbox=%s..%s img=%s"
			% [str(centre2d), str(corner2d), str(panel.global_position),
				str(_room.focused_quad() == panel), str(panel.highlight_visible()),
				amber_n, str(amber_lo), str(amber_hi), str(last_img.get_size())])
	var half_w: float = maxf(absf(corner2d.x - centre2d.x), 30.0)
	var half_h: float = maxf(absf(corner2d.y - centre2d.y), 40.0)
	var roi: Rect2i = Rect2i(
		int(centre2d.x - half_w * 1.6), int(centre2d.y - half_h * 1.3),
		int(half_w * 3.2), int(half_h * 2.6))
	var widths: Array[int] = []
	for gv: Variant in _motion_grabs:
		var img: Image = gv as Image
		if img == null:
			continue
		var lo_x: int = img.get_width()
		var hi_x: int = -1
		var y: int = maxi(0, roi.position.y)
		while y < mini(img.get_height(), roi.position.y + roi.size.y):
			var x: int = maxi(0, roi.position.x)
			while x < mini(img.get_width(), roi.position.x + roi.size.x):
				var px: Color = img.get_pixel(x, y)
				if px.r > 0.72 and px.g > 0.42 and px.g < 0.85 and px.b < 0.38:
					lo_x = mini(lo_x, x)
					hi_x = maxi(hi_x, x)
				x += 1
			y += 1
		widths.append(hi_x - lo_x if hi_x >= 0 else -1)
	var found: Array[int] = []
	for w: int in widths:
		if w > 0:
			found.append(w)
	print("MOTION POP GRABS: %d grabs at %s ms, %d with the focus frame measured, widths %s"
		% [widths.size(), str(_motion_grab_msec), found.size(), str(found)])
	_motion_expect(found.size() >= 4,
		"pop smoothness: the rendered centre frame is measurable on at least 4 dense grabs (got %d)" % found.size())
	if found.size() >= 3:
		var growth: float = float(found[found.size() - 1] - found[0])
		_motion_expect(growth >= 3.0,
			"pop smoothness: the rendered edge travelled over the pop (width grew %.0f px)" % growth)
		var back: int = 0
		for i: int in range(1, found.size()):
			if found[i] < found[i - 1] - 3:
				back += 1
		_motion_expect(back == 0,
			"pop smoothness: the rendered edge never jumped backwards (got %d)" % back)


func _motion_expect(cond: bool, label: String) -> void:
	if cond:
		print("  ok - motion smoke: ", label)
	else:
		_motion_fail(label)


func _motion_fail(label: String) -> void:
	_motion_failures += 1
	printerr("  FAIL - motion smoke: ", label)


func _finish_motion_smoke() -> void:
	if _motion_failures == 0:
		print("PVLDS MOTION SMOKE: PASS")
		get_tree().quit(0)
	else:
		printerr("PVLDS MOTION SMOKE: FAIL (%d)" % _motion_failures)
		get_tree().quit(1)


var _smoke_swingprobe: bool = false ## --pvlds-smoke-swingprobe: GRADFIX16 item 2, the swing A/B - one letter pick through the real pad path (focus the strip slot, press A) after a cold reset of the decode cache, recording the swing's travel frame deltas on the same fixture. A reading, not a verdict. (Its pair, the artstream cruise smoke, retired in the OPTIMIZE round; the probe stands alone now.)
var _swp_phase: int = 0
var _swp_wait: int = 0
var _swp_failures: int = 0
var _swp_settle_frames: int = 0
var _swp_from_col: int = -1
var _swp_to_col: int = -1
var _swp_letter: String = ""
var _swp_last_usec: int = 0
var _swp_frames: int = 0
var _swp_worst_ms: float = 0.0
var _swp_first_ms: float = 0.0
var _swp_over50: int = 0
var _swp_over33: int = 0
var _swp_spikes: Array = []
var _swp_col_marks: Array = []
var _swp_last_col: int = -1
var _swp_rest_frames: int = 0
var _swp_saw_swing: bool = false
var _swp_pick_ms: float = 0.0


func _swp_expect(cond: bool, label: String) -> void:
	if cond:
		print("  ok - swingprobe smoke: %s" % label)
	else:
		_swp_failures += 1
		printerr("  FAIL - swingprobe smoke: %s" % label)


func _finish_swingprobe_smoke() -> void:
	if _swp_failures == 0:
		print("PVLDS SWINGPROBE: DONE")
		get_tree().quit(0)
	else:
		printerr("PVLDS SWINGPROBE: FAIL (%d)" % _swp_failures)
		get_tree().quit(1)


## The swing A/B driver (see _smoke_swingprobe): boot and
## seat, cold-reset the decode cache, then make ONE letter
## pick the pad's way and record every frame delta until
## the swing settles.
func _drive_swingprobe_smoke() -> void:
	match _swp_phase:
		0:
			if _room != null and _room.visible and _room.wall_ready and not _scan_active \
					and (_art_warmer == null or _art_warmer.is_idle()):
				Input.warp_mouse(Vector2(4, 372))
				if _room._columns < 40:
					_swp_expect(false, "swingprobe: the fixture shelf holds %d columns (the swing probe needs at least 40)" % _room._columns)
					_finish_swingprobe_smoke()
					return
				_swp_phase = 1
				_swp_wait = 0
				_swp_settle_frames = 0
			else:
				_swp_wait += 1
				if _swp_wait > 21600:
					_swp_expect(false, "swingprobe: the room never came up (scan/warm never settled)")
					_finish_swingprobe_smoke()
		1:
			_swp_wait += 1
			if _swp_wait == 1:
				var mid: int = _room._panels.size() / 2
				var mid_col: int = _room._grid_coord(mid).x
				var want_col: int = clampi(mid_col, 12, maxi(12, _room._columns - 20))
				var start_idx: int = mid
				for i: int in range(_room._panels.size()):
					if _room._grid_coord(i).x == want_col and _room._grid_coord(i).y == _room._grid_coord(mid).y:
						start_idx = i
						break
				_room.set_wall_motion_mode("stepped")
				_room._set_centre(start_idx, true)
				_room._set_focused(_room._panels[start_idx])
			if _room.wall_ready and not _room._window_fill_busy and not _room.page_slide_active():
				_swp_settle_frames += 1
			else:
				_swp_settle_frames = 0
			if _swp_settle_frames >= 5:
				# The same cold reset the cruise gets.
				TextureFactory.clear_art_decode_cache()
				TextureFactory.probe_reset()
				_swp_from_col = _room._grid_coord(_room.centre_index()).x
				# Choose the nearest letter whose first game
				# stands at least 14 columns ahead - a long
				# swing through cold columns, the field shape
				# of Chris's letter taps.
				var best_key: String = ""
				var best_dist: int = 1 << 30
				for li: int in range(26):
					var key: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"[li]
					for gi: int in range(_room._visible_games.size()):
						if LetterIndex.letter_of(_room._visible_games[gi].title) == key:
							var gcol: int = _room._grid_coord(gi).x
							var dist: int = gcol - _swp_from_col
							if dist >= 14 and dist < best_dist:
								best_dist = dist
								best_key = key
							break
				if best_key == "":
					_swp_expect(false, "swingprobe: no letter stands 14+ columns ahead of col %d on this fixture" % _swp_from_col)
					_finish_swingprobe_smoke()
					return
				_swp_letter = best_key
				var pick_t0: int = Time.get_ticks_usec()
				_letters_pick(best_key)
				_swp_pick_ms = float(Time.get_ticks_usec() - pick_t0) / 1000.0
				_swp_to_col = _room._grid_coord(_room.centre_index()).x
				_swp_last_col = _swp_from_col
				_swp_last_usec = Time.get_ticks_usec()
				_swp_phase = 2
				_swp_wait = 0
			elif _swp_wait > 7200:
				_swp_expect(false, "swingprobe: the start window never settled")
				_finish_swingprobe_smoke()
		2:
			_swp_wait += 1
			var now_usec: int = Time.get_ticks_usec()
			var delta_ms: float = float(now_usec - _swp_last_usec) / 1000.0
			_swp_last_usec = now_usec
			_swp_frames += 1
			if _swp_frames == 1:
				_swp_first_ms = delta_ms
			if delta_ms > _swp_worst_ms:
				_swp_worst_ms = delta_ms
			if delta_ms > 50.0:
				_swp_over50 += 1
			if delta_ms > 33.0:
				_swp_over33 += 1
			var col_now: int = _room._grid_coord(_room.centre_index()).x
			if delta_ms > 40.0:
				_swp_spikes.append([col_now, snappedf(delta_ms, 0.1)])
			if col_now != _swp_last_col:
				_swp_col_marks.append(col_now)
				_swp_last_col = col_now
			if _room.swing_active():
				_swp_saw_swing = true
			if _swp_saw_swing and not _room.swing_active() and not _room.page_slide_active():
				_swp_rest_frames += 1
			else:
				_swp_rest_frames = 0
			if _swp_rest_frames >= 5:
				var final_col: int = _room._grid_coord(_room.centre_index()).x
				print("SWINGPROBE: letter %s, from col %d to col %d (target col %d), pick call %.1f ms, first frame %.1f ms, frames %d, worst frame %.1f ms, frames >50 ms: %d, frames >33 ms: %d" % [
					_swp_letter, _swp_from_col, final_col, _swp_to_col, _swp_pick_ms, _swp_first_ms, _swp_frames, _swp_worst_ms, _swp_over50, _swp_over33])
				var spikes_line: String = "SWINGPROBE SPIKES (>40 ms):"
				if _swp_spikes.is_empty():
					spikes_line += " none"
				for sp: Variant in _swp_spikes:
					spikes_line += " [col %d: %.1f ms]" % [int((sp as Array)[0]), float((sp as Array)[1])]
				print(spikes_line)
				_swp_expect(_swp_saw_swing, "swingprobe: the letter pick swung the drum (a real swing, not a teleport)")
				_swp_expect(absi(final_col - _swp_from_col) >= 10, "swingprobe: the swing spanned %d columns (a long travel, the cruise's pair)" % absi(final_col - _swp_from_col))
				_artstream_print_probe()
				_swp_phase = 3
				_swp_wait = 0
			elif _swp_wait > 7200:
				_swp_expect(false, "swingprobe: the swing never settled")
				_finish_swingprobe_smoke()
		3:
			# Quiescence before quit: staged work still in
			# flight at process exit crashed the harness
			# build at teardown - the probe waits for the
			# pipeline and the decode pump to drain, the
			# state a settled app quits from. (The base
			# build has no pipeline; its serial fill has
			# always drained by settle.)
			_swp_wait += 1
			if not _room.has_method("art_pipeline_idle") or _room.art_pipeline_idle() or _swp_wait > 3600:
				_finish_swingprobe_smoke()


## -------------------------------------------------- landing smoke (GRADFIX17 item 1)
##
## --pvlds-smoke-landing: hard travel through the room path -
## long held stepped travels BOTH directions, then letter
## swings - over a shelf whose named neighbourhood (the field
## report's shape: Medieval Madness, KISS, Ice Fever,
## Indianapolis 500) resolves its art LATE: big .directb2s
## extractions the warmer lands seconds after the first fill,
## a pair backglass, an embedded-.vpx face, and author shots
## that fetch in flight. After the travel, once the warmer and
## the fetcher have landed everything they will ever land, the
## driver tours the named tables and every travel stop: at
## each stop the room's landing census (fresh probes, the
## heal's read) must read ZERO visible faces still missing
## art, and a rendered grab is saved per stop. Legs are named
## "landing guarantee:". Under PVLDS_GF17_NC=noguarantee the
## room's settle audit is disabled and the census legs fail
## by name. The OPTIMIZE round adds one leg after the tour,
## "optimize: eviction keeps the census": after the hard
## travel + settle + the room's eviction pass, the visible
## census still reads zero, residency stands within its cap,
## and the eviction witness matches the cap's relation to
## the toured shelf (the leg cannot pass vacuously): a tour
## that rendered MORE unique games than the cap holds must
## show an eviction; a tour the cap covers whole must show
## none. (The COMPOSE-AHEAD round raised the cap from 108
## to 384 - above this fixture's whole shelf - and amended
## the witness from its original one-way shape.) Under
## PVLDS_OPT_NC=evictvis the eviction eats a visible face
## and the census part fails by that name.
func _landing_expect(cond: bool, label: String) -> void:
	if cond:
		print("  ok - landing smoke: ", label)
	else:
		_land_failures += 1
		printerr("  FAIL - landing smoke: ", label)


func _finish_landing_smoke() -> void:
	if _land_failures == 0:
		print("PVLDS LANDING SMOKE: PASS")
		get_tree().quit(0)
	else:
		printerr("PVLDS LANDING SMOKE: FAIL (%d)" % _land_failures)
		get_tree().quit(1)


func _land_tour_titles() -> Array[String]:
	return ["Medieval Madness", "KISS", "Ice Fever", "Indianapolis 500",
		"Embedded Falls", "Aaron Spelling", "!WOW!"]


func _drive_landing_smoke() -> void:
	match _land_phase:
		0:
			if not _land_warm_held and _room != null:
				# Hold the warm pass for the travel: the
				# field shape is a library whose warmer runs
				# far behind the player's cruise, so the
				# named neighbourhood's art lands only when
				# the driver releases the pass after the
				# travel (phase 4). The stop must land on
				# the first frame the room exists - the scan
				# started the pass in the same frame the
				# room was entered, and a later stop would
				# find a drained queue on a slow box.
				# Prefetch may still jump near-window
				# sources during travel - each races its
				# own first fill, exactly as on the field rig.
				_land_warm_held = true
				if _art_warmer != null:
					_art_warmer.request_stop()
			if _room != null and _room.visible and _room.wall_ready and not _scan_active:
				_land_wait += 1
				if _land_wait > 21600:
					_landing_expect(false, "landing guarantee: the start window never settled")
					_finish_landing_smoke()
					return
				if not _land_filter_forced:
					# The room boots on the VR filter; the
					# fixture shelf is judged whole, through
					# the room's own rail handler.
					_land_filter_forced = true
					_room._handle_rail("filter:all")
					return
				# Park the pointer over the furniture
				# (the nav driver's lesson): on the drum
				# any other park can sit on a card, and
				# hover would drive the centre away from
				# the legs' travel and fight every settle.
				Input.warp_mouse(Vector2(512.0, 764.0))
				if _room._columns < 40:
					_landing_expect(false, "landing guarantee: the fixture shelf holds %d columns (hard travel needs at least 40)" % _room._columns)
					_finish_landing_smoke()
					return
				var mid: int = _room._panels.size() / 2
				var mid_col: int = _room._grid_coord(mid).x
				var want_col: int = clampi(mid_col, 12, maxi(12, _room._columns - 20))
				var start_idx: int = mid
				for i: int in range(_room._panels.size()):
					if _room._grid_coord(i).x == want_col and _room._grid_coord(i).y == _room._grid_coord(mid).y:
						start_idx = i
						break
				_room.set_wall_motion_mode("stepped")
				_room._set_centre(start_idx, true)
				_room._set_focused(_room._panels[start_idx])
				if not _room._window_fill_busy and not _room.page_slide_active():
					_land_settle_frames += 1
				else:
					_land_settle_frames = 0
				if _land_settle_frames >= 5:
					TextureFactory.clear_art_decode_cache()
					print("LANDING: room up, %d columns, seating and travelling right" % _room._columns)
					_land_start_col = _room._grid_coord(_room.centre_index()).x
					_input_feed_stick_x(1.0)
					_land_phase = 1
					_land_wait = 0
			else:
				_land_wait += 1
				if _land_wait > 21600:
					_landing_expect(false, "landing guarantee: the room never came up (scan never settled)")
					_finish_landing_smoke()
		1:
			# Travel RIGHT through the real input path (a
			# held stick under the stepped gait: repeated
			# steps - travel is the swing standing and the
			# centre moving, the cruise seam is deleted).
			_land_wait += 1
			if _room.swing_active() or _room._grid_coord(_room.centre_index()).x != _land_start_col:
				_land_saw_travel = true
			var col_now: int = _room._grid_coord(_room.centre_index()).x
			if not _land_released and col_now >= _land_start_col + 15:
				_land_released = true
				_input_feed_stick_x(0.0)
			if _land_released:
				if not _room.swing_active():
					_land_rest_frames += 1
				else:
					_land_rest_frames = 0
				if _land_rest_frames >= 3:
					_landing_expect(_land_saw_travel, "landing guarantee: the rightward hold became stepped travel on the real input path")
					_landing_expect(col_now - _land_start_col >= 12, "landing guarantee: the rightward travel spanned %d columns (a long travel)" % (col_now - _land_start_col))
					_land_saw_travel = false
					_land_released = false
					_land_rest_frames = 0
					_input_feed_stick_x(-1.0)
					_land_phase = 2
					_land_wait = 0
			elif _land_wait > 7200:
				_input_feed_stick_x(0.0)
				_landing_expect(false, "landing guarantee: the rightward travel never spanned and settled")
				_finish_landing_smoke()
		2:
			# Travel LEFT, back past the start.
			_land_wait += 1
			if _room.swing_active() or _room._grid_coord(_room.centre_index()).x != _land_start_col:
				_land_saw_travel = true
			var col_now2: int = _room._grid_coord(_room.centre_index()).x
			if not _land_released and col_now2 <= maxi(2, _land_start_col - 10):
				_land_released = true
				_input_feed_stick_x(0.0)
			if _land_released:
				if not _room.swing_active():
					_land_rest_frames += 1
				else:
					_land_rest_frames = 0
				if _land_rest_frames >= 3:
					_landing_expect(_land_saw_travel, "landing guarantee: the leftward hold became stepped travel on the real input path")
					_land_swing_keys = ["I", "K", "M", "E"]
					_land_swing_i = 0
					_land_saw_swing = false
					_land_rest_frames = 0
					_letters_pick(_land_swing_keys[0])
					_land_phase = 3
					_land_wait = 0
			elif _land_wait > 7200:
				_input_feed_stick_x(0.0)
				_landing_expect(false, "landing guarantee: the leftward travel never spanned and settled")
				_finish_landing_smoke()
		3:
			# Letter swings through the strip, the pad's way.
			_land_wait += 1
			if _room.swing_active():
				_land_saw_swing = true
			if _land_saw_swing and not _room.swing_active() and not _room.page_slide_active():
				_land_rest_frames += 1
			else:
				_land_rest_frames = 0
			if _land_rest_frames >= 5:
				_land_swing_i += 1
				_land_saw_swing = false
				_land_rest_frames = 0
				_land_wait = 0
				if _land_swing_i < _land_swing_keys.size():
					_letters_pick(_land_swing_keys[_land_swing_i])
				else:
					_landing_expect(true, "landing guarantee: letter swings I/K/M/E all travelled and settled")
					_land_phase = 4
					_land_wait = 0
			elif _land_wait > 7200:
				_landing_expect(false, "landing guarantee: the letter swing to %s never settled" % _land_swing_keys[_land_swing_i])
				_finish_landing_smoke()
		4:
			# Every art source lands: release the held warm
			# pass (the full library ask, Main's own call),
			# then wait for warmer drained, pipeline idle,
			# and both author shots in their cache. Only
			# then is a still-missing face a NEVER, not a late.
			_land_wait += 1
			if not _land_rewarm_done:
				_land_rewarm_done = true
				if _art_warmer != null and _scanner != null:
					_art_warmer.warm_library(_scanner.games)
			var shots_in: bool = true
			if _scanner != null:
				for g: GameEntry in _scanner.games:
					if g.shot_url != "" and not ArtProvider.shot_is_cached(g.shot_url):
						shots_in = false
			var warm_in: bool = _art_warmer == null or _art_warmer.is_idle()
			if _land_wait == 2:
				print("LANDING: travel done; waiting for every art source to land (warmer idle %s, shots in %s)" % [str(warm_in), str(shots_in)])
			if warm_in and shots_in and _room.art_pipeline_idle():
				_land_tour = _land_tour_titles()
				_land_tour_i = 0
				_land_census_deadline_msec = 0
				_land_grabbed = false
				_land_phase = 5
				_land_wait = 0
			elif _land_wait > 21600:
				_landing_expect(false, "landing guarantee: the art sources never all landed (warmer idle %s, shots in %s)" % [str(warm_in), str(shots_in)])
				_finish_landing_smoke()
		5:
			# The census tour: centre each named table through
			# the room path, settle, then poll its window's
			# census - zero missing, or the leg fails by name
			# with the missing titles printed.
			_land_wait += 1
			if _land_tour_i >= _land_tour.size():
				_land_phase = 7
				_land_wait = 0
				_land_settle_frames = 0
				return
			var title: String = _land_tour[_land_tour_i]
			if _land_census_deadline_msec == 0:
				var tidx: int = -1
				for i: int in range(_room._visible_games.size()):
					if _room._visible_games[i].title == title:
						tidx = i
						break
				if tidx < 0:
					_landing_expect(false, "landing guarantee: the named table '%s' stands on the fixture shelf" % title)
					_land_tour_i += 1
					return
				_room._set_centre(tidx)
				_room._set_focused(_room._panels[tidx])
				_land_census_deadline_msec = -1 # travelling; the census window opens at settle
				_land_settle_frames = 0
				return
			if _land_census_deadline_msec == -1:
				if not _room.swing_active() and not _room.page_slide_active() and _room.art_pipeline_idle():
					_land_settle_frames += 1
				else:
					_land_settle_frames = 0
				if _land_settle_frames >= 3:
					_land_census_deadline_msec = Time.get_ticks_msec() + 30000
				elif _land_wait > 7200:
					_landing_expect(false, "landing guarantee: the tour stop at '%s' never settled" % title)
					_land_tour_i += 1
					_land_census_deadline_msec = 0
					_land_wait = 0
				return
			var census: Dictionary = _room.landing_census()
			var missing: Array = census.get("missing", []) as Array
			var total_faces: int = int(census.get("total", 0))
			if missing.is_empty() and total_faces > 0:
				_landing_expect(true, "landing guarantee: at '%s', every visible face wears its art a beat after settle (%d of %d landed, census zero)" % [title, total_faces, total_faces])
				_land_tour_grab(title)
				_land_tour_i += 1
				_land_census_deadline_msec = 0
				_land_wait = 0
			elif Time.get_ticks_msec() > _land_census_deadline_msec:
				var names: PackedStringArray = PackedStringArray(missing)
				_landing_expect(false, "landing guarantee: at '%s', %d of %d visible faces still missing art a beat after settle: %s" % [title, missing.size(), total_faces, ", ".join(names)])
				_land_tour_grab(title)
				_land_tour_i += 1
				_land_census_deadline_msec = 0
				_land_wait = 0
		7:
			# OPTIMIZE: eviction keeps the census. The tour
			# travelled the shelf and settled at its last
			# stop; give the room's eviction pass a beat at
			# rest, then judge all three parts at the
			# standing window: the census still zero,
			# residency within its cap, and at least one far
			# face actually evicted on the run - a leg that
			# cannot pass vacuously. Under PVLDS_OPT_NC=
			# evictvis the eviction eats a visible face and
			# the census part fails by this leg's name.
			_land_wait += 1
			if not _room.swing_active() and not _room.page_slide_active() and _room.art_pipeline_idle():
				_land_settle_frames += 1
			else:
				_land_settle_frames = 0
			if _land_settle_frames >= 10 or _land_wait > 3600:
				var census7: Dictionary = _room.landing_census()
				var missing7: Array = census7.get("missing", []) as Array
				var total7: int = int(census7.get("total", 0))
				_landing_expect(missing7.is_empty() and total7 > 0,
					"optimize: eviction keeps the census: after hard travel + settle + the eviction pass, the visible census still reads zero missing (%d of %d faces missing)" % [missing7.size(), total7])
				var res7: Dictionary = _room.residency_stats()
				_landing_expect(int(res7.get("resident_faces", -1)) >= 0 and int(res7.get("resident_faces", 0)) <= int(res7.get("cap_faces", 0)),
					"optimize: eviction keeps the census: residency stands within its cap (%d resident faces, cap %d, %d resident bytes, margin %d cols)" % [int(res7.get("resident_faces", 0)), int(res7.get("cap_faces", 0)), int(res7.get("resident_bytes", 0)), int(res7.get("margin_cols", 0))])
				var fc7: Dictionary = _room.face_cache_stats()
				var unique7: int = int(fc7.get("unique_games", 0))
				if unique7 > int(res7.get("cap_faces", 0)):
					_landing_expect(int(res7.get("evicted_total", 0)) > 0,
						"optimize: eviction keeps the census: at least one far game's face was actually evicted during the run (evicted_total %d after travelling a shelf of %d unique games past the %d cap)" % [int(res7.get("evicted_total", 0)), unique7, int(res7.get("cap_faces", 0))])
				else:
					_landing_expect(int(res7.get("evicted_total", 0)) == 0,
						"optimize: eviction keeps the census: no face was evicted on a tour the cap covers whole (%d unique games within cap %d, evicted_total %d)" % [unique7, int(res7.get("cap_faces", 0)), int(res7.get("evicted_total", 0))])
				_land_phase = 6
				_land_wait = 0
		6:
			_land_wait += 1
			if _room.art_pipeline_idle() or _land_wait > 3600:
				_finish_landing_smoke()


func _land_tour_grab(title: String) -> void:
	var dir: String = OS.get_environment("PVLDS_GRAB_DIR")
	if dir == "":
		return
	var slug: String = title.to_lower().replace(" ", "_").replace("!", "wow")
	_save_shot_png(dir.path_join("landing_" + slug + ".png"))


## -------------------------------------------------- facecache smoke (FACECACHE round)
##
## --pvlds-smoke-facecache: the field complaint as a census.
## The OPTIMIZE field session's video: "tap quickly, you
## come up empty on cards until it comes to a stop; doesn't
## matter if card has already loaded previously." The driver
## chains stick taps at field cadence (~320 ms tap to tap,
## a 90 ms deflection each) across the full fixture shelf
## TWICE, sampling the DRAWN panes (room.face_state) on
## every frame of both chains. Pass 1 (cold shelf): a drawn
## face may read missing only while its game has never
## rendered and its first render is in flight - bounded,
## counted, reported. Between the passes, a favourite
## round-trip on the focused card: X on renders the new
## state exactly once; X off must be served as a SWAP (the
## original face, still cached - no third render; this is
## the leg that isolates the cache, because the favourite
## toggle is what invalidates the panel's stamp). Pass 2
## (warm shelf): a game resident in the composed-face cache
## at the pass's start must NEVER read missing mid-chain
## and must NEVER re-render - its re-entries stand on
## their standing stamps and textures, served upstream of
## the cache by the fill's standing branch. Every pass-2
## render must be named: a first render the pass-1 chain
## outran (at this bench's pacing the pipe falls behind
## the taps), or a same-key re-render forced by a cap
## eviction or a heal. Landing census zero at both stops.
## Under PVLDS_OPT_NC=nocache the room's cache never
## serves: the toggle-back renders a third time, a second
## render lands between the passes, the favourite's
## round-trip delta reads 2 - and the round-trip and
## counters legs fail by name.
func _fc_expect(cond: bool, label: String) -> void:
	if cond:
		print("  ok - facecache smoke: ", label)
	else:
		_fc_failures += 1
		printerr("  FAIL - facecache smoke: ", label)


func _finish_facecache_smoke() -> void:
	if _fc_failures == 0:
		print("PVLDS FACECACHE SMOKE: PASS")
		get_tree().quit(0)
	else:
		printerr("PVLDS FACECACHE SMOKE: FAIL (%d)" % _fc_failures)
		get_tree().quit(1)


